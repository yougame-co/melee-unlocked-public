+// Synthetic fixtures and shipped manifest. No disc, game process, network or external delta encoder.
+#include "sysgen.h"
+#include "vcdiff.h"
+#include <nlohmann/json.hpp>
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <fstream>
