index 0000000..861f0eb
--- /dev/null
+++ b/port/tests/sim_work_test.cpp
@@ -0,0 +1,113 @@
+// Window-free histogram, exclusive stage and resimulation accounting checks.
+#include "sim_work.h"
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace host::perf;
+static bool near(double a, double b) { return std::abs(a - b) < 0.000001; }
+int main() {
+  CHECK(active == nullptr);
+  {
+    Scope inactive(Stage::Decode);
+    CHECK(sim_timer.stage == Stage::Step && sim_timer.last == Timer::Clock::time_point{});
+  }
+  CHECK(sim_timer.last == Timer::Clock::time_point{} && sim_timer.work.count == 0);
+  Histogram h;
+  CHECK(h.mean() == 0 && h.p99() == 0 && h.maximum == 0);
+  for (int i = 0; i < 98; ++i) h.add(1.001);
+  h.add(4.001); h.add(20);
+  CHECK(h.count == 100 && near(h.mean(), (98 * 1.001 + 4.001 + 20) / 100));
+  CHECK(near(h.p99(), 4.05) && h.maximum == 20);
+  Histogram edge;
+  edge.add(0); CHECK(edge.p99() == 0);
+  edge.add(0.05); CHECK(near(edge.p99(), 0.05));
+  edge.add(100); CHECK(edge.p99() == 100);
+  edge.add(100.001); CHECK(edge.p99() == edge.maximum && edge.maximum > 100);
+  Histogram many;
+  for (int i = 0; i < 9900; ++i) many.add(2);
+  for (int i = 0; i < 100; ++i) many.add(200);
+  CHECK(many.p99() == 2);
+  many.add(200); CHECK(many.p99() == 200); // overflow rank, no clipping
+
+  Timer t;
+  const auto at = [](int ms) { return Timer::Clock::time_point{} + std::chrono::milliseconds(ms); };
+  t.finish(at(0)); CHECK(t.work.count == 0); // no invented startup sample
+  t.begin(at(0));
+  const auto step = t.enter(Stage::Decode, at(2));
+  const auto decode = t.enter(Stage::Submit, at(3));
+  const auto submit = t.enter(Stage::Wait, at(4));
+  t.enter(submit, at(14));
+  t.enter(decode, at(15));
+  t.enter(step, at(16));
+  t.enter(Stage::Input, at(17));
+  t.enter(Stage::Step, at(18));
+  t.set_resim(true, 100, true, at(19));
+  t.set_resim(true, 101, true, at(20)); // duplicate does not lose the first resim frame
+  t.enter(Stage::Decode, at(20));
+  t.enter(Stage::Step, at(25));
+  t.set_resim(false, 103, true, at(29));
+  const auto frame = t.finish(at(31));
+  CHECK(near(frame.get(Stage::Step), 6) && near(frame.get(Stage::Decode), 2));
+  CHECK(near(frame.get(Stage::Submit), 2) && near(frame.get(Stage::Input), 1));
+  CHECK(near(frame.get(Stage::Wait), 10) && near(frame.work_ms(), 11));
+  CHECK(t.work.count == 1 && near(t.work.mean(), 11) && t.resim_frames == 3);
+  t.finish(at(500)); CHECK(t.work.count == 1); // repeated finish never samples shutdown
+  t.begin(at(500)); t.finish(at(502));
+  CHECK(t.work.count == 2 && near(t.work.mean(), 6.5));
+  CHECK(near(t.mean(Stage::Wait), 5));
+  t.set_resim(true, 100, false, at(503));
+  t.set_resim(false, 150, true, at(504));
+  CHECK(t.resim_frames == 3); // failed query cannot invent frames
+  t.set_resim(true, 100, true, at(505));
+  t.set_resim(false, 0, true, at(506));
+  CHECK(t.resim_frames == 3); // a scene reset cannot underflow
+  Timer only_resim;
+  only_resim.set_resim(true, 10, true, at(0));
+  only_resim.begin(at(0));
+  const auto skipped = only_resim.finish(at(100));
+  CHECK(only_resim.work.count == 0 && skipped.work_ms() == 0);
+  only_resim.set_resim(false, 12, true, at(100));
+  only_resim.set_resim(false, 12, true, at(101));
+  CHECK(only_resim.resim_frames == 2);
+  only_resim.begin(at(102)); only_resim.finish(at(103));
+  CHECK(only_resim.work.count == 1 && only_resim.work.mean() == 1);
+  std::thread simulation([] {
+    active = &sim_timer;
+    active->begin();
+    {
+      Scope decode_cost(Stage::Decode);
+      CHECK(sim_timer.stage == Stage::Decode);
+      { Scope submit_cost(Stage::Submit);
+        { Scope wait_cost(Stage::Wait); CHECK(sim_timer.stage == Stage::Wait); }
+        CHECK(sim_timer.stage == Stage::Submit);
+      }
+      CHECK(sim_timer.stage == Stage::Decode);
+      const auto last = sim_timer.last;
+      const auto frame = sim_timer.frame.ms;
+      // A renderer/worker stays inactive even while the simulation timer is running.
+      std::thread worker([] {
+        CHECK(active == nullptr);
+        Scope decode(Stage::Decode);
+        Scope wait(Stage::Wait);
+        CHECK(active == nullptr);
+      });
+      worker.join();
+      CHECK(sim_timer.stage == Stage::Decode && sim_timer.last == last);
+      CHECK(sim_timer.frame.ms == frame && sim_timer.work.count == 0);
+    }
+    CHECK(sim_timer.stage == Stage::Step);
+    active->finish();
+  });
+  simulation.join();
+  // Shutdown/reporting runs on an inactive thread after the simulation thread is gone.
+  CHECK(active == nullptr);
+  const auto& report = sim_timer;
+  CHECK(!report.running && report.work.count == 1 && report.work.mean() > 0);
+  const auto last = report.last;
+  const auto totals = report.totals;
+  { Scope inactive(Stage::Input); }
+  CHECK(report.last == last && report.totals == totals && report.work.count == 1);
+  std::puts("sim_work: histogram bounds/rank/overflow, exclusive stages, waits and resim ok");
+}
diff --git a/port/tests/slippi_game_prep_test.cpp b/port/tests/slippi_game_prep_test.cpp
new file mode 100644
index 0000000..77a49f5
--- /dev/null
+++ b/port/tests/slippi_game_prep_test.cpp
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "slippi_game_prep.h"
+#include "native_slippi_bridge.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+void prep() {
+  struct FakePeer {
+    slippi::GamePrepQueue received;
+    std::vector<uint8_t> sent;
+    void send(FakePeer& other, const slippi::GamePrepStep& step) {
+      sent = {0x85}; sent.insert(sent.end(), step.begin(), step.end());
+      slippi::GamePrepStep incoming{};
+      std::copy_n(sent.begin() + 1, 5, incoming.begin());
+      other.received.receive(incoming);
+    }
+  } a, b;
+  CHECK(b.received.fetch(0) == (std::array<uint8_t, 6>{}));
+  a.send(b, {0, 2, 1, 3, 4});
+  CHECK(a.sent == (std::vector<uint8_t>{0x85, 0, 2, 1, 3, 4}));
+  CHECK(b.received.fetch(0) == (std::array<uint8_t, 6>{1, 0, 2, 1, 3, 4}));
+  CHECK(b.received.fetch(0) == (std::array<uint8_t, 6>{1, 0, 2, 1, 3, 4}));
+  a.send(b, {1, 20, 2, 8, 9});
+  CHECK(b.received.fetch(1) == (std::array<uint8_t, 6>{1, 0, 20, 2, 8, 9}));
+  CHECK(b.received.fetch(0) == (std::array<uint8_t, 6>{}));
+  b.send(a, {255, 3, 4, 5, 6}); // indices are opaque bytes, including wrap
+  CHECK(a.received.fetch(255)[0] == 1);
+  a.received.clear(); // StartSlippiGame resets the queue between games, as Slippi does
+  CHECK(a.received.fetch(255)[0] == 0);
+  CHECK(a.received.fetch(0)[0] == 0);
+  for (int i = 0; i < 100; ++i) CHECK(a.received.fetch(0)[1] == 0); // no timeout/skip
+  CHECK(slippi::online::command_payload_valid(slippi::online::CMD_GP_COMPLETE_STEP, a.sent.data() + 1, 5));
+  CHECK(!slippi::online::command_payload_valid(slippi::online::CMD_GP_COMPLETE_STEP, a.sent.data() + 1, 4));
+  std::puts("yougame_ranked: fake peer GamePrep layout, ordering, repeated polls and no timeout ok");
+}
+
+int main() { prep(); }
diff --git a/port/tests/slippi_netplay_receive_test.cpp b/port/tests/slippi_netplay_receive_test.cpp
new file mode 100644
index 0000000..401ff90
--- /dev/null
+++ b/port/tests/slippi_netplay_receive_test.cpp
@@ -0,0 +1,136 @@
+// Pre-start inputs already ACKed to the sender must survive late selections.
+#include "slippi_netplay_receive.h"
+#include <algorithm>
+#include <cstdio>
+#include <vector>
+
+namespace {
+using namespace slippi;
+int failures = 0;
+void check(bool ok, const char* name) {
+  if (!ok) { std::printf("FAILED: %s\n", name); ++failures; }
+}
+
+PlayerSelections selection() {
+  PlayerSelections s;
+  s.player_idx = 1; s.character_id = 2; s.character_color = 3;
+  s.is_character_selected = s.is_stage_selected = true;
+  s.stage_id = 8; s.rng_offset = 0xDEDD;
+  return s;
+}
+
+// SendSlippiPad retains the ACK frame and trims all older frames. This models
+// the sender's newest-first wire payload; all eight bytes identify their frame.
+std::vector<uint8_t> pad_packet(int32_t frame, int32_t ack) {
+  std::vector<uint8_t> packet(14, 0);
+  packet[0] = NP_MSG_SLIPPI_PAD;
+  for (int i = 0; i < 4; ++i) packet[1 + i] = (uint8_t)((uint32_t)frame >> (24 - 8 * i));
+  for (int32_t f = frame; f >= std::max(ack, 1); --f)
+    packet.insert(packet.end(), PAD_DATA_SIZE, (uint8_t)f);
+  return packet;
+}
+
+struct Receiver {
+  PlayerSelections merged;
+  bool running = false;
+  int32_t sender_ack = 0;
+  std::deque<std::unique_ptr<Pad>> pads;
+  host::early_input::Buffer early;
+
+  void select() { receive::Selections(selection(), merged, running, pads, early); }
+  receive::PadResult pad(int32_t frame) {
+    const auto packet = pad_packet(frame, sender_ack);
+    const auto result = receive::PadInputs(frame, packet.data(), packet.size(), pads);
+    // OnData emits PAD_ACK(frame, player_idx) for successfully copied new inputs;
+    // the sender's PAD_ACK handler advances last_frame_acked_ monotonically.
+    if (result.error == receive::PadError::None && result.inputs > 0)
+      sender_ack = std::max(sender_ack, frame);
+    return result;
+  }
+  void speculative(int32_t target) {
+    uint8_t data[PAD_DATA_SIZE] = {}; data[0] = (uint8_t)target;
+    early.add(target, data);
+  }
+  void start() {
+    // StartSlippiGame resets timing/selections and unacknowledged MU predictions,
+    // but preserves the confirmed remote queue for the game thread to read.
+    running = false; merged.Reset(); early.clear();
+  }
+};
+
+void late_prestart_selection() {
+  Receiver r;
+  check(r.pad(3).error == receive::PadError::None && r.sender_ack == 3,
+        "pre-start confirmed frames 1..3 are received and ACKed");
+  r.speculative(4);
+  r.select();
+  check(!r.running && r.merged.is_character_selected && r.merged.rng_offset == selection().rng_offset,
+        "late selection merges before local match starts");
+  check(r.pads.size() == 3 && r.early.entries().size() == 1,
+        "pre-start selection preserves confirmed and speculative buffers");
+  const auto resend = r.pad(3);
+  check(resend.error == receive::PadError::None && resend.inputs == 0,
+        "22-byte ACK-trimmed frame 3 resend accepted after late selection");
+  r.start();
+  check(r.pads.size() == 3, "confirmed pre-start inputs survive StartSlippiGame");
+  r.running = true; // SendSlippiPad marks the local game started.
+  check(r.pad(12).error == receive::PadError::None && r.sender_ack == 12 && r.pads.size() == 12,
+        "94-byte frame 12 packet advances from preserved head 3");
+  for (const auto& p : r.pads)
+    check(p->buf[0] == p->frame && p->buf[7] == p->frame,
+          "game can consume all confirmed frames in their original order");
+}
+
+void legacy_failure_proof() {
+  Receiver r;
+  r.pad(3);
+  // The former unconditional selection reset loses acknowledged frames 1 and 2.
+  r.pads.clear();
+  const auto first = r.pad(3), later = r.pad(12);
+  check(pad_packet(3, r.sender_ack).size() == 22 && 14 + first.inputs * PAD_DATA_SIZE == 38,
+        "old reset: frame 3 has 22 bytes but receiver requires 38");
+  check(pad_packet(12, r.sender_ack).size() == 94 && 14 + later.inputs * PAD_DATA_SIZE == 110,
+        "old reset: frame 12 has 94 bytes but receiver requires 110");
+  check(first.error == receive::PadError::TooSmall && later.error == receive::PadError::TooSmall &&
+        r.sender_ack == 3 && r.pads.empty(), "old reset: refusal persists and ACK cannot advance");
+}
+
+void identical_rematch_clears_stale() {
+  Receiver r;
+  r.select(); r.start(); r.running = true;
+  r.pad(90); r.speculative(91);
+  // No game-end hook resets running; it remains true until the next selection.
+  r.select(); // Exactly the same wire selections as the previous game.
+  check(!r.running && r.merged.is_character_selected && r.pads.empty() && r.early.entries().empty(),
+        "identical rematch selection clears both stale queues after a finished game");
+  r.sender_ack = 0; // Opponent's StartSlippiGame resets its sender/ACK epoch.
+  check(r.pad(3).error == receive::PadError::None && r.pads.size() == 3,
+        "rematch accepts new frame numbering from 1");
+  r.select();
+  check(r.pads.size() == 3, "another pre-start selection preserves new rematch inputs");
+}
+
+void normal_order() {
+  Receiver r;
+  r.select(); r.start(); r.running = true;
+  check(r.pad(3).error == receive::PadError::None && r.sender_ack == 3, "normal order accepts initial inputs");
+  check(r.pad(4).inputs == 1 && r.sender_ack == 4 && r.pads.size() == 4,
+        "normal order accepts sender's trimmed incremental packet");
+  check(r.pad(2).inputs < 0 && r.sender_ack == 4 && r.pads.front()->frame == 4,
+        "old packets neither ACK backwards nor replace newer inputs");
+  Receiver limit;
+  check(limit.pad(128).error == receive::PadError::None, "128-frame receive bound unchanged");
+  Receiver oversized;
+  check(oversized.pad(129).error == receive::PadError::TooMany && oversized.pads.empty() && oversized.sender_ack == 0,
+        "oversized input batch is refused without ACK");
+}
+} // namespace
+
+int main() {
+  legacy_failure_proof();
+  late_prestart_selection();
+  identical_rematch_clears_stale();
+  normal_order();
+  if (!failures) std::puts("PASS: legacy_failure_proof, late_prestart_selection, identical_rematch_clears_stale, normal_order");
+  return failures ? 1 : 0;
+}
