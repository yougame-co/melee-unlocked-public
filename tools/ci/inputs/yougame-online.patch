+// Offline startup file checks; the test script supplies its own scratch directory.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_agent_test.h"
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <tuple>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using yougame::agent_test::Settings;
+using json = nlohmann::json;
+
+struct Fixture {
+  std::filesystem::path directory;
+  std::string utf8_directory;
+  explicit Fixture(const char* root) : directory(std::filesystem::u8path(root) / "profile-\xc3\xa9") {
+    std::filesystem::create_directory(directory);
+    const auto utf8 = directory.u8string();
+    utf8_directory.assign(utf8.begin(), utf8.end());
+  }
+  ~Fixture() { std::filesystem::remove_all(directory); }
+  void write(const std::string& bytes) const {
+    std::ofstream file(directory / "agent-test.json", std::ios::binary);
+    file.write(bytes.data(), bytes.size());
+    CHECK(file.good());
+  }
+  Settings load(bool active = true) const {
+    return yougame::agent_test::load(active, utf8_directory.c_str());
+  }
+  Settings load_json(const json& object) const { write(object.dump()); return load(); }
+};
+
+void inert_and_file_limits(Fixture& f) {
+  auto empty = [](const Settings& s) { return s.arguments.empty() && s.environment.empty() && s.log.empty(); };
+  CHECK(empty(f.load()));  // Missing file, including inside YouGame mode.
+  CHECK(empty(yougame::agent_test::load(true, nullptr)));
+  CHECK(empty(yougame::agent_test::load(true, "")));
+  f.write(R"({"mute":true,"online":"ranked","timer":5,"code":"SAND#38","quitAfter":1})");
+  CHECK(empty(f.load(false)));  // No options, env writes or logs outside YouGame.
+  CHECK(empty(f.load_json(json::object())));
+  f.write(std::string(4097, ' '));
+  CHECK(f.load().log == "agent-test.json ignored: exceeds 4 KiB");
+  CHECK(empty(f.load(false)));
+  const std::string valid = R"({"mute":true})";
+  f.write(valid + std::string(4096 - valid.size(), ' '));
+  CHECK(f.load().arguments == std::vector<std::string>({"--volume", "0"}));
+  f.write(valid + std::string(4097 - valid.size(), ' '));
+  CHECK(f.load().arguments.empty() && f.load().environment.empty());
+  for (const char* bad : {"", "{", "null", "[]", "true", "1", R"({"timer":1e999})", R"({"mute":true} trailing)"}) {
+    f.write(bad);
+    const auto s = f.load();
+    CHECK(s.arguments.empty() && s.environment.empty());
+    CHECK(s.log == "agent-test.json ignored: invalid JSON object");
+  }
+  f.write(std::string("{\"mute\":true}\0 trailing", 23));
+  CHECK(f.load().arguments.empty());
+  CHECK(f.load().log == "agent-test.json ignored: invalid JSON object");
+  std::puts("yougame_agent: gating, missing file, 4 KiB boundary and bad JSON ok");
+}
+
+void keys_and_types(Fixture& f) {
+  CHECK(f.load_json({{"mute", true}}).arguments == std::vector<std::string>({"--volume", "0"}));
+  for (const char* mode : {"unranked", "ranked", "direct", "teams"}) {
+    const auto s = f.load_json({{"online", mode}});
+    CHECK(s.arguments == std::vector<std::string>({"--online-test", mode}));  // No suffix: existing parser's default.
+    CHECK(s.environment.empty());
+    CHECK(s.log == "agent-test.json applied default keys: online");
+    for (int character : {0, 2, 25}) {
+      CHECK(f.load_json({{"online", mode}, {"character", character}}).arguments ==
+            std::vector<std::string>({"--online-test", std::string(mode) + ":" + std::to_string(character)}));
+    }
+  }
+  for (const auto& [key, env, low, high] : {
+         std::tuple{"timer", "MELEE_ONLINE_TEST_TIMER", 5, 600},
+         std::tuple{"quitAfter", "MELEE_ONLINE_TEST_QUIT_AFTER", 1, 3}}) {
+    for (int n : {low, high}) {
+      const auto s = f.load_json({{key, n}});
+      CHECK(s.environment == (std::vector<std::pair<std::string, std::string>>{{env, std::to_string(n)}}));
+    }
+  }
+  const std::map<std::string, std::vector<json>> invalid = {
+    {"mute", {false, 0, 1, "true", nullptr, json::array(), json::object()}},
+    {"online", {"Teams", "teams:2", "teamsRanked", "ranked-teams", "Ranked", "ranked:2", "", 1, true, nullptr}},
+    {"character", {-1, 26, 2.0, "2", true, nullptr, 18446744073709551615ull, -9223372036854775807ll}},
+    {"timer", {4, 601, -1, 5.0, "5", true, nullptr, 18446744073709551615ull}},
+    {"quitAfter", {0, 4, -1, 1.0, "1", false, nullptr, 18446744073709551615ull}},
+    {"code", {1, true, nullptr, json::array(), json::object()}}
+  };
+  for (const auto& [key, values] : invalid) {
+    for (const auto& value : values) {
+      const auto s = f.load_json({{key, value}});
+      CHECK(s.arguments.empty() && s.environment.empty());
+      CHECK(s.log.find("ignored") != std::string::npos);
+    }
+  }
+  // An invalid character falls back to the existing online parser's default.
+  CHECK(f.load_json({{"online", "direct"}, {"character", 26}}).arguments ==
+        std::vector<std::string>({"--online-test", "direct"}));
+  const auto teams = f.load_json({{"online", "teams"}, {"timer", 15}, {"quitAfter", 2}, {"teamsRanked", true}});
+  CHECK(teams.arguments == std::vector<std::string>({"--online-test", "teams"}));
+  CHECK(teams.environment == (std::vector<std::pair<std::string, std::string>>{
+      {"MELEE_ONLINE_TEST_QUIT_AFTER", "2"}, {"MELEE_ONLINE_TEST_TIMER", "15"}}));
+  CHECK(teams.log == "agent-test.json applied default keys: quitAfter, timer, online; invalid/unknown or inapplicable keys ignored");
+  CHECK(f.load_json({{"character", 2}}).arguments.empty());
+  CHECK(f.load_json({{"character", 2}}).log.find("ignored") != std::string::npos);
+  std::puts("yougame_agent: each key, strict types, numeric bounds and default character ok");
+}
+
+void code_and_logging(Fixture& f) {
+  for (const std::string code : {"SAND#38", "A", "0123456789##", "#"}) {
+    const auto s = f.load_json({{"code", code}});
+    CHECK(s.environment == (std::vector<std::pair<std::string, std::string>>{{"MELEE_ONLINE_TEST_CODE", code}}));
+  }
+  for (const std::string code : {"", "ABCDEFGHIJKLM", "sand#38", "A B", "A-B", "A_B", "A\nB", "\xc3\x89#1", "A/B", "A\\B"}) {
+    const auto s = f.load_json({{"code", code}});
+    CHECK(s.environment.empty() && s.log.find("ignored") != std::string::npos);
+  }
+  CHECK(f.load_json({{"code", std::string("A\0B", 3)}}).environment.empty());
+  const auto s = f.load_json({{"mute", true}, {"code", "SAND#38"}, {"timer", 600}, {"quitAfter", 3},
+                              {"online", "direct"}, {"character", 25}, {"unknown\npath/private", true}, {"bad", false}});
+  CHECK(s.log == "agent-test.json applied default keys: code, mute, quitAfter, timer, online, character; invalid/unknown or inapplicable keys ignored");
+  CHECK(s.log.find('\n') == std::string::npos);
+  CHECK(s.log.find(f.utf8_directory) == std::string::npos);
+  CHECK(s.log.find("SAND#38") == std::string::npos);
+  CHECK(s.arguments == std::vector<std::string>({"--volume", "0", "--online-test", "direct:25"}));
+  CHECK(s.environment.size() == 3);
+  CHECK(f.load_json({{"unknown", true}}).log == "agent-test.json; invalid/unknown or inapplicable keys ignored");
+  std::puts("yougame_agent: code length/charset and single log with only known key names ok");
+}
+
+void cli_precedence(Fixture& f) {
+  const auto s = f.load_json({{"mute", true}, {"online", "ranked"}, {"character", 25}, {"quitAfter", 2}});
+  std::vector<std::string> original = {"melee_source", "--volume", "41", "--online-test", "direct:9:3", "--log-file", "scratch.log"};
+  std::vector<char*> argv;
+  for (auto& arg : original) argv.push_back(arg.data());
+  const auto args = s.prepend(static_cast<int>(argv.size()), argv.data());
+  // The production parser consumes in order: the explicit flags must be last, intact, and must
+  // not acquire the file's character or mode. This also preserves unrelated flags and values.
+  CHECK(args == std::vector<std::string>({"melee_source", "--volume", "0", "--online-test", "ranked:25",
+                                        "--volume", "41", "--online-test", "direct:9:3", "--log-file", "scratch.log"}));
+  CHECK(Settings{}.prepend(static_cast<int>(argv.size()), argv.data()) == original);
+  CHECK(s.environment == (std::vector<std::pair<std::string, std::string>>{{"MELEE_ONLINE_TEST_QUIT_AFTER", "2"}}));
+  f.write(R"({"online":"unranked","mute":true})");
+  CHECK(s.prepend(static_cast<int>(argv.size()), argv.data()) == args);  // Snapshot, no watching/re-read.
+  std::puts("yougame_agent: CLI precedence, unchanged explicit character/color and startup snapshot ok");
+}
+
+void pad_back_key(Fixture& f) {
+  for (int seconds : {10, 900}) {
+    const auto s = f.load_json({{"padBack", seconds}});
+    CHECK(s.pad_back_seconds == seconds);
+    CHECK(s.arguments.empty() && s.environment.empty());
+    CHECK(s.log == "agent-test.json applied default keys: padBack");
+    CHECK(f.load(false).pad_back_seconds == 0);
+    CHECK(f.load(false).log.empty());
+  }
+  for (const json& value : {json(9), json(901), json("30"), json(30.5), json(true)}) {
+    const auto s = f.load_json({{"padBack", value}});
+    CHECK(s.pad_back_seconds == 0);
+    CHECK(s.arguments.empty() && s.environment.empty());
+    CHECK(s.log == "agent-test.json; invalid/unknown or inapplicable keys ignored");
+    CHECK(s.log.find("padBack") == std::string::npos);
+    CHECK(f.load_json({{"mute", true}, {"padBack", value}}).log ==
+          "agent-test.json applied default keys: mute; invalid/unknown or inapplicable keys ignored");
+  }
+  CHECK(f.load_json({{"mute", true}, {"padBack", 30}}).log ==
+        "agent-test.json applied default keys: mute, padBack");
+  CHECK(yougame::agent_test::load(true, nullptr).pad_back_seconds == 0);
+  CHECK(yougame::agent_test::load(true, "").pad_back_seconds == 0);
+  f.write("{}");
+  CHECK(f.load().pad_back_seconds == 0);
+  std::puts("yougame_agent: padBack bounds, strict types, applied keys and active-mode gating ok");
+}
+
+void script_keys_require_hook(Fixture& f) {
+  // This target deliberately compiles without YOUGAME_AGENT_TEST_HOOK.
+  const auto s = f.load_json({{"script", "ab_vs_source.txt"}, {"rng_seed", 305419896}, {"time_base", 0},
+      {"frames", 7200}, {"frame_times", "ft.csv"}, {"sim_times", "sim.csv"}, {"replay_dir", "replays"},
+      {"record_native", true}, {"slippi_menus", false}, {"no_gc_adapter", true}, {"early_rng_seed", "1@60"},
+      {"stopAt", 600}});
+  CHECK(s.arguments.empty() && s.environment.empty());
+  CHECK(s.log == "agent-test.json; invalid/unknown or inapplicable keys ignored");
+}
+
+void match_key_requires_hook(Fixture& f) {
+  for (const auto engine : {yougame::agent_test::Engine::Source, yougame::agent_test::Engine::Static}) {
+    const auto s = yougame::agent_test::map_keys({{"match", "31:2:20/c9"}}, engine);
+    CHECK(s.arguments.empty() && s.environment.empty());
+    CHECK(s.log == "agent-test.json; invalid/unknown or inapplicable keys ignored");
+  }
+  const auto s = f.load_json({{"match", "31:2:20/c9"}, {"mute", true}});
+  CHECK(s.arguments == std::vector<std::string>({"--volume", "0"}));
+  CHECK(s.log == "agent-test.json applied default keys: mute; invalid/unknown or inapplicable keys ignored");
+}
+
+int main(int argc, char** argv) {
+  CHECK(argc == 2);
+  Fixture fixture(argv[1]);
+  inert_and_file_limits(fixture);
+  keys_and_types(fixture);
+  code_and_logging(fixture);
+  cli_precedence(fixture);
+  pad_back_key(fixture);
+  script_keys_require_hook(fixture);
+  match_key_requires_hook(fixture);
+}
diff --git a/port/tests/yougame_controller_relay_test.cpp b/port/tests/yougame_controller_relay_test.cpp
new file mode 100644
index 0000000..fd1714a
--- /dev/null
+++ b/port/tests/yougame_controller_relay_test.cpp
@@ -0,0 +1,231 @@
+// The app's relayed pads in the game's controller families (yougame_controller_relay.h), read
+// through host::controller_relay the way window.cpp reads them. No window, devices or game.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_controller_relay.h"
+#include <cstdio>
+#include <fstream>
+#include <string>
+using namespace host;
+namespace {
+int failures = 0, checks = 0;
+#define CHECK(x) do { ++checks; if (!(x)) { std::printf("FAIL %d: %s\n", __LINE__, #x); ++failures; } } while (0)
+using Json = nlohmann::json;
+Json relay_pad(unsigned slot, const char* kind, unsigned family_index, uint32_t b, unsigned lt = 0, unsigned rt = 0) {
+  return {{"slot", slot}, {"familyIndex", family_index}, {"id", "p" + std::to_string(slot + 1)}, {"name", "Pad"},
+          {"kind", kind}, {"b", b}, {"lx", 32767}, {"ly", -32768}, {"rx", 0}, {"ry", 0}, {"lt", lt}, {"rt", rt}};
+}
+std::string pads_line(const Json& pads) { return "yg-pads " + Json({{"seq", 1}, {"t", 1}, {"pads", pads}}).dump(); }
+controller_relay::Snapshot bridged(const Json& pads) {
+  yougame::relay_pads::Frame frame; std::string reason;
+  CHECK(yougame::relay_pads::parse(pads_line(pads), frame, reason));
+  return yougame::relay_pads::controller_snapshot(frame);
+}
+const controller_relay::Sample* device_of(const controller_relay::Snapshot& s, CaptureDevice family, int index) {
+  for (const auto& d : s.devices) if (d.family == family && d.index == index) return &d;
+  return nullptr;
+}
+// As yougame_link.cpp installs it.
+yougame::relay_pads::State g_relay_state([](const std::string&) {});
+controller_relay::Snapshot relayed_snapshot() { return yougame::relay_pads::controller_snapshot(g_relay_state.snapshot()); }
+
+std::ifstream fixture(const char* name) {
+  // Copied verbatim from controller-lead's controller/{gap-run-lines.txt,fixtures/ps.jsonl}.
+  std::ifstream stream(std::filesystem::path(__FILE__).parent_path() / "fixtures" / "relay" / name);
+  CHECK(stream.is_open());
+  return stream;
+}
+InputDeviceFacts relay_facts() {
+  InputDeviceFacts facts;
+  const auto snapshot = relayed_snapshot();
+  for (const auto& device : snapshot.devices) {
+    if (device.index < 0 || device.index >= 4) continue;
+    switch (device.family) {
+      case CaptureDevice::XInputPad: facts.xinput[device.index] = true; break;
+      case CaptureDevice::DS4Pad: facts.ds4[device.index] = true; break;
+      case CaptureDevice::SwitchPro: facts.switch_pro[device.index] = true; break;
+      case CaptureDevice::HidPad: facts.hid[device.index] = true; break;
+      default: break;
+    }
+  }
+  return controller_relay::fallback_facts(facts);
+}
+void gap_run() {
+  auto stream = fixture("gap-run-lines.txt");
+  controller_relay::install(relayed_snapshot);
+  std::string line;
+  unsigned count = 0;
+  while (std::getline(stream, line)) {
+    if (line.rfind("yg-pads ", 0) != 0) continue;
+    ++count;
+    CHECK(g_relay_state.accept(line, count * 1000));
+    const auto frame = g_relay_state.snapshot();
+    const auto snapshot = relayed_snapshot();
+    CHECK(frame.seq == count);
+    for (unsigned seat = 0; seat < 4; ++seat) {
+      const bool present = seat == 0 || seat == 2 || (seat == 1 && count == 1);
+      CHECK(frame.pads[seat].present == present);
+      const auto& device = snapshot.devices[seat];
+      if (!present) { CHECK(device.family == CaptureDevice::None); continue; }
+      CHECK(frame.pads[seat].id == "p" + std::to_string(seat + 1));
+      const auto family = seat == 0 ? CaptureDevice::DS4Pad : CaptureDevice::XInputPad;
+      const int index = seat == 2 ? 1 : 0;
+      CHECK(device.family == family && device.index == index);
+      controller_relay::Sample sampled;
+      CHECK(controller_relay::sample(family, index, sampled));
+      const uint32_t expected = count == 3 ? (seat == 0 ? uint32_t(DS4_CROSS) : 0x1000u) : 0u;
+      CHECK(sampled.buttons == expected);
+    }
+    controller_relay::Sample missing;
+    CHECK(!controller_relay::sample(CaptureDevice::XInputPad, 2, missing));
+    CHECK(!controller_relay::sample(CaptureDevice::DS4Pad, 1, missing));
+    CHECK(controller_relay::sample(CaptureDevice::XInputPad, 0, missing) == (count == 1));
+  }
+  CHECK(count == 4);
+  controller_relay::install(nullptr);
+}
+void virtual_fallback() {
+  controller_relay::install(relayed_snapshot);
+  auto keyboard = relay_pad(0, "other", 0, 0x1000);
+  keyboard["id"] = "virtual";
+  auto sources = default_port_sources();
+  const auto route = [&](const Json& pads, const std::array<PortSource, 4>& configured, int port = 0) {
+    CHECK(g_relay_state.accept(pads_line(pads), 1));
+    return effective_port_source(configured, relay_facts(), port);
+  };
+  for (const char* kind : {"ps", "switch", "xbox", "other", "hid"}) {
+    const auto real = relay_pad(2, kind, 1, 0);
+    const auto real_kind = kind == std::string("ps") ? DeviceKind::DS4Pad :
+      kind == std::string("switch") ? DeviceKind::SwitchPro :
+      kind == std::string("hid") ? DeviceKind::HidPad : DeviceKind::XInputPad;
+    auto source = route(Json::array({keyboard, real}), sources);
+    CHECK(source.kind == real_kind);
+    CHECK(source.index == 1);
+    // It is still connected and can be explicitly selected on P1 or another port.
+    controller_relay::Sample sample;
+    CHECK(controller_relay::sample(CaptureDevice::XInputPad, 0, sample) && sample.buttons == 0x1000);
+    auto explicit_sources = sources;
+    explicit_sources[0] = {DeviceKind::XInputPad, 0};
+    source = route(Json::array({keyboard, real}), explicit_sources);
+    CHECK(source.kind == DeviceKind::XInputPad && source.index == 0);
+    explicit_sources[1] = {DeviceKind::XInputPad, 0};
+    source = route(Json::array({keyboard, real}), explicit_sources, 1);
+    CHECK(source.kind == DeviceKind::XInputPad && source.index == 0);
+    // A real pad already assigned elsewhere still excludes virtual from automatic P1.
+    explicit_sources = sources;
+    explicit_sources[1] = {real_kind, 1};
+    source = route(Json::array({keyboard, real}), explicit_sources);
+    CHECK(source.kind == DeviceKind::Keyboard);
+  }
+  auto source = route(Json::array({keyboard}), sources);
+  CHECK(source.kind == DeviceKind::XInputPad && source.index == 0);
+  auto ps = relay_pad(2, "ps", 0, 0);
+  ps["id"] = "virtual"; // The exception identifies kind and id together.
+  source = route(Json::array({keyboard, ps}), sources);
+  CHECK(source.kind == DeviceKind::DS4Pad && source.index == 0);
+  source = route(Json::array(), sources);
+  CHECK(source.kind == DeviceKind::Keyboard);
+  // Only the exact other/virtual identity is excluded; another generic pad keeps Xbox priority.
+  keyboard["id"] = "keyboard";
+  source = route(Json::array({keyboard, relay_pad(2, "ps", 0, 0)}), sources);
+  CHECK(source.kind == DeviceKind::XInputPad && source.index == 0);
+  controller_relay::install(nullptr);
+}
+void ps_fixture() {
+  auto stream = fixture("ps.jsonl");
+  controller_relay::install(relayed_snapshot);
+  unsigned count = 0;
+  std::string line;
+  while (std::getline(stream, line)) {
+    const auto entry = Json::parse(line);
+    const auto& device = entry.at("device");
+    // The device describes native masks; the line contains the parser's XInput-position wire form.
+    CHECK(device.at("kind") == "ps" && device.at("buttons") == Json::array({"DS4_CROSS"}));
+    CHECK(g_relay_state.accept(entry.at("line").get<std::string>(), 1000));
+    controller_relay::Sample sample;
+    CHECK(controller_relay::sample(CaptureDevice::DS4Pad, device.at("index").get<int>(), sample));
+    CHECK(sample.buttons == DS4_CROSS);
+    unsigned axis = 0;
+    for (const char* name : {"lx", "ly", "rx", "ry"}) CHECK(sample.axes[axis++] == device.at("axes").at(name).get<int>());
+    CHECK(sample.left == device.at("triggers").at("l2").get<int>());
+    CHECK(sample.right == device.at("triggers").at("r2").get<int>());
+    CHECK(entry.at("profile").is_null());
+    PadBindings defaults{}; defaults.mask[(size_t)BindAction::A] = DS4_CROSS; // window.cpp ds4_default_mask
+    auto pad = controller_relay::raw_pad(sample);
+    ds4_apply_bindings(defaults, static_cast<uint16_t>(sample.buttons), pad);
+    CHECK(pad.button == 0x100);
+    const auto source = effective_port_source(default_port_sources(), relay_facts(), entry.at("port").get<int>() - 1);
+    CHECK(source.kind == DeviceKind::DS4Pad && source.index == device.at("index").get<int>());
+    ++count;
+  }
+  CHECK(count == 1);
+  controller_relay::install(nullptr);
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc == 2) {
+    const std::string name = argv[1];
+    if (name == "gap") gap_run();
+    else if (name == "virtual") virtual_fallback();
+    else if (name == "ps-fixture") ps_fixture();
+    else CHECK(false);
+    std::printf("yougame controller relay %s: %d checks, %d failures\n", argv[1], checks, failures);
+    return failures ? 1 : 0;
+  }
+  // Seats 0 and 2 only: each family keeps its own numbers, and a gap stays a gap.
+  auto s = bridged(Json::array({relay_pad(0, "ps", 0, 0x1000, 79, 20), relay_pad(2, "xbox", 0, 0x1000, 0, 255)}));
+  const auto* ps = device_of(s, CaptureDevice::DS4Pad, 0);
+  const auto* xb = device_of(s, CaptureDevice::XInputPad, 0);
+  CHECK(ps && xb);
+  CHECK(!device_of(s, CaptureDevice::XInputPad, 2) && !device_of(s, CaptureDevice::DS4Pad, 2));
+  CHECK(s.devices[1].family == CaptureDevice::None && s.devices[3].family == CaptureDevice::None);
+  // PlayStation: its own mask (south = Cross), L2 past the press point, no travel below it.
+  if (ps) { CHECK(ps->buttons == (DS4_CROSS | DS4_L2)); CHECK(ps->left == 79 && ps->right == 0); }
+  // Xbox: what the app sent, triggers raw, as before.
+  if (xb) CHECK(xb->buttons == 0x1000 && xb->left == 0 && xb->right == 255);
+  // A custom PlayStation Cross -> B table gives B, never the Xbox default A.
+  if (ps) {
+    PadBindings custom{}; custom.mask[(int)BindAction::B] = DS4_CROSS;
+    PadState p = controller_relay::raw_pad(*ps);
+    ds4_apply_bindings(custom, (uint16_t)ps->buttons, p);
+    CHECK((p.button & 0x300) == 0x200);
+  }
+  // Switch: by position (south = B, east = A, west = Y, north = X); ZL/ZR are buttons with no travel.
+  s = bridged(Json::array({relay_pad(1, "switch", 3, 0x1000 | 0x2000 | 0x4000 | 0x8000, 255, 255)}));
+  const auto* sw = device_of(s, CaptureDevice::SwitchPro, 3);
+  CHECK(sw);
+  if (sw) {
+    CHECK(sw->buttons == (SWPRO_B | SWPRO_A | SWPRO_Y | SWPRO_X | SWPRO_ZL | SWPRO_ZR));
+    CHECK(sw->left == 0 && sw->right == 0);
+  }
+  // Raw HID: its own 32 bits (bit 31 = the hat's Left), its own family.
+  s = bridged(Json::array({relay_pad(0, "hid", 0, 0x80000001u)}));
+  const auto* hid = device_of(s, CaptureDevice::HidPad, 0);
+  CHECK(hid && hid->buttons == 0x80000001u);
+  // One number twice in the Xbox family (other + xbox): the lower seat plays, the other is left out.
+  s = bridged(Json::array({relay_pad(3, "xbox", 1, 0x2000), relay_pad(0, "other", 1, 0x1000)}));
+  const auto* one = device_of(s, CaptureDevice::XInputPad, 1);
+  CHECK(one && one->buttons == 0x1000);
+  CHECK(s.devices[3].family == CaptureDevice::None);
+
+  // Through the provider: installed with nothing accepted yet, it owns its families with no pads.
+  controller_relay::install(relayed_snapshot);
+  controller_relay::Sample sample;
+  CHECK(controller_relay::active() && !controller_relay::sample(CaptureDevice::XInputPad, 0, sample));
+  CHECK(g_relay_state.accept(pads_line(Json::array({relay_pad(0, "ps", 0, 0x1000), relay_pad(2, "xbox", 0, 0)})), 1));
+  CHECK(controller_relay::sample(CaptureDevice::DS4Pad, 0, sample) && sample.buttons == DS4_CROSS);
+  CHECK(controller_relay::sample(CaptureDevice::XInputPad, 0, sample) && sample.buttons == 0);
+  CHECK(!controller_relay::sample(CaptureDevice::XInputPad, 2, sample));
+  PadState pads[4]{}; uint32_t buttons[4]{};
+  CHECK(controller_relay::poll(CaptureDevice::DS4Pad, pads, buttons) == 1u && buttons[0] == DS4_CROSS);
+  CHECK(controller_relay::poll(CaptureDevice::SwitchPro, pads, buttons) == 0u);
+  CHECK(!g_relay_state.owns_hid());   // window.cpp leaves HID to the game's own reader
+  // EOF: the relay keeps its latch and the provider stays in, with every family empty.
+  g_relay_state.reset_on_eof();
+  for (auto family : {CaptureDevice::XInputPad, CaptureDevice::DS4Pad, CaptureDevice::SwitchPro, CaptureDevice::HidPad})
+    for (int i = 0; i < 4; ++i) CHECK(!controller_relay::sample(family, i, sample));
+  CHECK(controller_relay::active() && g_relay_state.active());
+  controller_relay::install(nullptr);
+  std::printf("yougame controller relay: %d failures\n", failures);
+  return failures ? 1 : 0;
+}
diff --git a/port/tests/yougame_direct_test.sh b/port/tests/yougame_direct_test.sh
new file mode 100755
index 0000000..e9350d1
--- /dev/null
+++ b/port/tests/yougame_direct_test.sh
@@ -0,0 +1,58 @@
+#!/bin/sh
+# Offline P4 checks; no sockets or packages. Run from the fork root.
+set -eu
+build_dir=$(mktemp -d /tmp/yougame-direct-test.XXXXXX)
+trap 'rm -rf "$build_dir"' EXIT HUP INT TERM
+san_flags=
+if [ "${SANITIZE:-0}" = 1 ]; then
+  san_flags='-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer'
+fi
+clang++ -std=c++20 -O1 -Wno-deprecated-declarations $san_flags -Iport/runtime/hle -Iport/third_party \
+  port/tests/yougame_transport_test.cpp -o "$build_dir/transport"
+"$build_dir/transport"
