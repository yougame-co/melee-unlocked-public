+// YouGame online: what replaces Slippi's servers when the YouGame desktop app launches the game.
+//
+// Slippi's matchmaking server, user record and game reporter are swapped for YouGame's: the
+// player's identity and match tickets come from the desktop app's bridge, matchmaking and results
+// go through YouGame's rooms Worker. With hello.netBroker.direct the app owns all networking:
+// brokered rooms and sealed datagrams through a shared ring, with virtual ENet addresses. Internet
+// builds keep STUN and punching before the Slippi netplay client takes over. The game's
+// menus, the rollback engine and the netplay wire format do not change.
+//
+// YouGame mode is on only when the app started the game: YOUGAME_STDIO=1 (the app's sandboxed
+// launch, the bridge on stdin/stdout) or YOUGAME_BRIDGE + YOUGAME_TOKEN (its loopback bridge). See
+// docs/MELEE_UNLOCKED.md in the YouGame repository. Off, nothing here runs and nothing changes,
+// Unranked with a local Slippi login uses Slippi's matchmaking and native UDP instead.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+struct _XINPUT_STATE;
+#ifndef _WIN32
+#include "yougame_pad_mirror.h"
+#endif
+
+namespace yougame {
+namespace relay_pads {
+// After the host selects --log-file; releases controller messages buffered during startup.
+void logging_ready();
+bool active();
+bool read(unsigned slot, _XINPUT_STATE* state);
+// Serialized with activation, so even the probe/rumble workers cannot open native pads
+// after the app takes over. poll serves the relay or invokes the native fallback.
+bool poll(unsigned slot, _XINPUT_STATE* state, const std::function<bool()>& native);
+void rumble(const std::function<void()>& native);
+// The app has sent a raw HID pad (kind "hid") this run, so HID pads are its own from then on.
+bool owns_hid();
+#ifdef YOUGAME_AGENT_TEST_HOOK
+void arm_rumble_test(double boot_ms);
+#endif
+}
+namespace mode_policy { enum class ModRefusal; }
+
+// Call once at startup, before the window exists: takes the bridge's address and token out of the
+// environment (so nothing the game starts inherits them) and, in stdio mode, starts reading the
+// app's lines, so the player box's commands are heard from the first frame.
+void start();
+
+// Launched by the YouGame desktop app (including Slippi-routed Unranked).
+bool active();
+// The bridge is this process's stdin/stdout (the app's sandboxed launch): stdout carries only
+// bridge lines (the log goes to stderr), and the GameCube adapter comes from the app's pad mirror.
+bool stdio_bridge();
+
+// Best-effort compatibility code for an explicit listing layer. At most one request per process;
+// any reply (including an old app's unknown-request reply) suffices. Returns within 500 ms.
+void notify_mod_refused(bool explicit_layer, mode_policy::ModRefusal refusal,
+                        const std::string& mod = {}, const std::string& version = {});
+
+// The game draws in the YouGame player box (YOUGAME_EMBED=1); the app places its window.
+bool embedded();
+// Windows launch contract, consumed before window creation; false/zero elsewhere.
+bool embed_toplevel();
+uint32_t app_pid();
+void embed_window_ready(uintptr_t hwnd = 0);
+// The player box's commands ("rect x y w h", "hide", "show", "focus", "blur", "volume v", "quit"),
+// delivered on the bridge's reader thread. Lines that arrive before a handler is set are kept.
+void set_box_handler(std::function<void(const std::string&)> handler);
+#ifdef MELEE_LINUX_X11_EMBED
+// Linux full host: ordered, bounded commands buffered from startup, drained by the video thread.
+std::vector<std::string> take_box_commands();
+#endif
+// The pad mirror the app shares (a section handle in this process, 0 until it arrives): the
+// GameCube adapter as the YouGame app's controller helper reads it (gc_adapter.cpp).
+uintptr_t pad_mirror_handle();
+#ifndef _WIN32
+// Inherited, borrowed O_RDONLY descriptor and advertised mapping size.
+pad_mirror::Attachment pad_mirror_attachment();
+#endif
+
+struct Identity {
+  bool ok = false;
+  std::string player_id;   // this game's player id for the signed-in account (the room's player id)
+  std::string name;        // display name, as the room shows it to opponents
+  std::string code;        // connect code, "TAG#123"; empty when YouGame has not assigned one
+  std::string error;       // why there is no identity (signed out, the app is not answering)
+};
+// The signed-in YouGame player, from a cache: never blocks (the game thread reads it every frame
+// in the online menus). The first call starts asking the app in the background and answers "not
+// signed in yet"; a failed answer is asked again after a few seconds. refresh_identity() asks
+// again now, in the background (the online menu's "log in", which re-read user.json for Slippi).
+Identity identity();
+void refresh_identity();
+// The first answer, waiting for it until `ms` after the first call of the process, never longer in
+// total (the online menu's status query at boot: answered before the identity arrived, the menus
+// would draw Slippi's "log in" screen; a slow app must not stall the game thread again and again).
+Identity wait_identity(int ms);
+
+// A key the YouGame page owns, pressed while the game has the keyboard ("escape": the page leaves
+// full screen). Sent over the stdio bridge as `yg {"key":"escape"}`.
+void relay_key(const char* key);
+
+// The page pause's state for the page (yougame_ux.h PagePause::Result), sent over the stdio bridge as
+// `yg {"event":{"type":"pause","pausable":B,"paused":P,"reason":R}}` (reason left out when null).
+void pause_event(bool pausable, bool paused, const char* reason);
+
+// The host picker runs off the simulation thread while code entry remains visible.
+// Throws on cancellation, a page error, or an invalid answer; opens no room.
+std::string pick_friend_room(const std::function<bool()>& cancelled);
+
+// Retire any previous YouGame room before selecting plain UDP for a Slippi search.
+bool prepare_slippi_match(const std::function<bool()>& cancelled);
+
+// One matchmaking search: the game's online menu choice.
+struct Search {
+  int mode = 1;               // Slippi's ids: 0 ranked, 1 unranked, 2 direct, 3 teams
+  std::string direct_code;    // the opponent's connect code (Direct)
+  std::string friend_room;    // internal invite; never an opponent connect code
+  uint16_t udp_port = 0;      // the netplay port; STUN and the punch run from it so the NAT mapping is the one ENet uses
+};
+
+struct Player {
+  int port = 0;               // 1-based, the in-game port (room seat + 1)
+  bool local = false;
+  std::string id, name, code; // id: the room's player id
+  std::string address;        // virtual "ip:port" in direct mode, otherwise the punched address; empty locally
+};
+
+struct Match {
+  bool ok = false;
+  std::string error;          // shown in the game's error box
+  bool retry = false;         // the connection failed after a match was found: search again
+  std::string match_id;       // a fresh id per match (never the room's code, which stays private)
+  bool host = false;          // seat 0: the decider
+  int local_index = 0;        // 0-based local port
+  std::vector<Player> players;
+};
+
+// Runs a whole search on the matchmaking thread: ticket, queue or direct room, compatibility
+// exchange and app-owned links (or legacy punching). Returns when the players can reach each other, on an error, or when `cancelled` turns true.
+// The room stays open afterwards for results (game_started / game_ended) until end_session().
+Match find_match(const Search& search, const std::function<bool()>& cancelled);
+
+// Room slot == Slippi player index (controller port - 1). Unknown or no room: -1.
+int seat_team(int player_idx);
+
+// The online game the room is recording started (the host asks the room to start a match).
+void game_started();
+// One game's end, from the game's Game End record (the Source Port) or Slippi's report (the Static
+// Recomp). A game is reported once, however many places say it ended.
+struct GameEnd {
+  int winner = -1;              // 0-based port of the single winner as the caller read it, -1 none
+  int end_method = 0;           // Slippi's: 1 TIME!, 2 GAME!, 7 No Contest (LRA-Start, disconnect, desync)
+  int lras = -1;                // the port a No Contest names, -1 none
+  bool has_placements = false;  // placements[]: the record's four placement bytes (0 first, 0xFF none)
+  int placements[4] = {-1, -1, -1, -1};
+  int teams[4] = {-1, -1, -1, -1}; // actual negotiated match teams, by Slippi player index
+  int stage = -1, frames = -1;  // the game's stage id and length, for the ranked report's detail
+  int characters[2] = {-1, -1};
+  int64_t rng = -1;             // the match's rng offset (both games agree on it): the report's id
+};
+void game_ended(const GameEnd& end);
+// Ranked: one best-of-3 set per room (yougame_ranked.h), decided from the games the room settles.
+void ranked_set_complete(uint8_t end_mode);   // C2 (a future GameSetup port)
+void ranked_match_status(uint8_t status);     // C4: 40 is Slippi's "abandoned"
+void ranked_game_setup();                     // the game sent a GameSetup step: its C2 decides
+// Game thread, every online menu poll: a game's result is still on its way (no next game may start
+// yet), or the set is decided or its room is gone (break the pair, back to the search).
+bool ranked_hold();
+bool ranked_set_over();
+// No ranked room is open or still finishing, and one was (the --online-test ranked harness).
+bool ranked_room_retired();
+// This client's games with unique room receipts (the --online-test quit-after harness).
+int ranked_games_received();
+// The Ranked character select's header ("Ranked Mode", "Ranked - Placements 2/5",
+// "Ranked - Gold II - 1534"). The first ask without a known rank reads it from the app (mpRank).
+std::string ranked_header();
+// The last ranked standing is cached per process (E3/E5 and the match-state rank bytes).
+std::vector<uint8_t> rank_response();
+uint8_t rank_visibility();
+uint8_t local_rank();
+
+// Why the game leaves the room. Quit: the local player left (leaving the online menus, holding Z,
+// a new search); Lost: the connection to the opponent broke; Over: the ranked set is decided.
+enum class Leave { Quit, Lost, Over };
+// Leaves the room: the session is over (the game's online cleanup). Only Ranked reads `why`.
+void end_session(Leave why);
+
+// Status for logs and the YouGame page: "searching", "connecting", "playing", the opponent.
+std::string status_line();
+
+}  // namespace yougame
diff --git a/port/runtime/hle/yougame_memcard.cpp b/port/runtime/hle/yougame_memcard.cpp
new file mode 100644
index 0000000..4b990ea
--- /dev/null
+++ b/port/runtime/hle/yougame_memcard.cpp
@@ -0,0 +1,49 @@
+// Answer only the memory-card scene's create/created prompts, through its own input path.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_memcard.h"
+#include "yougame_link.h"
+#include "host.h"
+
+namespace yougame::memcard {
+namespace {
+constexpr uint32_t kInput = 0x801AEDC8u, kMessage = 0x801AEE6Cu;
+constexpr uint32_t kProbe = 0x801AF0D4u, kDecide = 0x801AF250u, kFrame = 0x801AF568u;
+// NTSC 1.02 gmscmemcard.c enter_data: channel +4, decision +0x14, Yes/No +0x1C.
+constexpr uint32_t kData = 0x80480DA8u;
+ppc::Fn original_input = nullptr, original_message = nullptr;
+
+void input(ppc::Context& c, uint8_t* m) {
+  // gm_801AEDC8 is also used by other menus. Only calls from the card scene qualify.
+  if (c.lr >= kMessage && c.lr < 0x801B0264u &&
+      confirm(yougame::active(), host::rd8(kData + 4), host::rd32(kData + 0x14))) {
+    host::wr8(kData + 0x1C, 0);  // Yes, even if a physical direction was held at boot.
+    c.r[3] = 0x100;             // PAD_BUTTON_A, consumed only by this menu.
+    return;
+  }
+  original_input(c, m);
+}
+
+void message(ppc::Context& c, uint8_t* m) {
+  if (hide_message(yougame::active(), host::rd8(kData + 4), c.r[4])) return;
+  original_message(c, m);
+}
+}  // namespace
+
+void install_static_boot() {
+  if (!yougame::active() || original_input) return;
+  if (!ppc::lookup(kInput) || !ppc::lookup(kMessage)) {
+    host::log("yougame: memory-card prompt functions are unavailable");
+    return;
+  }
+  // Translated functions call each other directly. Interpret just these three small
+  // menu functions so their input/message calls reach the dispatch hooks, including
+  // a mod's current RAM code. The original probe, create, write and error paths run.
+  if (!ppc::redirect_to_interpreter(kFrame) || !ppc::redirect_to_interpreter(kProbe) ||
+      !ppc::redirect_to_interpreter(kDecide)) {
+    host::log("yougame: could not install memory-card menu answers");
+    return;
+  }
+  original_input = ppc::set_hook(kInput, input);
+  original_message = ppc::set_hook(kMessage, message);
+}
+}  // namespace yougame::memcard
diff --git a/port/runtime/hle/yougame_memcard.h b/port/runtime/hle/yougame_memcard.h
new file mode 100644
index 0000000..8e979ff
--- /dev/null
+++ b/port/runtime/hle/yougame_memcard.h
@@ -0,0 +1,19 @@
+// Boot menu policy shared by the Source Port and Static Recomp.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+namespace yougame::memcard {
+// gmscmemcard.c: decision 5 asks to create a missing save; decision 7 acknowledges
+// successful creation. Errors, formatting, existing saves and slot B need no answer.
+constexpr bool confirm(bool active, unsigned channel, unsigned decision) {
+  return active && channel == 0 && (decision == 5 || decision == 7);
+}
+
+// The menu builds these two messages before assigning decisions 5 and 7.
+constexpr bool hide_message(bool active, unsigned channel, unsigned message) {
+  return active && channel == 0 && (message == 0xA || message == 0xC);
+}
+
+// Installed after the Static Recomp's disc and dispatch table are ready.
+void install_static_boot();
+}  // namespace yougame::memcard
diff --git a/port/runtime/hle/yougame_mode_policy.h b/port/runtime/hle/yougame_mode_policy.h
new file mode 100644
index 0000000..adbacba
--- /dev/null
+++ b/port/runtime/hle/yougame_mode_policy.h
@@ -0,0 +1,85 @@
+// Process-local policy for the clean engine launched by YouGame.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <cstddef>
+#include <string>
+
+namespace yougame::mode_policy {
+
+enum class MatchmakingRoute { YouGame, Slippi };
+
+// Slippi's mode ids: 0 Ranked, 1 Unranked, 2 Direct, 3 Teams, 4 Party.
+// Launched by YouGame, only a plain Unranked search with a Slippi login on the base listing goes to
+// Slippi: `vanilla` is host::gameplay::vanilla_only() (a verified retail disc, no mods). A remix
+// build would desync against Slippi players, so it keeps YouGame's own pool (yougame-lead #33582).
+constexpr MatchmakingRoute matchmaking_route(int mode, bool yougame_mode, bool slippi_login,
+                                             bool agent_script, bool friend_room, bool vanilla) {
+  if (agent_script) return MatchmakingRoute::YouGame;
+  return !yougame_mode || (mode == 1 && slippi_login && !friend_room && vanilla)
+      ? MatchmakingRoute::Slippi : MatchmakingRoute::YouGame;
+}
+
+// Whether the Online menu offers Ranked in YouGame mode. Off until Ranked plays like Slippi's
+// (rank shown, best of 3, stage striking, rating change): Luis, 2026-10-29. The site's ladder
+// switch is off for these listings too, and the page turns a ranked request into a casual one.
+constexpr bool yougame_ranked_offered = false;
+// The Online menu's Friends row: off in the main build until its label renders right (Luis 10-30 saw "Fsjfoet") and a
+// real-input pass confirms it; the Friends branch build turns it on with -DYOUGAME_FRIENDS_ROW=1.
+#ifndef YOUGAME_FRIENDS_ROW
+#define YOUGAME_FRIENDS_ROW 0
+#endif
+constexpr bool friends_offered(bool yougame_mode) { return YOUGAME_FRIENDS_ROW != 0 && yougame_mode; }
+
+constexpr bool spectator_allowed(bool yougame_mode, bool setting_on) {
+  return !yougame_mode && setting_on;
+}
+
+// The crash dialog (main.cpp: die_report, crash_filter) is a modal message box on the thread that
+// stopped, and the process ends only once someone closes it. Launched by YouGame, the game draws
+// inside the app's player box and the app tells the player that it stopped, from the exit code; the
+// dialog there kept the process alive with its last picture on screen (the presenter runs on at the
+// monitor's rate, sim 0 Hz), so the app never learned. Beyond Melee's boot check on 10-27 stopped
+// that way. Hidden and headless test runs never show it either.
+constexpr bool crash_dialog_allowed(bool automated, bool yougame_mode) {
+  return !automated && !yougame_mode;
+}
+
+// The last stderr line of a run that stopped (exit code 3), which the app shows the player and puts in
+// reports: "crash: <reason>". One line, the reason up to its first ';' (a guest fault's registers
+// follow it), at most 160 characters, and never a path: a message naming a file could carry the
+// player's user name, so it becomes a plain "fatal error".
+inline std::string crash_line(const char* message) {
+  std::string reason = message ? message : "";
+  reason = reason.substr(0, reason.find_first_of(";\r\n"));
+  while (!reason.empty() && reason.back() == ' ') reason.pop_back();
+  if (reason.empty() || reason.find_first_of("\\/") != std::string::npos) reason = "fatal error";
+  if (reason.size() > 160) reason.resize(160);
+  return "crash: " + reason;
+}
+
+struct ModSources {
+  bool explicit_args;
+  bool saved_profile;
+  bool folders;  // Discovery, saved choices, implicit overlays and auxiliary mod-file loaders.
+  std::size_t ignored_choices;
+};
+
+// Explicit launch layers always survive. Standalone keeps its existing profile precedence and
+// folder scanning/overlay behavior. Count only known choices: YouGame never scans to count packs.
+// Listing profile/discovery precedence is enforced by upstream's vanilla-only, explicit layers
+// and no-mod-autodetect paths; the saved-profile and implicit Mods/Files sites also check this
+// policy in YouGame mode (defense in depth, loader finding #8). The folders gate still protects
+// auxiliary loaders and card mounts, which no-mod-autodetect does not suspend for remix listings.
+constexpr ModSources mod_sources(bool yougame_mode, bool explicit_args = false,
+                                 bool saved_profile = false, std::size_t saved_discovered_choices = 0) {
+  return {explicit_args, !yougame_mode && !explicit_args && saved_profile, !yougame_mode,
+          yougame_mode ? saved_discovered_choices + (saved_profile ? 1 : 0) : 0};
+}
+
+// Ordinary progress saves still mount. A known mod save on a card needs an explicit GCI layer;
+// selecting an ISO or a directory must not silently opt into an old mod save alongside it.
+constexpr bool card_save_allowed(bool yougame_mode, bool mod_save, bool explicit_import = false) {
+  return !mod_save || explicit_import || mod_sources(yougame_mode).folders;
+}
+
+}  // namespace yougame::mode_policy
diff --git a/port/runtime/hle/yougame_net_test.h b/port/runtime/hle/yougame_net_test.h
new file mode 100644
index 0000000..ad4e6e3
--- /dev/null
+++ b/port/runtime/hle/yougame_net_test.h
@@ -0,0 +1,75 @@
+// Hook-only outgoing input stress arm. No ENet, platform or gameplay RNG dependencies.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <utility>
+
+namespace yougame::net_test {
+struct Config {
+  uint32_t delay_ms = 0, jitter_ms = 0;
+  bool enabled() const { return delay_ms != 0; }
+};
+namespace detail { inline std::unique_ptr<const Config> installed; }
+// Startup only, before matchmaking or worker threads. Consumers get an immutable value.
+inline void install(Config config) {
+  if (!detail::installed) detail::installed = std::make_unique<const Config>(config);
+}
+inline const Config& config() {
+  static const Config off;
+  return detail::installed ? *detail::installed : off;
+}
+inline bool mode_allowed(const Config& c, int mode) { return !c.enabled() || mode == 2; }
+inline const char* mode_name(int mode) {
+  switch (mode) {
+    case 0: return "ranked"; case 1: return "unranked"; case 2: return "direct";
+    case 3: return "teams"; case 4: return "party"; default: return "unknown";
+  }
+}
+inline bool input_message(uint8_t id) { return id == 0x80 || id == 0xE1; }
+
+// Owned exclusively by the network thread. Times are monotonic integer milliseconds;
+// timestamps are captured at SendAsync enqueue, not when this queue is drained.
+// Each input gets delay + U[0,jitter], clamped to the preceding input deadline.
+// Control packets bypass pending inputs. A reset also resets the private fixed-seed PRNG.
+template<class T> class DelayQueue {
+ public:
+  explicit DelayQueue(Config config) : config_(config) {}
+  void reset(uint64_t generation) {
+    if (generation_ == generation) return;
+    pending_.clear(); last_due_ = 0; generation_ = generation; state_ = 0x9E3779B97F4A7C15ull;
+  }
+  // True consumes the value (including obsolete inputs); false leaves it untouched.
+  bool push(uint8_t id, uint64_t enqueued_ms, uint64_t generation, T&& value) {
+    if (!config_.enabled() || !input_message(id)) return false;
+    if (generation != generation_) return true;
+    state_ ^= state_ << 13; state_ ^= state_ >> 7; state_ ^= state_ << 17;
+    uint64_t due = enqueued_ms + config_.delay_ms + state_ % (config_.jitter_ms + 1);
+    due = std::max(due, last_due_); last_due_ = due;
+    pending_.push_back({due, std::move(value)});
+    return true;
+  }
+  template<class Send> bool drain(uint64_t now_ms, Send send) {
+    bool sent = false;
+    while (!pending_.empty() && pending_.front().due <= now_ms) {
+      send(pending_.front().value); pending_.pop_front(); sent = true;
+    }
+    return sent;
+  }
+  uint32_t wait_ms(uint64_t now_ms, uint32_t normal) const {
+    if (pending_.empty()) return normal;
+    return static_cast<uint32_t>(std::min<uint64_t>(normal,
+        pending_.front().due > now_ms ? pending_.front().due - now_ms : 0));
+  }
+  size_t size() const { return pending_.size(); }
+ private:
+  struct Held { uint64_t due; T value; };
+  const Config config_;
+  uint64_t last_due_ = 0, generation_ = 0, state_ = 0x9E3779B97F4A7C15ull;
+  std::deque<Held> pending_;
+};
+} // namespace yougame::net_test
+#endif
diff --git a/port/runtime/hle/yougame_pad_mirror.h b/port/runtime/hle/yougame_pad_mirror.h
new file mode 100644
index 0000000..99b1a1e
--- /dev/null
+++ b/port/runtime/hle/yougame_pad_mirror.h
@@ -0,0 +1,32 @@
+// POSIX pad attachment carried by the app's pads push. No JSON/runtime dependency.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <climits>
+#include <cstddef>
+#include <cstdint>
+
+namespace yougame::pad_mirror {
+struct Attachment {
+  int fd = -1;
+  size_t size = 0;
+  bool operator==(const Attachment& other) const { return fd == other.fd && size == other.size; }
+};
+
+// Keep the wire object's location here so the app handoff can change independently.
+template<class Json> bool attachment(const Json& push, Attachment& out) {
+  const auto mirror = push.find("posix");   // {type:"pads", posix:{version:1, fd:N, size:S}} (controller-lead, linux-lead 10-25)
+  if (mirror == push.end() || !mirror->is_object()) return false;
+  const auto number = [&](const char* key, uint64_t max, uint64_t& value) {
+    const auto n = mirror->find(key);
+    if (n == mirror->end() || !n->is_number_integer() ||
+        (!n->is_number_unsigned() && n->template get<int64_t>() < 0)) return false;
+    value = n->template get<uint64_t>();
+    return value <= max;
+  };
+  uint64_t version, fd, size;
+  if (!number("version", 1, version) || version != 1 ||
+      !number("fd", INT_MAX, fd) || !number("size", SIZE_MAX, size)) return false;
+  out = {static_cast<int>(fd), static_cast<size_t>(size)};
+  return true; // The reader checks descriptor kind, bounds and mapped header.
+}
+} // namespace yougame::pad_mirror
diff --git a/port/runtime/hle/yougame_parity.h b/port/runtime/hle/yougame_parity.h
new file mode 100644
index 0000000..157b4ba
--- /dev/null
+++ b/port/runtime/hle/yougame_parity.h
@@ -0,0 +1,164 @@
+// Host-only YouGame presentation and overlay protocol; no platform or game state.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <mutex>
+#include <cstdint>
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include <chrono>
+#include <limits>
+#endif
+
+namespace yougame::parity {
+inline constexpr const char* kMenuHint = "Escape / YouGame menu (D-pad + Start)";
+#if defined(_WIN32) || defined(__linux__)
+inline constexpr const char* kCaps = "yg {\"caps\":[\"ready\",\"overlay\",\"join\",\"notice\",\"pads\",\"rumble\",\"view\",\"volume\"]}";
+#else
+inline constexpr const char* kCaps = "yg {\"caps\":[\"ready\",\"overlay\",\"join\",\"notice\",\"pads\",\"rumble\"]}";
+#endif
+inline constexpr const char* kToplevelCaps = "yg {\"caps\":[\"ready\",\"overlay\",\"join\",\"notice\",\"pads\",\"rumble\",\"view\",\"volume\",\"toplevel\"]}";
+inline constexpr const char* caps(bool toplevel) { return toplevel ? kToplevelCaps : kCaps; }
+inline constexpr const char* kReady = "yg {\"ready\":true}";
+inline constexpr const char* kDown = "yg {\"overlay\":\"down\"}";
+inline constexpr const char* kUp = "yg {\"overlay\":\"up\"}";
+inline constexpr const char* kCancel = "yg {\"overlay\":\"cancel\"}";
+
+class Signals {
+ public:
+  using Writer = void (*)(const char*);
+  // Startup only. Publish the writer after caps, so ready can never overtake caps.
+  void start(bool stdio, Writer writer, bool toplevel = false) {
+    if (!stdio || !writer) return;
+    std::call_once(caps_, [&] { writer(caps(toplevel)); writer_.store(writer); });
+  }
+  void emit(const char* line) const {
+    if (line) if (auto writer = writer_.load()) writer(line);
+  }
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  using Clock = std::chrono::steady_clock;
+  bool first_present(Clock::time_point& at) const {
+    const auto ticks = first_present_.load();
+    if (ticks == kNotPresented) return false;
+    at = Clock::time_point(Clock::duration(ticks));
+    return true;
+  }
+#endif
+  // Called after a successful swap of a visible game frame, never a loading panel.
+  void presented(bool eligible
+#ifdef YOUGAME_AGENT_TEST_HOOK
+                 , Clock::time_point now = Clock::now()
+#endif
+                 ) {
+    auto writer = writer_.load();
+    if (eligible && writer && !ready_.exchange(true)) {
+      writer(kReady);
+#ifdef YOUGAME_AGENT_TEST_HOOK
+      first_present_.store(now.time_since_epoch().count());
+#endif
+    }
+  }
+ private:
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  static constexpr auto kNotPresented = std::numeric_limits<Clock::duration::rep>::min();
+  std::atomic<Clock::duration::rep> first_present_{kNotPresented};
+#endif
+  std::once_flag caps_;
+  std::atomic<Writer> writer_{nullptr};
+  std::atomic<bool> ready_{false};
+};
+
+// The window thread owns this state. Keep swallowing a cancelled press until release:
+// a repeat after focus returns must not open the game's practice menu.
+class OverlayKey {
+ public:
+  struct Result { bool swallowed; const char* line; };
+  Result tab(bool stdio, bool down, bool shift, bool repeat) {
+    if (!stdio) return {false, nullptr};
+    if (down) {
+      if (!repeat) {
+        reserved_ = shift;
+        if (shift && !down_) { down_ = true; return {true, kDown}; }
+      }
+      return {reserved_, nullptr};
+    }
+#ifdef YOUGAME_AGENT_TEST_HOOK
+    // A real Tab release cannot release a scripted tap early. Real presses during
+    // the tap coalesce with it; their eventual release is still swallowed.
+    if (scripted_) {
+      const bool swallowed = reserved_;
+      reserved_ = false;
+      return {swallowed, nullptr};
+    }
+#endif
+    const Result result{reserved_, down_ ? kUp : nullptr};
+    down_ = reserved_ = false;
+    return result;
+  }
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  const char* script_down() {
+    if (reserved_ || down_) return nullptr;  // Includes a cancelled real hold.
+    const auto event = tab(true, true, true, false);
+    scripted_ = true;
+    reserved_ = false;  // Only a real Tab press owns the real release.
+    return event.line;
+  }
+  const char* script_up() {
+    if (!scripted_) return nullptr;  // Focus loss already cancelled this tap.
+    scripted_ = false;
+    const bool was_down = down_;
+    down_ = false;
+    return was_down ? kUp : nullptr;
+  }
+#endif
+  const char* cancel() {
+#ifdef YOUGAME_AGENT_TEST_HOOK
+    scripted_ = false;
+#endif
+    const bool was_down = down_;
+    down_ = false;
+    return was_down ? kCancel : nullptr;
+  }
+ private:
+  bool down_ = false, reserved_ = false;
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  bool scripted_ = false;
+#endif
+};
+
+// Simulation-thread controller shortcut. Use the same down/up protocol as Shift+Tab,
+// with a fixed tap duration independent of how long Start remains physically held.
+class OverlayPad {
+ public:
+  const char* tick(uint64_t now_ms) {
+    if (!tapping_ || now_ms < release_at_) return nullptr;
+    tapping_ = false;
+    return key_.tab(true, false, false, false).line;
+  }
+  const char* poll(bool stdio, int port, bool connected, uint16_t& buttons,
+                   uint64_t now_ms, bool legacy_settings = false) {
+    constexpr uint16_t start = 0x1000, down = 0x0004, z = 0x0010;
+    const bool held = connected && (buttons & start);
+    const bool pressed = held && !was_start_[port];
+    was_start_[port] = held;
+    if (!stdio) return nullptr;
+    if (!held) claimed_[port] = false;
+    const bool chord = pressed && (buttons & down) && !(buttons & z) && !legacy_settings;
+    if (chord) claimed_[port] = true;
+    // Keep Start suppressed until its release, including when Down is released first.
+    if (claimed_[port]) buttons &= static_cast<uint16_t>(~start);
+    if (!chord || tapping_) return nullptr;
+    tapping_ = true;
+    release_at_ = now_ms + 100;
+    return key_.tab(true, true, true, false).line;
+  }
+ private:
+  OverlayKey key_;
+  bool was_start_[4]{}, claimed_[4]{};
+  bool tapping_ = false;
+  uint64_t release_at_ = 0;
+};
+
+// Header-only so renderer-only tools need no bridge/network dependency. In standalone
+// builds the writer stays null. The stdio link installs its existing serialized writer.
+inline Signals signals;
+}  // namespace yougame::parity
