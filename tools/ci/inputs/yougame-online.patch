+  f.b.at(6,[&]{CHECK(f.r.pending_begin && f.r.begin_at==2005);f.tick();});f.stop_at(7);f.run();
+  CHECK(std::all_of(f.b.waits.begin(),f.b.waits.end(),[](int ms){return ms==250;}));
