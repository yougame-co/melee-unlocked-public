+// Staging-only matchmaking policy for scripts supplied through agent-test.json.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include "yougame_agent_input.h"
+namespace yougame::agent_test {
+inline bool agent_script = false;  // Set once on main, before the matchmaking worker starts.
+
+inline constexpr bool matchmaking_allowed(bool local_peer, bool server_allowed,
+                                           bool agent_script, bool yougame_active, int mode) {
+  // An agent script can never reach local peering or Slippi, even with explicit CLI overrides.
+  return agent_script ? !ranked_mode(mode) && yougame_active && !local_peer
+                      : local_peer || server_allowed;
+}
+}  // namespace yougame::agent_test
+#endif
diff --git a/port/runtime/hle/yougame_agent_static.h b/port/runtime/hle/yougame_agent_static.h
new file mode 100644
index 0000000..f0c3c7f
--- /dev/null
+++ b/port/runtime/hle/yougame_agent_static.h
@@ -0,0 +1,98 @@
+// Static Recomp's staging harness: pure snapshot adapter and online event counting.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include "yougame_agent_fight.h"
+#include "online_test_quit.h"
+#include <atomic>
+#include <optional>
+
+namespace yougame::agent_test {
+// digest_state's MuStatePod carries vanilla NTSC 1.02 Player/Fighter fields. m-ex keeps these
+// for vanilla fighters; an added fighter or a relocated player table may need another reader.
+// Scene ids differ from Source's Debug VS harness, so the EXI start/end interval gates Static.
+inline std::optional<FightState> static_fight_state(const FightContext& c, const MuStatePod& digest,
+                                                   const MuLcancelView& air) {
+  if (!c.enabled || !c.yougame || !c.online_test || !c.in_match || c.replay ||
+      c.local_slot < 0 || c.local_slot >= 4 || c.local_port < 0 || c.local_port >= 4 ||
+      !digest.match_frame) return std::nullopt;
+  const auto& self = digest.player[c.local_slot];
+  if (!self.present || !self.stocks) return std::nullopt;
+  const MuFighterState* opponent = nullptr;
+  for (int slot = 0; slot < 4; ++slot) {
+    if (slot == c.local_slot || !digest.player[slot].present || !digest.player[slot].stocks) continue;
+    if (opponent) return std::nullopt;  // Duel only.
+    opponent = &digest.player[slot];
+  }
+  const auto& fighter = air.port[c.local_port];
+  if (!opponent || !fighter.present || fighter.slot != c.local_slot) return std::nullopt;
+  FightState s{digest.match_frame, fight_float(self.pos_x), fight_float(self.pos_y), fight_float(self.facing),
+               fighter.ground_or_air != 0, self.action, fight_float(self.percent),
+               fight_float(opponent->pos_x), fight_float(opponent->pos_y), fight_float(opponent->percent),
+               c.stage_edge};
+  if (!std::isfinite(s.self_x) || !std::isfinite(s.self_y) || !std::isfinite(s.facing) ||
+      !std::isfinite(s.self_percent) || !std::isfinite(s.opponent_x) || !std::isfinite(s.opponent_y) ||
+      !std::isfinite(s.opponent_percent) || !std::isfinite(s.stage_edge) || s.stage_edge <= 0)
+    return std::nullopt;
+  return s;
+}
+
+enum class StaticEvent { GameStart, GameEnd, Report, Cancel };
+
+class StaticMatch {
+ public:
+  StaticMatch() = default;
+  StaticMatch(bool armed, const char* after) : armed_(armed), quit_(0, armed ? after : nullptr) {}
+
+  template<class Leave>
+  void event(StaticEvent e, bool eligible, Leave leave) {
+    if (!armed_ || !eligible || e == StaticEvent::Cancel) {
+      in_match_ = ended_ = false;
+      return;
+    }
+    if (quit_.triggered()) return;
+    switch (e) {
+      case StaticEvent::GameStart:
+        if (!in_match_) { in_match_ = true; ended_ = false; }
+        break;
+      case StaticEvent::GameEnd:
+        if (in_match_) { in_match_ = false; ended_ = true; }
+        break;
+      case StaticEvent::Report:
+        if (!ended_) break;
+        ended_ = false;
+        ++finished_;
+        quit_.poll(finished_, leave);  // Count once, after Static publishes the game's result.
+        break;
+      case StaticEvent::Cancel: break;
+    }
+  }
+  bool in_match() const { return in_match_; }
+  bool armed() const { return armed_; }
+  int finished() const { return finished_; }
+  bool quitting() const { return quit_.triggered(); }
+
+ private:
+  bool armed_ = false, in_match_ = false, ended_ = false;
+  int finished_ = 0;
+  yougame::online_test::QuitAfter quit_;
+};
+
+// Armed on main before the simulation starts; events and samples stay on its thread.
+inline StaticMatch static_match;
+// close_room can also run on matchmaking's worker; never read simulation-owned counters there.
+inline std::atomic<bool> static_quit_requested{false};
+
+// The room pump owns result delivery. Keep it alive until its queue settles, with the same
+// 30-second ceiling as the Ranked harness; the retiring worker exits after closing the room.
+template<class Pending, class Clock, class Pause>
+inline bool drain_static_results(Pending pending, Clock clock, Pause pause) {
+  const uint64_t start = clock();
+  while (pending()) {
+    if (clock() - start >= 30000) return false;
+    pause(50);
+  }
+  return true;
+}
+}  // namespace yougame::agent_test
+#endif
diff --git a/port/runtime/hle/yougame_agent_test.h b/port/runtime/hle/yougame_agent_test.h
new file mode 100644
index 0000000..f7dfdd3
--- /dev/null
+++ b/port/runtime/hle/yougame_agent_test.h
@@ -0,0 +1,525 @@
+// Test-only startup defaults for app-launched native games. Read agent-test.json once, only
+// with an active YouGame bridge and nonempty YOUGAME_DATA. Missing files are silent. Optional
+// keys: mute:true, online:"unranked"|"ranked"|"direct"|"teams", character:0..25 (with online),
+// code:1..12 ASCII [A-Z0-9#], timer:5..600 seconds, quitAfter:1..3, padBack:10..900 seconds, fight:true. Invalid/unknown keys
+// are ignored together in one log line. Prepend defaults so the existing CLI parser handles
+// modes, character defaults and volume, and later explicit flags win. No file watching.
+// Hook builds also accept script (a bounded file in the data dir; Source permits subdirectories),
+// rng_seed:uint32 and time_base:uint64 (0 keeps the CLI's wall-clock default).
+// Source-only hook key: match:"<stage>:<kind>[/c<level>][/x<costume>][:...]" (1..6 players,
+// at most 128 ASCII [a-z0-9_:/] characters, numeric IDs; refused whenever online is present).
+// Both engines: frames:600..36000, stopAt:60..36000 (host::die at that frame: exit 3 and a last stderr
+// line "crash: agent test: stop at frame N", for the app's "stopped" notice). Static-only:
+// captureEvery:30..600 (agent-captures/cap.ppm).
+// Source-only hook keys: frame_times, sim_times, replay_dir, record_native, slippi_menus,
+// no_gc_adapter, early_rng_seed; netDelayMs:0..250, netJitterMs:0..100 (positive delay, Direct only).
+// padTrace:"<relative file>" appends changed game-poll pad states (both engines).
+// Output paths stay inside the data directory.
+// keys:"overlay@20,escape@30" emits stdio protocol taps after the first presented frame.
+// Hook-only, both online engines: dropRoomAfter:330..900 seconds (agent-only rooms, never ranked).
+// Source renderer hook: present_log:"<name>", present_frames:"<directory-name>:<1..600>".
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <nlohmann/json.hpp>
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include "yougame_agent_paths.h"
+#include "yougame_agent_pad_trace.h"
+#include "yougame_agent_keys.h"
+#include "yougame_agent_present.h"
+#include "yougame_box_present.h"
+#include "yougame_net_test.h"
+#endif
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cerrno>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace yougame::agent_test {
+enum class Engine { Source, Static };
+
+struct Settings {
+  std::vector<std::string> arguments;
+  std::vector<std::pair<std::string, std::string>> environment;
+  std::string log;
+  std::string unsupported_online;
+  bool static_online_test = false;
+  int pad_back_seconds = 0;
+  bool fight = false;
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  std::vector<ScriptedKey> key_script;
+  std::string pad_trace;
+  bool agent_script = false;
+  bool rumble_test = false;
+  bool box_present_compositor = false;
+  net_test::Config net;
+  agent_present::Config present;
+  int stop_at_frame = 0;
+#endif
+
+  std::vector<std::string> prepend(int argc, char* const* argv) const {
+    std::vector<std::string> result;
+    result.emplace_back(argv[0]);
+    result.insert(result.end(), arguments.begin(), arguments.end());
+    for (int i = 1; i < argc; ++i) result.emplace_back(argv[i]);
+    return result;
+  }
+};
+
+inline bool integer_in(const nlohmann::json& value, int minimum, int maximum) {
+  if (value.is_number_unsigned()) {
+    const auto n = value.get<uint64_t>();
+    return n >= static_cast<uint64_t>(minimum) && n <= static_cast<uint64_t>(maximum);
+  }
+  if (!value.is_number_integer()) return false;
+  const auto n = value.get<int64_t>();
+  return n >= minimum && n <= maximum;
+}
+
+#ifdef YOUGAME_AGENT_TEST_HOOK
+inline bool script_name_valid(const std::string& name) {
+  return !name.empty() && name.size() <= 64 && name.find("..") == std::string::npos &&
+      name.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-") == std::string::npos;
+}
+
+inline bool source_script_path_valid(const std::string& name) {
+  return agent_paths::relative_valid(name);
+}
+
+inline bool source_match_valid(const std::string& text) {
+  if (text.empty() || text.size() > 128 ||
+      text.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789_:/") != std::string::npos) return false;
+  // Dry parse source_port::set_match's base-0 numbers, six player slots and options in
+  // either order. Calling set_match itself would change the process's match override.
+  const char* next = text.c_str();
+  auto number = [&]() {
+    char* end = nullptr;
+    errno = 0;
+    const auto value = std::strtol(next, &end, 0);
+    if (end == next || errno == ERANGE || value < 0 || value > INT32_MAX) return false;
+    next = end;
+    return true;
+  };
+  if (!number()) return false;
+  size_t players = 0;
+  while (*next == ':') {
+    ++next;
+    if (++players > 6 || !number()) return false;
+    while (*next == '/') {
+      if (next[1] != 'c' && next[1] != 'x') return false;
+      next += 2;
+      if (!number()) return false;
+    }
+  }
+  return *next == '\0' && players != 0;
+}
+
+inline bool early_rng_seed_valid(const std::string& text) {
+  // Match both engines' base-0 strtoul grammar, but reject truncation, signs and overflow.
+  const char* next = text.c_str();
+  for (int field = 0; field < 2; ++field) {
+    if (*next < '0' || *next > '9') return false;
+    char* end = nullptr;
+    errno = 0;
+    const auto number = std::strtoull(next, &end, 0);
+    if (errno == ERANGE || number > UINT32_MAX || (field == 1 && number == 0)) return false;
+    if (field == 0) { if (*end != '@') return false; next = end + 1; }
+    else if (end != text.c_str() + text.size()) return false;
+  }
+  return true;
+}
+
+inline bool source_output_path(const std::string& name, const std::filesystem::path& data_dir,
+                               bool directory, std::filesystem::path& path,
+                               const agent_paths::Root& capability) {
+  (void)data_dir;
+  const auto& root = capability.path;
+  if (!source_script_path_valid(name) || root.empty()) return false;
+  auto normalized = name;
+  std::replace(normalized.begin(), normalized.end(), '\\', '/');
+  const auto relative = std::filesystem::u8path(normalized);
+  if (relative.filename().empty() || relative.filename() == ".") return false;
+  std::error_code ec;
+  const auto base = std::filesystem::symlink_status(root, ec);
+  if (ec || !std::filesystem::is_directory(base)) return false;
+  path = root;
+  for (const auto& component : relative) {
+    path /= component;
+    const auto status = std::filesystem::symlink_status(path, ec);
+    if (ec && ec != std::errc::no_such_file_or_directory) return false;
+    ec.clear();
+    if (std::filesystem::is_symlink(status)) return false;
+    if (std::filesystem::exists(status) &&
+        !(path == root / relative && !directory ? std::filesystem::is_regular_file(status) :
+                                                    std::filesystem::is_directory(status))) return false;
+  }
+  if (directory) return agent_paths::directory(root, normalized, true, capability);
+  else if (!std::filesystem::is_directory(path.parent_path(), ec)) return false;
+  return !ec;
+}
+
+inline bool unsigned_in(const nlohmann::json& value, uint64_t maximum) {
+  if (value.is_number_unsigned()) return value.get<uint64_t>() <= maximum;
+  return value.is_number_integer() && value.get<int64_t>() >= 0 &&
+      static_cast<uint64_t>(value.get<int64_t>()) <= maximum;
+}
+#endif
+
+inline Settings map_keys(const nlohmann::json& object, Engine engine = Engine::Source,
+                         const std::filesystem::path& data_dir = {}, bool receive_injector_set = false
+#ifdef YOUGAME_AGENT_TEST_HOOK
+                         , const agent_paths::Root* capability = nullptr
+#endif
+                         ) {
+  Settings out;
+  std::string keys, online;
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  // Direct mapping has no load/session prerequisite. Keep its root local; load()
+  // instead supplies the capability retained before agent-test.json was read.
+  agent_paths::Root mapping_root;
+  if (!capability) {
+    if (!data_dir.empty()) mapping_root.load(data_dir);
+    capability = &mapping_root;
+  }
+  std::string diagnostics;
+  auto diagnostic = [&](const std::string& text) {
+    diagnostics += "\nagent test: " + text + "; ignored";
+  };
+#else
+  (void)data_dir;
+  (void)receive_injector_set;
+#endif
+  int character = -1;
+  bool ignored = false;
+  auto applied = [&](const char* key) {
+    if (!keys.empty()) keys += ", ";
+    keys += key;
+  };
+  for (auto it = object.begin(); it != object.end(); ++it) {
+    const auto& key = it.key();
+    const auto& value = it.value();
+#ifdef YOUGAME_AGENT_TEST_HOOK
+    if (key == "padTrace") {
+      std::filesystem::path path;
+      if (!value.is_string() || !source_output_path(value.get<std::string>(), data_dir, false, path, *capability))
+        diagnostics += "\nagent-test: padTrace invalid output path; ignored";
+      else { out.pad_trace = agent_paths::slashes(value.get<std::string>()); applied("padTrace"); }
+      continue;
+    }
+    if (key == "rumbleTest" && value.is_boolean()) {
+      out.rumble_test = value.get<bool>(); applied("rumbleTest"); continue;
+    }
+    if (key == "boxPresent" && value == "compositor") {
+      out.box_present_compositor = true; applied("boxPresent"); continue;
+    }
+    if (key == "boxPresent" && value == "vsync") { applied("boxPresent"); continue; }   // the default since 0b002a
+    if (key == "present_log" || key == "present_frames") {
+      auto invalid = [&](const char* reason) { diagnostics += "\nagent-test: " + key + " " + reason + "; ignored"; };
+      std::string name;
+      unsigned every = 0;
+      const bool frames = key == "present_frames";
+      if (engine != Engine::Source) invalid("not supported on the Static Recomp");
+      else if (!value.is_string() ||
+          !(frames ? agent_present::frame_spec(value.get<std::string>(), name, every) :
+                     agent_present::plain_name(name = value.get<std::string>()))) invalid("invalid name or interval");
+      else {
+        std::filesystem::path path;
+        if (!source_output_path(name, data_dir, frames, path, *capability)) invalid("invalid output path");
+        else {
+          if (frames) { out.present.directory = name; out.present.every = every; }
+          else out.present.log = name;
+          applied(key.c_str());
+        }
+      }
+      continue;
+    }
+    if (key == "netDelayMs" || key == "netJitterMs") {
+      const bool delay = key == "netDelayMs";
+      auto invalid = [&](const char* reason) { diagnostics += "\nagent-test: " + key + " " + reason + "; ignored"; };
+      if (engine != Engine::Source) invalid("not supported on the Static Recomp");
+      else if (!integer_in(value, 0, delay ? 250 : 100)) invalid("invalid value");
+      else if (receive_injector_set) {
+        // One refusal for the pair, even if both keys are present.
+        if (diagnostics.find("receive-side injector") == std::string::npos)
+          diagnostics += "\nagent-test: net delay keys conflict with receive-side injector; ignored";
+      } else if (!delay && out.net.delay_ms == 0) {
+        invalid("requires netDelayMs > 0");
+      } else {
+        if (delay) out.net.delay_ms = value.get<int>();
+        else out.net.jitter_ms = value.get<int>();
+        applied(key.c_str());
+      }
+      continue;
+    }
+    if (key == "frame_times" || key == "sim_times" || key == "replay_dir" ||
+        key == "record_native" || key == "slippi_menus" || key == "no_gc_adapter" || key == "early_rng_seed") {
+      auto invalid = [&](const char* reason) { diagnostics += "\nagent-test: " + key + " " + reason + "; ignored"; };
+      if (engine != Engine::Source) invalid("not supported on the Static Recomp");
+      else if (key == "frame_times" || key == "sim_times" || key == "replay_dir") {
+        std::filesystem::path path;
+        if (!value.is_string() || !source_output_path(value.get<std::string>(), data_dir, key == "replay_dir", path, *capability))
+          invalid("invalid output path");
+        else {
+          if (key == "sim_times") out.environment.emplace_back("MELEE_SIM_TIMES", path.u8string());
+          else out.arguments.insert(out.arguments.end(), {key == "frame_times" ? "--frame-times" : "--replay-dir", path.u8string()});
+          applied(key.c_str());
+        }
+      } else if (key == "early_rng_seed") {
+        if (!value.is_string() || !early_rng_seed_valid(value.get<std::string>())) invalid("invalid value");
+        else { out.environment.emplace_back("MELEE_TEST_EARLY_RNG_SEED", value.get<std::string>()); applied(key.c_str()); }
+      } else if (!value.is_boolean()) invalid("invalid value");
+      else if (key == "slippi_menus") {
+        out.arguments.insert(out.arguments.end(), {"--slippi-menus", value.get<bool>() ? "on" : "off"});
+        applied(key.c_str());
+      } else if (value.get<bool>()) {
+        if (key == "record_native") out.arguments.emplace_back("--record-native");
+        else out.environment.emplace_back("MELEE_NO_GC_ADAPTER", "1");
+        applied(key.c_str());
+      }
+      continue;
+    }
+    if (key == "keys") {
+      std::string why;
+      if (!value.is_string()) why = "expected a string";
+      else out.key_script = parse_key_script(value.get<std::string>(), why);
+      if (!why.empty()) diagnostics += "\nagent-test: keys ignored: " + why;
+      else applied("keys");
+      continue;
+    }
+    if (key == "dropRoomAfter") {
+      if (!integer_in(value, 330, 900)) ignored = true;
+      else {
+        out.environment.emplace_back("MELEE_ONLINE_TEST_DROP_ROOM_AFTER", std::to_string(value.get<int>()));
+        applied("dropRoomAfter");
+      }
+      continue;
+    }
+    if (key == "rng_seed" || key == "time_base") {
+      const bool seed = key == "rng_seed";
+      if (!unsigned_in(value, seed ? UINT32_MAX : UINT64_MAX)) {
+        diagnostics += "\nagent-test: " + key + " invalid value; ignored";
+      } else {
+        out.arguments.insert(out.arguments.end(), {seed ? "--rng-seed" : "--time-base",
+                                                   std::to_string(value.get<uint64_t>())});
+        applied(seed ? "rng_seed" : "time_base");
+      }
+      continue;
+    }
+    if (key == "match") {
+      auto invalid = [&](const char* reason) { diagnostics += std::string("\nagent-test: match ") + reason + "; ignored"; };
+      if (engine != Engine::Source) invalid("not supported on the Static Recomp");
+      else if (object.count("online")) invalid("conflicts with online (offline only)");
+      else if (!value.is_string() || !source_match_valid(value.get<std::string>())) invalid("invalid value");
+      else {
+        out.arguments.insert(out.arguments.end(), {"--match", value.get<std::string>()});
+        applied("match");
+      }
+      continue;
+    }
+    if (key == "script") {
+      auto script_diagnostic = [&](const char* text) {
+        diagnostics += std::string("\nagent-test: script ") + text + "; ignored";
+      };
+      if (!value.is_string() || !(engine == Engine::Static ? script_name_valid(value.get<std::string>()) :
+                                                           source_script_path_valid(value.get<std::string>()))) {
+        script_diagnostic("invalid name");
+      } else if (data_dir.empty()) {
+        script_diagnostic("missing data directory");
+      } else {
+        auto name = value.get<std::string>();
+        std::replace(name.begin(), name.end(), '\\', '/');
+        const auto& root = capability->path;
+        const auto path = root / std::filesystem::u8path(name);
+        std::string snapshot;
+        if (!agent_paths::read(root, name, agent_paths::script_limit, snapshot, *capability)) {
+          script_diagnostic(errno == EFBIG ? "exceeds 64 KiB" : "missing or not a regular file");
+        } else {
+          out.arguments.insert(out.arguments.end(), {"--script", path.u8string()});
+          out.agent_script = true;
+          applied("script");
+        }
+      }
+      continue;
+    }
+    if (key == "stopAt") {
+      if (!integer_in(value, 60, 36000)) diagnostic("stopAt invalid value");
+      else { out.stop_at_frame = value.get<int>(); applied("stopAt"); }
+      continue;
+    }
+    if (key == "captureEvery" || key == "frames") {
+      const bool capture = key == "captureEvery";
+#if defined(MELEE_LINUX) && !defined(__APPLE__)
+      if (capture && engine == Engine::Source) {
+        diagnostics += "\nagent-test: captureEvery not supported on Linux; ignored";
+        continue;
+      }
+#endif
+      if ((capture && engine != Engine::Static) || !integer_in(value, capture ? 30 : 600, capture ? 600 : 36000)) {
+        if (!capture && engine == Engine::Source) diagnostics += "\nagent-test: frames invalid value; ignored";
+        else diagnostic(key + (engine != Engine::Static ? " not supported on the Source Port" : " invalid value"));
+      } else if (capture) {
+        std::filesystem::path directory;
+        if (!source_output_path("agent-captures", data_dir, true, directory, *capability)) diagnostic("captureEvery cannot create directory");
+        else {
+          out.arguments.insert(out.arguments.end(), {"--capture", (directory / "cap.ppm").u8string(),
+                                                     "--capture-every", std::to_string(value.get<int>())});
+          applied("captureEvery");
+        }
+      } else {
+        out.arguments.insert(out.arguments.end(), {"--frames", std::to_string(value.get<int>())});
+        applied("frames");
+      }
+      continue;
+    }
+#endif
+    if (key == "mute" && value.is_boolean() && value.get<bool>()) {
+      out.arguments.insert(out.arguments.end(), {"--volume", "0"});
+      applied("mute");
+    } else if (key == "online" && value.is_string() &&
+               (engine == Engine::Static || value == "unranked" || value == "ranked" || value == "direct" || value == "teams")) {
+      online = value.get<std::string>();
+    } else if (key == "character" && integer_in(value, 0, 25)) {
+      character = value.get<int>();
+    } else if (key == "code" && value.is_string() && engine == Engine::Source) {
+      const auto code = value.get<std::string>();
+      if (code.empty() || code.size() > 12 || code.find_first_not_of("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#") != std::string::npos) {
+        ignored = true;
+        continue;
+      }
+      out.environment.emplace_back("MELEE_ONLINE_TEST_CODE", code);
+      applied("code");
+    } else if (key == "fight" && value.is_boolean()) {
+      out.fight = value.get<bool>();
+      if (out.fight) applied("fight");
+    } else if (key == "padBack" && integer_in(value, 10, 900)) {
+      out.pad_back_seconds = value.get<int>();
+      applied("padBack");
+    } else if ((key == "timer" && integer_in(value, 5, 600)) ||
+               (key == "quitAfter" && integer_in(value, 1, 3))) {
+      out.environment.emplace_back(key == "timer" ? "MELEE_ONLINE_TEST_TIMER" : "MELEE_ONLINE_TEST_QUIT_AFTER",
+                                   std::to_string(value.get<int>()));
+      applied(key == "timer" ? "timer" : "quitAfter");
+    } else {
+      ignored = true;
+    }
+  }
+  if (engine == Engine::Static) {
+    if (online == "unranked" || online == "teams") {
+      out.environment.emplace_back("MELEE_PRACTICE_AUTOSTART", online);
+      out.static_online_test = true;
+      applied("online");
+    } else if (object.count("online") && object["online"].is_string()) {
+      out.unsupported_online = "agent test: online " + online + " not supported on the Static Recomp";
+    }
+    if (character >= 0) ignored = true;
+  } else if (!online.empty()) {
+    applied("online");
+    if (character >= 0) {
+      online += ":" + std::to_string(character);
+      applied("character");
+    }
+    out.arguments.insert(out.arguments.end(), {"--online-test", online});
+  } else if (character >= 0) {
+    ignored = true;  // A character alone does not opt into a match or modify an explicit CLI spec.
+  }
+  if (!keys.empty()) out.log = "agent-test.json applied default keys: " + keys;
+  if (ignored) {
+    if (out.log.empty()) out.log = "agent-test.json";
+    out.log += "; invalid/unknown or inapplicable keys ignored";
+  }
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  if (!diagnostics.empty()) out.log += diagnostics.substr(out.log.empty() ? 1 : 0);
+#endif
+  return out;
+}
+inline Settings load(bool active, const char* data_dir, Engine engine = Engine::Source) {
+  Settings out;
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  pad_trace.stop();
+  agent_present::recorder().stop();
+  agent_paths::policy = {};
+  agent_paths::session.reset();
+  // All early returns and exceptions release the root unless mapping activated a session.
+  struct LoadScope {
+    bool active = false;
+    ~LoadScope() { if (!active) { agent_paths::policy = {}; agent_paths::session.reset(); } }
+  } scope;
+#endif
+  if (!active || !data_dir || !*data_dir) return out;
+  // Bound the actual read BEFORE parsing; the same handle is checked and read.
+  std::array<char, 4097> bytes{};
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  if (!agent_paths::session.load(std::filesystem::u8path(data_dir))) return out;
+  const auto& root = agent_paths::session.path;
+  FILE* file = agent_paths::open(root, "agent-test.json", agent_paths::Mode::Read);
+  if (!file) return out;
+  const auto size = std::fread(bytes.data(), 1, bytes.size(), file);
+  const bool failed = std::ferror(file) != 0;
+  std::fclose(file);
+#else
+  std::ifstream file(std::filesystem::u8path(data_dir) / "agent-test.json", std::ios::binary);
+  if (!file) return out;
+  file.read(bytes.data(), bytes.size());
+  const auto size = file.gcount();
+  const bool failed = file.bad();
+#endif
+  if (size > 4096) {
+    out.log = "agent-test.json ignored: exceeds 4 KiB";
+    return out;
+  }
+  if (failed) {
+    out.log = "agent-test.json ignored: read failed";
+    return out;
+  }
+  // The JSON lexer treats a raw NUL as EOF; reject it rather than accepting a truncated file.
+  if (std::find(bytes.data(), bytes.data() + size, '\0') != bytes.data() + size) {
+    out.log = "agent-test.json ignored: invalid JSON object";
+    return out;
+  }
+  const auto object = nlohmann::json::parse(bytes.data(), bytes.data() + size, nullptr, false);
+  if (object.is_discarded() || !object.is_object()) {
+    out.log = "agent-test.json ignored: invalid JSON object";
+    return out;
+  }
+  out = map_keys(object, engine, std::filesystem::u8path(data_dir),
+      std::getenv("MELEE_NET_LAG_MS") != nullptr || std::getenv("MELEE_NET_JITTER_MS") != nullptr
+#ifdef YOUGAME_AGENT_TEST_HOOK
+      , &agent_paths::session
+#endif
+      );
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  const bool active_session = !out.arguments.empty() || !out.environment.empty() || !out.key_script.empty() ||
+      !out.pad_trace.empty() || out.rumble_test || out.box_present_compositor || out.static_online_test || out.pad_back_seconds > 0 || out.fight || out.net.delay_ms > 0 || out.present.enabled();
+  if (!active_session) return out;
+  // Consumers must reopen through the capability, not through a checked pathname.
+  agent_paths::policy = {};
+  agent_paths::policy.root = root;
+  for (size_t i = 0; i < out.arguments.size(); ++i) {
+    const auto& arg = out.arguments[i];
+    if (i + 1 == out.arguments.size()) continue;
+    if (arg == "--replay-dir") agent_paths::policy.replay_directory = out.arguments[i + 1];
+    if (arg == "--script") agent_paths::policy.script = out.arguments[i + 1];
+    if (arg == "--frame-times") agent_paths::policy.frame_times = out.arguments[i + 1];
+    if (arg == "--capture") agent_paths::policy.capture_directory =
+        std::filesystem::u8path(out.arguments[i + 1]).parent_path().u8string();
+  }
+  for (const auto& item : out.environment)
+    if (item.first == "MELEE_SIM_TIMES") agent_paths::policy.sim_times = item.second;
+  if (!agent_present::recorder().arm(out.present, agent_paths::session)) {
+    if (!out.log.empty()) out.log += '\n';
+    out.log += "agent-test: present output capability refused; ignored";
+  }
+  if (!pad_trace.arm(out.pad_trace, agent_paths::session)) {
+    if (!out.log.empty()) out.log += '\n';
+    out.log += "agent-test: padTrace output capability refused; ignored";
+  }
+  scope.active = true;
+#endif
+  return out;
+}
+}  // namespace yougame::agent_test
diff --git a/port/runtime/hle/yougame_box_present.h b/port/runtime/hle/yougame_box_present.h
new file mode 100644
index 0000000..b192628
--- /dev/null
+++ b/port/runtime/hle/yougame_box_present.h
@@ -0,0 +1,36 @@
+// DXGI present policy, independent of Windows headers for host-only tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+namespace yougame::box_present {
+inline constexpr unsigned allow_tearing = 0x200;
+struct Choice { unsigned interval, flags; bool compositor = false, agent = false; };
+inline Choice choose(bool embedded, bool vsync, bool fullscreen, bool agent_override,
+                     bool flip = true, bool paced = true, bool tearing = true, bool vrr_sync = false,
+                     bool toplevel = false) {
+  // In-box V-Sync presents at interval 1. The interval-0 compositor path measured worse on pc2 (perf-lead
+  // 10-30, 144 Hz: p50 126 vs 135 fps, ~50% more repeated frames, same latency), so it is an agent-test
+  // experiment only (agent-test.json "boxPresent":"compositor").
+  if (embedded && !toplevel && vsync && !fullscreen && flip && paced && agent_override) return {0, 0, true, true};
+  const bool synced = vsync || vrr_sync;
+  return {synced ? 1u : 0u, !synced && tearing ? allow_tearing : 0u};
+}
+#ifdef YOUGAME_AGENT_TEST_HOOK
+inline std::atomic<bool> agent_compositor{false};
+#endif
+inline bool agent_override() {
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  return agent_compositor.load(std::memory_order_relaxed);
+#else
+  return false;
+#endif
+}
+inline const char* message(Choice choice) {
+  return choice.compositor ? "present: embedded v-sync via compositor (interval 0, agent test)" : nullptr;
+}
+inline const char* announcement(Choice choice) {
+  static std::atomic<bool> said{false};
+  const auto line = message(choice);
+  return line && !said.exchange(true) ? line : nullptr;
+}
+} // namespace yougame::box_present
diff --git a/port/runtime/hle/yougame_compatibility.h b/port/runtime/hle/yougame_compatibility.h
new file mode 100644
index 0000000..c71ccaf
--- /dev/null
+++ b/port/runtime/hle/yougame_compatibility.h
@@ -0,0 +1,27 @@
+// Pure room compatibility key policy shared by matchmaking and host-only tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "native_online_policy.h"
+#include <cctype>
+#include <string>
+
+namespace yougame {
+inline std::string compatibility_key(const std::string& version, bool mod_view,
+                                     const std::string& fingerprint, bool static_engine = false,
+                                     const std::string& rules_digest = {}) {
+  if (mod_view && !slippi::online::native_mod_fingerprint_valid(fingerprint)) return {};
+  if (!rules_digest.empty() && !slippi::online::native_mod_fingerprint_valid(rules_digest)) return {};
+  std::string key = "mu-" + version;
+  for (char& c : key) if (!std::isalnum((unsigned char)c) && c != '.' && c != '-') c = '-';
+  std::string suffix = static_engine ? "-st" : "";
+  if (mod_view) suffix += "-mod-" + fingerprint.substr(0, 16);
+  if (!rules_digest.empty()) suffix += "-r" + rules_digest.substr(0, 8);
+  // Reserve engine, mod and rules identity before truncating the version.
+  const std::string result = key.substr(0, 64 - suffix.size()) + suffix;
+  // A version can itself contain "-st" at the truncation boundary. Keep the legacy Source key
+  // byte-identical, and shorten only Static's version once more if that would alias it.
+  if (static_engine && result == compatibility_key(version, mod_view, fingerprint, false, rules_digest))
+    return key.substr(0, 63 - suffix.size()) + suffix;
+  return result;
+}
+} // namespace yougame
diff --git a/port/runtime/hle/yougame_controller_relay.h b/port/runtime/hle/yougame_controller_relay.h
new file mode 100644
index 0000000..dd839c2
--- /dev/null
+++ b/port/runtime/hle/yougame_controller_relay.h
@@ -0,0 +1,107 @@
+// The app's relayed pads in the game's own controller families (host/controller_relay.h): a
+// PlayStation or Switch pad gets its family's bindings, options, capture and port choices instead
+// of the Xbox ones. Xbox and other pads stay the Xbox family; "hid" keeps its own 32-bit mask.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "yougame_relay_pads.h"
+#include "controller_relay.h"
+
+namespace yougame::relay_pads {
+inline host::CaptureDevice capture_family(Family family) {
+  switch (family) {
+    case Family::PlayStation: return host::CaptureDevice::DS4Pad;
+    case Family::Switch: return host::CaptureDevice::SwitchPro;
+    case Family::Hid: return host::CaptureDevice::HidPad;
+    default: return host::CaptureDevice::XInputPad;
+  }
+}
+
+// Resolve the actual routed family/index back to the app's seat, including sparse and mixed lists.
+inline int seat_for(const Frame& frame, host::CaptureDevice family, int index) {
+  if (family == host::CaptureDevice::None || index < 0 || index >= 4) return -1;
+  for (unsigned seat = 0; seat < frame.pads.size(); ++seat) {
+    const auto& p = frame.pads[seat];
+    if (p.present && p.family_index == unsigned(index) && capture_family(family_of(p.kind)) == family)
+      return int(seat);
+  }
+  return -1;
+}
+inline std::string family_line(unsigned seat, const Pad& pad, int port) {
+  if (pad.kind != "ps" && pad.kind != "switch" && pad.kind != "xbox") return {};
+  const auto family = family_of(pad.kind);
+  const char* bindings = family == Family::PlayStation ? "DS4" : family == Family::Switch ? "SWPRO" : "XInput";
+  return "relay pads: slot " + std::to_string(seat) + " kind " + pad.kind + " family " +
+      std::to_string(pad.family_index) + " -> " + bindings + " bindings, port " + std::to_string(port + 1);
+}
+// Keep the first (lowest) actual port for each seat. Duplicate explicit routes must not
+// alternate the logged port every poll. A gap or a reassignment starts a new announcement.
+class RouteLog {
+ public:
+  void begin(const Frame& frame) {
+    for (unsigned seat = 0; seat < last_.size(); ++seat) {
+      auto& last = last_[seat];
+      if (!last.seen || !frame.pads[seat].present) last = {};
+      last.seen = false;
+    }
+  }
+  std::string changed(const Frame& frame, host::CaptureDevice family, int index, int port) {
+    if (port < 0 || port >= 4) return {};
+    const int seat = seat_for(frame, family, index);
+    if (seat < 0) return {};
+    auto& last = last_[seat];
+    if (last.seen) return {};
+    last.seen = true;
+    const auto& pad = frame.pads[seat];
+    if (last.id == pad.id && last.kind == pad.kind && last.index == pad.family_index && last.port == port)
+      return {};
+    last.id = pad.id; last.kind = pad.kind; last.index = pad.family_index; last.port = port;
+    return family_line(unsigned(seat), pad, port);
+  }
+ private:
+  struct Last {
+    std::string id, kind;
+    unsigned index = kNoFamilyIndex;
+    int port = -1;
+    bool seen = false;
+  };
+  std::array<Last, 4> last_{};
+};
+// Game poll owns the cache: a single stdin frame serves all family reads and its routing log.
+inline thread_local Frame game_frame;
+
+// One sample per present pad, at its seat, numbered by its familyIndex (a gap stays a gap).
+inline host::controller_relay::Snapshot controller_snapshot(const Frame& frame) {
+  host::controller_relay::Snapshot result;
+  const bool has_real_pad = std::any_of(frame.pads.begin(), frame.pads.end(), [](const Pad& p) {
+    return p.present && !(p.kind == "other" && p.id == "virtual");
+  });
+  for (size_t seat = 0; seat < frame.pads.size(); ++seat) {
+    const Pad& p = frame.pads[seat];
+    if (!p.present || p.family_index >= 4) continue;   // a skipped duplicate stays out of the game
+    const Family family = family_of(p.kind);
+    host::controller_relay::Sample& s = result.devices[seat];
+    s.family = capture_family(family);
+    s.index = static_cast<int>(p.family_index);
+    s.name = p.name;
+    // The page keyboard may play alone, but must not take automatic P1 from a connected pad.
+    s.allow_fallback = !(has_real_pad && p.kind == "other" && p.id == "virtual");
+    s.axes[0] = p.lx; s.axes[1] = p.ly; s.axes[2] = p.rx; s.axes[3] = p.ry;
+    s.left = p.lt; s.right = p.rt;
+    if (family == Family::Hid) { s.buttons = p.buttons; continue; }
+    // The app's buttons are XInput positions (south = 0x1000): the family's own mask, L2/R2 or ZL/ZR
+    // from the trigger values. Xbox is unchanged.
+    s.buttons = host::controller_relay::native_buttons(static_cast<uint16_t>(p.buttons), s.family, p.lt, p.rt);
+    if (family == Family::PlayStation) {
+      // As playstation_pad.cpp reads a pad: no trigger travel below the L2/R2 press point.
+      if (s.left <= host::kPlayStationTriggerPress) s.left = 0;
+      if (s.right <= host::kPlayStationTriggerPress) s.right = 0;
+    } else if (family == Family::Switch) {
+      // ZL and ZR are buttons, as switch_pro.cpp reads a Pro Controller: no travel. Any travel here
+      // reaches the game through swpro_apply_bindings: ZR (Z by default) would also press R all the
+      // way in, and the unbound ZL would shield.
+      s.left = s.right = 0;
+    }
+  }
+  return result;
+}
+}  // namespace yougame::relay_pads
diff --git a/port/runtime/hle/yougame_embed_toplevel.h b/port/runtime/hle/yougame_embed_toplevel.h
new file mode 100644
index 0000000..d22df0a
--- /dev/null
+++ b/port/runtime/hle/yougame_embed_toplevel.h
@@ -0,0 +1,73 @@
+// Windows toplevel embed policy, independent of Windows headers for synthetic tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "yougame_embed_view.h"
+#include <algorithm>
+#include <charconv>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace yougame::embed_toplevel_policy {
+enum class Backend { D3D11, D3D12, OpenGL };
+// Win32 constants kept here so the policy can be exercised on non-Windows hosts.
+inline constexpr uint32_t popup = 0x80000000u, toolwindow = 0x80u,
+                          no_redirection = 0x00200000u;
+struct Styles { uint32_t style, exstyle; };
+inline constexpr Styles styles(bool toplevel, bool flip, Backend backend,
+                               uint32_t legacy_style = 0x00cf0000u, uint32_t legacy_exstyle = 0) {
+  return toplevel ? Styles{popup, toolwindow | (flip && backend != Backend::OpenGL ? no_redirection : 0)}
+                  : Styles{legacy_style, legacy_exstyle};
+}
+inline bool enabled(bool embedded, std::string_view flag) { return embedded && flag == "1"; }
+inline uint32_t app_pid(std::string_view text) {
+  if (text.empty()) return 0;
+  uint32_t pid = 0;
+  const auto result = std::from_chars(text.data(), text.data() + text.size(), pid);
+  // UINT32_MAX is ASFW_ANY, not an app PID. Never grant foreground access to everybody.
+  return result.ec == std::errc{} && result.ptr == text.data() + text.size() &&
+         pid != UINT32_MAX ? pid : 0;
+}
+inline uint32_t preferred_app_pid(uint32_t owner, uint32_t env) {
+  return owner && owner != UINT32_MAX ? owner : env;
+}
+inline bool emit_focus_return(bool foreground, bool focused) { return foreground || focused; }
+inline bool rect(std::string_view line, bool toplevel, yg_embed_box& box) {
+  if (line.substr(0, 5) != "rect ") return false;
+  line.remove_prefix(5);
+  int values[4]{};
+  for (int i = 0; i < 4; ++i) {
+    while (!line.empty() && line.front() == ' ') line.remove_prefix(1);
+    if (line.empty()) return false;
+    const auto result = std::from_chars(line.data(), line.data() + line.size(), values[i]);
+    if (result.ec != std::errc{}) return false;
+    line.remove_prefix(result.ptr - line.data());
+    if (i < 3 && (line.empty() || line.front() != ' ')) return false;
+  }
+  while (!line.empty() && line.front() == ' ') line.remove_prefix(1);
+  if (!line.empty() || values[2] <= 0 || values[3] <= 0 ||
+      (!toplevel && (values[0] < 0 || values[1] < 0))) return false;
+  box = {values[0], values[1], toplevel ? std::min(values[2], 16384) : values[2],
+         toplevel ? std::min(values[3], 16384) : values[3]};
+  return true;
+}
+inline uint64_t pack(int first, int second) {
+  return (uint64_t(uint32_t(first)) << 32) | uint32_t(second);
+}
+inline int first(uint64_t value) { return int32_t(value >> 32); }
+inline int second(uint64_t value) { return int32_t(value); }
+inline constexpr const char* kFocusReturn = "yg {\"focusReturn\":1}";
+// The app places this window and brings it forward itself (SetForegroundWindow on "focus"), so it is told which window.
+inline std::string hwnd_line(uintptr_t hwnd) { return "yg {\"toplevelHwnd\":" + std::to_string(hwnd) + "}"; }
+inline std::string focus_return_message(uint32_t pid) {
+  return "embed: toplevel focus return pid=" + (pid ? std::to_string(pid) : "none");
+}
+class FocusReturn {
+ public:
+  void focused() { returned_ = false; }
+  // Eligible blur/hide commands emit the protocol line; duplicates log only once.
+  bool changed() { const bool changed = !returned_; returned_ = true; return changed; }
+ private:
+  bool returned_ = false;
+};
+} // namespace yougame::embed_toplevel_policy
diff --git a/port/runtime/hle/yougame_embed_view.h b/port/runtime/hle/yougame_embed_view.h
new file mode 100644
index 0000000..8369d29
--- /dev/null
+++ b/port/runtime/hle/yougame_embed_view.h
@@ -0,0 +1,85 @@
+// Pure parent-relative embed geometry shared by the Win32 and X11 adapters.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef YOUGAME_EMBED_VIEW_H
+#define YOUGAME_EMBED_VIEW_H
+#include <stdint.h>
+
+typedef struct yg_embed_box { int x, y, w, h; } yg_embed_box;
+typedef struct yg_embed_view_state {
+    yg_embed_box view, rect, window;
+    int has_view, has_rect, shown, valid, minimum, warned_clamp;
+} yg_embed_view_state;
+typedef struct yg_embed_view_result {
+    yg_embed_box window, clip;
+    int geometry, move, resize, valid, visible, warn_clamp;
+} yg_embed_view_result;
+
+static inline yg_embed_view_state yg_embed_view_init(int w, int h, int minimum)
+{
+    yg_embed_view_state s = {0};
+    s.window.w = w; s.window.h = h;
+    s.shown = 1; s.minimum = minimum;
+    return s;
+}
+
+static inline int yg_embed_view_visible(const yg_embed_view_state *s)
+{
+    return s->shown && s->valid;
+}
+
+static inline void yg_embed_view_show(yg_embed_view_state *s, int shown)
+{
+    s->shown = shown;
+}
+
+/* The adapters retain their legacy parsing/range checks. minimum is 1 on Win32,
+ * 32 on X11. Invalid/tiny geometry hides without changing the drawable size.
+ * A view may precede the first rect: size the surface, but keep an empty clip.
+ * Geometry updates never undo hide. No-view rect mapping stays unchanged. */
+static inline yg_embed_view_result yg_embed_view_update(yg_embed_view_state *s,
+                                                       yg_embed_box box, int is_view)
+{
+    yg_embed_view_result r = {0};
+    yg_embed_box target;
+    if (is_view) { s->view = box; s->has_view = 1; }
+    else { s->rect = box; s->has_rect = 1; }
+    target = s->has_view ? s->view : s->rect;
+    r.geometry = target.w >= s->minimum && target.h >= s->minimum;
+    r.window = s->window;
+    if (r.geometry) {
+        r.window = target;
+        r.resize = target.w != s->window.w || target.h != s->window.h;
+        r.move = target.x != s->window.x || target.y != s->window.y;
+        s->window = target;
+    }
+    if (s->has_view && s->has_rect) {
+        /* Wide sums also cover the largest accepted Win32 integers. Clamp each
+         * edge into the view, so even disjoint rects produce a local empty clip. */
+        int64_t vx = s->view.x, vy = s->view.y;
+        int64_t right = vx + s->view.w, bottom = vy + s->view.h;
+        int64_t x = s->rect.x, y = s->rect.y;
+        int64_t x2 = x + s->rect.w, y2 = y + s->rect.h;
+        int outside = x < vx || y < vy || x2 > right || y2 > bottom ||
+                      s->rect.w < 0 || s->rect.h < 0;
+        if (x < vx) x = vx;
+        if (x > right) x = right;
+        if (y < vy) y = vy;
+        if (y > bottom) y = bottom;
+        if (x2 < x) x2 = x;
+        if (x2 > right) x2 = right;
+        if (y2 < y) y2 = y;
+        if (y2 > bottom) y2 = bottom;
+        r.clip.x = (int)(x - vx); r.clip.y = (int)(y - vy);
+        r.clip.w = (int)(x2 - x); r.clip.h = (int)(y2 - y);
+        r.warn_clamp = outside && !s->warned_clamp;
+        if (outside) s->warned_clamp = 1;
+    } else if (!s->has_view && s->has_rect) {
+        r.clip.w = s->rect.w; r.clip.h = s->rect.h;
+    }
+    r.valid = r.geometry && s->has_rect && r.clip.w >= s->minimum &&
+              r.clip.h >= s->minimum;
+    s->valid = r.valid;
+    r.visible = yg_embed_view_visible(s);
+    return r;
+}
+#endif
diff --git a/port/runtime/hle/yougame_embed_volume.h b/port/runtime/hle/yougame_embed_volume.h
new file mode 100644
index 0000000..e932718
--- /dev/null
+++ b/port/runtime/hle/yougame_embed_volume.h
@@ -0,0 +1,30 @@
+// The page's volume control for the player box ("embed volume <gain>", NativeEmbed.tsx sends toFixed(3)).
+// SPDX-License-Identifier: GPL-2.0-or-later
+#ifndef YOUGAME_EMBED_VOLUME_H
+#define YOUGAME_EMBED_VOLUME_H
+
+/* "volume <gain>" with a plain decimal gain in [0, 1] -> the game's volume 0..100, rounded; anything
+ * else -> -1. Parsed by hand, not with strtod: the game may run under a locale whose decimal point
+ * is a comma, and the page always sends a point. Digits past the third decimal are ignored. */
+static inline int yg_embed_volume(const char* line)
+{
+    static const char prefix[] = "volume ";
+    const char* p = line;
+    int i, whole = 0, thousandths = 0, places = 0, digits = 0, dot = 0, rest = 0;
+    for (i = 0; prefix[i]; ++i)
+        if (p[i] != prefix[i]) return -1;
+    for (p += i; *p; ++p) {
+        if (*p == '.' && !dot) { dot = 1; continue; }
+        if (*p < '0' || *p > '9') return -1;
+        ++digits;
+        if (!dot) { if (whole < 2) whole = whole * 10 + (*p - '0'); }
+        else if (places < 3) { thousandths = thousandths * 10 + (*p - '0'); ++places; }
+        else rest |= *p != '0';
+    }
+    if (!digits || whole > 1) return -1;
+    while (places < 3) { thousandths *= 10; ++places; }
+    if (whole == 1 && (thousandths || rest)) return -1;
+    return (whole * 1000 + thousandths + 5) / 10;
+}
+
+#endif
diff --git a/port/runtime/hle/yougame_exit_reason.h b/port/runtime/hle/yougame_exit_reason.h
new file mode 100644
index 0000000..b29d38f
--- /dev/null
+++ b/port/runtime/hle/yougame_exit_reason.h
@@ -0,0 +1,47 @@
+// Window-free policy for app-owned mod compatibility messages.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "../host/mod_scan.h"
+#include <nlohmann/json.hpp>
+#include <string>
+#include <string_view>
+
+namespace yougame::mode_policy {
+
+enum class ModRefusal { None, UnsupportedMod, UnsupportedVersion, ModdedDol, NativeFighters };
+
+inline ModRefusal mod_refusal(const source_port::mods::Detected& mod) {
+  using namespace source_port::mods;
+  // Unrecognized, unreadable, compressed, wrong-region and retail discs are not mod updates.
+  if (mod.kind == Kind::Unsupported || mod.kind == Kind::Vanilla) return ModRefusal::None;
+  if (mod.status != Support::Supported)
+    return mod.version.empty() ? ModRefusal::UnsupportedMod : ModRefusal::UnsupportedVersion;
+  if (mod.needs == Engine::Recomp) return ModRefusal::UnsupportedMod;
+  return ModRefusal::None;
+}
+
+inline std::string exit_reason_field(std::string_view value) {
+  std::string clean;
+  for (unsigned char c : value) if (c >= 0x20 && c <= 0x7e) clean += char(c);
+  std::string lower = clean;
+  for (char& c : lower) if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+  // Check after stripping too: removing a control byte must not assemble a link.
+  if (lower.find("://") != std::string::npos || lower.find("www.") != std::string::npos) return {};
+  clean.resize(clean.size() > 60 ? 60 : clean.size());
+  const auto first = clean.find_first_not_of(' ');
+  if (first == std::string::npos) return {};
+  return clean.substr(first, clean.find_last_not_of(' ') - first + 1);
+}
+
+// Null means no notification. Unknown metadata stays absent; filenames and log prose are not names.
+inline nlohmann::json mod_exit_request(bool active, bool stdio, bool explicit_layer, ModRefusal refusal,
+                                       std::string_view name = {}, std::string_view version = {}) {
+  if (!active || !stdio || !explicit_layer || refusal == ModRefusal::None) return nullptr;
+  nlohmann::json request = {{"type", "exitReason"}, {"reason", "mod_outdated"}};
+  const auto mod = exit_reason_field(name), mod_version = exit_reason_field(version);
+  if (!mod.empty()) request["mod"] = mod;
+  if (!mod_version.empty()) request["modVersion"] = mod_version;
+  return request;
+}
+
+}  // namespace yougame::mode_policy
diff --git a/port/runtime/hle/yougame_friends.h b/port/runtime/hle/yougame_friends.h
new file mode 100644
index 0000000..a3b05e1
--- /dev/null
+++ b/port/runtime/hle/yougame_friends.h
@@ -0,0 +1,302 @@
+// YouGame friends protocol and presentation state, shared with window-free tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <nlohmann/json.hpp>
+#include <cstdint>
+#include <cstdio>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <utility>
+
+namespace yougame::friends {
+using json = nlohmann::json;
+inline constexpr const char* kHint = "Leave empty to invite a YouGame friend";
+inline constexpr const char* kVersion = "Your friend is on a different version";
+inline constexpr const char* kJoined = "Joined";
+inline constexpr const char* kFailed = "Couldn't reach your friend";
+// Accept the explicit rooms refusal/notice reason; never guess from free-form text.
+inline bool version_reason(const json& value) {
+  const auto reason = value.find("reason");
+  return value.is_object() && reason != value.end() && reason->is_string() && *reason == "version";
+}
+struct InviteEdge {
+  uint16_t previous = 0;
+  bool need_release = false;
+  // connected = the pad is present AND the game has the keyboard/pads. After it was not (the page's
+  // friend picker had focus, a hot-plug), an A or START still held must be let go before a press counts:
+  // otherwise a held button reopened the picker every time focus came back (quality, pc2 10-30).
+  bool poll(bool connected, uint16_t buttons, bool code, bool empty, bool entry) {
+    if (!connected) { previous = 0; need_release = true; return false; }
+    if (need_release) {
+      if (!(buttons & 0x1100)) need_release = false;
+      previous = buttons;
+      return false;
+    }
+    const uint16_t pressed = buttons & ~previous;
+    previous = buttons;
+    return (code && empty && (pressed & 0x1000)) || (entry && (pressed & 0x1100));
+  }
+};
+inline constexpr const char* kWaiting = "Waiting for your friend...";
+inline constexpr const char* kTeamWaiting = "Waiting for your team...";
+inline constexpr const char* kTeamCodeError = "Team codes need 3 to 9 letters or numbers";
+inline constexpr int kPickerTimeout = 600000;
+
+// The game's Direct code field is Shift-JIS: ASCII letters and digits with the # as the full-width
+// 0x81 0x94 (convert_connect_code_for_game), and the on-screen keyboard can also give full-width
+// letters, digits or spaces. YouGame's search is UTF-8 JSON, so the code goes in as plain ASCII
+// ("LAIN#504"): the raw bytes made the request's dump() throw type_error.316, shown on CSS.
+// Anything outside that set returns false so the search fails with a readable message.
+inline bool direct_code_from_game(const std::string& sj, std::string* out) {
+  std::string code;
+  for (size_t i = 0; i < sj.size(); ++i) {
+    const auto c = static_cast<unsigned char>(sj[i]);
+    if (c == 0) break;
+    if (c < 0x80) {
+      if (c >= 'a' && c <= 'z') code += static_cast<char>(c - 'a' + 'A');
+      else if (c != ' ') code += static_cast<char>(c);
+      continue;
+    }
+    if (i + 1 >= sj.size()) return false;
+    const auto d = static_cast<unsigned char>(sj[++i]);
+    if (c == 0x81 && d == 0x94) code += '#';
+    else if (c == 0x81 && d == 0x40) continue;
+    else if (c == 0x82 && d >= 0x4F && d <= 0x58) code += static_cast<char>('0' + d - 0x4F);
+    else if (c == 0x82 && d >= 0x60 && d <= 0x79) code += static_cast<char>('A' + d - 0x60);
+    else if (c == 0x82 && d >= 0x81 && d <= 0x9A) code += static_cast<char>('A' + d - 0x81);
+    else return false;
+  }
+  for (const char ch : code)
+    if (!((ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '#')) return false;
+  if (out) *out = code;
+  return true;
+}
+
+inline bool search_code(int mode, const std::string& raw, std::string* out) {
+  std::string code;
+  const bool folded = direct_code_from_game(raw, &code);
+  if (!folded && (mode == 2 || (mode == 3 && !raw.empty()))) return false;
+  if (out) *out = code;
+  return true;
+}
+
+inline bool team_room_code(const std::string& folded, std::string* out) {
+  std::string code;
+  for (char c : folded) {
+    if (c == '#') continue;
+    if (c >= 'A' && c <= 'Z') c = static_cast<char>(c - 'A' + 'a');
+    if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) return false;
+    code += c;
+  }
+  if (code.size() < 3 || code.size() > 9) return false;
+  if (out) *out = "mut" + code;
+  return true;
+}
+inline json team_ticket(const std::string& compatibility, const std::string& code) {
+  if (code.size() < 6 || code.size() > 12 || code.compare(0, 3, "mut") != 0)
+    throw std::runtime_error(kTeamCodeError);
+  for (char c : code)
+    if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9'))) throw std::runtime_error(kTeamCodeError);
+  return {{"type", "mpTicket"}, {"players", 4}, {"mode", "teams"},
+          {"room", code}, {"ranked", false},
+          {"lobby", {{"version", 1}, {"minPlayers", 4}, {"maxLocalPlayers", 1}, {"compatibility", compatibility}}}};
+}
+
+inline std::string text(const json& value, const char* key, size_t max) {
+  if (!value.is_object()) return {};
+  const auto it = value.find(key);
+  if (it == value.end() || !it->is_string()) return {};
+  const auto& s = it->get_ref<const std::string&>();
+  if (s.empty() || s.size() > max * 4) return {};
+  size_t count = 0;
+  for (size_t i = 0; i < s.size();) {
+    const auto lead = static_cast<unsigned char>(s[i++]);
+    uint32_t cp = lead;
+    int tails = 0;
+    if (lead >= 0xC2 && lead <= 0xDF) { cp &= 0x1F; tails = 1; }
+    else if (lead >= 0xE0 && lead <= 0xEF) { cp &= 0x0F; tails = 2; }
+    else if (lead >= 0xF0 && lead <= 0xF4) { cp &= 0x07; tails = 3; }
+    else if (lead >= 0x80) return {};
+    if (i + tails > s.size()) return {};
+    for (int n = 0; n < tails; ++n) {
+      const auto c = static_cast<unsigned char>(s[i++]);
+      if ((c & 0xC0) != 0x80) return {};
+      cp = (cp << 6) | (c & 0x3F);
+    }
+    if ((tails == 1 && cp < 0x80) || (tails == 2 && cp < 0x800) ||
+        (tails == 3 && cp < 0x10000) || cp > 0x10FFFF ||
+        (cp >= 0xD800 && cp <= 0xDFFF) || cp < 32 || (cp >= 127 && cp <= 159) ||
+        ++count > max) return {};
+  }
+  return s;
+}
+inline std::string room_code(const json& value, const char* key) {
+  auto s = text(value, key, 16);
+  if (s.size() < 4 || s.size() > 16) return {};
+  for (unsigned char c : s)
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))) return {};
+  return s;
+}
+inline std::string room(const json& value) { return room_code(value, "room"); }
+inline std::string picker_room(const json& value) { return room_code(value, "code"); }
+inline bool empty_code(bool yougame, int mode, const std::string& code) {
+  return yougame && mode == 2 && code.empty();
+}
+// The picker supplies the host code; invitees repeat it in the `room` field.
+inline json ticket(const std::string& compatibility, const std::string& code) {
+  if (room(json{{"room", code}}).empty()) throw std::runtime_error("Invalid YouGame friends room");
+  return {{"type", "mpTicket"}, {"players", 2}, {"mode", "singles"},
+          {"room", code}, {"ranked", false},
+          {"lobby", {{"version", 1}, {"minPlayers", 2}, {"maxLocalPlayers", 1}, {"compatibility", compatibility}}}};
+}
+inline bool native_ready(bool yougame, int mode, const std::string& code, const std::string& invite) {
+  return !(yougame && (!invite.empty() || empty_code(true, mode, code)));
+}
+// The ordinary Direct winner path locks in on START without another code/stage screen.
+// A random first stage is already supplied by native_start_match, as for other searches.
+inline constexpr int kFirstCssWinner = 1;
+inline json picker() { return {{"type", "mpFriend"}, {"mode", "singles"}, {"players", 2}}; }
+inline bool version_request(const json& request) {
+  return request.value("type", "") == "mpFriend" ||
+      (request.value("type", "") == "mpTicket" && request.value("mode", "") == "singles" &&
+       request.value("players", 0) == 2 && !request.value("ranked", false) &&
+       !request.count("direct") && !room(request).empty());
+}
+inline std::string expire_joined(const std::string& status, uint64_t since, uint64_t now) {
+  return status == kJoined && now - since >= 10000 ? std::string() : status;
+}
+// Shared request path: no ticket can be sent before a valid picker answer (or invite).
+template <class Send, class Cancelled>
+std::string resolve_room(const std::string& invite, Send send, Cancelled cancelled) {
+  if (cancelled()) throw std::runtime_error("Cancelled");
+  const auto code = invite.empty() ? picker_room(send(picker(), kPickerTimeout))
+                                   : room(json{{"room", invite}});
+  if (cancelled()) throw std::runtime_error("Cancelled");
+  if (code.empty()) throw std::runtime_error("Invalid YouGame friends room");
+  return code;
+}
+template <class Send, class Cancelled, class Starting>
+json request_ticket(const std::string& compatibility, const std::string& invite,
+                    json& request, Send send, Cancelled cancelled, Starting starting) {
+  const auto code = resolve_room(invite, send, cancelled);
+  request = ticket(compatibility, code);
+  starting(code);  // track our room before the page can push its own URL's join
+  return send(request, 30000);
+}
+// Restrict scene changes to the initialized main menu or online CSS/stage/results menus.
+// Every match (including local play), replay and other scene remains untouched.
+inline bool menu_safe(int major, int minor) { return major == 1 || (major == 8 && (minor == 0 || minor == 1 || minor == 3)); }
+
+class Events {
+ public:
+  void hello(const json& value) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (hello_seen_) return;
+    hello_seen_ = true;
+    const auto code = room(value);
+    if (pending_.empty() && code != current_room_) pending_ = code;  // a newer push wins over the launch invite
+  }
+  bool push(const json& value, uint64_t now) {
+    const auto type = text(value, "type", 16);
+    if (type == "join") {
+      const auto code = room(value);
+      if (code.empty()) return false;
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (code == current_room_) return false;
+      pending_ = code;
+      return true;
+    }
+    if (type == "notice" && version_reason(value)) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      version_notice_ = true; picker_error_ = kVersion;
+      toast_ = kVersion; toast_until_ = now + 6000;
+      return true;
+    }
+    if (type != "notice" || text(value, "kind", 16) != "invite") return false;
+    const auto from = text(value, "from", 40), line = text(value, "text", 80);
+    if (from.empty() || line.empty()) return false;
+    std::lock_guard<std::mutex> lock(mutex_);
+    toast_ = from + " " + line;
+    toast_until_ = now + 6000;
+    return true;
+  }
+  bool report_version() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return !std::exchange(version_logged_, true);
+  }
+  bool take_version() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return std::exchange(version_notice_, false);
+  }
+  std::string take_join(bool safe) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!safe) return {};
+    return std::exchange(pending_, {});
+  }
+  std::string toast(uint64_t now) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return now < toast_until_ ? toast_ : std::string();
+  }
+  void current_room(const std::string& code) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    current_room_ = code;
+    if (!code.empty() && pending_ == code) pending_.clear();
+  }
+  void picker_error(std::string error) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    picker_error_ = std::move(error);
+  }
+  std::string picker_error() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return picker_error_;
+  }
+  void online_menu(bool visible, bool selected = false) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    online_menu_ = visible; friend_entry_ = visible && selected;
+    if (!visible) host_requested_ = false;
+  }
+  bool online_menu() const { std::lock_guard<std::mutex> lock(mutex_); return online_menu_; }
+  bool friend_entry() const { std::lock_guard<std::mutex> lock(mutex_); return friend_entry_; }
+  bool picker_context() const { std::lock_guard<std::mutex> lock(mutex_); return code_screen_ || online_menu_; }
+  // What asked for the picker last ("pad N buttons XXXX" or the keyboard/overlay path), for the entry log line.
+  std::string trigger() const { std::lock_guard<std::mutex> lock(mutex_); return trigger_; }
+  bool poll_pad(int port, bool connected, uint16_t buttons) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (port < 0 || port >= 4) return false;
+    if (!edges_[port].poll(connected, buttons, code_screen_, code_empty_, friend_entry_)) return false;
+    char why[40];
+    std::snprintf(why, sizeof why, "pad %d buttons %04x", port + 1, buttons);
+    trigger_ = why;
+    host_requested_ = true; picker_error_.clear(); version_notice_ = version_logged_ = false; return true;
+  }
+  void request_host() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if ((code_screen_ && code_empty_) || online_menu_) {
+      trigger_ = "Enter or the overlay button";
+      host_requested_ = true; picker_error_.clear(); version_notice_ = version_logged_ = false;
+    }
+  }
+  bool take_host() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return std::exchange(host_requested_, false);
+  }
+  void code_empty(bool empty) { std::lock_guard<std::mutex> lock(mutex_); code_empty_ = empty; }
+  bool code_empty() const { std::lock_guard<std::mutex> lock(mutex_); return code_empty_; }
+  void code_screen(bool visible) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    code_screen_ = visible;
+    if (!visible) { host_requested_ = false; picker_error_.clear(); }
+  }
+  bool code_screen() const { std::lock_guard<std::mutex> lock(mutex_); return code_screen_; }
+ private:
+  mutable std::mutex mutex_;
+  InviteEdge edges_[4];
+  std::string trigger_;
+  bool online_menu_ = false, friend_entry_ = false, version_notice_ = false, version_logged_ = false;
+  bool hello_seen_ = false, code_screen_ = false, code_empty_ = false, host_requested_ = false;
+  std::string pending_, toast_, current_room_, picker_error_;
+  uint64_t toast_until_ = 0;
+};
