+++ b/port/tests/agent_script_absent_test.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+# Every new hook marker must be rejected independently in either named game executable.
+set -eu
+scanner=${1:?usage: agent_script_absent_test.sh <scanner>}
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT HUP INT TERM
+for marker in 'netDelayMs' 'netJitterMs' 'AGENT TEST net delay' 'AGENT TEST: net delay' \
+  'agent test: script' 'agent-test: script' 'agent-test: rng_seed' 'agent-test: time_base' \
+  'rng_seed invalid value' 'time_base invalid value' 'script invalid name' 'script missing data directory' \
+  'script missing or not a regular file' 'script cannot read size' 'script exceeds 64 KiB' \
+  'script not supported on the Source Port' 'captureEvery' 'agent-captures' \
+  'agent-test: frame_times' 'agent-test: sim_times' 'agent-test: replay_dir' 'agent-test: record_native' \
+  'agent-test: slippi_menus' 'agent-test: no_gc_adapter' 'agent-test: early_rng_seed' \
+  'frames invalid value' 'frames not supported on the Source Port'; do
+  for dirty in melee_source.exe melee_port.exe; do
+    printf 'MZ\0clean\0' > "$scratch/melee_source.exe"
+    printf 'MZ\0clean\0' > "$scratch/melee_port.exe"
+    sh "$scanner" "$scratch/melee_port.exe" >/dev/null
+    printf 'MZ\0%s\0' "$marker" > "$scratch/$dirty"
+    if sh "$scanner" "$scratch/melee_port.exe" >/dev/null 2>&1; then
+      echo "missed $marker in $dirty" >&2
+      exit 1
+    fi
+  done
+done
diff --git a/port/tests/agent_test_hook_absent.sh b/port/tests/agent_test_hook_absent.sh
new file mode 100755
index 0000000..07888ab
--- /dev/null
+++ b/port/tests/agent_test_hook_absent.sh
@@ -0,0 +1,48 @@
+#!/bin/sh
+# Fails when a built Windows, Linux or Mac host carries the staging-only agent-test hook.
+# Windows: pass either exe to check both siblings. Linux: pass melee_source and/or melee_linux
+# explicitly (the full and minimal hosts live in different build directories).
+set -eu
+: "${1:?usage: agent_test_hook_absent.sh <melee_source.exe|melee_port.exe|melee_source|melee_linux|MeleeUnlocked> [other artifacts...]}"
+case "$1" in
+  */melee_source.exe|melee_source.exe) set -- "$@" "$(dirname "$1")/melee_port.exe" ;;
+  */melee_port.exe|melee_port.exe) set -- "$@" "$(dirname "$1")/melee_source.exe" ;;
+esac
+for exe do
+[ -s "$exe" ] || { echo "agent_test_hook_absent: $exe is missing or empty" >&2; exit 2; }
+if LC_ALL=C grep -a -q 'agent-test\.json' "$exe"; then
+  echo "agent_test_hook_absent: $exe contains the agent-test hook; rebuild without -DYOUGAME_AGENT_TEST_HOOK=ON" >&2
+  exit 1
+fi
+if LC_ALL=C grep -a -E -q 'netDelayMs|netJitterMs|AGENT TEST net delay|AGENT TEST: net delay' "$exe"; then
+  echo "agent_test_hook_absent: $exe contains network test hooks" >&2
+  exit 1
+fi
+# The hook's "padBack" key and log line, but not ImGui's "GamepadBack" key name, which every full host carries:
+# each run of letters ending in padBack must be exactly GamepadBack (a "_" ends the run, so ImGuiKey_GamepadBack too).
+if LC_ALL=C grep -a -o -E '[A-Za-z]*padBack' "$exe" | LC_ALL=C grep -q -v -x 'GamepadBack'; then
+  echo "agent_test_hook_absent: $exe contains padBack; rebuild without -DYOUGAME_AGENT_TEST_HOOK=ON" >&2
+  exit 1
+fi
+if LC_ALL=C grep -a -E -q 'agent[ -]test: (script|captureEvery|frames|rng_seed|time_base|frame_times|sim_times|replay_dir|record_native|slippi_menus|no_gc_adapter|early_rng_seed)|script (invalid name|missing data directory|missing or not a regular file|cannot read size|exceeds 64 KiB|not supported on the Source Port)|(rng_seed|time_base) invalid value|captureEvery|agent-captures|frames (invalid value|not supported on the Source Port)' "$exe"; then
+  echo "agent_test_hook_absent: $exe contains agent script/capture hooks; rebuild without -DYOUGAME_AGENT_TEST_HOOK=ON" >&2
+  exit 1
+fi
+if LC_ALL=C grep -a -E -q 'agent-test: (keys ignored:|key )' "$exe"; then
+  echo "agent_test_hook_absent: $exe contains agent key hooks; rebuild without -DYOUGAME_AGENT_TEST_HOOK=ON" >&2
+  exit 1
+fi
+if LC_ALL=C grep -a -E -q 'present_log|present_frames|present-log v1|agent-test: present output' "$exe"; then
+  echo "agent_test_hook_absent: $exe contains presentation test hooks" >&2
+  exit 1
+fi
+if LC_ALL=C grep -a -E -q 'rumbleTest|boxPresent|agent test: rumble pulse' "$exe"; then
+  echo "agent_test_hook_absent: $exe contains relay/present test hooks" >&2
+  exit 1
+fi
+if LC_ALL=C grep -a -E -q 'padTrace|agent-test: padTrace|port %d src %s buttons %04X stick %d,%d' "$exe"; then
+  echo "agent_test_hook_absent: $exe contains pad trace hooks" >&2
+  exit 1
+fi
+echo "agent_test_hook_absent: ok ($exe)"
+done
diff --git a/port/tests/agent_test_hook_absent_test.sh b/port/tests/agent_test_hook_absent_test.sh
new file mode 100755
index 0000000..80e414e
--- /dev/null
+++ b/port/tests/agent_test_hook_absent_test.sh
@@ -0,0 +1,43 @@
+#!/bin/sh
+# Scanner regression: each hook marker independently rejects an artifact.
+set -eu
+scanner=${1:?usage: agent_test_hook_absent_test.sh <scanner>}
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT HUP INT TERM
+printf 'MZ\0no hook here\0' > "$scratch/clean.exe"
+printf 'MZ\0agent-test.json\0' > "$scratch/file.exe"
+printf 'MZ\0padBack\0' > "$scratch/pad.exe"
+# ImGui's gamepad key name is in every full host and is not the hook (10-26: every full Linux build failed on it).
+printf 'MZ\0GamepadBack\0ImGuiKey_GamepadBack\0' > "$scratch/gamepad.exe"
+sh "$scanner" "$scratch/gamepad.exe"
+printf 'MZ\0GamepadBack\0padBack\0' > "$scratch/padgamepad.exe"
+printf 'MZ\0[yougame] agent test: padBack in %%d s\0' > "$scratch/padlog.exe"
+printf 'MZ\0agent-test: keys ignored: \0' > "$scratch/keys.exe"
+printf 'MZ\0agent-test: key \0' > "$scratch/key.exe"
+sh "$scanner" "$scratch/clean.exe"
+printf 'MZ\0netDelayMs\0' > "$scratch/delay.exe"
+printf 'MZ\0netJitterMs\0' > "$scratch/jitter.exe"
+printf 'MZ\0AGENT TEST net delay\0' > "$scratch/net.exe"
+printf 'MZ\0AGENT TEST: net delay\0' > "$scratch/refusal.exe"
+for marker in file pad padgamepad padlog keys key delay jitter net refusal; do
+  if sh "$scanner" "$scratch/$marker.exe"; then
+    echo "agent_test_hook_absent_test: missed $marker marker" >&2
+    exit 1
+  fi
+done
+# Linux ELF names use the same scan, including a dirty second artifact. No PE header required.
+for dirty in melee_source melee_linux; do
+  for marker in 'agent-test.json' 'padBack' 'netDelayMs' 'netJitterMs' \
+    'agent-test: key escape' 'agent-test: script' 'agent-test: captureEvery not supported on Linux; ignored' \
+    'padTrace' 'agent-test: padTrace output capability refused; ignored' 'port %d src %s buttons %04X stick %d,%d' \
+    'present_log' 'present_frames' 'present-log v1' 'agent-test: present output'; do
+    printf '\177ELF\0clean\0' > "$scratch/melee_source"
+    printf '\177ELF\0clean\0' > "$scratch/melee_linux"
+    sh "$scanner" "$scratch/melee_source" "$scratch/melee_linux"
+    printf '\177ELF\0%s\0' "$marker" > "$scratch/$dirty"
+    if sh "$scanner" "$scratch/melee_source" "$scratch/melee_linux"; then
+      echo "agent_test_hook_absent_test: missed $marker in $dirty" >&2
+      exit 1
+    fi
+  done
+done
diff --git a/port/tests/agent_test_static_absent_test.sh b/port/tests/agent_test_static_absent_test.sh
new file mode 100644
index 0000000..3952ead
--- /dev/null
+++ b/port/tests/agent_test_static_absent_test.sh
@@ -0,0 +1,25 @@
+#!/bin/sh
+# Checking either named executable must reject a hook in the other engine too.
+set -eu
+scanner=${1:?usage: agent_test_static_absent_test.sh <scanner>}
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT HUP INT TERM
+for entry in melee_source.exe melee_port.exe; do
+  for dirty in melee_source.exe melee_port.exe; do
+    for marker in 'agent-test.json' 'agent test: padBack'; do
+      printf 'MZ\0clean\0' > "$scratch/melee_source.exe"
+      printf 'MZ\0clean\0' > "$scratch/melee_port.exe"
+      sh "$scanner" "$scratch/$entry"
+      printf 'MZ\0%s\0' "$marker" > "$scratch/$dirty"
+      if sh "$scanner" "$scratch/$entry"; then
+        echo "missed $marker in $dirty when checking $entry" >&2
+        exit 1
+      fi
+    done
+  done
+done
+rm "$scratch/melee_source.exe"
+if sh "$scanner" "$scratch/melee_port.exe"; then
+  echo 'missing sibling was accepted' >&2
+  exit 1
+fi
