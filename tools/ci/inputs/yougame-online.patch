+ENetSocket enet_socket_create(ENetSocketType t) { return yg_enet_selected() ? (t==ENET_SOCKET_TYPE_DATAGRAM?yg_enet_create():ENET_SOCKET_NULL) : yg_native_socket_create(t); }
