index 0000000..34e4e12
--- /dev/null
+++ b/port/tests/yougame_exit_reason_test.cpp
@@ -0,0 +1,131 @@
+// Window-free compatibility policy and overlay refusal checks; no game or real disc required.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_exit_reason.h"
+#include "source_mod_overlay.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+int main() {
+  using namespace yougame::mode_policy;
+  using namespace source_port::mods;
+  // All refusal categories need all three launch gates. None includes ordinary file/disc errors.
+  for (auto refusal : {ModRefusal::None, ModRefusal::UnsupportedMod, ModRefusal::UnsupportedVersion,
+                       ModRefusal::ModdedDol, ModRefusal::NativeFighters}) {
+    for (bool active : {false, true}) for (bool stdio : {false, true}) for (bool explicit_layer : {false, true}) {
+      const auto request = mod_exit_request(active, stdio, explicit_layer, refusal);
+      CHECK(request.is_object() == (active && stdio && explicit_layer && refusal != ModRefusal::None));
+      if (!request.is_null()) {
+        CHECK(request.size() == 2);
+        CHECK(request.at("type") == "exitReason" && request.at("reason") == "mod_outdated");
+        CHECK(!request.count("mod") && !request.count("modVersion"));
+      }
+    }
+  }
+  // Every scanner kind: a supported Source/Either mod passes; another engine or unknown version
+  // is a compatibility refusal. Bad, missing, wrong-region and retail discs never become updates.
+  for (auto kind : {Kind::Te, Kind::TmCe, Kind::Vanilla, Kind::AssetMod, Kind::Mex, Kind::HackPack,
+                    Kind::CodeMod, Kind::CardMod, Kind::Unsupported}) {
+    for (auto support : {Support::Supported, Support::Untested, Support::NotSupportedYet}) {
+      for (auto engine : {Engine::Source, Engine::Recomp, Engine::Either}) {
+        Detected mod;
+        mod.kind = kind; mod.status = support; mod.needs = engine;
+        const bool is_mod = kind != Kind::Unsupported && kind != Kind::Vanilla;
+        CHECK((mod_refusal(mod) != ModRefusal::None) ==
+              (is_mod && (support != Support::Supported || engine == Engine::Recomp)));
+      }
+    }
+  }
+  Detected te;
+  te.kind = Kind::Te; te.name = "20XX TE"; te.version = "v2d r3";
+  CHECK(mod_refusal(te) == ModRefusal::UnsupportedVersion);
+  Detected tmce;
+  tmce.kind = Kind::TmCe; tmce.name = "Training Mode CE"; tmce.version = "v1.3";
+  CHECK(mod_refusal(tmce) == ModRefusal::UnsupportedVersion);
+  Detected maker;
+  maker.kind = Kind::CodeMod; maker.name = "Melee Maker"; maker.version = "1.3.7";
+  maker.status = Support::Supported; maker.needs = Engine::Recomp;
+  CHECK(mod_refusal(maker) == ModRefusal::UnsupportedMod);
+  auto request = mod_exit_request(true, true, true, mod_refusal(te), te.name, te.version);
+  CHECK(request.at("mod") == "20XX TE" && request.at("modVersion") == "v2d r3");
+  CHECK(nlohmann::json::parse(request.dump()) == request);
+  request = mod_exit_request(true, true, true, ModRefusal::NativeFighters, "ACE");
+  CHECK(request.at("mod") == "ACE" && !request.count("modVersion"));
+  request = mod_exit_request(true, true, true, ModRefusal::ModdedDol, "", "1.0");
+  CHECK(!request.count("mod") && request.at("modVersion") == "1.0");
+
+  CHECK(exit_reason_field(std::string(60, 'a')) == std::string(60, 'a'));
+  CHECK(exit_reason_field(std::string(61, 'a')) == std::string(60, 'a'));
+  CHECK(exit_reason_field(std::string(500, 'a')).size() == 60);
+  CHECK(exit_reason_field("  Akaneia  ") == "Akaneia");
+  CHECK(exit_reason_field(" \n\t\r\x7f\x80\xff ").empty());
+  // Exercise all byte values, including embedded NUL, DEL and UTF-8/non-ASCII bytes.
+  for (unsigned c = 0; c <= 255; ++c) {
+    const std::string value = std::string("A") + char(c) + "B";
+    CHECK(exit_reason_field(value) == (c >= 32 && c <= 126 ? value : "AB"));
+  }
+  for (const auto* link : {"https://bad", "www.bad", "WWW.bad", "w\nw\tw.bad", "x:\r//bad"}) {
+    request = mod_exit_request(true, true, true, ModRefusal::UnsupportedMod, link, link);
+    CHECK(!request.count("mod") && !request.count("modVersion"));
+  }
+  CHECK(exit_reason_field(std::string(60, 'a') + "www.bad").empty());
+  request = mod_exit_request(true, true, true, ModRefusal::UnsupportedMod, "A\"B\\C", "v1\nv2");
+  CHECK(nlohmann::json::parse(request.dump()).at("mod") == "A\"B\\C");
+  CHECK(request.at("modVersion") == "v1v2");
+
+  // Real importer calls distinguish native-fighter availability from I/O failures, for both
+  // explicit directories and ISOs (including profile layers). No matching on human error prose.
+  namespace fs = std::filesystem;
+  using Overlay = source_port::ModOverlay;
+  const auto root = fs::temp_directory_path() /
+      ("mu-exit-reason-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+  CHECK(fs::create_directory(root));
+  for (const char* name : {"mxdt.dat", "plsn.dat", "plts.dat"}) {
+    std::ofstream file(root / name, std::ios::binary); file << 'x';
+  }
+  Overlay overlay;
+  std::string error;
+  source_port::allow_native_akaneia(false);
+  CHECK(!overlay.add_directory(root, "explicit", error));
+  CHECK(overlay.native_fighters_refused());
+  CHECK(!overlay.add_directory(root / "missing", "missing", error));
+  CHECK(!overlay.native_fighters_refused());
+  source_port::allow_native_akaneia(true);
+  CHECK(overlay.add_directory(root, "supported", error));
+  CHECK(!overlay.native_fighters_refused());
+
+  std::vector<unsigned char> image(0x800);
+  const unsigned char disc_id[8] = {'G', 'A', 'L', 'E', '0', '1', 0, 2};
+  std::memcpy(image.data(), disc_id, sizeof disc_id);
+  const auto put32 = [&](size_t at, unsigned value) {
+    for (int i = 3; i >= 0; --i) { image[at + i] = (unsigned char)value; value >>= 8; }
+  };
+  put32(0x424, 0x500); put32(0x428, 75);
+  image[0x500] = 1; put32(0x508, 4);
+  for (unsigned i = 0; i < 3; ++i) {
+    put32(0x50c + i * 12, i * 9);
+    put32(0x510 + i * 12, 0x600 + i);
+    put32(0x514 + i * 12, 1);
+  }
+  std::memcpy(image.data() + 0x530, "mxdt.dat\0plsn.dat\0plts.dat", 27);
+  const auto iso = root / "test.iso";
+  { std::ofstream file(iso, std::ios::binary); file.write((const char*)image.data(), image.size()); }
+  const auto lookup = [](const std::string&, Overlay::DiscFile*) { return false; };
+  const auto read = [](uint32_t, void*, uint32_t) { return false; };
+  Overlay iso_overlay;
+  source_port::allow_native_akaneia(false);
+  CHECK(!iso_overlay.add_iso(iso, "explicit", lookup, read, error));
+  CHECK(iso_overlay.native_fighters_refused());
+  CHECK(!iso_overlay.add_iso(root / "missing.iso", "missing", lookup, read, error));
+  CHECK(!iso_overlay.native_fighters_refused());
+  source_port::allow_native_akaneia(true);
+  CHECK(iso_overlay.add_iso(iso, "supported", lookup, read, error));
+  CHECK(!iso_overlay.native_fighters_refused());
+  source_port::allow_native_akaneia(false);
+  fs::remove_all(root);
+  std::puts("yougame_exit_reason: policy, sanitized fields and typed overlay refusals ok");
+}
diff --git a/port/tests/yougame_friends_test.cpp b/port/tests/yougame_friends_test.cpp
new file mode 100644
index 0000000..08b8dbe
--- /dev/null
+++ b/port/tests/yougame_friends_test.cpp
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_friends.h"
+#include "yougame_parity.h"
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <regex>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+int main() {
+  using namespace yougame::friends;
+  const json expected = {
+    {"type", "mpTicket"}, {"players", 2}, {"mode", "singles"},
+    {"ranked", false}, {"room", "abcd2345"},
+    {"lobby", {{"version", 1}, {"minPlayers", 2}, {"maxLocalPlayers", 1}, {"compatibility", "mu-build"}}}
+  };
+  CHECK(ticket("mu-build", "abcd2345") == expected);
+  CHECK(!ticket("mu-build", "abcd2345").count("queue"));
+  CHECK(!ticket("mu-build", "abcd2345").count("direct"));
+  CHECK(!ticket("mu-build", "abcd2345").count("afterMatch"));
+  CHECK(picker() == json({{"type", "mpFriend"}, {"mode", "singles"}, {"players", 2}}));
+  CHECK(!picker().count("username"));
+  CHECK(version_request(picker()));
+  CHECK(version_request(expected));
+  for (const auto& ordinary : {
+      json{{"type", "mpTicket"}, {"mode", "singles"}, {"players", 2}, {"ranked", false}},
+      json{{"type", "mpTicket"}, {"mode", "singles"}, {"players", 2}, {"ranked", true}},
+      json{{"type", "mpTicket"}, {"mode", "singles"}, {"players", 2}, {"direct", "ABC#1"}},
+      team_ticket("mu-build", "mutabc123"), json{{"type", "mpRank"}}})
+    CHECK(!version_request(ordinary));
+  CHECK(expire_joined(kJoined, 100, 100) == kJoined);
+  CHECK(expire_joined(kJoined, 100, 10099) == kJoined);
+  CHECK(expire_joined(kJoined, 100, 10100).empty());
+  CHECK(expire_joined(kJoined, 100, 50000).empty());
+  for (const char* status : {kWaiting, kFailed, kVersion, "offline", "playing opponent"})
+    CHECK(expire_joined(status, 100, 50000) == status);
+  CHECK(kPickerTimeout == 600000);
+  {
+    std::string code;
+    // What the game's field holds for LAIN#504: ASCII with the full-width # (0x81 0x94).
+    CHECK(direct_code_from_game(std::string("LAIN\x81\x94" "504\0\0\0", 10), &code) && code == "LAIN#504");
+    // Full-width letters, digits, # and spaces from the on-screen keyboard; lower case folds up.
+    CHECK(direct_code_from_game("\x82\x6B\x82\x60\x82\x68\x82\x6D\x81\x94\x82\x54\x82\x4F\x82\x53", &code) && code == "LAIN#504");
+    CHECK(direct_code_from_game("lain\x81\x40#504", &code) && code == "LAIN#504");
+    CHECK(direct_code_from_game("\x82\x81\x82\x9A#1", &code) && code == "AZ#1");
+    CHECK(direct_code_from_game("", &code) && code.empty());
+    // The raw field is what broke the request; the folded code serializes.
+    bool threw = false;
+    try { (void)json({{"direct", std::string("ABC\x81\x94" "1")}}).dump(); } catch (const json::type_error&) { threw = true; }
+    CHECK(threw);
+    CHECK(direct_code_from_game("ABC\x81\x94" "1", &code) && json({{"direct", code}}).dump() == "{\"direct\":\"ABC#1\"}");
+    // Other Shift-JIS (hiragana), a cut-off pair, or punctuation: refused, never sent.
+    code = "keep";
+    CHECK(!direct_code_from_game("\x82\xA0#1", &code) && code == "keep");
+    CHECK(!direct_code_from_game("ABC\x81", &code));
+    CHECK(!direct_code_from_game("AB-C#1", &code));
+  }
+#if defined(_WIN32) || defined(__linux__)
+  CHECK(std::string(yougame::parity::kCaps) == "yg {\"caps\":[\"ready\",\"overlay\",\"join\",\"notice\",\"pads\",\"rumble\",\"view\",\"volume\"]}");
+#else
+  CHECK(std::string(yougame::parity::kCaps) == "yg {\"caps\":[\"ready\",\"overlay\",\"join\",\"notice\",\"pads\",\"rumble\"]}");
+#endif
+
+  for (int mode : {0, 1, 2, 3, 4}) {
+    std::string code = "stale";
+    CHECK(search_code(mode, "lain#504", &code) && code == "LAIN#504");
+    CHECK(search_code(mode, "", &code) && code.empty());
+    code = "stale";
+    const bool expected = mode != 2 && mode != 3;
+    CHECK(search_code(mode, "\x83\x65", &code) == expected);
+    if (expected) CHECK(code.empty());
+    CHECK(search_code(mode, "AB-C#1", &code) == expected);
+    if (expected) CHECK(code.empty());
+  }
+
+  {
+    std::string code, room;
+    CHECK(team_room_code("LAIN#504", &room) && room == "mutlain504");
+    CHECK(search_code(3, "\x82\x6B\x82\x60\x82\x68\x82\x6D\x81\x94\x82\x54\x82\x4F\x82\x53", &code));
+    CHECK(team_room_code(code, &room) && room == "mutlain504");
+    const json expected_team = {
+      {"type", "mpTicket"}, {"players", 4}, {"mode", "teams"}, {"room", room}, {"ranked", false},
+      {"lobby", {{"version", 1}, {"minPlayers", 4}, {"maxLocalPlayers", 1}, {"compatibility", "mu-build"}}}
+    };
+    CHECK(team_ticket("mu-build", room) == expected_team);
+    for (const char* bad : {"", "AB", "ABCDEFGHIJ", "ABC-123", "ABC/123", "ABC 123", "###"})
+      CHECK(!team_room_code(bad, &room));
+    for (int length = 3; length <= 9; ++length) {
+      for (char c : std::string("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")) {
+        CHECK(team_room_code(std::string(length, c) + "#", &room));
+        CHECK(std::regex_match(room, std::regex("^[a-z0-9]{6,12}$")));
+        CHECK(team_ticket("mu-build", room).at("room") == room);
+      }
+    }
+    for (const char* bad : {"", "mutab", "mutabcdefghij", "mutABC123", "mutabc/12", "xxxabc123"}) {
+      try { team_ticket("mu-build", bad); CHECK(false); }
+      catch (const std::runtime_error& e) { CHECK(std::string(e.what()) == kTeamCodeError); }
+    }
+    CHECK(std::string(kTeamWaiting) == "Waiting for your team...");
+  }
+
+  // Exercise the same picker -> ticket path used by matchmaking, with no room opened
+  // by a failed picker and no ticket ever sent with an empty room.
+  std::vector<json> messages;
+  std::vector<int> timeouts;
+  json request;
+  Events own;
+  const auto send = [&](const json& q, int timeout) -> json {
+    messages.push_back(q); timeouts.push_back(timeout);
+    if (q.at("type") == "mpFriend") return {{"code", "Ab12"}, {"url", "unused"}, {"to", "Friend"}};
+    CHECK(q.at("type") == "mpTicket");
+    CHECK(q.at("room") == "Ab12");
+    CHECK(!q.count("queue"));
+    // The page changing to our own room while the ticket is pending is a no-op.
+    CHECK(!own.push({{"type", "join"}, {"room", "Ab12"}}, 1));
+    return {{"room", "Ab12"}};
+  };
+  CHECK(request_ticket("mu-build", "", request, send, [] { return false; },
+                       [&](const std::string& code) { own.current_room(code); }) == json({{"room", "Ab12"}}));
+  CHECK(messages.size() == 2);
+  CHECK(messages[0] == picker());
+  CHECK(messages[1] == ticket("mu-build", "Ab12"));
+  CHECK(timeouts == std::vector<int>({600000, 30000}));
+  CHECK(own.take_join(true).empty());
+  messages.clear(); timeouts.clear();
+  request_ticket("mu-build", "Ab12", request, send, [] { return false; },
+                 [&](const std::string& code) { own.current_room(code); });
+  CHECK(messages.size() == 1 && messages[0] == ticket("mu-build", "Ab12")); // invitee: no picker
+  CHECK(timeouts == std::vector<int>({30000}));
+  CHECK(own.push({{"type", "join"}, {"room", "ab12"}}, 2)); // case-sensitive
+  CHECK(own.take_join(true) == "ab12");
+  CHECK(own.push({{"type", "join"}, {"room", "OtherRoom"}}, 3));
+  CHECK(!own.push({{"type", "join"}, {"room", "Ab12"}}, 4));
+  CHECK(own.take_join(false).empty());
+  CHECK(own.take_join(true) == "OtherRoom"); // own push cannot displace a different invite
+  own.current_room({}); // cleanup permits joining that room again
+  CHECK(own.push({{"type", "join"}, {"room", "Ab12"}}, 5));
+  own.current_room("Ab12"); // discard an own-room push queued just before ticket request
+  CHECK(own.take_join(true).empty());
+  own.hello({{"room", "Ab12"}});
+  CHECK(own.take_join(true).empty());
+
+  for (const auto& code : {"Ab12", "abcdefgh", "AbCd0123456789xy"})
+    CHECK(picker_room({{"code", code}}) == code);
+  for (const auto& bad : {json(), json::array(), json(1), json("abcd"), json{{"room", "abcdefgh"}},
+       json{{"code", ""}}, json{{"code", "abc"}}, json{{"code", std::string(17, 'a')}},
+       json{{"code", 42}}, json{{"code", "abcd/efg"}}, json{{"code", "abc\n2345"}},
+       json{{"code", "abcd efgh"}}, json{{"code", "éabc"}}}) {
+    CHECK(picker_room(bad).empty());
+    int sent = 0, started = 0;
+    try {
+      request_ticket("mu-build", "", request,
+          [&](const json& q, int ms) { CHECK(q == picker()); CHECK(ms == 600000); ++sent; return bad; },
+          [] { return false; }, [&](const std::string&) { ++started; });
+      CHECK(false);
+    } catch (const std::runtime_error&) {}
+    CHECK(sent == 1 && started == 0);
+  }
+  for (const auto& code : {"", "abc", "abcd/efg", "abcdefghijklmnopq"}) {
+    try { ticket("mu-build", code); CHECK(false); } catch (const std::runtime_error&) {}
+  }
+  for (bool page_error : {false, true}) {
+    int sent = 0;
+    bool cancelled = false;
+    try {
+      request_ticket("mu-build", "", request,
+          [&](const json& q, int) -> json {
+            CHECK(q == picker()); ++sent;
+            if (page_error) throw std::runtime_error("Picker cancelled");
+            cancelled = true; return {{"code", "abcd2345"}};
+          }, [&] { return cancelled; }, [&](const std::string&) { CHECK(false); });
+      CHECK(false);
+    } catch (const std::runtime_error&) {}
+    CHECK(sent == 1);
+  }
+
+  CHECK(kFirstCssWinner == 1);
+  CHECK(!native_ready(true, 2, "", ""));
+  CHECK(!native_ready(true, 2, "", "abcd2345"));
+  CHECK(native_ready(false, 2, "", ""));
+  CHECK(native_ready(true, 2, "NAME#123", ""));
+  for (int mode : {0, 1, 3}) CHECK(native_ready(true, mode, "", ""));
+  CHECK(empty_code(true, 2, ""));
+  CHECK(!empty_code(false, 2, ""));
+  CHECK(!empty_code(true, 2, "NAME#123"));
+  for (int mode : {0, 1, 3, 4, -1}) CHECK(!empty_code(true, mode, ""));
+  CHECK(menu_safe(1, 0));
+  CHECK(menu_safe(8, 0));
+  CHECK(menu_safe(8, 1));
+  CHECK(menu_safe(8, 3));
+  for (int minor : {2, 4}) CHECK(!menu_safe(8, minor));
+  for (int major : {0, 2, 3, 0x1C, 0x2B}) CHECK(!menu_safe(major, 2));
+
+  Events launch;
+  launch.hello({{"room", "abcd2345"}});
+  CHECK(launch.take_join(false).empty()); // local match: leave it pending
+  CHECK(launch.take_join(true) == "abcd2345");
+  CHECK(launch.take_join(true).empty());
+  launch.hello({{"room", "abcd2345"}}); // identity refresh must not replay the invite
+  CHECK(launch.take_join(true).empty());
+  Events absent;
+  absent.hello(json::object());
+  CHECK(absent.take_join(true).empty());
+  absent.hello({{"room", "abcd2345"}});
+  CHECK(absent.take_join(true).empty());
+
+  const json join = {{"type", "join"}, {"room", "abcd2345"}};
+  const json notice = {{"type", "notice"}, {"kind", "invite"}, {"from", "A Friend"}, {"text", "Play with me"}};
+  Events running;
+  CHECK(running.push(join, 100));
+  running.hello({{"room", "zzzz2345"}}); // a late hello cannot supersede a running-game push
+  CHECK(running.take_join(true) == "abcd2345");
+  CHECK(running.take_join(true).empty());
+  CHECK(running.push(join, 100));
+  CHECK(running.push({{"type", "join"}, {"room", "efgh6789"}}, 101));
+  CHECK(running.take_join(false).empty());
+  CHECK(running.take_join(true) == "efgh6789"); // latest accepted invite wins
+  CHECK(running.push(notice, 100));
+  CHECK(running.toast(100) == "A Friend Play with me");
+  CHECK(!running.toast(6099).empty());
+  CHECK(running.toast(6100).empty());
+  CHECK(running.take_join(true).empty()); // notices never accept invites
+
+  for (const auto& bad : {json(), json::array(), json(1), json("join"),
+       json{{"type", 42}}, json{{"type", "join"}}, json{{"type", "join"}, {"room", 42}},
+       json{{"type", "join"}, {"room", "abc"}},
+       json{{"type", "join"}, {"room", std::string(10000, 'a')}},
+       json{{"type", "join"}, {"room", "abc\n2345"}},
+       json{{"type", "join"}, {"room", "abc/2345"}}}) {
+    Events e;
+    CHECK(!e.push(bad, 100));
+    e.hello(bad);
+    CHECK(e.take_join(true).empty());
+    CHECK(e.toast(100).empty());
+  }
+  for (const char* field : {"type", "kind", "from", "text"}) {
+    for (const json& bad : {json(), json(1), json::array(), json::object(), json(true), json("")}) {
+      auto n = notice; n[field] = bad;
+      CHECK(!running.push(n, 200));
+    }
+    auto n = notice; n.erase(field);
+    CHECK(!running.push(n, 200));
+  }
+  for (const char* field : {"from", "text"}) {
+    auto n = notice; n[field] = std::string(10000, 'x');
+    CHECK(!running.push(n, 200));
+    n[field] = "bad\nline";
+    CHECK(!running.push(n, 200));
+  }
+  CHECK(running.toast(200) == "A Friend Play with me");
+
+  const auto repeated = [](const std::string& cp, int count) {
+    std::string s; while (count-- > 0) s += cp; return s;
+  };
+  Events unicode;
+  auto localized = notice;
+  localized["from"] = repeated("界", 40);
+  localized["text"] = "invited you to play. Shift+Tab to join";
+  CHECK(unicode.push(localized, 1));
+  CHECK(unicode.toast(1) == repeated("界", 40) + " invited you to play. Shift+Tab to join");
+  localized["from"] = repeated("界", 41);
+  CHECK(!unicode.push(localized, 2));
+  for (const auto& cp : {"é", "界", "😀"}) {
+    localized["from"] = repeated(cp, 40);
+    localized["text"] = repeated(cp, 80);
+    CHECK(unicode.push(localized, 3));
+    CHECK(unicode.toast(3) == repeated(cp, 40) + " " + repeated(cp, 80));
+    localized["text"] = repeated(cp, 81);
+    CHECK(!unicode.push(localized, 4));
+  }
+  for (const auto& bad : {std::string("bad\tname"), std::string("bad\x7f"), std::string("bad\xc2\x85"),
+       std::string("\xc0\xaf"), std::string("\xed\xa0\x80"), std::string("\xf4\x90\x80\x80"),
+       std::string("\xe7\x95"), std::string("\x80")}) {
+    for (const char* field : {"from", "text"}) {
+      auto n = notice; n[field] = bad;
+      CHECK(!unicode.push(n, 5));
+    }
+  }
+  Events presentation;
+  presentation.code_screen(true);
+  presentation.code_empty(true);
+  CHECK(!presentation.push({{"type", "hide"}}, 1));
+  CHECK(presentation.code_screen()); // embed hide/show never changes Friends state
+  presentation.picker_error("Picker cancelled");
+  CHECK(presentation.picker_error() == "Picker cancelled");
+  presentation.request_host();
+  CHECK(presentation.picker_error().empty());
+
+  Events host;
+  host.request_host();
+  CHECK(!host.take_host());
+  host.code_screen(true);
+  host.code_empty(false);
+  host.request_host();
+  CHECK(!host.take_host());
+  host.code_empty(true);
+  host.request_host();
+  CHECK(host.take_host());
+  CHECK(!host.take_host());
+  host.request_host();
+  host.code_screen(false); // Back/cancel must not host a room later
+  CHECK(!host.take_host());
+  std::puts("YouGame friends passed");
+}
diff --git a/port/tests/yougame_memcard_static_test.cpp b/port/tests/yougame_memcard_static_test.cpp
new file mode 100644
index 0000000..c2ba6a4
--- /dev/null
+++ b/port/tests/yougame_memcard_static_test.cpp
@@ -0,0 +1,80 @@
+// Exercise the actual host adapter without a disc, renderer or PPC runtime.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "host.h"
+#include "yougame_memcard.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+namespace {
+bool active = false;
+std::array<uint8_t, 0x20> data{};
+std::map<uint32_t, ppc::Fn> dispatch;
+std::vector<uint32_t> interpreted;
+unsigned inputs = 0, messages = 0;
+constexpr uint32_t base = 0x80480DA8, input_addr = 0x801AEDC8, message_addr = 0x801AEE6C;
+void original_input(ppc::Context& c, uint8_t*) { ++inputs; c.r[3] = 0x80002; }
+void original_message(ppc::Context&, uint8_t*) { ++messages; }
+void set_decision(unsigned decision) { data[0x17] = decision; }
+}
+namespace yougame { bool active() { return ::active; } }
+namespace ppc {
+Fn lookup(uint32_t addr) { const auto it = dispatch.find(addr); return it == dispatch.end() ? nullptr : it->second; }
+Fn set_hook(uint32_t addr, Fn fn) { Fn old = lookup(addr); dispatch[addr] = fn; return old; }
+bool redirect_to_interpreter(uint32_t addr) { interpreted.push_back(addr); return true; }
+}
+namespace host {
+uint8_t rd8(uint32_t addr) { CHECK(addr >= base && addr - base < data.size()); return data[addr - base]; }
+uint32_t rd32(uint32_t addr) {
+  return (uint32_t(rd8(addr)) << 24) | (uint32_t(rd8(addr + 1)) << 16) |
+         (uint32_t(rd8(addr + 2)) << 8) | rd8(addr + 3);
+}
+void wr8(uint32_t addr, uint8_t v) { CHECK(addr == base + 0x1C); data[addr - base] = v; }
+void log(const char*, ...) {}
+}
+
+int main() {
+  using yougame::memcard::install_static_boot;
+  install_static_boot();
+  CHECK(dispatch.empty() && interpreted.empty()); // Standalone installs nothing.
+  active = true;
+  install_static_boot();
+  CHECK(dispatch.empty() && interpreted.empty()); // Missing symbols leave the menu alone.
+  dispatch[input_addr] = original_input;
+  dispatch[message_addr] = original_message;
+  install_static_boot();
+  CHECK(interpreted == (std::vector<uint32_t>{0x801AF568, 0x801AF0D4, 0x801AF250}));
+  install_static_boot();
+  CHECK(interpreted.size() == 3); // One installation.
+
+  ppc::Context c;
+  for (unsigned enabled = 0; enabled != 2; ++enabled) {
+    active = enabled;
+    for (unsigned chan = 0; chan != 2; ++chan) {
+      data[4] = chan;
+      for (unsigned decision = 0; decision != 21; ++decision) {
+        set_decision(decision);
+        for (uint32_t lr : {0x801AF100u, 0x801AF900u, 0x801B0264u, 0x80200000u}) {
+          data[0x1C] = 1; // A held physical direction must not choose No.
+          c.lr = lr;
+          const unsigned before = inputs;
+          dispatch[input_addr](c, nullptr);
+          const bool answer = enabled && chan == 0 && (decision == 5 || decision == 7) && lr < 0x801B0264;
+          CHECK(c.r[3] == (answer ? 0x100u : 0x80002u));
+          CHECK(inputs == before + (answer ? 0 : 1));
+          CHECK(data[0x1C] == (answer ? 0 : 1));
+        }
+      }
+      for (unsigned msg = 0; msg != 25; ++msg) {
+        c.r[4] = msg;
+        const unsigned before = messages;
+        dispatch[message_addr](c, nullptr);
+        CHECK(messages == before + ((enabled && chan == 0 && (msg == 10 || msg == 12)) ? 0 : 1));
+      }
+    }
+  }
+  std::puts("YouGame Static Recomp memory-card adapter passed");
+}
