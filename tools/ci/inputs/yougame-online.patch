+// YouGame Ranked: one best-of-3 set per room, and the player's rank. Kept independent of WinHTTP
+// for deterministic socket tests (port/tests/yougame_ranked_test.cpp).
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <nlohmann/json.hpp>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace yougame::ranked {
+using json = nlohmann::json;
+
+// A string field, or "" when it is missing or not a string (json::value throws on a wrong type).
+inline std::string str(const json& m, const char* key) {
+  if (!m.is_object()) return {};
+  const auto it = m.find(key);
+  return it != m.end() && it->is_string() ? it->get<std::string>() : std::string();
+}
+
+inline std::string ticket_error(const json& answer) {
+  const std::string code = str(answer, "code"), error = str(answer, "error");
+  if (code == "ranked_signed_out") return "Sign in to YouGame to play Ranked.";
+  if (code == "ranked_off") return "Ranked is off for this game.";
+  return error.empty() ? "YouGame request failed" : error;
+}
+
+// Ranked v1 plays Melee Unlocked's Unranked screens (character select, a random legal stage each
+// game) and is rated on YouGame's ladder as one best-of-3 set per room. The game sends no set
+// result in that flow (there is no GameSetup scene, so no C2): the set is decided here, from the
+// games the room settled, which both players receive alike.
+constexpr int kSetWins = 2;
+// Draws and games the room voids do not count. A set still undecided after this many settled
+// games is void (it cannot produce a winner); it only bounds the reports.
+constexpr int kMaxGames = 9;
+// How many times (every kRetryMs) the host asks the room to start the set's match.
+constexpr int kBeginTries = 15;
+constexpr uint64_t kRetryMs = 2000;
+// A set whose room has not started its match this long after its first game began cannot be
+// recorded: the pair breaks up instead of playing unrated games under Ranked.
+constexpr uint64_t kStartWaitMs = kBeginTries * kRetryMs + 5000;
+
+// One game's winner (0-based port, -1 for none) from the game's own end record. `end_method` is
+// Slippi's Game End method: 1 TIME!, 2 GAME!, 7 a No Contest. Ranked has no LRA-Start (the game
+// installs no pause in mode 0), so a No Contest there is the online code ending the game for a
+// disconnect or a desync, naming the other player as `lras`; either way the player it names
+// quit: they lose the game, and the set (Game::forfeit). `placements` are the record's four
+// placement bytes (0 first, 0xFF no player); without them `reported` (Slippi's winnerIdx) is used.
+inline int game_winner(int end_method, int lras, int reported, const int* placements) {
+  if (end_method == 7) return lras == 0 || lras == 1 ? 1 - lras : -1;
+  if (placements && (end_method == 1 || end_method == 2)) {
+    int winner = -1;
+    for (int port = 0; port < 4; ++port) {
+      if (placements[port] != 0) continue;
+      if (port > 1 || winner >= 0) return -1;   // a tie, or a placement outside the duel
+      winner = port;
+    }
+    return winner;
+  }
+  return reported == 0 || reported == 1 ? reported : -1;
+}
+
+// Casual/Direct duels use the same placements, but a No Contest never awards a winner.
+// Multiplayer uses team_winner below; this single-port result remains duel-only.
+inline int casual_winner(int end_method, int lras, int reported, const int* placements, int players) {
+  if (players != 2 || end_method == 7) return -1;
+  return game_winner(end_method, lras, reported, placements);
+}
+
+// A duel's TIME! is Slippi's to decide (SinglesDetermineWinner: the ledge grab limit, then stocks,
+// then damage; an exact tie has no winner), and only the game's report carries that: winnerIdx,
+// sent once the game can no longer roll back (slippi_online.cpp handle_report_game). The Game End
+// record ranks a time-out the way Melee's results screen does (stocks, kills, falls, then port),
+// and the Source Port sends it before the last frames are confirmed: on 10-28 two tied ranked
+// time-outs (4 stocks and 0% each) went to port 1 from the record while the report said no winner.
+// So a duel's TIME! from the record (`from_record`: it has placements) waits for the report.
+// Teams has no report (ReportGameQuery has no teams result) and keeps the record.
+inline bool time_out_waits_for_report(int end_method, bool from_record, int players) {
+  return end_method == 1 && from_record && players == 2;
+}
+
+// Teams v1 requires exactly two known players per team. An absent/invalid seat cannot win.
+inline bool valid_teams(const int* teams) {
+  if (!teams) return false;
+  int count[2] = {};
+  for (int port = 0; port < 4; ++port) {
+    if (teams[port] != 0 && teams[port] != 1) return false;
+    ++count[teams[port]];
+  }
+  return count[0] == 2 && count[1] == 2;
+}
+
+// Game End placements are 0-based (0 first, 0xFF absent). Winners may share first place
+// within one team, or a surviving player may win after their teammate was eliminated.
+// Only TIME/GAME with first place belonging exclusively to one team is conclusive. LRAS
+// never awards a casual win; a No Contest, missing placements or a cross-team tie is void.
+inline int team_winner(int end_method, int lras, const int* placements, const int* teams) {
+  if ((end_method != 1 && end_method != 2) || lras != -1 || !placements || !valid_teams(teams)) return -1;
+  int winner = -1;
+  for (int port = 0; port < 4; ++port) {
+    if (placements[port] < 0 || placements[port] > 3) return -1;
+    if (placements[port] != 0) continue;
+    if (winner >= 0 && winner != teams[port]) return -1;
+    winner = teams[port];
+  }
+  return winner;
+}
+
+// A game report's `detail`: what the room stores beside the outcome and never compares. The room
+// takes at most 8 keys of 1-4 lowercase letters, each an integer in [-1, 2^31) or up to four of
+// them (rooms/src/game-lobby.ts cleanDetail); anything outside that is sent as -1.
+inline json game_detail(int end_method, int lras, int stage, const int characters[2], int64_t frames) {
+  const auto fit = [](int64_t v) -> int64_t { return v >= -1 && v < (int64_t(1) << 31) ? v : -1; };
+  json detail = {{"end", fit(end_method)}, {"lras", fit(lras)}};
+  if (stage >= 0) detail["stg"] = fit(stage);
+  if (characters) detail["char"] = {fit(characters[0]), fit(characters[1])};
+  if (frames >= 0) detail["frm"] = fit(frames);
+  return detail;
+}
+
+// A game's report id from what both players' games negotiated for it (the match's rng offset and
+// stage), so a game one side failed to count cannot shift every later id. "" when unknown.
+inline std::string game_key(int64_t rng_offset, int stage) {
+  if (rng_offset < 0 || rng_offset > 0xFFFFFFFFll || stage < 0 || stage > 0xFFFF) return {};
+  char key[32];
+  std::snprintf(key, sizeof key, "r%llx-s%d", (unsigned long long)rng_offset, stage);
+  return key;
+}
+
+struct Game {
+  std::string key;          // game_key(); without one the id is "g<index>-t<tiebreak>"
+  uint32_t index = 0, tiebreak = 0;
+  int winner = -1;        // 0-based port; -1 a draw or a game with no winner (reported void)
+  bool forfeit = false;   // the loser quit (a No Contest naming them): the set goes to the winner
+  json detail = json::object();
+};
+
+// One ranked room's set, as one client sees it. The rooms Worker (game-lobby.ts) settles a duel's
+// game only when both players report the same outcome, and its final only when both send the
+// same `finish`, or by its leave rule: once a player has been gone for its reconnect allowance
+// (15 s), the player still there gets the set, unless a pending report is void or names someone
+// else. So:
+// - the set's winner is the first to kSetWins games the room settled (both clients see the same
+//   game-result events, so both send the same finish), or the player a No Contest did not name;
+// - a player who quits (leaves the online menus, holds Z, Slippi's status 40) concedes and closes
+//   at once, so the leave rule can award the opponent even if the opponent's game says nothing;
+// - a player whose connection to the opponent broke claims the set, but only once its own games
+//   are settled: the pair may have broken because the opponent already saw the deciding result;
+// - exactly one final per set: C2 (a future GameSetup port) never adds a second one.
+class Set {
+ public:
+  void configure(int local, std::vector<std::string> participants) {
+    local_ = local;
+    participants_ = std::move(participants);
+  }
+  // A game of the set started (its first frame; the game repeats frame 1 while it waits for the
+  // opponent, so only the first call of a game counts). The first game makes the host ask for the
+  // match. Both players count the same games, so their reports carry the same ids.
+  void start_game() {
+    if (final_requested_ || closed_ || in_game_) return;
+    started_ = in_game_ = true;
+    ++games_started_;
+  }
+  int games_started() const { return games_started_; }
+  // Unique room receipts/restore acknowledgements for our reports (draws/voids count too).
+  int games_received() const {
+    return (int)std::count_if(order_.begin(), order_.end(), [&](const std::string& id) {
+      return (results_.count(id) || games_.at(id).acknowledged) && games_.at(id).received;
+    });
+  }
+  // The game runs Slippi's GameSetup flow and sends C2 itself: C2 alone decides the set.
+  void game_setup() { game_setup_ = true; }
+
+  void report_game(const Game& game) {
+    in_game_ = false;
+    if (final_requested_ || !started_ || closed_) return;
+    const std::string id = !game.key.empty() ? game.key : "g" + std::to_string(game.index) + "-t" + std::to_string(game.tiebreak);
+    if (games_.count(id)) return;   // one report per game, however many places say it ended
+    Pending report;
+    report.message = {{"t", "game-report"}, {"id", id}};
+    if (valid_port(game.winner)) report.message["winner"] = participants_[game.winner];
+    else report.message["void"] = true;
+    if (game.detail.is_object() && !game.detail.empty()) report.message["detail"] = game.detail;
+    games_.emplace(id, std::move(report));
+    order_.push_back(id);
+    if (game.forfeit && valid_port(game.winner) && forfeit_ < 0) forfeit_ = game.winner;
+    decide();
+  }
+  // C2 (CMD_REPORT_SET_COMPLETE): the game's own verdict, once its games are settled.
+  void complete(uint8_t end_mode) {
+    if (!started_ || c2_ >= 0) return;
+    c2_ = end_mode;
+    decide();
+  }
+  // The local player left the set (Slippi's status 40, leaving the online menus, holding Z).
+  void quit() {
+    if (!started_ || quit_ || lost_) return;
+    quit_ = true;
+    decide();
+  }
+  // The connection to the opponent broke (their game left, or the link died).
+  void lost() {
+    if (!started_ || quit_ || lost_) return;
+    lost_ = true;
+    decide();
+  }
+  // A quitter whose concession is already decided leaves at once (sends what it owes, then closes),
+  // so the room's leave rule can run; anyone else stays until the room's result.
+  bool leaves_at_once() const { return conceded_; }
+
+  // What is due now: the host's begin, then each game report in order (the next waits for the
+  // previous one's game-result), then the final. Unchanged retries every kRetryMs.
+  std::vector<json> due(uint64_t now, bool host, int revision) {
+    std::vector<json> out;
+    // A concession is flushed exactly once by close_room before closing the socket; the pump
+    // must not send it concurrently with that flush.
+    if (!started_ || settled_ || closed_ || closing_ || conceded_) return out;
+    if (match_id_.empty()) {
+      if (!waiting_since_) waiting_since_ = now;
+      if (now - waiting_since_ >= kStartWaitMs) {
+        orphaned_ = true;
+        return out;
+      }
+      if (host && !begin_dead_ && (begin_tries_ == 0 || now >= begin_at_)) {
+        out.push_back({{"t", "begin"}, {"revision", revision}});
+        begin_at_ = now + kRetryMs;
+        if (++begin_tries_ >= kBeginTries) begin_dead_ = true;
+      }
+      return out;
+    }
+    for (const auto& id : order_) {
+      auto& p = games_.at(id);
+      if (p.received) continue;
+      if (!p.sent || now >= p.retry_at) {
+        p.message["matchId"] = match_id_;
+        out.push_back(p.message);
+        p.sent = true;
+        p.retry_at = now + kRetryMs;
+      }
+      return out;
+    }
+    if (final_requested_ && !final_dead_ && (!final_sent_ || now >= final_at_)) {
+      final_["matchId"] = match_id_;
+      out.push_back(final_);
+      final_sent_ = true;
+      final_at_ = now + kRetryMs;
+    }
+    return out;
+  }
+  // A quitter's last words before it closes: everything still owed, once, unfenced.
+  std::vector<json> flush() {
+    std::vector<json> out;
+    if (match_id_.empty() || settled_ || closed_ || closing_) return out;
+    for (const auto& id : order_) {
+      auto& p = games_.at(id);
+      if (p.received) continue;
+      p.message["matchId"] = match_id_;
+      out.push_back(p.message);
+      p.sent = true;
+    }
+    if (final_requested_ && !final_dead_) {
+      final_["matchId"] = match_id_;
+      out.push_back(final_);
+      final_sent_ = true;
+    }
+    return out;
+  }
+
+  // A room message. True only for this set's first final result.
+  bool receive(const json& message) {
+    const std::string type = str(message, "t");
+    if (type == "start" && match_id_.empty()) {
+      match_id_ = str(message, "matchId");
+      if (!match_id_.empty()) orphaned_ = false;   // late, but before the pair broke up: play on
+      return false;
+    }
+    if (match_id_.empty() || str(message, "matchId") != match_id_) return false;
+    if (type == "game-result") {
+      const std::string id = str(message, "id");
+      if (id.empty()) return false;
+      if (!results_.count(id)) results_[id] = settled_winner(message);   // a repeated receipt counts once
+      const auto it = games_.find(id);
+      if (it != games_.end() && it->second.sent) it->second.received = true;
+      decide();
+    } else if (type == "result" && !settled_) {
+      settled_ = true;
+      return true;
+    }
+    return false;
+  }
+  // A command-error from the room: drop what it refuses for good instead of resending it forever.
+  void refused(const json& message, bool restored = false) {
+    const std::string action = str(message, "action"), error = str(message, "error");
+    // The room is recording the match's result or already has it: nothing more to send; wait.
+    if (error == "The match result is being recorded" || error == "The set is over") {
+      closing_ = true;
+      return;
+    }
+    if (action == "begin") {
+      // A roster still settling or a player reconnecting may pass; anything else will not.
+      if (error.rfind("Waiting for", 0) != 0 && error.rfind("The lobby changed", 0) != 0) begin_dead_ = true;
+    } else if (action == "game-report") {
+      // Normally wait for the authoritative result. After a restore it may already have been
+      // broadcast while we were away, so an acknowledgement must also advance the fence.
+      if (error.find("already being recorded") != std::string::npos || error.find("already recorded") != std::string::npos) {
+        if (restored) {
+          const auto it = games_.find(str(message, "id"));
+          if (it != games_.end() && it->second.sent && !it->second.received) {
+            // Advance the receipt fence without inventing the room's settled outcome.
+            // A delayed game-result remains authoritative for the set's score.
+            it->second.received = it->second.acknowledged = true;
+            decide();
+          }
+        }
+        return;
+      }
+      const auto it = games_.find(str(message, "id"));
+      if (it != games_.end() && it->second.sent && !it->second.received) {
+        it->second.received = it->second.refused = true;   // the fence moves on; it counts nothing
+        decide();
+      }
+    } else if (action == "finish") {
+      if (error.rfind("Wait for individual game reports", 0) != 0) final_dead_ = true;
+    }
+  }
+  void room_closed() { closed_ = true; }
+
+  bool started() const { return started_; }
+  bool decided() const { return final_requested_; }
+  bool settled() const { return settled_; }
+  bool closed() const { return closed_; }
+  // The game thread breaks the pair: the set has a final, a result, no room any more, or a room
+  // that never started its match.
+  bool over() const { return final_requested_ || settled_ || closed_ || orphaned_; }
+  // A report still waits for its game-result: no next game may start yet.
+  bool awaiting_receipt() const {
+    if (settled_ || closed_ || match_id_.empty()) return false;
+    for (const auto& id : order_) if (!games_.at(id).received) return true;
+    return false;
+  }
+  // The room started a match for this set and has not given its result: leaving now could cost it.
+  bool needs_drain() const { return !match_id_.empty() && !settled_ && !closed_; }
+  const json& final_message() const { return final_; }
+  const std::string& local_participant() const {
+    static const std::string empty;
+    return valid_port(local_) ? participants_[local_] : empty;
+  }
+
+ private:
+  bool valid_port(int port) const {
+    return participants_.size() == 2 && port >= 0 && port < 2 && !participants_[port].empty();
+  }
+  int port_of(const std::string& participant) const {
+    for (int port = 0; port < 2 && port < (int)participants_.size(); ++port)
+      if (!participant.empty() && participants_[port] == participant) return port;
+    return -1;
+  }
+  int settled_winner(const json& m) const {
+    if (!m.is_object()) return -1;
+    const auto flag = [&](const char* key) { const auto it = m.find(key); return it != m.end() && it->is_boolean() && it->get<bool>(); };
+    if (flag("void") || flag("draw")) return -1;
+    const auto ranking = m.find("ranking");
+    if (ranking == m.end() || !ranking->is_array() || ranking->empty() || !(*ranking)[0].is_string()) return -1;
+    return port_of((*ranking)[0].get<std::string>());
+  }
+  std::array<int, 2> wins() const {
+    std::array<int, 2> out{};
+    for (const auto& [id, winner] : results_) if (winner == 0 || winner == 1) ++out[winner];
+    return out;
+  }
+  bool fence_clear() const {
+    for (const auto& id : order_) if (!games_.at(id).received) return false;
+    return true;
+  }
+  void finish(int port) {
+    final_requested_ = true;
+    final_ = {{"t", "finish"}};
+    if (valid_port(port)) final_["winner"] = participants_[port];
+    else final_["void"] = true;
+  }
+  void decide() {
+    if (final_requested_ || !started_) return;
+    if (!game_setup_) {
+      if (forfeit_ >= 0) return finish(forfeit_);
+      const auto w = wins();
+      for (int port = 0; port < 2; ++port) if (w[port] >= kSetWins) return finish(port);
+      if ((int)results_.size() >= kMaxGames) return finish(-1);
+    }
+    if (!fence_clear()) return;
+    if (c2_ >= 0) {
+      const auto w = wins();
+      return finish(c2_ == 0 && w[0] != w[1] ? (w[0] > w[1] ? 0 : 1) : -1);
+    }
+    if (quit_) {
+      conceded_ = true;
+      return finish(valid_port(local_) ? 1 - local_ : -1);
+    }
+    if (lost_) return finish(valid_port(local_) ? local_ : -1);
+  }
+  struct Pending { json message; bool sent = false, received = false, refused = false, acknowledged = false; uint64_t retry_at = 0; };
+  int local_ = -1;
+  std::vector<std::string> participants_, order_;
+  std::map<std::string, Pending> games_;
+  std::map<std::string, int> results_;   // game id -> settled winner port, -1 none
+  std::string match_id_;
+  int games_started_ = 0, forfeit_ = -1, c2_ = -1, begin_tries_ = 0;
+  bool started_ = false, in_game_ = false, game_setup_ = false, quit_ = false, lost_ = false, conceded_ = false;
+  bool begin_dead_ = false, closing_ = false, final_requested_ = false, final_sent_ = false, final_dead_ = false;
+  bool settled_ = false, closed_ = false, orphaned_ = false;
+  uint64_t begin_at_ = 0, final_at_ = 0, waiting_since_ = 0;
+  json final_;
+};
+
+// YouGame's authoritative tier/division compressed to Slippi's three divisions (E3/E5 and the
+// match-state rank bytes; nothing in the native game draws them yet).
+inline uint8_t rank_enum(const json& rank) {
+  if (!rank.is_object() || !rank.count("placed") || !rank["placed"].is_boolean() || !rank["placed"].get<bool>()) return 0;
+  const std::string tier = str(rank, "tier");
+  if (tier == "challenger") return 19; // Grandmaster
+  static const std::array<const char*, 5> tiers = {"bronze", "silver", "gold", "platinum", "diamond"};
+  const auto it = std::find(tiers.begin(), tiers.end(), tier);
+  if (it == tiers.end() || !rank.count("division") || !rank["division"].is_number_integer()) return 0;
+  const int division = rank["division"].get<int>();
+  if (division < 1 || division > 4) return 0;
+  return (uint8_t)(1 + 3 * (it - tiers.begin()) + (division == 1 ? 2 : division == 2 ? 1 : 0));
+}
+
+// The rank's name as YouGame writes it (web/src/lib/ranks.ts rankFor's `label`: "Gold II",
+// "Challenger", "Placements 2/5"), kept to plain ASCII the game's text can show. Built from the
+// tier and division with ranks.ts's names when the label is missing or unusable.
+inline std::string rank_label(const json& rank, bool placed, int64_t matches) {
+  std::string label;
+  for (char c : str(rank, "label"))
+    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == ' ' || c == '/') label += c;
+  if (!label.empty() && label.size() <= 20) return label;
+  if (!placed) {
+    int64_t total = 5;   // ranks.ts PLACEMENT_MATCHES
+    if (rank.count("placementTotal") && rank["placementTotal"].is_number_integer()) total = rank["placementTotal"].get<int64_t>();
+    if (total < 1 || total > 99) total = 5;
+    return "Placements " + std::to_string(std::min(matches, total)) + "/" + std::to_string(total);
+  }
+  const std::string tier = str(rank, "tier");
+  if (tier == "challenger") return "Challenger";
+  static const std::array<std::pair<const char*, const char*>, 5> names = {
+      {{"bronze", "Bronze"}, {"silver", "Silver"}, {"gold", "Gold"}, {"platinum", "Platinum"}, {"diamond", "Diamond"}}};
+  static const char* roman[] = {"", "I", "II", "III", "IV"};
+  for (const auto& [id, name] : names) {
+    if (tier != id) continue;
+    if (!rank.count("division") || !rank["division"].is_number_integer()) return name;
+    const int division = rank["division"].get<int>();
+    return division >= 1 && division <= 4 ? std::string(name) + " " + roman[division] : std::string(name);
+  }
+  return {};
+}
+
+// The local player's ranked standing for this process: from a ranked ticket, the bridge's mpRank,
+// or a set's final result, whichever is newest. Shown in the Ranked character select's header.
+class RankCache {
+ public:
+  // A ranks.ts Rank object ({tier, division, label, placed, matches, rating, ...}) and the rating
+  // beside it (the rank's own rating when `rating` is not a number). False when it is unusable, or
+  // describes a player with no ranked result yet (0 matches): the header then stays plain.
+  bool standing(const json& rank, const json& rating, float change = 0) {
+    if (!rank.is_object() || !rank.count("placed") || !rank["placed"].is_boolean()) return false;
+    const json& r = rating.is_number() ? rating : rank.count("rating") ? rank["rating"] : json();
+    if (!r.is_number() || !rank.count("matches") || !(rank["matches"].is_number_integer() || rank["matches"].is_number_unsigned()))
+      return false;
+    const double value = r.get<double>();
+    const int64_t matches = rank["matches"].get<int64_t>();
+    const bool placed = rank["placed"].get<bool>();
+    if (!std::isfinite(value) || std::abs(value) > 1000000 || matches < 0 || matches > INT32_MAX) return false;
+    if (!placed && matches == 0) return false;
+    known_ = true;
+    placed_ = placed;
+    rating_ = (float)value;
+    change_ = change;
+    matches_ = (uint32_t)matches;
+    rank_ = rank_enum(rank);
+    label_ = rank_label(rank, placed, matches);
+    ++version_;
+    return true;
+  }
+  // A set's final result: ratings[participant] = {before, after, matches, rank, rankBefore}.
+  bool result(const json& event, const std::string& participant) {
+    if (str(event, "t") != "result" || str(event, "queue") != "ranked" || !event.count("ratings") ||
+        !event["ratings"].is_object()) return false;
+    const auto it = event["ratings"].find(participant);
+    if (it == event["ratings"].end() || !it->is_object()) return false;
+    const auto& r = *it;
+    if (!r.count("before") || !r["before"].is_number() || !r.count("after") || !r["after"].is_number() ||
+        !r.count("rank") || !r["rank"].is_object()) return false;
+    const double before = r["before"].get<double>(), after = r["after"].get<double>();
+    if (!std::isfinite(before) || std::abs(before) > 1000000) return false;
+    json rank = r["rank"];
+    if (r.count("matches") && (r["matches"].is_number_integer() || r["matches"].is_number_unsigned())) rank["matches"] = r["matches"];
+    return standing(rank, r["after"], (float)(after - before));
+  }
+  uint64_t version() const { return version_; }
+  bool known() const { return known_; }
+  // The Ranked character select's header: "Ranked Mode" before any result, then
+  // "Ranked - Placements 2/5" while placing and "Ranked - Gold II - 1534" once placed.
+  std::string header() const {
+    if (!known_) return "Ranked Mode";
+    const std::string rating = std::to_string((long long)std::lround(rating_));
+    if (!placed_) return label_.empty() ? "Ranked Mode" : "Ranked - " + label_;
+    return label_.empty() ? "Ranked - " + rating : "Ranked - " + label_ + " - " + rating;
+  }
+  uint8_t visibility() const { return known_ ? 1 : 0; } // only the local rank is known
+  uint8_t rank() const { return known_ ? rank_ : 0; }
+  std::vector<uint8_t> response() const {
+    std::vector<uint8_t> out = {visibility(), 1, rank()};
+    append_float(out, rating_);
+    append_word(out, matches_);
+    append_float(out, change_);
+    // RustRankInfo's enum declarations are absent from the sparse reference. Preserve the
+    // existing fetch byte (1) and leave the rank-change animation neutral rather than guess.
+    out.push_back(0);
+    return out;
+  }
+
+ private:
+  static void append_word(std::vector<uint8_t>& out, uint32_t word) {
+    for (int i = 3; i >= 0; --i) out.push_back((uint8_t)(word >> (8 * i)));
+  }
+  static void append_float(std::vector<uint8_t>& out, float value) {
+    uint32_t bits; std::memcpy(&bits, &value, sizeof bits); append_word(out, bits);
+  }
+  bool known_ = false, placed_ = false;
+  uint8_t rank_ = 0;
+  uint32_t matches_ = 0;
+  float rating_ = 0, change_ = 0;
+  std::string label_;
+  uint64_t version_ = 0;
+};
+
+// The bridge's mpRank answer (docs/MELEE_UNLOCKED.md, "Bridge request: mpRank (proposed)"):
+// {mode, rating, matches, wins, place, rank} with rank a ranks.ts Rank, or rank null for a player
+// with no ranked row yet. Applied only if nothing newer reached the cache since it was asked
+// (`asked` is the cache's version then): a set's result outranks an older read.
+inline bool apply_rank_answer(RankCache& cache, const json& result, uint64_t asked) {
+  if (!result.is_object() || cache.version() != asked || !result.count("rank") || !result["rank"].is_object()) return false;
+  json rank = result["rank"];
+  if (!rank.count("matches") && result.count("matches")) rank["matches"] = result["matches"];
+  return cache.standing(rank, result.count("rating") ? result["rating"] : json());
+}
+// A bridge that does not know a request answers "Unknown request" (the page, Player.tsx) or
+// "Unknown request <type>" (tools/melee-unlocked/dev-bridge.mjs): never ask it again.
+inline bool unknown_request(const std::string& error) { return error.rfind("Unknown request", 0) == 0; }
+} // namespace yougame::ranked
diff --git a/port/runtime/hle/yougame_ranked_rules.h b/port/runtime/hle/yougame_ranked_rules.h
new file mode 100644
index 0000000..2063b58
--- /dev/null
+++ b/port/runtime/hle/yougame_ranked_rules.h
@@ -0,0 +1,88 @@
+// Package-owned YouGame ranked rules. Pure parsing/policy for both engines and host tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "native_online_policy.h"
+#include "../host/hackpack_ai.h" // existing portable, tested SHA-256
+#include <nlohmann/json.hpp>
+#include <algorithm>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <vector>
+
+namespace yougame::ranked_rules {
+constexpr size_t kMaxBytes = 16 * 1024;
+constexpr const char* kInvalid = "This remix's ranked rules are invalid";
+struct Rules {
+  std::vector<uint16_t> stages;
+  std::vector<uint8_t> characters;
+  bool all_characters = true;
+  std::string canonical, digest;
+  bool character_allowed(uint8_t id) const {
+    return all_characters || std::binary_search(characters.begin(), characters.end(), id);
+  }
+};
+
+// Extended builds follow native_direct_selection_supported: the entire uint8/uint16 wire range.
+// Lists are sets: sorting also makes random draws use the same order on both peers.
+inline bool parse(const std::string& text, bool extended_content, Rules& out) {
+  out = {};
+  if (text.size() > kMaxBytes) return false;
+  try {
+    using json = nlohmann::json;
+    bool duplicate = false;
+    std::set<std::string> keys;
+    const auto j = json::parse(text, [&](int depth, json::parse_event_t event, json& value) {
+      if (depth > 3) throw std::runtime_error("rules nesting");
+      if (event == json::parse_event_t::key && depth == 1 && !keys.insert(value.get<std::string>()).second)
+        duplicate = true;
+      return true;
+    });
+    if (duplicate || !j.is_object() || j.size() != 3 || !j.count("version") ||
+        !j.count("stages") || !j.count("characters") || !j["version"].is_number_integer() ||
+        j["version"] != 1 || !j["stages"].is_array() || j["stages"].empty()) return false;
+    Rules rules;
+    const auto ids = [](const json& list, unsigned max, auto& result) {
+      if (!list.is_array()) return false;
+      for (const auto& id : list) {
+        if (!id.is_number_integer() || id < 0 || id > max) return false;
+        result.push_back(static_cast<typename std::decay_t<decltype(result)>::value_type>(id.get<unsigned>()));
+      }
+      std::sort(result.begin(), result.end());
+      return std::adjacent_find(result.begin(), result.end()) == result.end();
+    };
+    if (!ids(j["stages"], extended_content ? 65535 : 0x55, rules.stages)) return false;
+    rules.all_characters = j["characters"].is_string() && j["characters"] == "all";
+    if (!rules.all_characters && !ids(j["characters"], extended_content ? 255 : 25, rules.characters)) return false;
+    // A list nobody can pick from would only fail at the character screen: refuse it with the file.
+    if (!rules.all_characters && rules.characters.empty()) return false;
+    json canonical = {{"version", 1}, {"stages", rules.stages}, {"characters", "all"}};
+    if (!rules.all_characters) canonical["characters"] = rules.characters;
+    rules.canonical = canonical.dump();
+    rules.digest = host::hackpack_ai::rules::sha256_hex(
+        reinterpret_cast<const uint8_t*>(rules.canonical.data()), rules.canonical.size());
+    out = std::move(rules);
+    return true;
+  } catch (const std::exception&) { return false; }
+}
+
+inline bool applies(bool yougame, int mode, bool mod_view, const std::string& fingerprint) {
+  return yougame && mode == 0 && mod_view && slippi::online::native_mod_fingerprint_valid(fingerprint);
+}
+
+inline const std::vector<uint16_t>& stage_pool(const Rules* rules, bool remix_ranked,
+                                              const std::vector<uint16_t>& matchmaking) {
+  if (rules && remix_ranked) return rules->stages;
+  if (!matchmaking.empty()) return matchmaking;
+  static const std::vector<uint16_t> vanilla = {0x2, 0x3, 0x8, 0x1C, 0x1F, 0x20};
+  return vanilla;
+}
+
+// Missing build messages wait only when local rules require verification. A full digest compares
+// every bit even if two short room suffixes collide; Direct/Teams never call this policy.
+inline int peer_verdict(const std::string& local, bool received, const std::string& remote, bool expired) {
+  if (!received) return local.empty() ? 1 : expired ? -1 : 0;
+  return local == remote ? 1 : -1;
+}
+} // namespace yougame::ranked_rules
diff --git a/port/runtime/hle/yougame_relay_pads.h b/port/runtime/hle/yougame_relay_pads.h
new file mode 100644
index 0000000..3ffa24c
--- /dev/null
+++ b/port/runtime/hle/yougame_relay_pads.h
@@ -0,0 +1,286 @@
+// App-owned standard-layout controllers. No platform or SDL dependencies.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <nlohmann/json.hpp>
+#include "yougame_relay_timing.h"
+#include <memory>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cctype>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <mutex>
+#include <shared_mutex>
+#include <string>
+#include <vector>
+
+namespace yougame::relay_pads {
+struct Pad {
+  bool present = false;
+  std::string id, name, kind;
+  uint32_t buttons = 0;  // XInput-layout wButtons; kind "hid": the device's own 32-bit mask
+  unsigned family_index = 0;  // its number in its game family (family_of); kNoFamilyIndex: skipped
+  int16_t lx = 0, ly = 0, rx = 0, ry = 0;
+  uint8_t lt = 0, rt = 0;
+};
+struct Frame {
+  uint32_t seq = 0;
+  double t = 0;
+  bool has_hs = false;
+  double hs = 0;
+  std::array<Pad, 4> pads{};
+};
+
+// The game controller family a relayed pad joins (yougame_controller_relay.h). Xbox and other pads
+// share the Xbox family, so they share familyIndex numbers, as the app numbers them.
+enum class Family : uint8_t { Xbox, PlayStation, Switch, Hid };
+inline Family family_of(const std::string& kind) {
+  return kind == "ps" ? Family::PlayStation : kind == "switch" ? Family::Switch :
+         kind == "hid" ? Family::Hid : Family::Xbox;
+}
+// The family_index of a pad whose number another pad of its family already has.
+inline constexpr unsigned kNoFamilyIndex = 4;
+
+inline bool parse(const std::string& line, Frame& out, std::string& reason) {
+  using json = nlohmann::json;
+  auto fail = [&](const char* why) { reason = why; return false; };
+  if (line.rfind("yg-pads ", 0) != 0) return fail("bad prefix");
+  // Four full pads with 64-character names stay well under this; a longer line is never parsed.
+  if (line.size() > 2048) return fail("line longer than 2048 bytes");
+  const auto j = json::parse(line.substr(8), nullptr, false);
+  if (!j.is_object()) return fail("expected object");
+  auto integer = [](const json& obj, const char* key, int64_t lo, uint64_t hi) {
+    const auto i = obj.find(key);
+    if (i == obj.end() || !i->is_number_integer()) return false;
+    if (i->is_number_unsigned()) return i->get<uint64_t>() <= hi;
+    const int64_t n = i->get<int64_t>();
+    return n >= lo && (n < 0 || static_cast<uint64_t>(n) <= hi);
+  };
+  Frame next;
+  if (!integer(j, "seq", 0, UINT32_MAX)) return fail("seq must be uint32");
+  const auto time = j.find("t");
+  if (time == j.end() || !time->is_number() || !std::isfinite(time->get<double>()) || time->get<double>() < 0)
+    return fail("t must be finite nonnegative milliseconds");
+  next.seq = j["seq"].get<uint32_t>(); next.t = time->get<double>();
+  const auto helper = j.find("hs");
+  if (helper != j.end()) {
+    if (!helper->is_number() || !std::isfinite(helper->get<double>()) || helper->get<double>() < 0)
+      return fail("hs must be finite nonnegative milliseconds");
+    next.has_hs = true; next.hs = helper->get<double>();
+  }
+  const auto pads = j.find("pads");
+  if (pads == j.end() || !pads->is_array() || pads->size() > 4) return fail("pads must be an array of at most 4");
+  for (const auto& p : *pads) {
+    if (!p.is_object()) return fail("pad must be an object");
+    if (!integer(p, "slot", 0, 3)) return fail("slot must be 0..3");
+    auto& pad = next.pads[p["slot"].get<unsigned>()];
+    if (pad.present) return fail("duplicate slot");
+    auto string = [&](const char* key) { const auto i = p.find(key); return i != p.end() && i->is_string(); };
+    // The id is the app's opaque per-run handle ("p1", "virtual") and the only pad identity the log shows, so it
+    // stays short and plain; the pad's name never reaches the log (pack-platform).
+    if (!string("id")) return fail("id must be 1..32 of A-Z a-z 0-9 _ -");
+    const auto& id = p["id"].get_ref<const std::string&>();
+    if (id.empty() || id.size() > 32 || !std::all_of(id.begin(), id.end(), [](unsigned char c) {
+          return std::isalnum(c) || c == '_' || c == '-'; }))
+      return fail("id must be 1..32 of A-Z a-z 0-9 _ -");
+    if (!string("name")) return fail("name must be a string");
+    pad.name = p["name"].get<std::string>();
+    // JSON is UTF-8: count code points, not bytes, for the 64-character limit.
+    if (std::count_if(pad.name.begin(), pad.name.end(), [](unsigned char c) { return (c & 0xc0) != 0x80; }) > 64)
+      return fail("name exceeds 64 characters");
+    if (!string("kind")) return fail("kind must be ps|xbox|switch|other|hid");
+    pad.kind = p["kind"].get<std::string>();
+    // "hid": a raw HID pad (a box in DInput mode, say) with its own button mask, all 32 bits.
+    if (pad.kind != "ps" && pad.kind != "xbox" && pad.kind != "switch" && pad.kind != "other" && pad.kind != "hid")
+      return fail("kind must be ps|xbox|switch|other|hid");
+    if (!integer(p, "b", 0, pad.kind == "hid" ? UINT32_MAX : 65535)) return fail("b must be 0..65535 (hid: uint32)");
+    // The pad's number in its family, which the app keeps through other pads' hotplugs. Optional:
+    // without it the seat is the number, as before.
+    const bool numbered = p.find("familyIndex") != p.end();
+    if (numbered && !integer(p, "familyIndex", 0, 3)) return fail("familyIndex must be 0..3");
+    pad.family_index = numbered ? p["familyIndex"].get<unsigned>() : p["slot"].get<unsigned>();
+    for (const char* axis : {"lx", "ly", "rx", "ry"})
+      if (!integer(p, axis, -32768, 32767)) return fail("sticks must be int16");
+    for (const char* trigger : {"lt", "rt"})
+      if (!integer(p, trigger, 0, 255)) return fail("triggers must be 0..255");
+    pad.present = true; pad.id = p["id"].get<std::string>();
+    pad.buttons = p["b"].get<uint32_t>();
+    pad.lx = p["lx"].get<int16_t>(); pad.ly = p["ly"].get<int16_t>();
+    pad.rx = p["rx"].get<int16_t>(); pad.ry = p["ry"].get<int16_t>();
+    pad.lt = p["lt"].get<uint8_t>(); pad.rt = p["rt"].get<uint8_t>();
+  }
+  // Two pads with one number in one family would be one controller to the game. The lower seat
+  // keeps the number and the other is skipped (State logs it): failing the line instead would
+  // hold every pad on its last state, held buttons included.
+  bool taken[4][4]{};
+  for (auto& pad : next.pads) {
+    if (!pad.present) continue;
+    bool& used = taken[static_cast<size_t>(family_of(pad.kind))][pad.family_index];
+    if (used) pad.family_index = kNoFamilyIndex; else used = true;
+  }
+  out = std::move(next); reason.clear(); return true;
+}
+
+class State {
+ public:
+  using Log = std::function<void(const std::string&)>;
+  explicit State(Log log, bool logging_ready = true) : log_(std::move(log)), logging_ready_(logging_ready) {}
+  // stdin starts before argv parsing: emitting host::log then would open the default
+  // log file before --log-file is known. Buffer until the host has selected its path.
+  void logging_ready() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    logging_ready_ = true;
+    for (const auto& line : pending_logs_) log_(line);
+    pending_logs_.clear();
+  }
+  bool accept(const std::string& line, uint64_t received_ms) {
+    Frame next; std::string reason;
+    const bool valid = parse(line, next, reason);
+    const double arrived = steady_ms();
+    std::unique_lock<std::shared_mutex> native_lock(native_mutex_);
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!valid) {
+      if (!rejected_) { rejected_ = true; emit_locked("pads: rejected relay line: " + reason); }
+      return false;
+    }
+    if (!active_) {
+      active_ = true; first_local_ = received_ms; first_app_ = next.t;
+      emit_locked("pads: relay mode (app): non-adapter pads come from the YouGame app");
+    }
+    // Connects and disconnects by the app's opaque id and kind only, never the pad's name (pack-platform).
+    for (unsigned slot = 0; slot < next.pads.size(); ++slot) {
+      const auto& before = latest_.pads[slot];
+      const auto& now = next.pads[slot];
+      if (before.present && (!now.present || now.id != before.id))
+        emit_locked("pads: relay disconnect slot " + std::to_string(slot) + " " + before.id);
+      if (now.present && (!before.present || now.id != before.id))
+        emit_locked("pads: relay connect slot " + std::to_string(slot) + " " + now.id + " " + now.kind);
+      if (now.present && now.family_index == kNoFamilyIndex &&
+          (!before.present || now.id != before.id || before.family_index != kNoFamilyIndex))
+        emit_locked("pads: relay slot " + std::to_string(slot) + " " + now.id + " skipped: its familyIndex is taken");
+    }
+    if (!owns_hid_.load(std::memory_order_relaxed) &&
+        std::any_of(next.pads.begin(), next.pads.end(), [](const Pad& p) { return p.present && p.kind == "hid"; })) {
+      owns_hid_.store(true, std::memory_order_release);
+      emit_locked("pads: relay owns HID pads (the app sent a raw HID pad)");
+    }
+    // Signed delay relative to the first arrival: jitter, NOT absolute app-to-game latency.
+    // Subtract in floating point to avoid unsigned wrap when an app timestamp moves backwards.
+    lag_.push_back((double(received_ms) - double(first_local_)) - (double(next.t) - double(first_app_)));
+    timing_->arrival(arrived, next.has_hs, next.hs,
+        std::any_of(next.pads.begin(), next.pads.end(), [](const Pad& p) { return p.present; }));
+    latest_ = std::move(next); // stdin arrival order wins, including repeated or wrapped seq.
+    if (lag_.size() == 600) report_locked();
+    return true;
+  }
+  bool active() const { std::lock_guard<std::mutex> lock(mutex_); return active_; }
+  // The latest accepted line, copied for the game's readers (yougame_controller_relay.h).
+  Frame snapshot() const { std::lock_guard<std::mutex> lock(mutex_); return latest_; }
+  // The app has sent a raw HID pad this run: HID pads are the app's from then on (sticky, like the
+  // relay itself), so a box is never read twice or flips between two readers. Until then the
+  // game's own HID reader keeps them (window.cpp relay_hid_poll).
+  void timing_tick() {
+    const double now = steady_ms();
+    { std::lock_guard<std::mutex> lock(mutex_); if (!timing_->due(now)) return; }
+    Timing completed;  // allocate replacement sample buffers outside the PADRead lock
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!timing_->take_report(now, completed)) return;
+    }
+    char line[384];
+    completed.format(line, sizeof line);
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (!logging_ready_) { pending_logs_.push_back(line); return; }
+    }
+    log_(line);
+  }
+  Frame game_snapshot() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const double now = steady_ms();
+    timing_->poll(now);
+    return latest_;
+  }
+  bool owns_hid() const { return owns_hid_.load(std::memory_order_acquire); }
+  template<class XState> bool read(unsigned slot, XState* out) const {
+    std::lock_guard<std::mutex> lock(mutex_); return read_locked(slot, out);
+  }
+  // Native calls share a gate with the irreversible latch. Native reads/probes/rumble
+  // run concurrently, preserving the host's off-thread slow-driver isolation. Activation
+  // waits for in-flight calls; no native call can start after activation.
+  template<class XState, class Native> bool poll(unsigned slot, XState* out, Native native) const {
+    std::shared_lock<std::shared_mutex> native_lock(native_mutex_);
+    { std::lock_guard<std::mutex> lock(mutex_); if (active_) return read_locked(slot, out); }
+    return native();
+  }
+  template<class Native> void rumble(Native native, bool relayed_output = false) {
+    std::shared_lock<std::shared_mutex> native_lock(native_mutex_);
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (active_) {
+        if (!relayed_output && !rumble_reported_) { rumble_reported_ = true; emit_locked("pads: relayed pads have no rumble yet"); }
+        return;
+      }
+    }
+    native();
+  }
+  void flush() { std::lock_guard<std::mutex> lock(mutex_); if (!lag_.empty()) report_locked(); }
+  void reset_on_eof() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!active_) return;
+    for (unsigned slot = 0; slot < latest_.pads.size(); ++slot) {
+      const auto& pad = latest_.pads[slot];
+      if (pad.present)
+        emit_locked("pads: relay disconnect slot " + std::to_string(slot) + " " + pad.id);
+    }
+    timing_->reset();
+    latest_ = {}; // Keep the relay latch: closed stdin must never restore native pads.
+    if (!eof_reported_) {
+      eof_reported_ = true;
+      emit_locked("pads: relay ended (stdin closed): all relayed pads released");
+    }
+  }
+ private:
+  void emit_locked(const std::string& line) {
+    if (logging_ready_) log_(line); else pending_logs_.push_back(line);
+  }
+  template<class XState> bool read_locked(unsigned slot, XState* out) const {
+    if (!out) return false;
+    *out = {};
+    // Kind "hid" has no Xbox layout: the seat reads as empty here.
+    if (!active_ || slot >= 4 || !latest_.pads[slot].present || latest_.pads[slot].kind == "hid") return false;
+    const auto& p = latest_.pads[slot];
+    out->dwPacketNumber = latest_.seq;
+    auto& g = out->Gamepad;
+    g.wButtons = static_cast<uint16_t>(p.buttons); g.bLeftTrigger = p.lt; g.bRightTrigger = p.rt;
+    g.sThumbLX = p.lx; g.sThumbLY = p.ly; g.sThumbRX = p.rx; g.sThumbRY = p.ry;
+    return true;
+  }
+  void report_locked() {
+    std::sort(lag_.begin(), lag_.end());
+    const auto percentile = [&](double p) {
+      char ms[384]; // fixed notation also handles large, valid app timestamps without integer overflow
+      std::snprintf(ms, sizeof ms, "%.0f", lag_[size_t(std::ceil(p * lag_.size())) - 1]);
+      return std::string(ms);
+    };
+    emit_locked("pads: relay lag p50 " + percentile(.50) + " ms p95 " +
+         percentile(.95) + " ms over " + std::to_string(lag_.size()) + " lines");
+    lag_.clear();
+  }
+  Log log_;
+  bool logging_ready_;
+  std::vector<std::string> pending_logs_;
+  mutable std::mutex mutex_;
+  mutable std::shared_mutex native_mutex_;
+  bool active_ = false, rejected_ = false, rumble_reported_ = false, eof_reported_ = false;
+  std::atomic<bool> owns_hid_{false};
+  Frame latest_;
+  std::unique_ptr<Timing> timing_{new Timing};
+  uint64_t first_local_ = 0;
+  double first_app_ = 0;
+  std::vector<double> lag_;
+};
+} // namespace yougame::relay_pads
diff --git a/port/runtime/hle/yougame_relay_rumble.h b/port/runtime/hle/yougame_relay_rumble.h
new file mode 100644
index 0000000..902d26b
--- /dev/null
+++ b/port/runtime/hle/yougame_relay_rumble.h
@@ -0,0 +1,58 @@
+// App rumble protocol and bounded change/refresh mailbox. No platform I/O.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <string>
+namespace yougame::relay_pads {
+struct RumbleCommand {
+  int seat = 0, strong = 0, weak = 0, ms = 0;
+};
+inline std::string rumble_line(RumbleCommand c) {
+  c.seat = std::clamp(c.seat, 0, 3);
+  c.strong = std::clamp(c.strong, 0, 65535); c.weak = std::clamp(c.weak, 0, 65535);
+  c.ms = c.strong || c.weak ? std::clamp(c.ms, 0, 5000) : 0;
+  char line[128];
+  std::snprintf(line, sizeof line, "yg {\"rumble\":{\"seat\":%d,\"strong\":%d,\"weak\":%d,\"ms\":%d}}",
+      c.seat, c.strong, c.weak, c.ms);
+  return line;
+}
+class Rumble {
+ public:
+  void set(int seat, bool on, double now) {
+    if (seat < 0 || seat >= 4) return;
+    auto& s = seats_[seat];
+    if (s.on == on) return;
+    s.on = on; s.next = now + 4000;
+    put({seat, on ? 65535 : 0, on ? 32768 : 0, on ? 5000 : 0});
+  }
+  void pulse(int seat, double now) {
+    if (seat < 0 || seat >= 4) return;
+    auto& s = seats_[seat]; s.on = false; s.stop = now + 300;
+    put({seat, 65535, 65535, 300});
+  }
+  void tick(double now) {
+    for (int i = 0; i < 4; ++i) {
+      auto& s = seats_[i];
+      if (s.stop && now >= s.stop) { s.stop = 0; s.on = false; put({i, 0, 0, 0}); }
+      else if (s.on && now >= s.next) { s.next = now + 4000; put({i, 65535, 32768, 5000}); }
+    }
+  }
+  bool take(RumbleCommand& out) {
+    if (!count_) return false;
+    out = queue_[head_]; head_ = (head_ + 1) % queue_.size(); --count_; return true;
+  }
+ private:
+  struct Seat { bool on = false; double next = 0, stop = 0; };
+  std::array<Seat, 4> seats_{};
+  std::array<RumbleCommand, 64> queue_{};
+  size_t head_ = 0, count_ = 0;
+  void put(RumbleCommand c) {
+    // A stalled stdout cannot grow memory or block PADRead. On saturation drop the oldest
+    // command; subsequent changes (especially stops) and refreshes remain deliverable.
+    if (count_ == queue_.size()) { head_ = (head_ + 1) % queue_.size(); --count_; }
+    queue_[(head_ + count_++) % queue_.size()] = c;
+  }
+};
+} // namespace yougame::relay_pads
diff --git a/port/runtime/hle/yougame_relay_timing.h b/port/runtime/hle/yougame_relay_timing.h
new file mode 100644
index 0000000..00c6cf2
--- /dev/null
+++ b/port/runtime/hle/yougame_relay_timing.h
@@ -0,0 +1,90 @@
+// Bounded relay timing windows; stamps are steady_clock milliseconds, including helper hs.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <utility>
+
+namespace yougame::relay_pads {
+inline double steady_ms() {
+  return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+class Timing {
+ public:
+  // More than 8 kHz for 30 seconds. If exhausted, retain the most recent samples;
+  // counts and maxima still cover every line. No allocation or sorting on arrival.
+  static constexpr size_t capacity = 262144;
+  struct Samples {
+    std::unique_ptr<std::array<double, capacity>> values{new std::array<double, capacity>};
+    uint64_t count = 0;
+    double maximum = 0;
+    void add(double value) { (*values)[count++ % capacity] = value; maximum = std::max(maximum, value); }
+    double percentile(double p) {
+      const size_t n = size_t(std::min<uint64_t>(count, capacity));
+      if (!n) return 0;
+      const size_t at = size_t(std::ceil(p * n)) - 1;
+      std::nth_element(values->begin(), values->begin() + at, values->begin() + n);
+      return (*values)[at];
+    }
+    void clear() { count = 0; maximum = 0; }
+  };
+  void arrival(double now, bool has_hs, double hs, bool attached) {
+    if (!attached) { reset(); return; }
+    if (!active_) { active_ = true; start_ = now; }
+    if (pending_) ++overwritten_;
+    ++lines_;
+    if (has_hs) {
+      ++hs_;
+      if (now < hs) ++negative_;
+      else arrival_.add(now - hs);
+    }
+    pending_ = true; pending_stats_ = has_hs && now >= hs; arrived_ = now;
+  }
+  void poll(double now) {
+    if (!pending_) return;
+    if (pending_stats_) poll_.add(std::max(0.0, now - arrived_));
+    pending_ = false;
+  }
+  bool due(double now) const { return active_ && now - start_ >= 30000; }
+  // The caller allocates the destination before locking. Only buffer pointers and
+  // counters move here; the live pending arrival still belongs to the next poll.
+  bool take_report(double now, Timing& completed) {
+    if (!due(now)) return false;
+    std::swap(arrival_, completed.arrival_); std::swap(poll_, completed.poll_);
+    completed.lines_ = lines_; completed.hs_ = hs_;
+    completed.negative_ = negative_; completed.overwritten_ = overwritten_;
+    start_ = now; lines_ = hs_ = negative_ = overwritten_ = 0;
+    arrival_.clear(); poll_.clear();
+    return true;
+  }
+  void format(char* out, size_t size) {
+    const double a50 = arrival_.percentile(.50), a95 = arrival_.percentile(.95);
+    const double p50 = poll_.percentile(.50), p95 = poll_.percentile(.95);
+    std::snprintf(out, size, "[relay-pads] 30 s: lines=%llu hs=%llu arrival-hs p50=%.3f p95=%.3f max=%.3f poll-arrival p50=%.3f p95=%.3f max=%.3f neg=%llu overwritten=%llu",
+        (unsigned long long)lines_, (unsigned long long)hs_, a50, a95, arrival_.maximum,
+        p50, p95, poll_.maximum, (unsigned long long)negative_, (unsigned long long)overwritten_);
+  }
+  bool report(double now, char* out, size_t size) {
+    if (!due(now)) return false;
+    format(out, size);
+    start_ = now; lines_ = hs_ = negative_ = overwritten_ = 0;
+    arrival_.clear(); poll_.clear();
+    return true;
+  }
+  void reset() {
+    active_ = pending_ = pending_stats_ = false;
+    lines_ = hs_ = negative_ = overwritten_ = 0;
+    arrival_.clear(); poll_.clear();
+  }
+ private:
+  Samples arrival_, poll_;
+  bool active_ = false, pending_ = false, pending_stats_ = false;
+  double start_ = 0, arrived_ = 0;
+  uint64_t lines_ = 0, hs_ = 0, negative_ = 0, overwritten_ = 0;
+};
+} // namespace yougame::relay_pads
diff --git a/port/runtime/hle/yougame_room.h b/port/runtime/hle/yougame_room.h
new file mode 100644
index 0000000..e2ae861
--- /dev/null
+++ b/port/runtime/hle/yougame_room.h
@@ -0,0 +1,298 @@
+// Room lifecycle shared verbatim by WinHTTP's adapter and offline fake-broker tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "yougame_transport.h"
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include "yougame_agent_input.h"
+#include <cstdlib>
+#endif
+#include <memory>
+#include <thread>
+
+namespace yougame::transport {
+// Shared by matchmaking and the offline duel contract. These are the pre-Teams rules:
+// slots, not roster order or team numbers, determine controller ports and result ids.
+inline int connection_seat(const json& participants, const std::string& connection) {
+  for (const auto& p : participants)
+    if (p.value("connectionId", "") == connection && p.value("localIndex", 0) == 0) return p.value("slot", -1);
+  return -1;
+}
+inline std::vector<std::string> port_participants(const json& participants, int size) {
+  std::vector<std::string> ids(size, "");
+  for (const auto& p : participants) {
+    const int seat = p.value("slot", -1);
+    if (seat >= 0 && seat < size) ids[seat] = p.value("id", "");
+  }
+  return ids;
+}
+
+template<class Socket> struct RoomState {
+  std::unique_ptr<Socket> socket;
+  std::string url, ticket, code;
+  json ticket_request;
+  Recovery recovery;
+  TicketRetry ticket_retry;
+  Links links;
+  std::thread pump;
+  std::atomic<bool> stop{false};
+  std::string me, host_connection, match_id;
+  int revision = 0;
+  json participants = json::array();  // Current server roster, including each participant's hn.
+  int size = 2;
+  int mode = -2;
+  bool ranked = false;
+  ranked::Set set;
+  std::vector<std::string> port_ids;   // participant id for each port (0-based)
+  // Four-seat Teams only. Singles rosters also carry team numbers; they do not enable Teams.
+  // Room slot n is Slippi player_idx n / controller port n+1, independent of roster order.
+  std::array<int, 4> port_teams = {{-1, -1, -1, -1}};
+  int seat_team(int player_idx) const {
+    return size == 4 && player_idx >= 0 && player_idx < 4 ? port_teams[player_idx] : -1;
+  }
+  json pending_team_result;             // legacy socket's complete Teams finish outcome
+  bool pending_begin = false;
+  uint64_t begin_at = 0;               // when a refused begin may be tried again
+  bool in_game = false;                // between game_started and its one game_ended
+  Games games;
+  int pending_winner = -2;             // -2 none, -1 no single winner, else 0-based port
+};
+
+struct RoomIO {
+  Request request;
+  std::function<uint64_t()> clock = now_ms;
+  std::function<void(int)> pause = [](int ms) { std::this_thread::sleep_for(std::chrono::milliseconds(ms)); };
+  std::function<int(unsigned)> link_state;
+  std::function<void()> disable_links = [] {};
+  std::function<void(const char*)> log = [](const char*) {};
+  std::function<void(const json&)> result = [](const json&) {};
+};
+// What the room is waiting for: a begin (the host, once a game starts) and the finish. Decided
+// under the room mutex, sent after it is released (a stalled socket must not hold up the game thread).
+template<class Room> std::vector<json> due_messages(Room& r, uint64_t now) {
+  if (r.ranked) return r.set.due(now, r.me == r.host_connection, r.revision);
+  if (r.socket->brokered()) return r.games.due(now, r.me == r.host_connection, r.revision, r.port_ids);
+  std::vector<json> out;
+  if (r.pending_begin && r.me == r.host_connection && r.match_id.empty() && now >= r.begin_at) {
+    out.push_back({{"t", "begin"}, {"revision", r.revision}});
+    r.pending_begin = false;
+  }
+  if (r.pending_winner != -2 && !r.match_id.empty()) {
+    json finish = {{"t", "finish"}, {"matchId", r.match_id}};
+    if (r.pending_winner >= 0 && r.pending_winner < (int)r.port_ids.size()) finish["winner"] = r.port_ids[r.pending_winner];
+    else finish["void"] = true;
+    out.push_back(finish);
+    r.pending_winner = -2;
+    r.match_id.clear();
+  }
+  if (!r.pending_team_result.is_null() && !r.match_id.empty()) {
+    json finish = r.pending_team_result;
+    finish["t"] = "finish"; finish["matchId"] = r.match_id;
+    out.push_back(std::move(finish));
+    r.pending_team_result = nullptr;
+    r.match_id.clear();
+  }
+  return out;
+}
+
+template<class Room> void read_seat_teams(Room& r, const json& m) {
+  if (r.size != 4) { r.port_teams.fill(-1); return; }
+  if (m.count("participants") && m["participants"].is_array()) {
+    r.port_teams.fill(-1);   // a missing team in a fresh roster must not retain an old assignment
+    for (const auto& p : m["participants"]) {
+      if (!p.is_object() || !p.count("slot") || !p["slot"].is_number_integer()) continue;
+      const auto slot = p["slot"].get<int64_t>();
+      if (slot < 0 || slot >= r.size || slot >= 4) continue;
+      if (p.count("team") && p["team"].is_number_integer() && (p["team"] == 0 || p["team"] == 1))
+        r.port_teams[slot] = p["team"].get<int>();
+    }
+  }
+}
+
+template<class Room> void read_participants(Room& r, const json& m) {
+  if (m.count("participants"))
+    r.participants = m["participants"].is_array() ? m["participants"] : json::array();
+  else {
+    const auto t = str(m, "t");
+    if (t == "welcome" || t == "lobby" || t == "join" || t == "back" || t == "leave" || t == "away")
+      r.participants = json::array();  // Membership changed without a usable roster.
+  }
+}
+template<class Room> void read_roster(Room& r, const json& m) {
+  read_participants(r, m);
+  read_seat_teams(r, m);
+  if (m.count("host") && m["host"].is_string()) r.host_connection = m["host"].get<std::string>();
+  if (m.count("revision") && m["revision"].is_number_integer()) r.revision = m["revision"].get<int>();
+}
+
+inline std::string leave_id(const json& m, bool brokered) {
+  return brokered && m.count("player") ? str(m["player"], "id") : str(m, "id");
+}
+template<class Room> void end_links(Room& r, const RoomIO& io) {
+  if (r.links.ids.empty()) return;
+  io.disable_links();
+  close_links(r.links, io.request);
+}
+template<class Room> bool reopen_room(Room& r, const RoomIO& io) {
+  const auto open = [&] {
+    const auto left = r.recovery.remaining(io.clock());
+    std::string error;
+    return left && !r.stop && r.socket->open_session(r.url, r.ticket, r.code, &error, (int)std::min<uint64_t>(2000, left));
+  };
+  const auto renew = [&] {
+    const auto left = r.recovery.remaining(io.clock());
+    if (!left || r.stop) return;
+    renew_room_ticket(r.ticket, r.code, [&] {
+      return io.request(r.ticket_request, (int)std::min<uint64_t>(3000, left));
+    }, io.log); // a failed renewal leaves the current ticket available
+  };
+  try { return r.ticket_retry.attempt(open, renew); } catch (...) { return false; }
+}
+
+#ifdef YOUGAME_AGENT_TEST_HOOK
+inline std::atomic<bool> agent_drop_room_attempted{false};
+inline int agent_drop_room_seconds(const char* value) {
+  if (!value || !*value) return 0;
+  int seconds = 0;
+  for (const char* p = value; *p; ++p) {
+    if (*p < '0' || *p > '9' || seconds > 900) return 0;
+    seconds = seconds * 10 + (*p - '0');
+  }
+  return seconds >= 330 && seconds <= 900 ? seconds : 0;
+}
+// Called with the room mutex held; claim the attempt process-wide, including refusals.
+template<class Room> bool agent_drop_room_due(Room& r, const RoomIO& io, int seconds) {
+  if (!seconds || agent_drop_room_attempted || !r.socket->brokered() || r.socket->closed() ||
+      !r.in_game || r.match_id.empty()) return false;
+  const auto now = io.clock(), first = r.socket->agent_test_first_open_at();
+  if (now < first || now - first < uint64_t(seconds) * 1000) return false;
+  if (agent_drop_room_attempted.exchange(true)) return false;
+  const auto state = agent_test::room_input_state(0, r.mode, r.ranked, r.participants, r.me);
+  if (state.mode < 1 || state.mode > 4 || !state.players || !state.all_agents ||
+      !agent_test::gameplay_input_allowed(state)) {
+    io.log("agent-test: dropRoomAfter refused: not an agent-only room");
+    return false;
+  }
+  io.log(("agent-test: dropped the room socket (dropRoomAfter " + std::to_string(seconds) + " s)").c_str());
+  return true;
+}
+#endif
+
+// A link ending does not end the room: ranked still owes reports and must hear its result.
+template<class Room> void pump_room(Room* r, std::mutex& mutex, const RoomIO& io) {
+  uint64_t last_ping = 0, reopen_at = 0;
+  bool awaiting_welcome = false, links_ended = false, restored = false, room_closed = false, recovered_match_known = false;
+  std::string recovered_match;
+  const bool broker = r->socket->brokered();
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  const int drop_room_seconds = agent_drop_room_seconds(std::getenv("MELEE_ONLINE_TEST_DROP_ROOM_AFTER"));
+#endif
+  while (!r->stop) {
+#ifdef YOUGAME_AGENT_TEST_HOOK
+    bool drop_room = false;
+    { std::lock_guard<std::mutex> lock(mutex); drop_room = agent_drop_room_due(*r, io, drop_room_seconds); }
+    if (drop_room) r->socket->agent_test_drop_room();
+#endif
+    json m;
+    const bool got = r->socket->next(m, broker ? 100 : 250);
+    if (!got && r->socket->closed()) {
+      { std::lock_guard<std::mutex> lock(mutex); r->participants = json::array(); }
+      if (!broker || !r->recovery.dropped(io.clock(), r->socket->recoverable())) { room_closed = true; break; }
+      awaiting_welcome = true;
+      if (io.clock() >= reopen_at) {
+        reopen_room(*r, io);
+        reopen_at = io.clock() + 1000;
+      }
+      const auto left = r->recovery.remaining(io.clock());
+      if (r->socket->closed() && left && !r->stop) io.pause((int)std::min<uint64_t>(100, left));
+    }
+    std::vector<json> out;
+    bool stop_links = false;
+    {
+      std::lock_guard<std::mutex> lock(mutex);
+      if (got) {
+        const auto t = str(m, "t");
+        if (broker && (t == "ended" || t == "end" || t == "kick" || t == "kicked" || t == "error" || m.count("setOver"))) stop_links = true;
+        if (broker && t == "leave" && !r->recovery.leave(m, io.clock(), !r->match_id.empty())) stop_links = true;
+        if (broker && r->recovery.pending() && (t == "welcome" || t == "join" || t == "back" || t == "lobby")) {
+          if (!awaiting_welcome || t == "welcome") {
+            const bool recovered = r->recovery.restore(m, io.clock(), !links_ended, r->ranked);
+            if (r->recovery.expired(io.clock())) room_closed = true;
+            if (t == "welcome" && !r->recovery.expired(io.clock())) {
+              awaiting_welcome = false; restored = true;
+              recovered_match = str(m, "matchId"); recovered_match_known = true;
+            }
+            if (recovered) { awaiting_welcome = false; restored = true; r->ticket_retry = {}; reopen_at = 0; }
+          }
+        }
+        if (broker && t == "welcome" && !r->ranked) r->games.receive(m);
+        if (broker && !awaiting_welcome && !r->recovery.pending() && !r->recovery.expired(io.clock()) && recovered_match_known) {
+          r->match_id = std::move(recovered_match); recovered_match_known = false;
+          if (r->match_id.empty()) r->recovery.result(); else r->recovery.start(r->match_id);
+          r->pending_begin = false;
+          if (r->ranked) r->set.receive({{"t", "start"}, {"matchId", r->match_id}});
+          else r->games.started(r->match_id);
+        }
+        if (r->ranked && r->set.receive(m)) io.result(m);
+        if (t == "start") {
+          io.log("yougame: room started a match");
+          r->match_id = str(m, "matchId");
+          if (broker) {
+            r->recovery.start(r->match_id);
+            if (!r->ranked) r->games.started(r->match_id);
+            r->pending_begin = false;
+          }
+        } else if (t == "result" || t == "game-result") {
+          io.log("yougame: room recorded the result");
+          if (broker && t == "result") {
+            if (!r->ranked) r->games.receive(m);
+            if (str(m, "matchId") == r->match_id) { r->match_id.clear(); r->recovery.result(); }
+          }
+        } else if (t == "command-error") {
+          const auto action = str(m, "action");
+          // Which command and the room's reason: the set's own handling depends on the text (10-25 1-1 set).
+          io.log(("yougame: room refused a command: " + action.substr(0, 32) + ": " + str(m, "error").substr(0, 160)).c_str());
+          if (r->ranked) r->set.refused(m, broker && restored);
+          else if (broker && r->games.refused(m)) { r->match_id.clear(); r->recovery.result(); }
+          if (!r->ranked && action == "begin" && (r->in_game || (broker && r->pending_winner != -2))) {
+            r->pending_begin = true; r->begin_at = io.clock() + 2000;
+          }
+        }
+        if (broker || t == "lobby" || t == "join" || t == "back" || t == "leave" || t == "away") read_roster(*r, m);
+        else {
+          read_participants(*r, m);
+          if (t == "welcome" || t == "start") read_seat_teams(*r, m);
+        }
+      }
+      for (unsigned id : r->links.ids) if (io.link_state(id) == 3) stop_links = true;
+      if (stop_links) {
+        links_ended = true;
+        // A definitive peer departure cancels its grace, while our own socket can still recover.
+        if (!awaiting_welcome) { r->recovery.cancel_wait(); r->ticket_retry = {}; reopen_at = 0; }
+      }
+      if (broker && r->recovery.expired(io.clock())) room_closed = true;
+      if (!room_closed && !r->recovery.pending() && !awaiting_welcome && !r->socket->closed()) out = due_messages(*r, io.clock());
+    }
+    if (stop_links) end_links(*r, io);
+    if (room_closed) break;
+    if (!r->socket->closed() && io.clock() - last_ping > 5000) {
+      out.push_back({{"t", "ping"}, {"at", io.clock()}}); last_ping = io.clock();
+    }
+    for (auto& j : out) r->socket->send(j);
+  }
+  end_links(*r, io);
+  if (room_closed) {
+    std::lock_guard<std::mutex> lock(mutex);
+    r->participants = json::array();
+    if (r->ranked) r->set.room_closed();
+  }
+}
+
+// Join before the at-once flush: open/next/send have one pump owner until it has stopped.
+template<class Room> void stop_and_flush(Room& r, std::mutex& mutex) {
+  r.stop = true;
+  if (r.pump.joinable()) r.pump.join();
+  std::vector<json> last;
+  { std::lock_guard<std::mutex> lock(mutex); last = r.set.flush(); }
+  for (const auto& j : last) r.socket->send(j);
+}
