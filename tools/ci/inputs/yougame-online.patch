+// Offline Teams contract: real room roster/pump, pure end-record result, real casual outbox.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_room.h"
+#include <cstdio>
+#include <cstdlib>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame::transport;
+using yougame::ranked::team_winner;
+
+struct Socket {
+  bool broker = true;
+  std::deque<json> messages;
+  std::function<void()> observe;
+  std::vector<json> sent;
+  bool brokered() const { return broker; }
+  bool closed() const { return false; }
+  bool recoverable() const { return false; }
+  bool open_session(const std::string&, const std::string&, const std::string&, std::string*, int) { return false; }
+  bool next(json& m, int) {
+    if (observe) observe();
+    if (messages.empty()) return false;
+    m = messages.front(); messages.pop_front(); return true;
+  }
+  bool send(const json& m) { sent.push_back(m); return true; }
+};
+
+static json roster() {
+  // Deliberately shuffled: array index and connection id have no bearing on the port.
+  return json::array({{{"id","c"},{"connectionId","conn-c"},{"slot",2},{"localIndex",0},{"team",0}},
+                      {{"id","a"},{"connectionId","conn-a"},{"slot",0},{"localIndex",0},{"team",1}},
+                      {{"id","d"},{"connectionId","conn-d"},{"slot",3},{"localIndex",0},{"team",1}},
+                      {{"id","b"},{"connectionId","conn-b"},{"slot",1},{"localIndex",0},{"team",0}}});
+}
+
+static void room_teams() {
+  RoomState<Socket> r; r.size = 4;
+  for (int i = -1; i <= 4; ++i) CHECK(r.seat_team(i) == -1);
+  for (const char* type : {"welcome", "lobby", "start"}) {
+    read_roster(r, {{"t",type},{"participants",roster()}});
+    CHECK(r.seat_team(0) == 1 && r.seat_team(1) == 0 && r.seat_team(2) == 0 && r.seat_team(3) == 1);
+    auto missing = roster(); missing[0].erase("team");
+    read_roster(r, {{"t",type},{"participants",missing}});
+    CHECK(r.seat_team(2) == -1 && r.seat_team(0) == 1);
+    read_roster(r, {{"t", "ping"}}); CHECK(r.seat_team(0) == 1); // no roster retains known teams
+  }
+  for (const json invalid : {json(-1), json(2), json("0"), json(0.0), json(true), json(nullptr)}) {
+    auto bad = roster(); bad[0]["team"] = invalid;
+    read_roster(r, {{"participants",bad}}); CHECK(r.seat_team(2) == -1);
+  }
+  read_roster(r, {{"participants",json::array()}});
+  for (int i = 0; i < 4; ++i) CHECK(r.seat_team(i) == -1);
+  auto private_roster = roster();
+  for (auto& p : private_roster) p["team"] = nullptr;
+  read_roster(r, {{"participants",private_roster}});
+  for (int port = 0; port < 4; ++port) CHECK(r.seat_team(port) == -1);
+  auto bad = roster(); bad.push_back({{"slot",-1},{"team",0}}); bad.push_back({{"slot",4},{"team",1}});
+  bad.push_back({{"slot","0"},{"team",0}});
+  read_roster(r, {{"participants",bad}});
+  CHECK(r.seat_team(0) == 1 && r.seat_team(4) == -1);
+
+  // Exercise actual welcome/lobby/start dispatch for app-broker and legacy adapters.
+  for (bool broker : {false, true}) {
+    RoomState<Socket> room; room.size = 4; room.socket = std::make_unique<Socket>(); room.socket->broker = broker;
+    auto lobby = roster(); lobby[0]["team"] = 1;
+    auto start = roster(); start[0].erase("team");
+    room.socket->messages = {{{"t","welcome"},{"participants",roster()}},
+                             {{"t","lobby"},{"participants",lobby}},
+                             {{"t","start"},{"matchId","teams-1"},{"participants",start}}};
+    int seen = 0;
+    room.socket->observe = [&] {
+      if (seen == 1) CHECK(room.seat_team(2) == 0);
+      if (seen == 2) CHECK(room.seat_team(2) == 1);
+      if (seen == 3) { CHECK(room.seat_team(2) == -1 && room.match_id == "teams-1"); room.stop = true; }
+      ++seen;
+    };
+    std::mutex mutex; RoomIO io; io.clock = [] { return 1; };
+    pump_room(&room, mutex, io); CHECK(seen == 4);
+  }
+}
+
+static void team_results() {
+  // Every balanced seat/team permutation and every legal set of four placement bytes.
+  for (int mask = 0; mask < 16; ++mask) {
+    int teams[4], count = 0;
+    for (int i = 0; i < 4; ++i) count += teams[i] = (mask >> i) & 1;
+    if (count != 2) continue;
+    for (int encoded = 0; encoded < 256; ++encoded) {
+      int placements[4], first_teams = 0;
+      for (int i = 0; i < 4; ++i) {
+        placements[i] = (encoded >> (2 * i)) & 3;
+        if (placements[i] == 0) first_teams |= 1 << teams[i];
+      }
+      const int expected = first_teams == 1 ? 0 : first_teams == 2 ? 1 : -1;
+      for (int method : {1, 2}) CHECK(team_winner(method, -1, placements, teams) == expected);
+    }
+  }
+  const int teams[4] = {0,1,0,1};
+  const int shared_first[4] = {0,1,0,1}, survivor[4] = {0,1,3,2}, other[4] = {2,0,3,1};
+  const int tie[4] = {0,0,1,1}, no_first[4] = {1,1,2,2};
+  for (int method : {1,2}) {
+    CHECK(team_winner(method,-1,shared_first,teams) == 0);
+    CHECK(team_winner(method,-1,survivor,teams) == 0);
+    CHECK(team_winner(method,-1,other,teams) == 1);
+    CHECK(team_winner(method,-1,tie,teams) == -1);
+    CHECK(team_winner(method,-1,no_first,teams) == -1);
+    CHECK(team_winner(method,-1,nullptr,teams) == -1);
+    CHECK(team_winner(method,-1,shared_first,nullptr) == -1);
+    for (int lras : {-2,0,1,2,3,4,255}) CHECK(team_winner(method,lras,shared_first,teams) == -1);
+    for (int invalid : {-1,4,255}) {
+      int placements[4] = {0,1,0,invalid};
+      CHECK(team_winner(method,-1,placements,teams) == -1);
+      int missing[4] = {0,1,0,invalid};
+      CHECK(team_winner(method,-1,shared_first,missing) == -1);
+    }
+    const int unbalanced[4] = {0,0,0,1};
+    CHECK(team_winner(method,-1,shared_first,unbalanced) == -1);
+  }
+  for (int method : {0,3,4,5,6,7,8,255})
+    for (int lras : {-1,0,1,2,3}) CHECK(team_winner(method,lras,shared_first,teams) == -1);
+}
+
+static void team_reports() {
+  std::vector<std::string> ids = {"a","b","c","d"};
+  int teams[4] = {1,0,0,1};
+  const json win0 = {{"ranking",{"b","c","a","d"}},{"detail",{{"tw",0}}}};
+  const json win1 = {{"ranking",{"a","d","b","c"}},{"detail",{{"tw",1}}}};
+  CHECK(team_outcome(0,ids,teams) == win0 && team_outcome(1,ids,teams) == win1);
+  CHECK(team_outcome(-1,ids,teams) == json({{"void",true}}));
+  CHECK(team_outcome(2,ids,teams) == json({{"void",true}}));
+  CHECK(team_outcome(0,{"a","b"},teams) == json({{"void",true}}));
+  CHECK(team_outcome(0,{"a","b","c","c"},teams) == json({{"void",true}}));
+  CHECK(team_outcome(0,{"a","b","c",""},teams) == json({{"void",true}}));
+  CHECK(team_outcome(0,ids,nullptr) == json({{"void",true}}));
+
+  const int no_map[4] = {-1,-1,-1,-1};
+  const int different[4] = {0,1,0,1}, partial[4] = {1,0,0,-1};
+  const int unbalanced[4] = {0,0,0,1}, ffa[4] = {0,1,2,3};
+  const json voided = {{"void",true}};
+  CHECK(room_team_outcome(0,ids,teams,no_map,false) == win0);
+  CHECK(room_team_outcome(1,ids,teams,no_map,false) == win1);
+  CHECK(room_team_outcome(0,ids,unbalanced,no_map,false) == voided);
+  CHECK(room_team_outcome(0,ids,ffa,no_map,false) == voided);
+  CHECK(room_team_outcome(0,ids,teams,teams,false) == win0);
+  CHECK(room_team_outcome(0,ids,different,teams,false) == voided);
+  CHECK(room_team_outcome(0,ids,teams,partial,false) == voided);
+  CHECK(room_team_outcome(0,ids,teams,no_map,true) == voided);
+  CHECK(room_team_outcome(0,ids,nullptr,no_map,false) == voided);
+  CHECK(room_team_outcome(0,ids,teams,nullptr,false) == voided);
+
+  // Private rooms: any two CSS colours with two players each become teams 0 and 1, lower colour first.
+  const auto paired = [&](const int (&game)[4], const int* room, bool ranked, std::array<int, 4> want) {
+    int out[4]; outcome_teams(game, room, ranked, out);
+    return std::array<int, 4>{{out[0], out[1], out[2], out[3]}} == want;
+  };
+  const int red_green[4] = {2,0,0,2}, blue_green[4] = {1,2,2,1}, three[4] = {0,1,2,2}, all_green[4] = {2,2,2,2};
+  CHECK(paired(red_green, no_map, false, {{1,0,0,1}}));
+  CHECK(paired(blue_green, no_map, false, {{0,1,1,0}}));
+  CHECK(paired(teams, no_map, false, {{teams[0],teams[1],teams[2],teams[3]}}));
+  CHECK(paired(three, no_map, false, {{0,1,2,2}}));
+  CHECK(paired(all_green, no_map, false, {{2,2,2,2}}));
+  CHECK(paired(unbalanced, no_map, false, {{0,0,0,1}}));
+  CHECK(paired(red_green, no_map, true, {{2,0,0,2}}));
+  CHECK(paired(red_green, teams, false, {{2,0,0,2}}));
+  int rg[4]; outcome_teams(red_green, no_map, false, rg);
+  const int placements[4] = {1,0,0,1};
+  CHECK(team_winner(1,-1,placements,red_green) == -1 && team_winner(1,-1,placements,rg) == 0);
+  CHECK(room_team_outcome(team_winner(1,-1,placements,rg),ids,rg,no_map,false) ==
+        json({{"ranking",{ids[1],ids[2],ids[0],ids[3]}},{"detail",{{"tw",0}}}}));
+
+  Games private_games; private_games.start_game("private-teams");
+  private_games.report_team_result(room_team_outcome(0,ids,teams,no_map,false));
+  json private_finish = win0; private_finish["t"] = "finish"; private_finish["matchId"] = "private-teams";
+  CHECK(private_games.due(1,false,0,ids) == std::vector<json>({private_finish}));
+
+  Games games; games.start_game(); games.report_team(0,ids,teams);
+  CHECK(games.due(1,true,7,ids)[0] == json({{"t","begin"},{"revision",7}}));
+  games.started("teams-1");
+  json expected = win0; expected["t"] = "finish"; expected["matchId"] = "teams-1";
+  CHECK(games.due(2,false,7,ids) == std::vector<json>({expected}));
+  games.start_game(); games.report_team(1,ids,teams);
+  ids[0] = "replacement"; teams[0] = 0; // retries and queued games retain their original roster
+  CHECK(games.due(2002,false,8,ids) == std::vector<json>({expected}));
+  games.receive({{"t","result"},{"matchId","wrong"}});
+  CHECK(games.due(4002,false,8,ids) == std::vector<json>({expected}));
+  games.receive({{"t","result"},{"matchId","teams-1"}});
+  games.started("teams-2"); expected = win1; expected["t"] = "finish"; expected["matchId"] = "teams-2";
+  CHECK(games.due(4003,false,8,ids) == std::vector<json>({expected}));
+  games.receive({{"t","result"},{"matchId","teams-2"}});
+  CHECK(games.due(4004,false,8,ids).empty());
+  games.start_game("teams-void"); games.report_team(-1,ids,teams);
+  CHECK(games.due(4005,false,8,ids)[0] == json({{"t","finish"},{"matchId","teams-void"},{"void",true}}));
+
+  RoomState<Socket> legacy; legacy.socket = std::make_unique<Socket>(); legacy.socket->broker = false;
+  legacy.match_id = "legacy-teams"; legacy.pending_team_result = win0;
+  expected = win0; expected["t"] = "finish"; expected["matchId"] = "legacy-teams";
+  CHECK(due_messages(legacy,1) == std::vector<json>({expected}));
+  CHECK(due_messages(legacy,2).empty());
+}
+
+int main() {
+  room_teams(); team_results(); team_reports();
+  std::puts("yougame_teams: roster/pump mapping, exhaustive end-record results, stable 4-seat finish/retries/void passed");
+}
diff --git a/port/tests/yougame_transport_test.cpp b/port/tests/yougame_transport_test.cpp
new file mode 100644
index 0000000..f5b6939
--- /dev/null
+++ b/port/tests/yougame_transport_test.cpp
@@ -0,0 +1,302 @@
+// Offline: clang++ -std=c++20 -Iport/runtime/hle -Iport/third_party ...
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_transport.h"
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr,"line %d: %s\n",__LINE__,#x); std::exit(1); } } while (0)
+using namespace yougame::transport;
+
+static json participants() {
+  return json::array({{{"id","a"},{"connectionId","a"},{"slot",0},{"localIndex",0},{"user","account-a"}},
+                      {{"id","b"},{"connectionId","b"},{"slot",1},{"localIndex",0},{"user","account-b"}}});
+}
+static json welcome() {
+  return {{"t","welcome"},{"me","a"},{"room",{{"code","abcdef"}}},{"matchId","set-1"},
+          {"participants",participants()},{"players",json::array({{{"id","a"},{"user","account-a"}},{{"id","b"},{"user","account-b"}}})}};
+}
+static void mode_and_candidates() {
+  CHECK(!Mode::hello(json::object()).broker);
+  CHECK(posix_datagram_route(json::object())==DatagramRoute::Standalone);
+  json h={{"netBroker",{{"version",1},{"mode","internet"}}}};
+  CHECK(!Mode::hello(h).broker && !Mode::hello(h).direct);
+  CHECK(posix_datagram_route(h)==DatagramRoute::Standalone);
+  h["netBroker"]["mode"]="yougame";
+  CHECK(Mode::hello(h).broker && !Mode::hello(h).direct);
+  CHECK(posix_datagram_route(h)==DatagramRoute::Refuse);
+  h["netBroker"]["direct"]={{"version",1},{"maxDatagram",1200}};
+  CHECK(Mode::hello(h).direct);
+  CHECK(posix_datagram_route(h)==DatagramRoute::Ring);
+  for (const char* key : {"version", "maxDatagram"}) {
+    json bad=h; bad["netBroker"]["direct"][key]=key==std::string("version")?1.5:1200.5;
+    CHECK(posix_datagram_route(bad)==DatagramRoute::Refuse);
+    bad=h; bad["netBroker"]["direct"][key]=true;
+    CHECK(posix_datagram_route(bad)==DatagramRoute::Refuse);
+    bad=h; bad["netBroker"]["direct"][key]=uint64_t(1)<<63;
+    CHECK(posix_datagram_route(bad)==DatagramRoute::Refuse);
+  }
+  h["netBroker"]["direct"]["maxDatagram"]=1400;
+  CHECK(!Mode::hello(h).direct && Mode::hello(h).unsupported);
+  CHECK(posix_datagram_route(h)==DatagramRoute::Refuse);
+  h["netBroker"]["version"]=2;
+  CHECK(posix_datagram_route(h)==DatagramRoute::Refuse);
+  h["netBroker"]["version"]="bad";
+  CHECK(posix_datagram_route(h)==DatagramRoute::Refuse);
+  PosixAttachment p;
+  const json valid={{"posix",{{"version",1},{"section",3},{"wake",4},{"wait",5},{"size",655744}}}};
+  CHECK(posix_attachment(valid,p) && p.section==3 && p.wake==4 && p.wait==5 && p.size==655744);
+  CHECK(!posix_attachment(json::object(),p));
+  for (const char* key : {"version","section","wake","wait","size"}) {
+    json bad=valid; bad["posix"].erase(key); CHECK(!posix_attachment(bad,p));
+    bad=valid; bad["posix"][key]=-1; CHECK(!posix_attachment(bad,p));
+    bad=valid; bad["posix"][key]=3.5; CHECK(!posix_attachment(bad,p));
+    bad=valid; bad["posix"][key]="3"; CHECK(!posix_attachment(bad,p));
+  }
+  for (const char* key : {"section","wake","wait"}) {
+    json bad=valid; bad["posix"][key]=uint64_t(INT_MAX)+4; CHECK(!posix_attachment(bad,p));
+  }
+  json bad=valid; bad["posix"]["version"]=2; CHECK(!posix_attachment(bad,p));
+  const auto d=candidate(true,"mu-test","TAG#1","yg-match","legacy-lan","legacy-ext","test-only");
+  CHECK(d==json({{"kind","mu-cand"},{"v",2},{"compat","mu-test"},{"code","TAG#1"},{"match","yg-match"}}));
+  const auto legacy=candidate(false,"mu-test","TAG#1","yg-match","legacy-lan","legacy-ext","test-only");
+  CHECK(legacy.count("lan") && legacy.count("ext") && legacy.count("token"));
+}
+static void broker_ordering() {
+  Events events; std::vector<json> sent; int next=1;
+  Stream s(events,[&](const json& q,int) {
+    sent.push_back(q);
+    if(q["type"]=="netOpen") {
+      const int id=next++;
+      // All pushes arrive before netOpen's answer, as on a fast broker socket.
+      events.push({{"conn",id},{"event","open"}});
+      events.push({{"conn",id},{"event","message"},{"data",json({{"t","welcome"}}).dump()}});
+      events.push({{"conn",id},{"event","message"},{"data",json({{"t","matched"},{"room","abcdef"}}).dump()}});
+      return json{{"conn",id}};
+    }
+    return json();
+  });
+  CHECK(s.open("test-ticket","",100));
+  CHECK(sent[0]==json({{"type","netOpen"},{"ticket","test-ticket"}}));
+  json m; CHECK(s.next(m,0) && m["t"]=="welcome");
+  CHECK(s.next(m,0) && m["t"]=="matched");
+  CHECK(s.send({{"t","ping"},{"at",1}}));
+  CHECK(sent.back()==json({{"type","netSend"},{"conn",1},{"data","{\"at\":1,\"t\":\"ping\"}"}}));
+  events.push({{"conn",1},{"event","close"},{"code",1006}});
+  CHECK(!s.next(m,0) && s.closed() && s.close_code()==1006);
+  CHECK(s.open("fresh-test-ticket","abcdef",100));
+  CHECK(std::none_of(sent.begin(),sent.end(),[](const json& q){return q["type"]=="netClose";}));
+  CHECK(sent.back()==json({{"type","netOpen"},{"ticket","fresh-test-ticket"},{"room","abcdef"}}));
+  CHECK(s.next(m,0) && m["t"]=="welcome");
+  s.close();
+  // No send while opening: it must wait for the open push, even after the response arrived.
+  Stream slow(events,[&](const json& q,int) { sent.push_back(q); return json{{"conn",3}}; });
+  CHECK(!slow.open("test-ticket","abcdef",1));
+  CHECK(!slow.send({{"t","begin"}}));
+  CHECK(sent.back()["type"]=="netOpen");
+  CHECK(!slow.closed()); // still opening: a late app open remains the same connection
+  events.push({{"conn",3},{"event","open"}});
+  CHECK(slow.open("test-ticket","abcdef",100));
+  CHECK(slow.send({{"t","begin"}}));
+
+}
+static void closed_during_event_wait() {
+  std::mutex wait_mutex;
+  std::condition_variable wait_cv;
+  bool waiting = false, release = false;
+  Events events([&](int ms) {
+    std::unique_lock<std::mutex> lock(wait_mutex);
+    waiting = true;
+    wait_cv.notify_one();
+    wait_cv.wait_for(lock, std::chrono::milliseconds(ms), [&] { return release; });
+  });
+  Stream s(events, [&](const json& q, int) -> json {
+    if (q["type"] == "netOpen") {
+      events.push({{"conn", 1}, {"event", "open"}});
+      return {{"conn", 1}};
+    }
+    return nullptr;
+  });
+  CHECK(s.open("test-ticket", "abcdef", 100));
+  std::thread reader([&] { json m; CHECK(!s.next(m, 300)); });
+  {
+    std::unique_lock<std::mutex> lock(wait_mutex);
+    CHECK(wait_cv.wait_for(lock, std::chrono::seconds(2), [&] { return waiting; }));
+  }
+  const auto start = std::chrono::steady_clock::now();
+  const bool closed = s.closed();
+  const auto elapsed = std::chrono::steady_clock::now() - start;
+  {
+    std::lock_guard<std::mutex> lock(wait_mutex);
+    release = true;
+  }
+  wait_cv.notify_one();
+  reader.join();
+  CHECK(!closed);
+  CHECK(elapsed < std::chrono::milliseconds(20));
+}
+static void closed_state_transitions() {
+  Events events; int next = 1;
+  Stream s(events, [&](const json& q, int) -> json {
+    if (q["type"] == "netOpen") {
+      const int id = next++;
+      events.push({{"conn", id}, {"event", "open"}});
+      return {{"conn", id}};
+    }
+    return nullptr;
+  });
+  CHECK(s.closed());
+  CHECK(s.open("test-ticket", "abcdef", 100) && !s.closed());
+  events.push({{"conn", 1}, {"event", "close"}, {"code", 1006}});
+  json m;
+  CHECK(!s.next(m, 0));
+  CHECK(s.closed() && !s.ready() && s.close_code() == 1006);
+  CHECK(!s.send({{"t", "ping"}}));
+  CHECK(s.open("test-ticket", "abcdef", 100) && !s.closed());
+  s.close();
+  CHECK(s.closed() && !s.ready());
+  CHECK(!s.send({{"t", "ping"}}) && !s.next(m, 0));
+}
+static void unranked_recovery() {
+  Games games;
+  const std::vector<std::string> ids={"a","b"};
+  games.start_game(); games.start_game(); // repeated frame 1 counts once
+  CHECK(games.due(1,true,7,ids)[0]==json({{"t","begin"},{"revision",7}}));
+  games.started("game-1"); games.report(0);
+  auto finish=games.due(2,true,7,ids);
+  CHECK(finish[0]==json({{"t","finish"},{"matchId","game-1"},{"winner","a"}}));
+  // Both games finish during the outage. An older finish and its receipt retain their identity.
+  games.start_game(); games.report(1);
+  CHECK(games.due(14000,true,8,ids)==finish);
+  games.receive({{"t","result"},{"matchId","wrong"}});
+  CHECK(games.due(16000,true,8,ids)==finish);
+  games.receive({{"t","result"},{"matchId","game-1"}});
+  CHECK(games.due(16001,true,8,ids)[0]["t"]=="begin");
+  games.started("game-2");
+  CHECK(games.due(16002,true,8,ids)[0]==json({{"t","finish"},{"matchId","game-2"},{"winner","b"}}));
+  games.receive({{"t","result"},{"matchId","game-1"}}); // duplicate old receipt does not retire game 2
+  CHECK(games.due(18002,true,8,ids)[0]["matchId"]=="game-2");
+  games.receive({{"t","result"},{"matchId","game-2"}});
+  CHECK(games.due(18003,true,8,ids).empty());
+  Games nonhost; nonhost.started("early"); nonhost.start_game("early"); nonhost.report(-1);
+  CHECK(nonhost.due(1,false,8,ids)[0]==json({{"t","finish"},{"matchId","early"},{"void",true}}));
+}
+static void link_budget() {
+  uint64_t clock=10; std::vector<json> sent; unsigned next=1;
+  const auto request=[&](const json& q,int budget) { CHECK(budget>0 && budget<=12000); sent.push_back(q); return json{{"link",next++}}; };
+  Links links;
+  CHECK(open_links(links,7,{"b","c","d"},request,[](unsigned){return 2;},[&]{return clock;},[&]{clock+=10;},[]{return false;}));
+  CHECK(links.ids==std::vector<unsigned>({1,2,3}));
+  CHECK(sent[0]==json({{"type","directOpen"},{"conn",7},{"peer","b"}}));
+  CHECK(sent.size()==3);
+  links={}; clock=10;
+  CHECK(!open_links(links,7,{"b"},request,[](unsigned){return 1;},[&]{return clock;},[&]{clock+=10;},[]{return false;}));
+  CHECK(clock==12010); // one 12 s budget, no per-peer extension
+  links={}; clock=10;
+  CHECK(!open_links(links,7,{"b"},request,[](unsigned){return 3;},[&]{return clock;},[&]{clock+=10;},[]{return false;}));
+  CHECK(clock==10);
+  CHECK(retry_link_failure(1) && retry_link_failure(3));
+  CHECK(!retry_link_failure(0) && !retry_link_failure(2));
+  links={};
+  CHECK(!open_links(links,7,{"b"},[](const json&,int)->json{throw std::runtime_error("refused");},[](unsigned){return 1;},[&]{return clock;},[]{},[]{return false;}));
+}
+static Recovery recovery() { Recovery r; r.configure("abcdef","a",participants()); r.start("set-1"); return r; }
+static void recovery_and_ranked() {
+  auto r=recovery();
+  yougame::ranked::Set set; set.configure(0,{"a","b"}); set.start_game();
+  CHECK(set.due(1,true,7)[0]["t"]=="begin");
+  set.receive({{"t","start"},{"matchId","set-1"}});
+  yougame::ranked::Game game; game.index=1; game.winner=0; set.report_game(game);
+  auto report=set.due(100,true,7); CHECK(report.size()==1 && report[0]["t"]=="game-report");
+  CHECK(r.dropped(101,true));
+  CHECK(r.dropped(14000,true) && r.remaining(14000)==1101); // repeats do not extend grace
+  auto partial=welcome(); partial["players"].erase(1);
+  CHECK(!r.restore(partial,5000) && r.pending());
+  CHECK(r.restore(welcome(),14000) && !r.pending());
+  auto resumed=set.due(14000,true,8);
+  CHECK(resumed.size()==1 && resumed[0]==report[0] && set.needs_drain() && !set.closed());
+  set.receive({{"t","game-result"},{"matchId","set-1"},{"id","g1-t0"},{"ranking",{"a","b"}}});
+  CHECK(set.games_received()==1);
+  set.start_game(); game.index=2; set.report_game(game);
+  CHECK(set.due(16000,true,8)[0]["t"]=="game-report");
+  set.receive({{"t","game-result"},{"matchId","set-1"},{"id","g2-t0"},{"ranking",{"a","b"}}});
+  CHECK(set.decided() && set.due(18000,true,8)[0]["t"]=="finish");
+  set.receive({{"t","result"},{"matchId","set-1"},{"ranking",{"a","b"}}});
+  CHECK(set.settled() && !set.needs_drain());
+  for(int kind=0;kind<6;kind++) {
+    r=recovery(); CHECK(r.dropped(1,true)); auto bad=welcome();
+    if(kind==0) bad["room"]["code"]="other";
+    if(kind==1) bad["me"]="other";
+    if(kind==2) bad["participants"][1]["slot"]=2;
+    if(kind==3) bad["participants"][1]["user"]="other-account";
+    if(kind==4) bad["matchId"]="another-set";
+    if(kind==5) bad["players"][1]["user"]="other-account";
+    CHECK(!r.restore(bad,10) && r.expired(10));
+  }
+  r=recovery(); CHECK(!r.leave({{"t","leave"},{"id","b"}},1,false));
+  r=recovery(); CHECK(!r.dropped(1,false));
+  r=recovery(); CHECK(r.dropped(1,true) && !r.restore(welcome(),15001));
+}
+static void leave_reasons() {
+  for (const auto* reason : {"left", "kicked"}) for (bool pending : {false, true}) {
+    auto r=recovery();
+    Links links; links.ids={1,257}; std::vector<json> closed;
+    const auto record=[&](const json& q,int)->json { closed.push_back(q); return nullptr; };
+    if (pending) CHECK(r.leave({{"t","leave"},{"id","b"},{"reason","dropped"}},1,true));
+    CHECK(!r.leave({{"t","leave"},{"id","b"},{"reason",reason}},5000,true));
+    CHECK(r.expired(5000) && !r.pending() && r.remaining(5000)==0);
+    // Definitive roster departures cancel peer recovery and close links immediately.
+    if (r.expired(5000)) close_links(links,record);
+    CHECK(links.ids.empty() && closed==std::vector<json>({{{"type","directClose"},{"link",1}},{{"type","directClose"},{"link",257}}}));
+    close_links(links,record); CHECK(closed.size()==2);
+    CHECK(!r.restore(welcome(),5000) && !r.dropped(5000,true));
+    CHECK(!r.pending() && r.remaining(5000)==0);
+  }
+  for (bool reason : {false, true}) {
+    auto r=recovery(); Links links; links.ids={1,257};
+    json leave={{"t","leave"},{"id","b"}}; if (reason) leave["reason"]="dropped";
+    CHECK(r.leave(leave,1,true) && r.pending());
+    CHECK(r.leave(leave,5000,true) && r.remaining(5000)==10001);
+    CHECK(!r.expired(15000) && r.remaining(15000)==1);
+    CHECK(links.ids==std::vector<unsigned>({1,257}));
+    CHECK(!r.leave(leave,15001,true) && r.expired(15001));
+    CHECK(!r.restore(welcome(),15001));
+    int closes=0; close_links(links,[&](const json&,int)->json { ++closes; return nullptr; });
+    CHECK(links.ids.empty() && closes==2);
+    r=recovery(); CHECK(r.leave(leave,1,true));
+    CHECK(r.restore(welcome(),15000) && !r.pending() && !r.expired(15001));
+  }
+}
+
+// Model the room pump with real broker frames and the shared lifecycle policies. Links are
+// opened in the lobby, then keep their ids through start/result/rematch with an unchanged roster.
+static void lobby_match_links() {
+  Events events; std::vector<json> requests;
+  const auto request=[&](const json& q,int)->json {
+    requests.push_back(q);
+    if(q["type"]=="netOpen") { events.push({{"conn",7},{"event","open"}}); return {{"conn",7}}; }
+    if(q["type"]=="directOpen") return {{"link",257}};
+    return nullptr;
+  };
+  Stream socket(events,request); CHECK(socket.open("test-ticket","abcdef",100));
+  Links links;
+  CHECK(open_links(links,7,{"b"},request,[](unsigned){return 2;},[]{return uint64_t(1);},[]{},[]{return false;}));
+  Recovery r; r.configure("abcdef","a",participants()); Games games;
+  for(const auto* match : {"game-1","game-2"}) {
+    games.start_game(); CHECK(games.due(1,true,7,{"a","b"})[0]["t"]=="begin");
+    json start={{"t","start"},{"matchId",match},{"participants",participants()},{"players",welcome()["players"]}};
+    events.push({{"conn",7},{"event","message"},{"data",start.dump()}});
+    json m; CHECK(socket.next(m,0) && m==start);
+    r.start(yougame::ranked::str(m,"matchId")); games.started(yougame::ranked::str(m,"matchId"));
+    CHECK(!r.pending() && !r.expired(1) && links.ids==std::vector<unsigned>({257}));
+    games.report(0); CHECK(games.due(2,true,7,{"a","b"})[0]["matchId"]==match);
+    games.receive({{"t","result"},{"matchId",match}}); r.result();
+    CHECK(!r.expired(2) && links.ids==std::vector<unsigned>({257}));
+  }
+  CHECK(requests.size()==2 && requests[0]["type"]=="netOpen" && requests[1]["type"]=="directOpen");
+  close_links(links,request); CHECK(requests.size()==3 && requests.back()["type"]=="directClose");
+}
+int main() {
+  closed_during_event_wait(); closed_state_transitions();
+  mode_and_candidates(); broker_ordering(); unranked_recovery(); link_budget(); recovery_and_ranked(); leave_reasons(); lobby_match_links();
+  std::puts("yougame_transport: mode, candidates, broker ordering, link timeout/retry, leave reasons, lobby/match links, seat recovery and ranked resume passed");
+}
diff --git a/port/tests/yougame_ux_test.cpp b/port/tests/yougame_ux_test.cpp
new file mode 100644
index 0000000..ffce074
--- /dev/null
+++ b/port/tests/yougame_ux_test.cpp
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_ux.h"
+#include "yougame_parity.h"
+#include "settings_chord.h"
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <thread>
+#include <vector>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+namespace {
+std::vector<std::string> lines;
+void write_line(const char* line) { lines.emplace_back(line); }
+void pause_cases() {
+  using nlohmann::json;
+  using Outcome = yougame::ux::PagePause::Outcome;
+  yougame::ux::PagePause pause;
+  bool frozen = false;
+  std::vector<bool> writes;
+  auto set = [&](bool value) { frozen = value; writes.push_back(value); };
+  auto tick = [&](bool stdio = true, bool online = false, bool match = true,
+                  uint32_t scene = 0x202, uint32_t frame = 20) {
+    return pause.tick(stdio, online, match, scene, frame, frozen, set);
+  };
+  auto check = [](yougame::ux::PagePause::Result result, Outcome expected,
+                  bool released_scene = false) {
+    CHECK(result.outcome == expected);
+    CHECK(result.released_scene == released_scene);
+  };
+  auto push = [&](bool value) { CHECK(pause.push(json{{"type", "pause"}, {"paused", value}})); };
+  check(tick(), Outcome::None);
+  // Same JSON object handed to the push branch by handle_app_line.
+  std::thread stdin_reader([&] { CHECK(pause.push(json::parse(
+      R"({"push":{"type":"pause","paused":true}})")["push"])); });
+  stdin_reader.join();
+  CHECK(writes.empty());  // Stdin cannot touch simulation state.
+  check(tick(), Outcome::Applied); CHECK(frozen && writes == std::vector<bool>{true});
+  check(tick(), Outcome::None); CHECK(writes.size() == 1);
+  push(true); check(tick(), Outcome::IgnoredAlreadyPaused); CHECK(writes.size() == 1);
+  for (const char* text : {"null", "[]", "true", "{}", R"({"type":"pause"})",
+       R"({"type":"pause","paused":null})", R"({"type":"pause","paused":1})",
+       R"({"type":"pause","paused":0})", R"({"type":"pause","paused":"false"})",
+       R"({"type":"pause","paused":[]})", R"({"type":"pause","paused":{}})",
+       R"({"type":1,"paused":true})", R"({"type":"notice","paused":false})"}) {
+    CHECK(!pause.push(json::parse(text))); check(tick(), Outcome::None);
+    CHECK(frozen && writes.size() == 1);
+  }
+  push(false); check(tick(), Outcome::Cleared);
+  CHECK(!frozen && writes == (std::vector<bool>{true, false}));
+  push(false); check(tick(), Outcome::IgnoredUnownedResume); CHECK(writes.size() == 2);
+  // Both request values are consumed in standalone/online/non-match states, never deferred.
+  for (bool desired : {true, false}) {
+    push(desired); check(tick(false), Outcome::IgnoredNotInMatch);
+    check(tick(), Outcome::None);
+    push(desired); check(tick(true, true), Outcome::IgnoredOnline);
+    check(tick(true, true), Outcome::None);
+    push(desired); check(tick(true, true, false), Outcome::IgnoredOnline);
+    check(tick(), Outcome::None);
+    push(desired); check(tick(true, false, false), Outcome::IgnoredNotInMatch);
+    check(tick(true, false, false), Outcome::None);
+  }
+  CHECK(!frozen && writes.size() == 2);
+  // Preserve a preexisting engine pause on page resume.
+  frozen = true;
+  push(true); check(tick(), Outcome::IgnoredAlreadyPaused);
+  push(false); check(tick(), Outcome::IgnoredUnownedResume);
+  CHECK(frozen && writes.size() == 2);
+  frozen = false;
+  push(true); push(false); check(tick(), Outcome::IgnoredUnownedResume);
+  CHECK(!frozen && writes.size() == 2);  // Latest desired state wins before retrace.
+  push(true); check(tick(), Outcome::Applied); CHECK(frozen);
+  // A new scene owns its flags; stale resume must not clear them. Both events are reported.
+  push(false); check(tick(true, false, true, 0x1C02), Outcome::IgnoredUnownedResume, true);
+  CHECK(frozen && writes.size() == 3);
+  check(tick(true, false, true, 0x1C02), Outcome::None);  // Release is reported only once.
+  frozen = false; push(true);
+  check(tick(true, false, true, 0x1C02, 30), Outcome::Applied); CHECK(frozen);
+  push(false); check(tick(true, false, true, 0x1C02, 0), Outcome::IgnoredUnownedResume, true);
+  CHECK(frozen && writes.size() == 4);
+  frozen = false; push(true); check(tick(), Outcome::Applied); CHECK(frozen);
+  push(false); check(tick(true, true), Outcome::IgnoredOnline);
+  CHECK(frozen && writes.size() == 5);
+  push(false); check(tick(), Outcome::IgnoredUnownedResume); CHECK(frozen);
+
+  // Scene/frame changes without a request report a release once, without a setter call.
+  for (bool scene_change : {true, false}) {
+    frozen = false; push(true); check(tick(), Outcome::Applied);
+    const auto count = writes.size();
+    const uint32_t scene = scene_change ? 0x1C02 : 0x202;
+    const uint32_t frame = scene_change ? 21 : 0;
+    check(tick(true, false, true, scene, frame), Outcome::None, true);
+    check(tick(true, false, true, scene, frame + 1), Outcome::None);
+    push(false);
+    check(tick(true, false, true, scene, frame + 2), Outcome::IgnoredUnownedResume);
+    CHECK(frozen && writes.size() == count);
+  }
+  // A scene transition may also consume a fresh pause and acquire ownership again.
+  frozen = false; push(true); check(tick(), Outcome::Applied);
+  frozen = false; push(true);
+  check(tick(true, false, true, 0x1C02), Outcome::Applied, true);
+  push(false); check(tick(true, false, true, 0x1C02), Outcome::Cleared);
+  CHECK(!frozen);
+  // Non-match and standalone transitions still discard ownership without changing flags.
+  for (bool stdio : {true, false}) {
+    push(true); check(tick(), Outcome::Applied);
+    const auto count = writes.size();
+    check(tick(stdio, false, false), Outcome::None);
+    push(false); check(tick(), Outcome::IgnoredUnownedResume);
+    CHECK(frozen && writes.size() == count);
+    frozen = false;
+  }
+}
+
+// What the page hears (yg {"event":{"type":"pause",...}}): every change, and an answer to every request.
+void pause_event_cases() {
+  using nlohmann::json;
+  using Result = yougame::ux::PagePause::Result;
+  yougame::ux::PagePause pause;
+  bool frozen = false;
+  auto set = [&](bool value) { frozen = value; };
+  auto tick = [&](bool online = false, bool match = true, uint32_t scene = 0x202, uint32_t frame = 20,
+                  bool stdio = true) {
+    return pause.tick(stdio, online, match, scene, frame, frozen, set);
+  };
+  auto event = [](const Result& r, bool pausable, bool paused, const char* reason) {
+    CHECK(r.event && r.pausable == pausable && r.paused == paused);
+    CHECK(reason ? (r.reason && std::string(r.reason) == reason) : r.reason == nullptr);
+  };
+  auto push = [&](bool value) { CHECK(pause.push(json{{"type", "pause"}, {"paused", value}})); };
+  // The first tick tells the page where it stands; then nothing until something changes.
+  event(tick(false, false, 0x101), false, false, "not-in-match");   // a menu
+  CHECK(!tick(false, false, 0x101).event);
+  push(true); event(tick(false, false, 0x101), false, false, "not-in-match");   // answered, not applied
+  CHECK(!frozen);
+  event(tick(), true, false, nullptr);   // a local match: pausable
+  CHECK(!tick().event);
+  push(true); event(tick(), true, true, nullptr); CHECK(frozen);     // applied
+  push(true); event(tick(), true, true, nullptr);                    // already paused: still answered
+  push(false); event(tick(), true, false, nullptr); CHECK(!frozen);  // cleared
+  push(false); event(tick(), true, false, nullptr);                  // a resume nobody asked for: answered
+  push(true); CHECK(tick().event && frozen);
+  event(tick(false, true, 0x1C02), true, false, "scene-changed");    // a new scene drops the page's pause
+  CHECK(!tick(false, true, 0x1C02).event);
+  event(tick(true, true, 0x1C02), false, false, "online");           // online: never pausable
+  push(true); event(tick(true, true, 0x1C02), false, false, "online");
+  CHECK(!tick(true, true, 0x1C02).event);
+  // A Start pause is the player's own: the page's request is answered paused:false.
+  frozen = true; event(tick(false, true, 0x1C02), true, false, nullptr);
+  push(true); event(tick(false, true, 0x1C02), true, false, nullptr);
+  frozen = false;
+  // Without the stdio bridge there is nobody to tell.
+  push(true); CHECK(!tick(false, true, 0x1C02, 20, false).event);
+}
+
+void pad_cases() {
+  using namespace yougame::parity;
+  Signals signals;
+  signals.start(true, write_line);
+  lines.clear();
+  OverlayPad pad;
+  bool legacy[4]{};
+  auto sample = [&](uint16_t raw, uint64_t time, bool stdio = true, int port = 0, bool connected = true) {
+    signals.emit(pad.tick(time));
+    uint16_t gameplay = raw;
+    host::settings_shortcut::poll_z_start(connected, gameplay, legacy[port]);
+    signals.emit(pad.poll(stdio, port, connected, raw, time, legacy[port]));
+    if (!(raw & 0x1000)) gameplay &= static_cast<uint16_t>(~0x1000);
+    return gameplay;
+  };
+  CHECK(sample(0x1000, 0) == 0x1000); CHECK(lines.empty());  // Start alone.
+  CHECK(sample(0x1004, 1) == 0x1004); CHECK(lines.empty());  // Down added after Start.
+  sample(0, 2);
+  CHECK(sample(0x0004, 3) == 0x0004);
+  CHECK(sample(0x1104, 4) == 0x0104); // Down held, Start edge; preserve A and Down.
+  CHECK(lines == std::vector<std::string>{kDown});
+  CHECK(sample(0x1104, 50) == 0x0104); CHECK(lines.size() == 1); // Repeats.
+  CHECK(sample(0x1100, 103) == 0x0100); CHECK(lines.size() == 1); // Down released first.
+  CHECK(sample(0x1100, 104) == 0x0100);
+  CHECK(lines == (std::vector<std::string>{kDown, kUp}));
+  sample(0x1004, 200); CHECK(lines.size() == 2);  // Held after expiry still cannot repeat.
+  sample(0, 201); CHECK(sample(0x1000, 202) == 0x1000); // Plain Start restored after release.
+  sample(0, 203);
+  sample(0x1004, 204); sample(0, 205); sample(0x1004, 206); // Rapid tap coalesces.
+  sample(0x1004, 304); CHECK(lines == (std::vector<std::string>{kDown, kUp, kDown, kUp}));
+  sample(0, 305); sample(0x1004, 306, true, 3); sample(0, 406, true, 3);
+  CHECK(lines.size() == 6 && lines[4] == kDown && lines[5] == kUp); // Every port.
+  sample(0, 407); CHECK(sample(0x1114, 408) == 0x0100); // Legacy 3-button settings still wins.
+  CHECK(lines.size() == 6);
+  sample(0, 409); CHECK(sample(0x1104, 410, false) == 0x1104); CHECK(lines.size() == 6);
+  sample(0, 411); sample(0x1004, 412, true, 0, false); CHECK(lines.size() == 6);
+  sample(0x1004, 413); CHECK(lines.size() == 7);
+  sample(0, 414, true, 0, false); sample(0, 513); CHECK(lines.size() == 8 && lines.back() == kUp);
+}
+} // namespace
+int main() {
+  pause_cases(); pause_event_cases(); pad_cases();
+  CHECK(std::string(yougame::parity::kMenuHint) == "Escape / YouGame menu (D-pad + Start)");
+  std::puts("YouGame page pause and controller menu passed");
+}
