@@ -0,0 +1,65 @@
+// Source content views preserve standalone behavior and isolate YouGame Ranked/Unranked mods.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "native_online_policy.h"
+#include "yougame_compatibility.h"
+#include <cstdio>
+#include <initializer_list>
+#include <string>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); return 1; } } while (0)
+
+int main() {
+  using namespace slippi::online;
+  const std::string fp = "0123456789abcdef" + std::string(48, 'a');
+  struct FingerprintCase { std::string value; bool valid; };
+  const FingerprintCase fingerprints[] = {
+    {fp, true}, {"", false}, {fp.substr(0, 63), false}, {fp + "0", false},
+    {std::string(64, 'g'), false}, {std::string(64, 'A'), false}
+  };
+
+  // Full cross product, including every mode, two offline IDs and an unknown online ID.
+  // Today's standalone table: no mod -> retail; offline -> mod; Direct -> mod iff
+  // enabled and not a plain opponent; Ranked/Unranked/Teams/Party/unknown -> retail.
+  int rows = 0;
+  for (bool has_mod : {false, true})
+    for (int mode : {-2, -1, 0, 1, 2, 3, 4, 5})
+      for (bool yougame : {false, true})
+        for (bool plain : {false, true})
+          for (bool setting : {false, true})
+            for (const auto& fingerprint : fingerprints) {
+              const bool today = has_mod && (mode < 0 || (mode == 2 && !plain && setting));
+              const bool added = has_mod && yougame && (mode == 0 || mode == 1) && fingerprint.valid;
+              const bool actual = native_source_mod_view(has_mod, mode, yougame, plain, setting,
+                                                         fingerprint.value);
+              if (actual != (today || added)) {
+                std::fprintf(stderr, "view mismatch: mod=%d mode=%d yougame=%d plain=%d setting=%d valid=%d\n",
+                             has_mod, mode, yougame, plain, setting, fingerprint.valid);
+                return 1;
+              }
+              if (!yougame) CHECK(actual == today);
+              ++rows;
+            }
+  CHECK(rows == 768);
+
+  // A Source mod view feeds both the room key and the full-fingerprint peer verdict.
+  for (int mode : {0, 1}) {
+    const bool mod_view = native_source_mod_view(true, mode, true, false, false, fp);
+    CHECK(mod_view);
+    const auto mod_key = yougame::compatibility_key("0.9.52", mod_view, fp);
+    CHECK(mod_key == "mu-0.9.52-mod-0123456789abcdef");
+    CHECK(mod_key != yougame::compatibility_key("0.9.52", false, ""));
+    CHECK(!native_yougame_online_builds_match(mod_view, fp, false, ""));
+    CHECK(native_yougame_online_builds_match(mod_view, fp, true, fp));
+    // Matching room suffixes alone cannot bypass the full build check.
+    std::string same_prefix = fp;
+    same_prefix.back() = 'b';
+    CHECK(mod_key == yougame::compatibility_key("0.9.52", true, same_prefix));
+    CHECK(!native_yougame_online_builds_match(mod_view, fp, true, same_prefix));
+
+    // Showing mod files alone never relaxes the fixed-rules roster/stage limits.
+    CHECK(!native_yougame_online_mod_content(true, mode, mod_view, false, fp));
+    CHECK(native_yougame_online_mod_content(true, mode, mod_view, true, fp));
+    CHECK(!native_yougame_online_mod_content(true, mode, mod_view, true, ""));
+  }
+  std::printf("source_mod_view: %d decision rows, room isolation and content gates ok\n", rows);
+}
diff --git a/port/tests/stage_read_pin_test.cpp b/port/tests/stage_read_pin_test.cpp
new file mode 100644
index 0000000..54743f3
--- /dev/null
+++ b/port/tests/stage_read_pin_test.cpp
@@ -0,0 +1,62 @@
+// Host-only regression checks for partial stage reads across online-state changes.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "stage_read_pin.h"
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+using Form = std::shared_ptr<const std::vector<unsigned char>>;
+using host::cosmetics::stage_read_pin::PinState;
+using host::cosmetics::stage_read_pin::pick;
+
+static Form form(std::size_t size, unsigned char byte) {
+  return std::make_shared<const std::vector<unsigned char>>(size, byte);
+}
+
+int main() {
+  const auto offline = form(1024, 1);
+  const auto next_offline = form(1024, 2);
+  const auto online = form(1024, 3);  // Online padding can make the lengths equal.
+  const auto next_online = form(1024, 6);
+  const auto longer = form(2048, 4);
+  PinState<Form> pin;
+
+  CHECK(pick(pin, offline, false, 0, offline->size()) == offline);
+  CHECK(pin.form == offline && !pin.online);
+  CHECK(pick(pin, next_offline, false, 512, next_offline->size()) == offline);
+  CHECK(pick(pin, longer, false, 512, longer->size()) == longer);
+  CHECK(pick(pin, next_offline, false, 768, next_offline->size()) == offline);
+
+  // A mid-file switch must discard the offline form even with identical lengths.
+  CHECK(pick(pin, online, true, 512, online->size()) == online);
+  CHECK(pin.form == online && pin.online);
+  CHECK(pick(pin, next_online, true, 768, next_online->size()) == online);
+  CHECK(pick(pin, next_offline, false, 768, next_offline->size()) == next_offline);
+  CHECK(pin.form == next_offline && !pin.online);
+  CHECK(pick(pin, offline, false, 896, offline->size()) == next_offline);
+
+  CHECK(pick(pin, online, true, 0, online->size()) == online);
+  CHECK(pick(pin, offline, false, 0, offline->size()) == offline);
+  CHECK(pick(pin, next_offline, false, 0, next_offline->size()) == next_offline);
+
+  // A first piece may start mid-file; a switch with a new length must pin too.
+  PinState<Form> mid_file;
+  CHECK(pick(mid_file, offline, false, 512, offline->size()) == offline);
+  CHECK(pick(mid_file, longer, true, 512, longer->size()) == longer);
+  CHECK(pick(mid_file, online, true, 768, online->size()) == online);
+  CHECK(pick(mid_file, longer, true, 1024, longer->size()) == longer);
+
+  // The runtime pin owns its bytes across runtime-state replacement.
+  PinState<Form> owned;
+  auto temporary = form(1024, 5);
+  std::weak_ptr<const std::vector<unsigned char>> lifetime = temporary;
+  CHECK(pick(owned, temporary, false, 0, temporary->size()) == temporary);
+  temporary.reset();
+  CHECK(!lifetime.expired());
+  CHECK(pick(owned, online, true, 512, online->size()) == online);
+  CHECK(lifetime.expired());
+  std::puts("stage_read_pin: partial reads, state switches and lifetime ok");
+}
