+  std::vector<std::string> targets;
+  const auto is_sha1 = [](const std::string& hash) {
+    return hash.size() == 40 && std::all_of(hash.begin(), hash.end(), [](char c) {
+      return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
