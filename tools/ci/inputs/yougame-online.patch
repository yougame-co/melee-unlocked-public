+#ifdef __APPLE__
+// One translation worker, no GL context or game-state access. Header-only for both Mac hosts.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <cstring>
+#include <deque>
+#include <filesystem>
