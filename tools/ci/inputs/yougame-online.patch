@@ -0,0 +1,353 @@
+// A foreign SDL/OpenGL surface following the YouGame player's window in screen points.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#import <AppKit/AppKit.h>
+#import <CoreGraphics/CoreGraphics.h>
+#include <SDL.h>
+#include "embed_mac.h"
+#include "embed_mac_state.h"
+#include "../runtime/hle/yougame_link.h"
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <memory>
+#include <mutex>
+
+// host::log reaches melee.log (--log-file); declared here to keep the Win32 compatibility headers out of AppKit.
+namespace host { void log(const char* fmt, ...); }
+
+@interface YGMeleeEmbedPanel : NSPanel
+@end
+@implementation YGMeleeEmbedPanel
+- (BOOL)canBecomeKeyWindow { return YES; }
+- (BOOL)canBecomeMainWindow { return (self.styleMask & NSWindowStyleMaskTitled) != 0; }
+// The panel sits exactly over the player box, which in full screen reaches the top of the screen. AppKit keeps ordinary
+// windows out of the menu bar's band and moved the panel down; track() set it back the next tick, and full screen
+// flickered (d0020's real-app check, 10-26). The fallback's titled window keeps AppKit's rule.
+- (NSRect)constrainFrameRect:(NSRect)frameRect toScreen:(NSScreen*)screen {
+  return (self.styleMask & NSWindowStyleMaskTitled) ? [super constrainFrameRect:frameRect toScreen:screen] : frameRect;
+}
+@end
+
+namespace mac_embed {
+namespace {
+Millis now_ms() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+struct Inbox {
+  std::mutex mutex;
+  std::deque<Command> commands;
+  bool quit = false;
+};
+struct Surface {
+  YGMeleeEmbedPanel* panel = nil;
+  SDL_Window* sdl = nullptr;
+  id activation = nil;
+  Tracker tracker;
+  SettleGate settle;
+  Presentation presentation;
+  std::shared_ptr<Inbox> inbox = std::make_shared<Inbox>();
+  bool allowed_visible = false, embedded = true, ordered = false;
+  bool wants_key = false;
+  int width = 0, height = 0;
+};
+std::unique_ptr<Surface> surface;
+std::optional<uint32_t> configured_parent;
+std::atomic<SDL_Window*> frame_window{nullptr};
+
+// Only IDs from these lists: never request window names, images or Screen Recording access.
+bool contains(CFArrayRef list, CGWindowID id) {
+  if (!list) return false;
+  for (CFIndex i = 0; i < CFArrayGetCount(list); ++i)
+    if (static_cast<CGWindowID>(reinterpret_cast<uintptr_t>(CFArrayGetValueAtIndex(list, i))) == id)
+      return true;
+  return false;
+}
+int number(CFDictionaryRef info, CFStringRef key) {
+  int value = 0;
+  auto n = static_cast<CFNumberRef>(CFDictionaryGetValue(info, key));
+  if (n && CFGetTypeID(n) == CFNumberGetTypeID()) CFNumberGetValue(n, kCFNumberIntType, &value);
+  return value;
+}
+Parent query_parent(CGWindowID id) {
+  Parent parent;
+  // OnScreenOnly excludes minimized windows and windows on other Spaces. Access only the
+  // matching window's number, bounds, layer and owner PID; never kCGWindowName/owner names.
+  if (CFArrayRef list = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly, kCGNullWindowID)) {
+    for (CFIndex i = 0; i < CFArrayGetCount(list); ++i) {
+      auto info = static_cast<CFDictionaryRef>(CFArrayGetValueAtIndex(list, i));
+      if (static_cast<CGWindowID>(number(info, kCGWindowNumber)) != id) continue;
+      parent.exists = true;
+      parent.owner = number(info, kCGWindowOwnerPID);
+      CGRect bounds{};
+      auto rect = static_cast<CFDictionaryRef>(CFDictionaryGetValue(info, kCGWindowBounds));
+      if (rect && CGRectMakeWithDictionaryRepresentation(rect, &bounds)) {
+        parent.bounds = {bounds.origin.x, bounds.origin.y, bounds.size.width, bounds.size.height};
+        parent.on_screen = number(info, kCGWindowLayer) == 0 && bounds.size.width > 0 && bounds.size.height > 0;
+      }
+      break;
+    }
+    CFRelease(list);
+  }
+  if (!parent.exists) {
+    // On recent macOS a minimized parent can disappear from IncludingWindow too. An ID-only
+    // All list distinguishes hidden from closed, without pulling metadata for other windows.
+    if (CFArrayRef all = CGWindowListCreate(kCGWindowListOptionAll, kCGNullWindowID)) {
+      parent.exists = contains(all, id);
+      CFRelease(all);
+    }
+  }
+  return parent;
+}
+void hide(Surface& s) {
+  if (s.ordered || s.panel.visible) [s.panel orderOut:nil];
+  s.ordered = false;
+}
+void fallback(Surface& s) {
+  hide(s);
+  s.embedded = false;
+  s.panel.styleMask = NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                      NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable;
+  s.panel.collectionBehavior = NSWindowCollectionBehaviorDefault;
+  s.panel.hidesOnDeactivate = NO;
+  s.panel.hasShadow = YES;
+  [s.panel setContentSize:NSMakeSize(s.width, s.height)];
+  [s.panel center];
+  [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+  if (s.allowed_visible) {
+    [s.panel makeKeyAndOrderFront:nil];
+    [s.panel makeMainWindow];
+  }
+  host::log("embed: parent gone for 2 seconds; using a regular window");
+}
+void track(Surface& s) {
+  if (!s.embedded) return;
+  s.tracker.tick(now_ms(), [&] { return query_parent(*configured_parent); });
+  // WindowServer may block: time inside the query is not observed stable time.
+  const auto now = now_ms();
+  if (s.tracker.fallback()) { fallback(s); return; }
+  const Parent& parent = s.tracker.parent();
+  bool show = s.allowed_visible && s.presentation.visible(parent);
+  s.settle.observe(now, show, parent.bounds);
+  const auto screens = NSScreen.screens;
+  const double primary_height = screens.count ? screens[0].frame.size.height : 0;
+  // The box is in the parent's backing pixels: convert with the app's scale when it sent one (0.13.1076+), else with
+  // the scale of the display holding most of the parent (older apps). Never both: dividing twice halves the panel.
+  double scale = s.presentation.app_scale;
+  const char* source = "from app";
+  if (!(scale > 0)) {
+    source = "from display overlap";
+    const Rect parent_cocoa{parent.bounds.x, primary_height - parent.bounds.y - parent.bounds.h, parent.bounds.w, parent.bounds.h};
+    double most = 0;
+    for (NSScreen* screen in screens) {
+      const NSRect f = screen.frame;
+      const double area = overlap_area(parent_cocoa, {f.origin.x, f.origin.y, f.size.width, f.size.height});
+      if (area > most) { most = area; scale = screen.backingScaleFactor; }
+    }
+    if (!(scale > 0)) scale = NSScreen.mainScreen ? NSScreen.mainScreen.backingScaleFactor : 1;
+  }
+  static double logged_scale = 0;
+  static const char* logged_source = nullptr;
+  if (scale != logged_scale || source != logged_source) {
+    logged_scale = scale; logged_source = source;
+    host::log("embed: scale %.2f %s", scale, source);
+  }
+  const Rect frame = screen_rect(parent.bounds, points_from_backing(s.presentation.box, scale), primary_height);
+  bool intersects_screen = false;
+  for (NSScreen* screen in screens) {
+    const NSRect bounds = screen.frame;
+    if (intersects(frame, {bounds.origin.x, bounds.origin.y, bounds.size.width, bounds.size.height}))
+      intersects_screen = true;
+  }
+  show = show && intersects_screen;
+  if (show && !s.ordered && !s.settle.ready(now)) show = false;
+  if (!show) { hide(s); return; }
+  const NSRect wanted = NSMakeRect(frame.x, frame.y, frame.w, frame.h);
+  // A frame AppKit would not keep is not set again every tick (that flickered): up to three more tries, a second apart,
+  // in case the refusal was passing (a Space switch, a full-screen animation), then it waits for the next new frame.
+  static NSRect refused = NSZeroRect;
+  static int refused_tries = 0;
+  static Millis refused_at = 0;
+  const bool retry = NSEqualRects(wanted, refused) && refused_tries < 4 && now - refused_at >= 1000;
+  if (!NSEqualRects(s.panel.frame, wanted) && (!NSEqualRects(wanted, refused) || retry)) {
+    [s.panel setFrame:wanted display:YES animate:NO];
+    const NSRect got = s.panel.frame;
+    if (NSEqualRects(got, wanted)) {
+      refused = NSZeroRect; refused_tries = 0;
+    } else {
+      if (!NSEqualRects(wanted, refused)) { refused = wanted; refused_tries = 0; }
+      ++refused_tries; refused_at = now;
+    }
+    // Once per new frame, with where AppKit put it if not there.
+    static Rect logged{};
+    if (!equal(logged, frame)) {
+      logged = frame;
+      const Rect& box = s.presentation.box;
+      const Rect& pb = parent.bounds;
+      char elsewhere[96] = "";
+      if (!NSEqualRects(got, wanted))
+        std::snprintf(elsewhere, sizeof elsewhere, " (AppKit placed it at %.1f,%.1f %.1fx%.1f)", got.origin.x, got.origin.y,
+                      got.size.width, got.size.height);
+      host::log("embed: panel %.1f,%.1f %.1fx%.1f pt from box %.0f,%.0f %.0fx%.0f px at %.2fx in window %.0f,%.0f %.0fx%.0f "
+                "(top-left) of a %.0f-pt-high main screen%s", frame.x, frame.y, frame.w, frame.h, box.x, box.y, box.w, box.h,
+                scale, pb.x, pb.y, pb.w, pb.h, primary_height, elsewhere);
+    }
+  }
+  bool below = !s.ordered || !s.panel.visible;
+  // Consume the ordering timer even on the initial order-in, keeping all queries bounded.
+  if (s.tracker.ordering_due(now) && !below) {
+    if (CFArrayRef above = CGWindowListCreate(kCGWindowListOptionOnScreenAboveWindow,
+                                             static_cast<CGWindowID>(s.panel.windowNumber))) {
+      below = contains(above, *configured_parent);
+      CFRelease(above);
+    }
+  }
+  if (below) {
+    // Relative ordering preserves other apps and the parent's menus above the game.
+    [s.panel orderWindow:NSWindowAbove relativeTo:*configured_parent];
+    s.ordered = true;
+  }
+  if (s.wants_key && s.presentation.focused) {
+    [s.panel makeKeyWindow]; // NSNonactivatingPanel: keyboard without activating this process
+    s.wants_key = false;
+  }
+}
+} // namespace
+
+bool configure(bool embedded) {
+  configured_parent.reset();
+  if (!embedded) return false;
+  const char* parent = std::getenv("YOUGAME_EMBED_PARENT");
+  if (parent) configured_parent = parent_id(parent);
+  unsetenv("YOUGAME_EMBED_PARENT");
+  if (!configured_parent) {
+    std::fprintf(stderr, "embed: missing/invalid YOUGAME_EMBED_PARENT; using a regular SDL window\n");
+    return false;
+  }
+  // SDL's video init must not turn this background game into the frontmost app.
+  SDL_SetHint(SDL_HINT_MAC_BACKGROUND_APP, "1");
+  return true;
+}
+SDL_Window* create(int w, int h, const char* title, bool allowed_visible) {
+  @autoreleasepool {
+    NSCAssert(NSThread.isMainThread, @"Mac embed must be created on the main thread");
+    if (!configured_parent) return nullptr;
+    surface = std::make_unique<Surface>();
+    auto& s = *surface;
+    s.width = w; s.height = h; s.allowed_visible = allowed_visible;
+    s.panel = [[YGMeleeEmbedPanel alloc] initWithContentRect:NSMakeRect(0, 0, w, h)
+        styleMask:NSWindowStyleMaskBorderless | NSWindowStyleMaskNonactivatingPanel
+        backing:NSBackingStoreBuffered defer:NO];
+    if (!s.panel) { surface.reset(); return nullptr; }
+    s.panel.releasedWhenClosed = NO;
+    s.panel.hidesOnDeactivate = NO;
+    s.panel.floatingPanel = NO;
+    s.panel.becomesKeyOnlyIfNeeded = NO;
+    s.panel.opaque = YES;
+    s.panel.backgroundColor = NSColor.blackColor;
+    s.panel.hasShadow = NO;
+    s.panel.animationBehavior = NSWindowAnimationBehaviorNone;
+    s.panel.level = NSNormalWindowLevel;
+    s.panel.collectionBehavior = NSWindowCollectionBehaviorMoveToActiveSpace |
+        NSWindowCollectionBehaviorIgnoresCycle | NSWindowCollectionBehaviorTransient;
+    s.panel.title = [NSString stringWithUTF8String:title];
+    SDL_SetHint(SDL_HINT_VIDEO_FOREIGN_WINDOW_OPENGL, "1");
+    s.sdl = SDL_CreateWindowFrom(s.panel);
+    if (!s.sdl) { destroy(); return nullptr; }
+    // SDL owns the event observer/view wrapper, we retain ownership of the native panel.
+    // The panel's GL surface stays in points, as SDL_CreateWindowFrom left it: SDL 2.30 never marks a foreign window
+    // high-DPI, so SDL_GL_GetDrawableSize, present()'s letterbox and ImGui's viewport all count in points. Asking for a
+    // Retina surface here made it twice that size, and on a 2x display the picture drew half-size in its lower left in
+    // theater and black in full screen (d0017/d0018, Luis 10-26). present() logs the window and surface sizes.
+    std::weak_ptr<Inbox> inbox = s.inbox;
+    yougame::set_box_handler([inbox](const std::string& line) {
+      const auto command = parse_command(line);
+      if (!command) return;
+      // One log line per command from the app (a rect only when it changes), so a page/host disagreement about the
+      // player box can be told apart (native-experience-lead #15940).
+      static std::string last_rect;
+      if (command->kind == Kind::Rect) {
+        if (line != last_rect) { last_rect = line; host::log("embed: got %s", line.c_str()); }
+      } else {
+        host::log("embed: got %s", line.c_str());
+      }
+      if (auto queue = inbox.lock()) {
+        std::lock_guard<std::mutex> lock(queue->mutex);
+        if (command->kind == Kind::Quit) queue->quit = true;
+        else {
+          // One pending command per channel (rect, show/hide, focus/blur, scale): a rect flood must not discard hide/blur.
+          const auto channel = [](Kind kind) {
+            return kind == Kind::Rect ? 0 : kind == Kind::Show || kind == Kind::Hide ? 1 : kind == Kind::Scale ? 3 : 2;
+          };
+          const int target = channel(command->kind);
+          auto& commands = queue->commands;
+          commands.erase(std::remove_if(commands.begin(), commands.end(),
+              [&](const Command& old) { return channel(old.kind) == target; }), commands.end());
+          queue->commands.push_back(*command);
+        }
+      }
+    });
+    s.activation = [NSWorkspace.sharedWorkspace.notificationCenter
+        addObserverForName:NSWorkspaceDidActivateApplicationNotification object:nil
+        queue:NSOperationQueue.mainQueue usingBlock:^(NSNotification* notification) {
+          if (!surface || !surface->embedded) return;
+          NSRunningApplication* app = notification.userInfo[NSWorkspaceApplicationKey];
+          if (app.processIdentifier == surface->tracker.parent().owner) {
+            surface->tracker.owner_activated();
+            track(*surface);
+          }
+        }];
+    // No startup sleeps on the main thread. pump() implements the same 20/50/100/200 ms
+    // retry schedule, keeping the SDL event loop and the bridge responsive during startup.
+    // set_box_handler just replayed what the app sent before this window existed ('scale' first on 0.13.1076+), so the
+    // first placement applies it through pump() instead of a bare track(): never the display-overlap guess when the
+    // app already said its scale (d0022 logged one startup 'from display overlap').
+    pump();
+    return s.sdl;
+  }
+}
+bool active() { return surface && surface->embedded; }
+bool pump() {
+  @autoreleasepool {
+    if (!surface) return false;
+    NSCAssert(NSThread.isMainThread, @"Mac embed commands must run on the main thread");
+    auto& s = *surface;
+    std::deque<Command> commands;
+    bool quit = false;
+    {
+      std::lock_guard<std::mutex> lock(s.inbox->mutex);
+      commands.swap(s.inbox->commands);
+      quit = s.inbox->quit;
+    }
+    if (quit) { hide(s); return true; }
+    for (const auto& command : commands) {
+      s.presentation.apply(command);
+      s.tracker.refresh();
+      if (command.kind == Kind::Focus) s.wants_key = true;
+      // Blur never calls resignKeyWindow: it only posts the notification (Apple: never call it yourself) and leaves
+      // the panel key, so typing on the page died after a match (native-experience #33649). The app takes the key
+      // back itself (win.focus() + webContents.focus()); hide() orders the panel out.
+      if (command.kind == Kind::Blur) s.wants_key = false;
+    }
+    if (frame_window.exchange(nullptr) == s.sdl) s.presentation.first_frame();
+    track(s);
+    return false;
+  }
+}
+void frame_presented(SDL_Window* window) { frame_window.store(window); }
+void destroy() {
+  @autoreleasepool {
+    if (!surface) return;
+    yougame::set_box_handler({});
+    if (surface->activation)
+      [NSWorkspace.sharedWorkspace.notificationCenter removeObserver:surface->activation];
+    [surface->panel orderOut:nil];
+    [surface->panel close];
+    [surface->panel release];
+    surface.reset();
+    frame_window.store(nullptr);
+  }
+}
+} // namespace mac_embed
diff --git a/port/mac/embed_mac_state.h b/port/mac/embed_mac_state.h
new file mode 100644
index 0000000..1df977c
--- /dev/null
+++ b/port/mac/embed_mac_state.h
@@ -0,0 +1,180 @@
+// WindowServer-independent embed policy. Placement is in points; the app's player box arrives in backing pixels and is
+// converted once (points_from_backing).
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <charconv>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <string_view>
+
+namespace mac_embed {
+using Millis = int64_t; // monotonic clock, supplied by the adapter (or a test)
+struct Rect { double x = 0, y = 0, w = 0, h = 0; };
+inline bool equal(Rect a, Rect b) { return a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h; }
+// The app sends the player box in its window's backing pixels (the page's placeEmbed: CSS pixels times devicePixelRatio,
+// page zoom included, plus the title bar in backing pixels); AppKit places windows in points. Taking the pixels as points
+// made the panel twice the box on a 2x display: d0017/d0018 drew the picture low and off to the side, d0019 twice too
+// big (Luis 10-26). scale is the backing scale of the display the parent is on; anything not positive counts as 1.
+inline Rect points_from_backing(Rect box, double scale) {
+  if (!(scale > 0)) scale = 1;
+  return {box.x / scale, box.y / scale, box.w / scale, box.h / scale};
+}
+// How much of a lies on b: the parent's display is the one it overlaps most, as Electron's getDisplayMatching picks it.
+inline double overlap_area(Rect a, Rect b) {
+  const double w = std::min(a.x + a.w, b.x + b.w) - std::max(a.x, b.x);
+  const double h = std::min(a.y + a.h, b.y + b.h) - std::max(a.y, b.y);
+  return w > 0 && h > 0 ? w * h : 0;
+}
+// parent: CGWindowList bounds (top-left origin, points); box: the player box in points. Returns a Cocoa frame.
+inline Rect screen_rect(Rect parent, Rect box, double primary_height) {
+  return {parent.x + box.x, primary_height - parent.y - box.y - box.h, box.w, box.h};
+}
+inline bool intersects(Rect a, Rect b) {
+  return a.w > 0 && a.h > 0 && b.w > 0 && b.h > 0 &&
+      a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h;
+}
+inline std::optional<uint32_t> parent_id(std::string_view text) {
+  if (text.empty()) return {};
+  uint32_t id = 0;
+  auto result = std::from_chars(text.data(), text.data() + text.size(), id);
+  if (result.ec != std::errc{} || result.ptr != text.data() + text.size() || id == 0) return {};
+  return id;
+}
+enum class Kind { Rect, Show, Hide, Focus, Blur, Quit, Scale };
+// scale: the app's display scale for the rects that follow ("embed scale n", desktop 0.13.1076+).
+struct Command { Kind kind; Rect rect{}; double scale = 0; };
+// The stdio bridge strips "embed ". Reject malformed/trailing/overflow input atomically.
+inline std::optional<Command> parse_command(const std::string& line) {
+  if (line == "show") return Command{Kind::Show};
+  if (line == "hide") return Command{Kind::Hide};
+  if (line == "focus") return Command{Kind::Focus};
+  if (line == "blur") return Command{Kind::Blur};
+  if (line == "quit") return Command{Kind::Quit};
+  // "scale <n>": the YouGame window's display scale, written before the launch rect and before any rect whose scale
+  // changed (desktop 126f55c97). Strictly one finite number in [0.5, 8]; anything else is ignored like before.
+  if (line.size() <= 32 && line.rfind("scale ", 0) == 0) {
+    std::istringstream in(line.substr(6));
+    double scale = 0;
+    std::string trailing;
+    if (!(in >> scale) || (in >> trailing) || !std::isfinite(scale) || scale < 0.5 || scale > 8) return {};
+    return Command{Kind::Scale, {}, scale};
+  }
+  if (line.size() > 128 || line.rfind("rect ", 0) != 0) return {};
+  std::istringstream in(line.substr(5));
+  int x, y, w, h;
+  std::string trailing;
+  if (!(in >> x >> y >> w >> h) || (in >> trailing)) return {};
+  constexpr int limit = 100000;
+  if (x < -limit || x > limit || y < -limit || y > limit || w < 0 || h < 0 || w > limit || h > limit) return {};
+  return Command{Kind::Rect, {double(x), double(y), double(w), double(h)}};
+}
+
+class QueryTimer {
+ public:
+  explicit QueryTimer(Millis interval) : interval_(interval) {}
+  void request() { requested_ = true; }
+  void reset() { last_.reset(); requested_ = false; }
+  bool due(Millis now, Millis interval = -1) {
+    const Millis delay = requested_ ? 20 : (interval < 0 ? interval_ : interval);
+    if (last_ && now - *last_ < delay) return false;
+    last_ = now; requested_ = false;
+    return true;
+  }
+ private:
+  Millis interval_;
+  std::optional<Millis> last_;
+  bool requested_ = false;
+};
+class StartupBackoff {
+ public:
+  Millis next() {
+    constexpr std::array<Millis, 4> delays{20, 50, 100, 200};
+    const auto delay = delays[step_];
+    step_ = std::min(step_ + 1, delays.size() - 1);
+    return delay;
+  }
+ private:
+  size_t step_ = 0;
+};
+// Ordering in waits for stable visible bounds; moving an already visible surface never waits.
+class SettleGate {
+ public:
+  void observe(Millis now, bool visible, Rect bounds) {
+    if (!visible) { since_.reset(); return; }
+    if (!since_ || !equal(bounds_, bounds)) { since_ = now; bounds_ = bounds; }
+  }
+  bool ready(Millis now) const { return since_ && now - *since_ >= 500; }
+ private:
+  Rect bounds_{};
+  std::optional<Millis> since_;
+};
+struct Parent { bool exists = false, on_screen = false; Rect bounds{}; int owner = 0; };
+
+// Query at most 10 Hz (startup misses back off to 5 Hz), or 50 Hz on explicit requests.
+// A minimized/other-Space parent still exists: only actual absence starts the grace.
+class Tracker {
+ public:
+  void refresh() { parent_timer_.request(); above_timer_.request(); }
+  void owner_activated() { parent_timer_.request(); above_timer_.reset(); }
+  template<class Query> void tick(Millis now, Query query) {
+    if (fallback_) return;
+    if (parent_timer_.due(now, startup_ ? startup_delay_ : 100)) {
+      auto next = query();
+      // Hidden parents may only be represented by an ID. Retain the cached owner so an
+      // activation still triggers an immediate ordering check while the parent is hidden.
+      if (!next.owner) next.owner = parent_.owner;
+      parent_ = next;
+      if (parent_.exists) {
+        startup_ = false;
+        missing_since_.reset();
+      } else {
+        if (!missing_since_) missing_since_ = now;
+        if (startup_) startup_delay_ = backoff_.next();
+        // Decide only from a fresh sample. During startup the next bounded retry can be
+        // up to 200 ms after the grace; a parent returning between queries must survive.
+        if (now - *missing_since_ >= 2000) fallback_ = true;
+      }
+    }
+  }
+  const Parent& parent() const { return parent_; }
+  bool fallback() const { return fallback_; }
+  bool ordering_due(Millis now) { return above_timer_.due(now); }
+ private:
+  QueryTimer parent_timer_{100}, above_timer_{250};
+  StartupBackoff backoff_;
+  Parent parent_;
+  bool startup_ = true, fallback_ = false;
+  Millis startup_delay_ = 0;
+  std::optional<Millis> missing_since_;
+};
+
+// Keep tiny/zero page boxes hidden even through subsequent "show" commands.
+class Presentation {
+ public:
+  void apply(Command command) {
+    switch (command.kind) {
+      case Kind::Rect: box = command.rect; have_rect_ = true; break;
+      case Kind::Show: shown_ = true; break;
+      case Kind::Hide: shown_ = false; break;
+      case Kind::Focus: focused = true; break;
+      case Kind::Blur: focused = false; break;
+      case Kind::Quit: quit = true; break;
+      case Kind::Scale: app_scale = command.scale; break;
+    }
+  }
+  void first_frame() { frame_ = true; }
+  bool visible(const Parent& parent) const {
+    return !quit && frame_ && have_rect_ && shown_ && box.w >= 32 && box.h >= 32 && parent.on_screen;
+  }
+  Rect box{};
+  double app_scale = 0;   // from the app's "scale" line; 0 until one arrives (apps before 0.13.1076 send none)
+  bool focused = true, quit = false;
+ private:
+  bool frame_ = false, have_rect_ = false, shown_ = true;
+};
+} // namespace mac_embed
diff --git a/port/mac/embed_mac_test.cpp b/port/mac/embed_mac_test.cpp
new file mode 100644
index 0000000..fd527f8
--- /dev/null
+++ b/port/mac/embed_mac_test.cpp
@@ -0,0 +1,155 @@
+// No SDL/AppKit initialization, WindowServer calls, game or sockets.
+#include "embed_mac_state.h"
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+using namespace mac_embed;
+namespace {
+int checks = 0;
+void check(bool ok, const char* text) {
+  ++checks;
+  if (!ok) { std::fprintf(stderr, "FAIL: %s\n", text); std::exit(1); }
+}
+void math() {
+  struct Case { Rect parent, box, cocoa; double primary, backing_scale; };
+  const Case cases[] = {
+    {{100, 200, 1000, 700}, {10, 58, 640, 480}, {110, 342, 640, 480}, 1080, 1},
+    {{100, 200, 1000, 700}, {10, 58, 640, 480}, {110, 342, 640, 480}, 1080, 2},
+    {{-1500, 20, 1000, 700}, {0, 28, 960, 640}, {-1500, 392, 960, 640}, 1080, 2},
+    {{1800, -900, 1200, 900}, {25, 0, 800, 600}, {1825, 1380, 800, 600}, 1080, 1},
+    {{-50, 1180, 1000, 700}, {10, 28, 640, 480}, {-40, -608, 640, 480}, 1080, 2},
+    {{10.5, 20.25, 900, 600}, {3, 28, 800, 500}, {13.5, 351.75, 800, 500}, 900, 2},
+  };
+  for (const auto& c : cases) {
+    auto frame = screen_rect(c.parent, c.box, c.primary);
+    check(equal(frame, c.cocoa), "top-left/points/negative-display/titlebar conversion");
+    check(frame.w * c.backing_scale == c.box.w * c.backing_scale,
+          "Retina backing size changes, placement stays in points");
+  }
+  // The app's box is in backing pixels: Luis's 2x display, theater and the in-window full screen (10-26 melee.log).
+  check(equal(points_from_backing({142, 240, 2326, 1383}, 2), {71, 120, 1163, 691.5}), "theater box: pixels to points at 2x");
+  check(equal(points_from_backing({142, 0, 3314, 2122}, 2), {71, 0, 1657, 1061}), "full-window box: pixels to points at 2x");
+  check(equal(points_from_backing({10, 58, 640, 480}, 1), {10, 58, 640, 480}), "1x display: unchanged");
+  check(equal(points_from_backing({10, 58, 640, 480}, 0), {10, 58, 640, 480}), "unknown scale counts as 1");
+  check(equal(screen_rect({0, 33, 1728, 1084}, points_from_backing({142, 240, 2326, 1383}, 2), 1117),
+              {71, 272.5, 1163, 691.5}), "2x theater panel sits inside the parent, at the box's size in points");
+  check(overlap_area({0, 0, 100, 100}, {50, 50, 100, 100}) == 2500, "overlap area");
+  check(overlap_area({0, 0, 100, 100}, {100, 0, 100, 100}) == 0, "touching displays do not overlap");
+  check(intersects({-100, 0, 200, 100}, {0, 0, 1000, 1000}), "partial offscreen");
+  check(!intersects({-200, 0, 200, 100}, {0, 0, 1000, 1000}), "fully offscreen");
+  check(!intersects({0, 0, 0, 100}, {0, 0, 1000, 1000}), "empty box");
+}
+void commands() {
+  check(parent_id("12345") == 12345, "CGWindowID decimal");
+  for (auto value : {"", "0", "-1", "+1", "1 ", " 1", "0x42", "4294967296", "1x"})
+    check(!parent_id(value), "invalid CGWindowID");
+  for (auto line : {"rect 10 28 640 480", "rect -20 -3 960 640", "rect 0 0 0 0",
+                    "show", "hide", "focus", "blur", "quit", "scale 2", "scale 1.5", "scale 0.5", "scale 8", "scale 2.000"})
+    check(bool(parse_command(line)), "valid command");
+  check(parse_command("scale 2")->kind == Kind::Scale && parse_command("scale 2")->scale == 2, "scale value");
+  check(parse_command("scale 1.25")->scale == 1.25, "fractional scale");
+  for (auto line : {"scale", "scale ", "scale 0.49", "scale 8.01", "scale 0", "scale -2", "scale 2 x", "scale 2x",
+                    "scale nan", "scale inf", "scale 1e9", "scales 2", "scale 2\nquit", "embed scale 2"})
+    check(!parse_command(line), "malformed scale rejected");
+  for (auto line : {"rect 1 2 3", "rect 1 2 3 4 tail", "rect 1 2 -3 4", "rect 1 2 3 -4",
+                    "rect 1.5 2 3 4", "rect 2147483648 0 32 32", "rect 0 0 100001 50",
+                    "rect 0 0 3 4\nquit", "embed show", "volume 0", "show ", "quitter", ""})
+    check(!parse_command(line), "malformed/unsupported command rejected");
+  Presentation p;
+  Parent parent{true, true, {100, 100, 800, 600}, 123};
+  check(!p.visible(parent), "starts hidden");
+  p.apply(*parse_command("rect 0 28 640 480"));
+  check(!p.visible(parent), "rect without first frame hidden");
+  p.first_frame(); check(p.visible(parent), "first frame plus rect shown");
+  p.apply(*parse_command("hide")); check(!p.visible(parent), "hide immediate");
+  p.apply(*parse_command("show")); check(p.visible(parent), "show restores");
+  p.apply(*parse_command("rect 0 0 1 1"));
+  p.apply(*parse_command("show")); check(!p.visible(parent), "tiny rect stays hidden through show");
+  p.apply(*parse_command("rect 0 0 32 32")); check(p.visible(parent), "minimum rect restores");
+  parent.on_screen = false; check(!p.visible(parent), "minimized/other Space hidden");
+  parent.on_screen = true;
+  p.apply(*parse_command("blur")); check(!p.focused && p.visible(parent), "blur preserves picture");
+  p.apply(*parse_command("focus")); check(p.focused, "focus");
+  check(p.app_scale == 0, "no app scale until one arrives");
+  p.apply(*parse_command("scale 2")); check(p.app_scale == 2 && p.visible(parent), "app scale kept, picture unchanged");
+  p.apply(*parse_command("scale 1")); check(p.app_scale == 1, "app scale follows a display change");
+  p.apply(*parse_command("quit")); check(p.quit && !p.visible(parent), "quit");
+  Presentation frame_first;
+  frame_first.first_frame(); check(!frame_first.visible(parent), "first frame without rect hidden");
+}
+void timing() {
+  QueryTimer t(100);
+  check(t.due(0), "first query");
+  t.request(); check(!t.due(1) && !t.due(19), "20ms forced floor");
+  check(t.due(20), "deferred force remains pending");
+  check(!t.due(119) && t.due(120), "normal 100ms cache resumes");
+  StartupBackoff backoff;
+  for (auto delay : {20, 50, 100, 200, 200, 200}) check(backoff.next() == delay, "startup backoff");
+  Tracker startup;
+  std::vector<Millis> attempts;
+  for (Millis now = 0; now <= 2200; ++now)
+    startup.tick(now, [&] { attempts.push_back(now); return Parent{}; });
+  check(attempts == std::vector<Millis>({0,20,70,170,370,570,770,970,1170,1370,1570,1770,1970,2170}),
+        "startup fake clock exact attempts; no per-frame queries");
+  check(startup.fallback(), "startup absence falls back after grace plus bounded retry");
+  Tracker late_parent;
+  for (Millis now = 0; now < 2170; ++now)
+    late_parent.tick(now, [&] { return Parent{now >= 1999, now >= 1999, {0,0,900,700}, 88}; });
+  check(!late_parent.fallback(), "grace decision cannot use stale cached absence");
+  late_parent.tick(2170, [] { return Parent{true,true,{0,0,900,700},88}; });
+  check(late_parent.parent().exists && !late_parent.fallback(), "late startup parent survives");
+
+  struct FakeWindowList {
+    bool exists = true, on_screen = true;
+    int queries = 0;
+    Parent query() { ++queries; return {exists, on_screen, {100,200,900,700}, on_screen ? 77 : 0}; }
+  } windows;
+  Tracker tracker;
+  int ordering = 0;
+  for (Millis now = 0; now < 1000; ++now) {
+    tracker.tick(now, [&] { return windows.query(); });
+    if (tracker.parent().on_screen && tracker.ordering_due(now)) ++ordering;
+  }
+  check(windows.queries == 10 && ordering == 4, "steady 10 parent + 4 ordering queries/second");
+  windows.on_screen = false;
+  for (Millis now = 1000; now < 5000; ++now) tracker.tick(now, [&] { return windows.query(); });
+  check(tracker.parent().exists && !tracker.fallback(), "minimize/other Space never parent loss");
+  check(tracker.parent().owner == 77, "hidden parent retains owner for activation refresh");
+  windows.on_screen = true;
+  tracker.owner_activated(); tracker.tick(5000, [&] { return windows.query(); });
+  check(tracker.parent().on_screen && tracker.ordering_due(5000), "owner activation refresh");
+  check(!tracker.ordering_due(5001), "activation ordering not repeated each frame");
+  windows.exists = false; windows.on_screen = false;
+  tracker.tick(5100, [&] { return windows.query(); });
+  tracker.tick(6999, [&] { return windows.query(); });
+  check(!tracker.fallback(), "parent absent just under grace");
+  windows.exists = true; windows.on_screen = true;
+  tracker.refresh(); tracker.tick(7019, [&] { return windows.query(); });
+  check(!tracker.fallback(), "parent returns at force floor before decision");
+  windows.exists = false; windows.on_screen = false;
+  tracker.tick(7220, [&] { return windows.query(); });
+  tracker.tick(9220, [&] { return windows.query(); });
+  check(tracker.fallback(), "permanent loss fallback after grace");
+
+  Tracker forced;
+  int queries = 0, above = 0;
+  for (Millis now = 0; now < 1000; ++now) {
+    forced.refresh();
+    forced.tick(now, [&] { ++queries; return Parent{true,true,{0,0,800,600},77}; });
+    if (forced.ordering_due(now)) ++above;
+  }
+  check(queries == 50 && above == 50, "command flood max 50+50 queries/second");
+  SettleGate settle;
+  Rect bounds{100,200,900,700};
+  settle.observe(0, true, bounds);
+  check(!settle.ready(499) && settle.ready(500), "500ms settle before order-in");
+  bounds.x += 1; settle.observe(501, true, bounds);
+  check(!settle.ready(1000) && settle.ready(1001), "moving parent restarts settle");
+  settle.observe(1002, false, bounds);
+  check(!settle.ready(5000), "hidden parent cannot accrue stable time");
+}
+} // namespace
+int main() {
+  math(); commands(); timing();
+  std::printf("Mac embed: %d checks passed; steady 14 queries/s; forced <=100 queries/s; no windows\n", checks);
+}
diff --git a/port/mac/embed_test_parent.mm b/port/mac/embed_test_parent.mm
new file mode 100644
index 0000000..d988a9e
--- /dev/null
+++ b/port/mac/embed_test_parent.mm
@@ -0,0 +1,125 @@
+// Manual smoke only, on a spare Mac with explicit authorization. NOT an automated window test.
+// Hidden parent until "front". Starts one owned child with a fresh, explicit environment.
+#import <AppKit/AppKit.h>
+#include <cstdio>
+#include <string>
+#include <thread>
+#include <unistd.h>
+
+int main(int argc, char** argv) {
+  if (argc < 3) {
+    std::fprintf(stderr, "Usage: embed-test-parent /absolute/host /absolute/fresh-scratch [host args...]\n"
+        "Manual only. Starts hidden. Commands: front, hidewin, mini, unmini, closewin,\n"
+        "move X Y (Cocoa points), size W H (content points), send rect/show/hide/focus/blur/quit, exit\n");
+    return 2;
+  }
+  @autoreleasepool {
+    NSString* exe = [NSString stringWithUTF8String:argv[1]];
+    NSString* scratch = [NSString stringWithUTF8String:argv[2]];
+    if (!exe.isAbsolutePath || !scratch.isAbsolutePath) return 2;
+    NSError* error = nil;
+    // Require a new scratch directory: do not reuse any real player profile.
+    if ([NSFileManager.defaultManager fileExistsAtPath:scratch] ||
+        ![NSFileManager.defaultManager createDirectoryAtPath:scratch withIntermediateDirectories:YES
+            attributes:nil error:&error]) {
+      std::fprintf(stderr, "scratch must be a new writable absolute directory\n");
+      return 2;
+    }
+    [NSApplication sharedApplication];
+    [NSApp setActivationPolicy:NSApplicationActivationPolicyRegular];
+    [NSApp finishLaunching];
+    static NSWindow* parent = [[NSWindow alloc] initWithContentRect:NSMakeRect(180,180,1000,700)
+        styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable |
+                  NSWindowStyleMaskResizable | NSWindowStyleMaskMiniaturizable
+        backing:NSBackingStoreBuffered defer:NO];
+    parent.releasedWhenClosed = NO;
+    parent.title = @"YouGame embed stand-in (manual test)";
+    parent.backgroundColor = NSColor.darkGrayColor;
+    // Mark the default rect: points from frame top-left, including the title bar.
+    const CGFloat top = parent.frame.size.height - parent.contentView.frame.size.height;
+    NSBox* box = [[NSBox alloc] initWithFrame:NSMakeRect(40,160,800,500)];
+    box.title = @"Player box";
+    [parent.contentView addSubview:box];
+    [box release];
+
+    NSTask* child = [[NSTask alloc] init];
+    child.executableURL = [NSURL fileURLWithPath:exe];
+    child.currentDirectoryURL = [NSURL fileURLWithPath:scratch];
+    NSMutableDictionary* environment = [@{@"PATH":@"/usr/bin:/bin:/usr/sbin:/sbin", @"LANG":@"C",
+        @"LC_ALL":@"C", @"YOUGAME_STDIO":@"1", @"YOUGAME_EMBED":@"1",
+        @"YOUGAME_EMBED_PARENT":[NSString stringWithFormat:@"%ld", (long)parent.windowNumber],
+        @"SDL_AUDIODRIVER":@"dummy", @"SDL_MAC_BACKGROUND_APP":@"1", @"ROSETTA_ADVERTISE_AVX":@"1"}
+        mutableCopy];
+    for (NSString* name in @[@"HOME", @"XDG_DATA_HOME", @"XDG_CONFIG_HOME", @"XDG_CACHE_HOME",
+                             @"XDG_STATE_HOME", @"XDG_RUNTIME_DIR", @"APPDATA", @"LOCALAPPDATA", @"TMPDIR"]) {
+      NSString* path = [scratch stringByAppendingPathComponent:name];
+      [NSFileManager.defaultManager createDirectoryAtPath:path withIntermediateDirectories:YES
+          attributes:nil error:&error];
+      environment[name] = path;
+    }
+    child.environment = environment;
+    [environment release];
+    NSMutableArray* arguments = [NSMutableArray array];
+    for (int i = 3; i < argc; ++i) [arguments addObject:[NSString stringWithUTF8String:argv[i]]];
+    child.arguments = arguments;
+    NSPipe* input = [NSPipe pipe];
+    child.standardInput = input;
+    // Child stdout goes directly to this terminal: observe the yg key relay without a reader.
+    child.standardOutput = NSFileHandle.fileHandleWithStandardOutput;
+    child.standardError = NSFileHandle.fileHandleWithStandardError;
+    if (![child launchAndReturnError:&error]) {
+      std::fprintf(stderr, "could not start owned test child: %s\n", error.localizedDescription.UTF8String);
+      [parent close]; [parent release]; [child release];
+      return 1;
+    }
+    std::fprintf(stderr, "parent CGWindowID=%ld (hidden); default: send rect 40 %.0f 800 500\n",
+                 (long)parent.windowNumber, top + 40);
+    std::fflush(stderr);
+    // Read fd 0 directly so no stdio lock is held while the AppKit thread logs or exits.
+    std::thread([input] {
+      std::string pending;
+      char buffer[1024];
+      ssize_t count;
+      while ((count = read(STDIN_FILENO, buffer, sizeof(buffer))) > 0) {
+        for (ssize_t i = 0; i < count; ++i) {
+          if (buffer[i] != '\n') { if (pending.size() < 4096) pending += buffer[i]; continue; }
+          @autoreleasepool {
+          NSString* line = [NSString stringWithUTF8String:pending.c_str()];
+          pending.clear();
+          dispatch_async(dispatch_get_main_queue(), ^{
+            if ([line hasPrefix:@"send "]) {
+              NSString* cmd = [@"embed " stringByAppendingString:[line substringFromIndex:5]];
+              @try { [input.fileHandleForWriting writeData:[[cmd stringByAppendingString:@"\n"]
+                  dataUsingEncoding:NSUTF8StringEncoding]]; } @catch (NSException*) { }
+            } else if ([line isEqualToString:@"front"]) {
+              [parent makeKeyAndOrderFront:nil]; [NSApp activateIgnoringOtherApps:YES];
+            } else if ([line isEqualToString:@"hidewin"]) [parent orderOut:nil];
+            else if ([line isEqualToString:@"mini"]) [parent miniaturize:nil];
+            else if ([line isEqualToString:@"unmini"]) [parent deminiaturize:nil];
+            else if ([line isEqualToString:@"closewin"]) {
+              [parent close]; [parent release]; parent = nil;
+            }
+            else if ([line isEqualToString:@"exit"]) { [NSApp stop:nil]; }
+            else {
+              double x, y;
+              if (std::sscanf(line.UTF8String, "move %lf %lf", &x, &y) == 2)
+                [parent setFrameOrigin:NSMakePoint(x,y)];
+              else if (std::sscanf(line.UTF8String, "size %lf %lf", &x, &y) == 2 && x > 0 && y > 0)
+                [parent setContentSize:NSMakeSize(x,y)];
+            }
+          });
+          }
+        }
+      }
+      dispatch_async(dispatch_get_main_queue(), ^{ [NSApp stop:nil]; });
+    }).detach();
+    [NSApp run];
+    @try { [input.fileHandleForWriting writeData:[@"embed quit\n" dataUsingEncoding:NSUTF8StringEncoding]]; }
+    @catch (NSException*) { }
+    // The helper only signals the child it created. It never searches or kills other processes.
+    if (child.running) [child terminate];
+    [parent close]; [parent release]; parent = nil;
+    // Detached input thread exits with the process; retained objects stay valid until then.
+    return 0;
+  }
+}
