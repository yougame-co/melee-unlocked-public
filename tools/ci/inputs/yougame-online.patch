diff --git a/port/mac/seed-merge.py b/port/mac/seed-merge.py
new file mode 100644
index 0000000..93ba1de
--- /dev/null
+++ b/port/mac/seed-merge.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Merge shader caches from several seed-generation runs into one shader seed (renderer_gl.cpp seed_cache).
+
+Usage: seed-merge.py <out-dir> <cache-dir> [<cache-dir> ...]
+Each cache dir holds gx-gl410-v2-s1/{vs-*.glsl, ps-*.glsl, recipes.bin}. Shaders merge by file name (the name is
+the shader's hash); recipes merge by their exact bytes, in first-seen order, in the same file format the renderer
+writes (magic, count, hash of the records, then the records). Prints what it found, and refuses a file that is not
+plain GLSL text so nothing else can ride along into the bundle.
+"""
+import os
+import shutil
+import struct
+import sys
+
+MAGIC = 0x3150524C47505847  # "GXPGLRP1"
+SUBDIR = "gx-gl410-v2-s1"
+
+
+def fnv1a64(data: bytes) -> int:
+    """gx::hash_bytes (port/runtime/gx/gx_texture.cpp): 8-byte little-endian words, then the tail bytes.
+    Checked against every file the renderer wrote before any merged file is trusted."""
+    m = 0xFFFFFFFFFFFFFFFF
+    h = 0xCBF29CE484222325
+    whole = len(data) - len(data) % 8
+    for (v,) in struct.iter_unpack("<Q", data[:whole]):
+        h = ((h ^ v) * 0x100000001B3) & m
+        h ^= h >> 29
+    for b in data[whole:]:
+        h = ((h ^ b) * 0x100000001B3) & m
+    return h
+
+
+def read_recipes(path):
+    data = open(path, "rb").read()
+    magic, count, digest = struct.unpack_from("<QQQ", data, 0)
+    body = data[24:]
+    if magic != MAGIC or count == 0 or len(body) % count:
+        raise SystemExit(f"{path}: not a recipes file")
+    size = len(body) // count
+    return size, [body[i * size:(i + 1) * size] for i in range(count)], digest, body
+
+
+def main():
+    out, caches = sys.argv[1], sys.argv[2:]
+    dest = os.path.join(out, SUBDIR)
+    os.makedirs(dest, exist_ok=True)
+    shaders, seen, recipes, size = 0, set(), [], None
+    for cache in caches:
+        src = os.path.join(cache, SUBDIR)
+        for name in sorted(os.listdir(src)):
+            path = os.path.join(src, name)
+            if name.endswith(".glsl"):
+                text = open(path, "rb").read()
+                if not text.startswith(b"#version 410") or b"\0" in text:
+                    raise SystemExit(f"{path}: not plain GLSL; refusing")
+                if not os.path.exists(os.path.join(dest, name)):
+                    shutil.copyfile(path, os.path.join(dest, name))
+                    shaders += 1
+            elif name == "recipes.bin":
+                rsize, records, digest, body = read_recipes(path)
+                if fnv1a64(body) != digest:
+                    raise SystemExit(f"{path}: recipe hash differs from gx::hash_bytes as implemented here")
+                if size not in (None, rsize):
+                    raise SystemExit(f"{path}: recipe size {rsize} differs from {size}")
+                size = rsize
+                for r in records:
+                    if r not in seen:
+                        seen.add(r)
+                        recipes.append(r)
+    if recipes:
+        body = b"".join(recipes)
+        with open(os.path.join(dest, "recipes.bin"), "wb") as f:
+            f.write(struct.pack("<QQQ", MAGIC, len(recipes), fnv1a64(body)) + body)
+    total = len([n for n in os.listdir(dest) if n.endswith(".glsl")])
+    print(f"seed: {total} shaders ({shaders} new from {len(caches)} caches), {len(recipes)} recipes of {size} bytes")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/port/mac/seed_build.cpp b/port/mac/seed_build.cpp
new file mode 100644
index 0000000..2313207
--- /dev/null
+++ b/port/mac/seed_build.cpp
@@ -0,0 +1,59 @@
+// Regenerate the recorded shader seed for a different EFB scale, without SDL/GL or the game.
+// Never relabel scale-1 GLSL: the fragment-coordinate correction depends on EFB height.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "../linux/shader_translation.h"
+#include "gx_shader.h"
+#include "gx_texture.h"
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#include <unordered_set>
+struct ProgramRecipe { uint32_t components = 0; gx::BPMemory bp{}; uint32_t xf[0x58]{}; };
+int main(int argc, char** argv) {
+  try {
+    if (argc != 5) throw std::runtime_error("usage: seed-build <source-seed> <output-seed> <scale> <tool-dir>");
+    const std::filesystem::path source = argv[1], output = argv[2], tools = argv[4];
+    const int scale = std::stoi(argv[3]);
+    if (scale < 1 || scale > 6) throw std::runtime_error("scale must be 1..6");
+    const auto data = shader_translation::read_text(source / "gx-gl410-v2-s1/recipes.bin");
+    uint64_t header[3]{};
+    if (data.size() < sizeof header) throw std::runtime_error("missing seed recipes");
+    std::memcpy(header, data.data(), sizeof header);
+    if (header[0] != 0x3150524C47505847ull || header[1] > 16384 ||
+        data.size() != sizeof header + header[1] * sizeof(ProgramRecipe) ||
+        gx::hash_bytes(data.data() + sizeof header, data.size() - sizeof header) != header[2])
+      throw std::runtime_error("invalid seed recipes/ABI/hash");
+    const auto cache = output / ("gx-gl410-v2-s" + std::to_string(scale));
+    std::filesystem::create_directories(cache);
+    shader_translation::Queue queue;
+    std::vector<std::shared_ptr<shader_translation::Result>> results;
+    std::unordered_set<std::string> names;
+    size_t source_hits = 0;
+    for (size_t i = 0; i < header[1]; ++i) {
+      ProgramRecipe recipe{};
+      std::memcpy(&recipe, data.data() + sizeof header + i * sizeof recipe, sizeof recipe);
+      gx::DrawCall dc{}; dc.components = recipe.components; dc.bp = recipe.bp;
+      std::memcpy(dc.xf_regs, recipe.xf, sizeof recipe.xf);
+      for (bool vertex : {true, false}) {
+        const auto hlsl = vertex ? gx::generate_vertex_shader(gx::make_vs_uid(dc)) : gx::generate_pixel_shader(gx::make_ps_uid(dc));
+        std::ostringstream name; name << (vertex ? "vs-" : "ps-") << std::hex << gx::hash_bytes(hlsl.data(), hlsl.size());
+        if (!names.insert(name.str()).second) continue;
+        if (std::filesystem::is_regular_file(source / "gx-gl410-v2-s1" / (name.str() + ".glsl"))) ++source_hits;
+        results.push_back(queue.request(cache / (name.str() + ".glsl"), [=, shader_name = name.str()] {
+          return shader_translation::translate(cache, shader_name, vertex, gx::EFB_HEIGHT * scale, hlsl, tools);
+        }));
+      }
+    }
+    for (const auto& result : results) {
+      while (result->state.load(std::memory_order_acquire) == shader_translation::Result::Pending)
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      if (result->state.load(std::memory_order_acquire) != shader_translation::Result::Ready)
+        throw std::runtime_error(result->error);
+    }
+    queue.stop();
+    shader_translation::write_text(cache / "recipes.bin", data);
+    std::cout << "Seed scale " << scale << ": " << results.size() << " shaders, " << header[1]
+              << " recipes; " << source_hits << " generated shader hashes found in source seed\n";
+    return 0;
+  } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
