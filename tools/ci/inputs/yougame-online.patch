diff --git a/port/tests/yougame_display_defaults_test.cpp b/port/tests/yougame_display_defaults_test.cpp
new file mode 100644
index 0000000..aa56b56
--- /dev/null
+++ b/port/tests/yougame_display_defaults_test.cpp
@@ -0,0 +1,35 @@
+// Window-free checks of the V-Sync and FPS counter defaults inside YouGame.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_display_defaults.h"
+#include <cstdio>
+#include <cstdlib>
+#include <initializer_list>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+namespace dd = yougame::display_defaults;
+
+int main() {
+  // Outside YouGame: the saved "vsync" key, untouched, on every platform.
+  for (bool windows : {false, true}) {
+    CHECK(dd::vsync(false, windows, true, -1) && !dd::vsync(false, windows, false, -1));
+    CHECK(dd::vsync(false, windows, true, 0) && !dd::vsync(false, windows, false, 1));
+    CHECK(!dd::own_vsync_key(false, windows));
+  }
+  // YouGame on Windows: an install whose file says "vsync 1" (every old save) starts with V-Sync off;
+  // only the player's own choice inside YouGame turns it on, and turning it back off sticks.
+  CHECK(dd::own_vsync_key(true, true));
+  CHECK(!dd::vsync(true, true, true, -1) && !dd::vsync(true, true, false, -1));
+  CHECK(dd::vsync(true, true, false, 1) && dd::vsync(true, true, true, 1));
+  CHECK(!dd::vsync(true, true, true, 0));
+  // YouGame on Linux and Mac: the saved key as before.
+  CHECK(!dd::own_vsync_key(true, false));
+  CHECK(dd::vsync(true, false, true, -1) && !dd::vsync(true, false, false, 1));
+
+  // FPS counter: outside YouGame the saved "showfps" key; inside, on unless turned off there.
+  CHECK(!dd::show_fps(false, false, -1) && dd::show_fps(false, true, 0));
+  CHECK(dd::show_fps(true, false, -1) && dd::show_fps(true, false, 1));
+  CHECK(!dd::show_fps(true, true, 0));
+  std::puts("yougame display defaults: ok");
+  return 0;
+}
diff --git a/port/tests/yougame_display_defaults_wiring_test.py b/port/tests/yougame_display_defaults_wiring_test.py
new file mode 100644
index 0000000..b4837e6
--- /dev/null
+++ b/port/tests/yougame_display_defaults_wiring_test.py
@@ -0,0 +1,51 @@
+"""Inside YouGame, V-Sync and the FPS counter follow their own saved keys (pc_settings.cpp)."""
+from pathlib import Path
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def function(body, signature):
+    start = body.index(signature)
+    end = body.index("\n}\n", start)
+    return body[start:end]
+
+
+class DisplayDefaultsWiringTest(unittest.TestCase):
+    def setUp(self):
+        self.settings = (ROOT / "port/runtime/gx/pc_settings.cpp").read_text(encoding="utf-8-sig")
+        self.load = function(self.settings, "void load_pc_settings(RenderOptions& options, int& volume) {")
+        self.write = function(self.settings, "static bool write_settings_file(const SettingsState& state, const RenderOptions& options) {")
+
+    def test_load_reads_both_keys_and_applies_the_policy_after_the_file(self):
+        self.assertIn('else if (key == "vsync_yougame") saved_vsync_yougame = value == "1";', self.load)
+        self.assertIn('else if (key == "showfps_yougame") saved_showfps_yougame = value == "1";', self.load)
+        loop_end = self.load.index("split_old_trigger_tables();")
+        for call in ("yougame::display_defaults::vsync(g_display_keys.yougame, kWindows, options.vsync, saved_vsync_yougame)",
+                     "yougame::display_defaults::show_fps(g_display_keys.yougame, options.show_fps, saved_showfps_yougame)"):
+            self.assertGreater(self.load.index(call), loop_end)
+        # The old keys' values are captured before the policy replaces them, and a key the file
+        # lacks is captured as its fresh-install value, not as an earlier load's YouGame default.
+        capture = self.load.index("vsync_seen ? options.vsync : fresh.vsync, showfps_seen ? options.show_fps : fresh.show_fps,")
+        self.assertLess(capture, self.load.index("options.vsync = yougame::display_defaults::vsync("))
+        self.assertIn('else if (key == "vsync") { options.vsync = value == "1"; vsync_seen = true; }', self.load)
+        self.assertIn('else if (key == "showfps") { options.show_fps = value == "1"; showfps_seen = true; }', self.load)
+
+    def test_write_keeps_the_old_keys_and_adds_the_youGame_ones_only_inside_youGame(self):
+        self.assertIn('<< "\\nvsync " << (g_display_keys.own_vsync ? g_display_keys.vsync : options.vsync)', self.write)
+        self.assertIn('(g_display_keys.own_vsync ? std::string("\\nvsync_yougame ")', self.write)
+        self.assertIn('<< "\\nshowfps " << (g_display_keys.yougame ? g_display_keys.show_fps : options.show_fps)', self.write)
+        self.assertIn('(g_display_keys.yougame ? std::string("\\nshowfps_yougame ")', self.write)
+        self.assertNotIn('<< "\\nvsync " << options.vsync', self.write)
+        # A save outside YouGame keeps the YouGame keys the file already had.
+        self.assertIn('g_display_keys.saved_vsync_yougame >= 0 ? "\\nvsync_yougame " + std::to_string(g_display_keys.saved_vsync_yougame)', self.write)
+        self.assertIn('g_display_keys.saved_showfps_yougame >= 0 ? "\\nshowfps_yougame " + std::to_string(g_display_keys.saved_showfps_yougame)', self.write)
+
+    def test_the_state_starts_as_outside_youGame(self):
+        self.assertIn("  bool yougame = false, own_vsync = false, vsync = true, show_fps = false;\n"
+                      "  int saved_vsync_yougame = -1, saved_showfps_yougame = -1;\n} g_display_keys;", self.settings)
+        self.assertLess(self.settings.index("g_display_keys;"), self.settings.index("void load_pc_settings("))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/port/tests/yougame_drop_room_test.cpp b/port/tests/yougame_drop_room_test.cpp
new file mode 100644
index 0000000..cb5366a
--- /dev/null
+++ b/port/tests/yougame_drop_room_test.cpp
@@ -0,0 +1,308 @@
+// dropRoomAfter parsing in both build modes, and the real pump against the room-test fakes.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_agent_test.h"
+#include "yougame_room.h"
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <type_traits>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr,"line %d: %s\n",__LINE__,#x); std::exit(1); } } while (0)
+using json = nlohmann::json;
+static constexpr const char* drop_env = "MELEE_ONLINE_TEST_DROP_ROOM_AFTER";
+template<class T, class = void> struct HasDropRoom : std::false_type {};
+template<class T> struct HasDropRoom<T, std::void_t<decltype(std::declval<T&>().agent_test_drop_room())>> : std::true_type {};
+#ifdef YOUGAME_AGENT_TEST_HOOK
+static_assert(HasDropRoom<yougame::transport::Stream>::value);
+#else
+static_assert(!HasDropRoom<yougame::transport::Stream>::value);
+#endif
+
+static void mapping(const char* scratch) {
+  using namespace yougame::agent_test;
+  const auto directory = std::filesystem::u8path(scratch);
+  std::filesystem::create_directories(directory);
+  for (auto engine : {Engine::Source, Engine::Static}) {
+    for (const json& value : {json(330), json(600), json(900), json(uint64_t(330))}) {
+      const auto settings = map_keys({{"dropRoomAfter", value}}, engine);
+      CHECK(settings.arguments.empty());
+#ifdef YOUGAME_AGENT_TEST_HOOK
+      CHECK(settings.environment == (std::vector<std::pair<std::string, std::string>>{
+          {drop_env, std::to_string(value.get<int>())}}));
+      CHECK(settings.log == "agent-test.json applied default keys: dropRoomAfter");
+#else
+      CHECK(settings.environment.empty());
+      CHECK(settings.log == "agent-test.json; invalid/unknown or inapplicable keys ignored");
+#endif
+      { std::ofstream file(directory / "agent-test.json"); file << json{{"dropRoomAfter", value}}; CHECK(file.good()); }
+      const auto loaded = load(true, directory.string().c_str(), engine);
+      CHECK(loaded.environment == settings.environment && loaded.log == settings.log);
+      const auto inactive = load(false, directory.string().c_str(), engine);
+      CHECK(inactive.environment.empty() && inactive.arguments.empty() && inactive.log.empty());
+    }
+    for (const json& value : {json(329), json(901), json(-1), json(0), json(330.0), json(330.5),
+         json("330"), json(true), json(false), json(nullptr), json::array(), json::object(),
+         json(std::numeric_limits<uint64_t>::max()), json(std::numeric_limits<int64_t>::min())}) {
+      const auto settings = map_keys({{"dropRoomAfter", value}}, engine);
+      CHECK(settings.arguments.empty() && settings.environment.empty());
+      CHECK(settings.log == "agent-test.json; invalid/unknown or inapplicable keys ignored");
+    }
+  }
+  std::filesystem::remove_all(directory);
+}
+
+#ifdef YOUGAME_AGENT_TEST_HOOK
+using namespace yougame::transport;
+// Reuse the existing room test's offline Broker/Stream/Fixture design; no live socket or game.
+static json roster() {
+  return json::array({{{"id","a"},{"connectionId","a"},{"slot",0},{"localIndex",0},{"user","account-a"}},
+                      {{"id","b"},{"connectionId","b"},{"slot",1},{"localIndex",0},{"user","account-b"}}});
+}
+static json welcome(const std::string& match = "set-1") {
+  // Lobby players deliberately have no seat: no dependency on the app's former relabel bug.
+  return {{"t","welcome"},{"me","a"},{"room",{{"code","abcdef"}}},{"matchId",match},
+          {"participants",roster()},{"players",json::array({{{"id","a"},{"user","account-a"}},{{"id","b"},{"user","account-b"}}})}};
+}
+struct Broker {
+  uint64_t now = 1;
+  struct Action { uint64_t at; std::function<void()> run; };
+  std::deque<Action> actions;
+  Events events{[this](int ms) { wait(ms); }};
+  std::vector<json> requests, sent;
+  std::vector<int> waits;
+  int conn = 0, link_state = 2, disabled = 0;
+  bool fail_send = false, fail_renew = false;
+  std::function<void(const json&)> on_close;
+  std::function<void(int)> on_open;
+  std::function<void(const json&)> on_send;
+  std::function<json(int)> on_ticket;
+  void wait(int ms) {
+    CHECK(ms >= 0); waits.push_back(ms);
+    const auto until = now + ms;
+    if (!actions.empty() && actions.front().at <= until) {
+      auto action = std::move(actions.front()); actions.pop_front();
+      now = std::max(now, action.at); action.run();
+    } else now = until; // an empty fake wait consumes precisely the caller's budget
+  }
+  void at(uint64_t time, std::function<void()> action) { actions.push_back({time,std::move(action)}); }
+  void push(const json& m) { events.push({{"conn",conn},{"event","message"},{"data",m.dump()}}); }
+  void opened(int id) { events.push({{"conn",id},{"event","open"}}); }
+  void closed(int code = 1006) { events.push({{"conn",conn},{"event","close"},{"code",code}}); }
+  json request(const json& q, int ms) {
+    CHECK(ms > 0); requests.push_back(q);
+    const auto type = str(q,"type");
+    if (type == "netOpen") {
+      ++conn;
+      if (on_open) on_open(conn); else opened(conn);
+      return {{"conn",conn}};
+    }
+    if (type == "netClose" && on_close) on_close(q);
+    if (type == "netSend") {
+      if (fail_send) throw std::runtime_error("backed_up");
+      auto m = json::parse(q["data"].get<std::string>()); sent.push_back(m);
+      if (on_send) on_send(m);
+    }
+    if (type == "mpTicket") {
+      if (on_ticket) return on_ticket(ms);
+      if (fail_renew) throw std::runtime_error("temporary ticket failure");
+      return {{"ticket","ticket-new"},{"room","abcdef"}};
+    }
+    if (type == "directOpen") return {{"link",257}};
+    return json::object();
+  }
+  int count(const char* type) const {
+    return (int)std::count_if(requests.begin(),requests.end(),[&](const json& q){return str(q,"type")==type;});
+  }
+  int messages(const char* type) const {
+    return (int)std::count_if(sent.begin(),sent.end(),[&](const json& q){return str(q,"t")==type;});
+  }
+};
+struct FakeSocket {
+  Broker& broker;
+  Stream stream;
+  bool broker_mode = true;
+  std::function<void()> on_drop;
+  explicit FakeSocket(Broker& b) : broker(b), stream(b.events,[&b](const json& q,int ms){return b.request(q,ms);},[&b]{return b.now;}) {}
+  bool open_session(const std::string&,const std::string& ticket,const std::string& room,std::string*,int ms=10000) { return stream.open(ticket,room,ms); }
+  bool next(json& m,int ms) { return stream.next(m,ms); }
+  bool closed() const { return stream.closed(); }
+  bool recoverable() const { return broker_mode && stream.close_code()==1006; }
+  bool brokered() const { return broker_mode; }
+  uint64_t agent_test_first_open_at() const { return stream.agent_test_first_open_at(); }
+  void agent_test_drop_room() { stream.agent_test_drop_room(); if (on_drop) on_drop(); }
+  bool send(const json& m) { return stream.send(m); }
+};
+struct Fixture {
+  Broker b;
+  RoomState<FakeSocket> r;
+  std::mutex mutex;
+  RoomIO io;
+  std::vector<std::string> logs;
+  Fixture() {
+    r.socket=std::make_unique<FakeSocket>(b);
+    CHECK(r.socket->stream.open("ticket-old","abcdef",100));
+    r.me=r.host_connection="a"; r.code="abcdef"; r.ticket="ticket-old";
+    r.ticket_request={{"type","mpTicket"}}; r.port_ids={"a","b"}; r.revision=7;
+    r.recovery.configure(r.code,r.me,roster());
+    io.request=[this](const json& q,int ms){return b.request(q,ms);};
+    io.clock=[this]{return b.now;}; io.pause=[this](int ms){b.wait(ms);}; io.link_state=[this](unsigned){return b.link_state;};
+    io.disable_links=[this]{++b.disabled;};
+    io.log=[this](const char* message){logs.emplace_back(message);};
+  }
+  void ranked() {
+    r.ranked=true; r.set.configure(0,{"a","b"}); r.set.start_game();
+    r.match_id="set-1"; r.recovery.start(r.match_id);
+    r.set.receive({{"t","start"},{"matchId","set-1"}});
+  }
+  void report(int index=1) {
+    yougame::ranked::Game g; g.index=index; g.winner=0; r.set.report_game(g);
+  }
+  void tick() { b.push({{"t","test-tick"}}); }
+  void stop_at(uint64_t at) { b.at(at,[this]{r.stop=true;tick();}); }
+  void run() { pump_room(&r,mutex,io); CHECK(b.actions.empty()); }
+};
+
+static json agent_roster() {
+  auto participants = roster();
+  for (auto& p : participants) p["hn"] = true;
+  return participants;
+}
+static void live(Fixture& f) {
+  f.r.mode = 1; f.r.in_game = true; f.r.match_id = "game-1";
+  f.r.participants = agent_roster();
+  f.r.recovery.start(f.r.match_id);
+}
+static size_t drop_logs(const Fixture& f) {
+  return std::count_if(f.logs.begin(), f.logs.end(), [](const std::string& line) {
+    return line.find("agent-test:") == 0;
+  });
+}
+static void drop_and_renew() {
+  agent_drop_room_attempted = false;
+  CHECK(setenv(drop_env, "330", 1) == 0);
+  Fixture f; live(f);
+  CHECK(f.r.socket->agent_test_first_open_at() == 1);
+  // The pump starts long after the socket opened: elapsed time belongs to the first open.
+  f.b.now = 330000;
+  f.b.on_close = [&](const json& q) {
+    CHECK(f.b.now >= 330001 && q["conn"] == 1 && q["code"] == 4000);
+    CHECK(f.r.socket->closed());
+  };
+  f.r.socket->on_drop = [&] {
+    CHECK(f.b.count("netClose") == 1 && f.r.socket->closed() && f.r.socket->recoverable());
+    CHECK(f.r.socket->stream.close_code() == 1006);
+  };
+  f.b.on_open = [&](int id) {
+    if (id == 2) {
+      CHECK(f.b.count("mpTicket") == 0 && f.r.socket->closed());
+      throw std::runtime_error("HTTP 401");
+    }
+    CHECK(id == 3 && f.b.count("mpTicket") == 1);
+    CHECK(f.b.requests.back()["ticket"] == "ticket-new");
+    f.b.opened(id);
+    auto m = welcome("game-1"); m["participants"] = agent_roster(); f.b.push(m);
+  };
+  f.b.at(330001, [&] { CHECK(f.b.count("netClose") == 0); f.tick(); });
+  f.b.at(331501, [&] {
+    CHECK(!f.r.recovery.pending() && f.r.ticket == "ticket-new");
+    CHECK(f.b.count("netClose") == 1 && f.b.count("netOpen") == 3 && f.b.count("mpTicket") == 1);
+    f.tick();
+  });
+  f.stop_at(700001); f.run();
+  CHECK(f.r.socket->agent_test_first_open_at() == 1);
+  f.b.on_close = {};
+  CHECK(f.b.count("netClose") == 1 && f.b.count("netOpen") == 3 && drop_logs(f) == 1);
+  CHECK(f.logs == std::vector<std::string>({
+      "agent-test: dropped the room socket (dropRoomAfter 330 s)", "yougame: room ticket renewed"}));
+  // A second room in the same process cannot consume the hook again.
+  Fixture later; live(later); later.b.now = 900001; later.stop_at(900101); later.run();
+  CHECK(later.b.count("netClose") == 0 && later.b.count("netOpen") == 1 && later.logs.empty());
+}
+static void refuses_unsafe_rooms() {
+  const auto agents = agent_roster();
+  std::vector<json> rosters;
+  auto bad = agents; bad[0]["hn"] = false; rosters.push_back(bad);
+  bad = agents; bad[1]["hn"] = false; rosters.push_back(bad);
+  bad = agents; bad[1].erase("hn"); rosters.push_back(bad);
+  bad = agents; bad[1]["hn"] = "true"; rosters.push_back(bad);
+  bad = agents; bad[0]["hn"] = 1; rosters.push_back(bad);
+  bad = agents; bad[0]["connectionId"] = "absent-self"; rosters.push_back(bad);
+  bad = agents; bad.push_back({{"connectionId", "spectator"}}); rosters.push_back(bad);
+  rosters.push_back(json::array());
+  rosters.push_back(agents); // ranked by mode
+  rosters.push_back(agents); // ranked Teams fact, regardless of mode
+  for (size_t i = 0; i < rosters.size(); ++i) {
+    agent_drop_room_attempted = false;
+    Fixture f; live(f); f.r.participants = rosters[i];
+    if (i == rosters.size() - 2) f.r.mode = 0;
+    if (i == rosters.size() - 1) { f.r.mode = 3; f.r.ranked = true; }
+    f.b.now = 330001;
+    f.b.at(330101, [&] { f.r.mode = 1; f.r.ranked = false; f.r.participants = agents; f.tick(); });
+    f.stop_at(900001); f.run();
+    CHECK(f.b.count("netClose") == 0 && f.b.count("netOpen") == 1);
+    CHECK(f.logs == std::vector<std::string>({"agent-test: dropRoomAfter refused: not an agent-only room"}));
+  }
+}
+static void waits_for_live_match() {
+  agent_drop_room_attempted = false;
+  Fixture f; live(f); f.r.in_game = false; f.b.now = 340001;
+  f.b.on_open = [&](int id) {
+    f.b.opened(id); auto m = welcome("game-1"); m["participants"] = agent_roster(); f.b.push(m);
+  };
+  f.b.at(340101, [&] { CHECK(f.b.count("netClose") == 0); f.r.in_game = true; f.r.match_id.clear(); f.tick(); });
+  f.b.at(340201, [&] { CHECK(f.b.count("netClose") == 0); f.r.match_id = "game-1"; f.tick(); });
+  f.stop_at(340401); f.run();
+  CHECK(f.b.count("netClose") == 1 && drop_logs(f) == 1);
+}
+static void first_open_survives_reconnect() {
+  for (int seconds : {330, 900}) {
+    agent_drop_room_attempted = false;
+    Fixture f; live(f);
+    f.b.closed(); json m;
+    CHECK(!f.r.socket->next(m, 0) && f.r.socket->closed());
+    f.b.now = 100001;
+    CHECK(f.r.socket->stream.open("ticket-new", "abcdef", 100));
+    CHECK(f.r.socket->agent_test_first_open_at() == 1);
+    f.b.now = uint64_t(seconds) * 1000;
+    CHECK(!agent_drop_room_due(f.r, f.io, seconds) && f.logs.empty());
+    ++f.b.now;
+    CHECK(agent_drop_room_due(f.r, f.io, seconds));
+    CHECK(!agent_drop_room_due(f.r, f.io, seconds) && drop_logs(f) == 1);
+  }
+  // Steady-clock epoch zero is a valid first open time, not an uninitialized sentinel.
+  Broker b; b.now = 0; FakeSocket socket(b);
+  CHECK(socket.stream.open("ticket-old", "abcdef", 100));
+  b.closed(); json m; CHECK(!socket.next(m, 0)); b.now = 5000;
+  CHECK(socket.stream.open("ticket-new", "abcdef", 100));
+  CHECK(socket.agent_test_first_open_at() == 0);
+}
+static void environment_bounds() {
+  CHECK(agent_drop_room_seconds(nullptr) == 0);
+  for (const char* bad : {"", "329", "901", "-330", "+330", "330.0", "330s", " 330", "330 ",
+                        "999999999999999999999999999999999999999999999"}) {
+    CHECK(agent_drop_room_seconds(bad) == 0);
+    agent_drop_room_attempted = false;
+    CHECK(setenv(drop_env, bad, 1) == 0);
+    Fixture f; live(f); f.b.now = 900001; f.stop_at(900101); f.run();
+    CHECK(f.b.count("netClose") == 0 && f.logs.empty() && !agent_drop_room_attempted);
+  }
+  for (const char* value : {"330", "600", "900"})
+    CHECK(agent_drop_room_seconds(value) == std::atoi(value));
+  CHECK(unsetenv(drop_env) == 0);
+  agent_drop_room_attempted = false;
+  Fixture f; live(f); f.b.now = 900001; f.stop_at(900101); f.run();
+  CHECK(f.b.count("netClose") == 0 && f.logs.empty() && !agent_drop_room_attempted);
+}
+#endif
+int main(int argc, char** argv) {
+  CHECK(argc == 2);
+  mapping(argv[1]);
+#ifdef YOUGAME_AGENT_TEST_HOOK
+  environment_bounds();
+  drop_and_renew();
+  refuses_unsafe_rooms();
+  waits_for_live_match();
+  first_open_survives_reconnect();
+  CHECK(unsetenv(drop_env) == 0);
+#endif
+  std::puts("yougame_drop_room: mapping, build gating, elapsed time, once per process, agent-only gate and recovery passed");
+}
diff --git a/port/tests/yougame_duel_mapping_test.cpp b/port/tests/yougame_duel_mapping_test.cpp
new file mode 100644
index 0000000..3ffbcde
--- /dev/null
+++ b/port/tests/yougame_duel_mapping_test.cpp
@@ -0,0 +1,172 @@
+// Offline duel contract: production seat mapping, room dispatch, ranked receipts and casual outbox.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_room.h"
+#include <cstdio>
+#include <cstdlib>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame::transport;
+
+struct Socket {
+  bool broker = true;
+  std::deque<json> messages;
+  std::function<void()> observe;
+  std::vector<json> sent;
+  bool brokered() const { return broker; }
+  bool closed() const { return false; }
+  bool recoverable() const { return false; }
+  bool open_session(const std::string&, const std::string&, const std::string&, std::string*, int) { return false; }
+  bool next(json& m, int) {
+    if (observe) observe();
+    if (messages.empty()) return false;
+    m = messages.front(); messages.pop_front(); return true;
+  }
+  bool send(const json& m) { sent.push_back(m); return true; }
+};
+
+static json roster(bool reverse, int ada_team) {
+  json players = json::array({
+    {{"id","ada"},{"connectionId","conn-ada"},{"slot",0},{"localIndex",0},{"team",ada_team}},
+    {{"id","bo"},{"connectionId","conn-bo"},{"slot",1},{"localIndex",0},{"team",1-ada_team}}});
+  if (reverse) std::swap(players[0], players[1]);
+  return players;
+}
+
+static void mapping(const json& participants, const std::string& me, int local) {
+  // Independent expected values from 1c97e20: room slot n -> port n+1 -> participant n.
+  CHECK(connection_seat(participants, me) == local);
+  CHECK(connection_seat(participants, "absent") == -1);
+  CHECK(port_participants(participants, 2) == std::vector<std::string>({"ada","bo"}));
+  auto without_teams = participants;
+  for (auto& p : without_teams) p.erase("team");
+  CHECK(connection_seat(participants, me) == connection_seat(without_teams, me));
+  CHECK(port_participants(participants, 2) == port_participants(without_teams, 2));
+}
+
+static void room_messages() {
+  for (bool broker : {false, true}) for (int local : {0, 1}) {
+    RoomState<Socket> r;
+    r.socket = std::make_unique<Socket>(); r.socket->broker = broker;
+    r.me = local == 0 ? "conn-ada" : "conn-bo";
+    r.port_ids = port_participants(roster(true, 1), 2);
+    r.set.configure(connection_seat(roster(true, 1), r.me), r.port_ids);
+    CHECK(r.set.local_participant() == (local == 0 ? "ada" : "bo"));
+    // Welcome/lobby/start change array order and team assignment without changing slots.
+    r.socket->messages = {
+      {{"t","welcome"},{"me",r.me},{"participants",roster(true, 1)}},
+      {{"t","lobby"},{"participants",roster(false, 0)}},
+      {{"t","start"},{"matchId","duel"},{"participants",roster(true, 0)}}};
+    int seen = 0;
+    r.socket->observe = [&] {
+      CHECK(r.port_ids == std::vector<std::string>({"ada","bo"}));
+      CHECK(r.set.local_participant() == (local == 0 ? "ada" : "bo"));
+      for (int port = -1; port <= 4; ++port) CHECK(r.seat_team(port) == -1);
+      if (seen == 3) { CHECK(r.match_id == "duel"); r.stop = true; }
+      ++seen;
+    };
+    std::mutex mutex; RoomIO io; io.clock = [] { return 1; };
+    pump_room(&r, mutex, io);
+    CHECK(seen == 4);
+  }
+  // localIndex identifies the connection's first controller, not a global port.
+  auto controllers = roster(true, 1);
+  controllers.push_back({{"id","extra"},{"connectionId","conn-ada"},{"slot",3},{"localIndex",1},{"team",0}});
+  CHECK(connection_seat(controllers, "conn-ada") == 0);
+}
+
+static void agent_roster() {
+  RoomState<Socket> r;
+  auto players = roster(false, 0);
+  players[0]["hn"] = true; players[1]["hn"] = "true";
+  read_roster(r, {{"participants", players}});
+  CHECK(r.participants == players);
+  CHECK(r.participants[0]["hn"].is_boolean() && r.participants[0]["hn"] == true);
+  CHECK(r.participants[1]["hn"].is_string());
+  read_roster(r, {{"t", "ping"}}); CHECK(r.participants == players);
+  players[0].erase("hn"); players[1]["hn"] = false;
+  read_roster(r, {{"participants", players}}); CHECK(r.participants == players);
+  read_roster(r, {{"participants", json::object()}}); CHECK(r.participants.empty());
+  read_roster(r, {{"participants", json::array()}}); CHECK(r.participants.empty());
+  read_roster(r, {{"participants", players}});
+  read_roster(r, {{"t", "join"}}); CHECK(r.participants.empty());
+}
+
+static void team_scope() {
+  RoomState<Socket> r; r.size = 4;
+  auto players = roster(true, 1);
+  players.push_back({{"id","c"},{"connectionId","conn-c"},{"slot",2},{"localIndex",0},{"team",0}});
+  players.push_back({{"id","d"},{"connectionId","conn-d"},{"slot",3},{"localIndex",0},{"team",1}});
+  read_roster(r, {{"participants",players}});
+  CHECK(port_participants(players, 4) == std::vector<std::string>({"ada","bo","c","d"}));
+  CHECK(r.seat_team(0) == 1 && r.seat_team(1) == 0 && r.seat_team(2) == 0 && r.seat_team(3) == 1);
+  r.size = 2;
+  for (int port = 0; port < 4; ++port) CHECK(r.seat_team(port) == -1);
+  read_roster(r, {{"participants",roster(false, 0)}});
+  CHECK((r.port_teams == std::array<int,4>{-1,-1,-1,-1}));
+}
+
+static void ranked_set(const json& participants, bool split) {
+  yougame::ranked::Set clients[2];
+  const auto ids = port_participants(participants, 2);
+  for (int local : {0, 1}) {
+    clients[local].configure(connection_seat(participants, local == 0 ? "conn-ada" : "conn-bo"), ids);
+    CHECK(clients[local].local_participant() == ids[local]);
+    clients[local].receive({{"t","start"},{"matchId","duel-set"}});
+  }
+  const std::vector<int> winners = split ? std::vector<int>{0,1,0} : std::vector<int>{0,0};
+  for (size_t i = 0; i < winners.size(); ++i) {
+    const int winner = winners[i];
+    const int placements[4] = {winner, 1-winner, 255, 255};
+    for (auto& set : clients) {
+      set.start_game();
+      yougame::ranked::Game game;
+      game.index = set.games_started();
+      game.key = yougame::ranked::game_key(0x100 + i, 31);
+      game.winner = yougame::ranked::game_winner(2, -1, -1, placements);
+      CHECK(game.winner == winner);
+      set.report_game(game);
+      const auto report = set.due(i * 100 + 1, true, 7);
+      CHECK(report.size() == 1 && report[0]["t"] == "game-report");
+      CHECK(report[0]["winner"] == (winner == 0 ? "ada" : "bo"));
+      CHECK(set.awaiting_receipt() && !set.over());
+      json receipt = {{"t","game-result"},{"matchId","duel-set"},{"id",game.key},
+                      {"ranking",winner == 0 ? json{"ada","bo"} : json{"bo","ada"}}};
+      set.receive(receipt); set.receive(receipt); // retries count once
+      CHECK(!set.awaiting_receipt());
+      if (i + 1 < winners.size()) {
+        CHECK(!set.over() && !set.decided());
+        CHECK(set.due(i * 100 + 2, true, 7).empty()); // no finish at 1-1
+      } else {
+        CHECK(set.over() && set.decided());
+        CHECK(set.due(i * 100 + 2, true, 7) == std::vector<json>({
+          {{"t","finish"},{"matchId","duel-set"},{"winner","ada"}}}));
+        CHECK(set.receive({{"t","result"},{"matchId","duel-set"},{"ranking",{"ada","bo"}}}));
+        CHECK(set.settled());
+      }
+    }
+  }
+}
+
+static void casual_reports(const json& participants) {
+  for (bool broker : {false, true}) for (int winner : {0, 1}) {
+    RoomState<Socket> r; r.socket = std::make_unique<Socket>(); r.socket->broker = broker;
+    r.port_ids = port_participants(participants, 2); r.match_id = "casual-game";
+    const int placements[4] = {winner, 1-winner, 255, 255};
+    const int port = yougame::ranked::casual_winner(2, -1, -1, placements, r.size);
+    CHECK(port == winner);
+    if (broker) { r.games.start_game(r.match_id); r.games.report(port); }
+    else r.pending_winner = port;
+    CHECK(due_messages(r, 1) == std::vector<json>({
+      {{"t","finish"},{"matchId","casual-game"},{"winner",winner == 0 ? "ada" : "bo"}}}));
+  }
+}
+
+int main() {
+  for (bool reverse : {false, true}) for (int team : {0, 1}) {
+    auto participants = roster(reverse, team);
+    for (int local : {0, 1}) mapping(participants, local == 0 ? "conn-ada" : "conn-bo", local);
+    ranked_set(participants, true); ranked_set(participants, false);
+    casual_reports(participants); // Unranked, Direct and Friends share the two-seat casual path
+  }
+  room_messages(); agent_roster(); team_scope();
+  std::puts("yougame_duel_mapping: slot/port/participant mapping, both clients' 1-1/2-0 sets and casual reports passed");
+}
diff --git a/port/tests/yougame_embed_focus_wiring_test.py b/port/tests/yougame_embed_focus_wiring_test.py
new file mode 100644
index 0000000..a056e0d
--- /dev/null
+++ b/port/tests/yougame_embed_focus_wiring_test.py
@@ -0,0 +1,41 @@
+"""A hidden game in the player box never keeps or takes the keyboard (Windows, window.cpp)."""
+from pathlib import Path
+import re
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def case(body, label):
+    start = body.index(label)
+    end = body.find("\n    case ", start + len(label))
+    return body[start:end if end >= 0 else len(body)]
+
+
+class EmbedFocusWiringTest(unittest.TestCase):
+    def setUp(self):
+        self.window = (ROOT / "port/runtime/host/window.cpp").read_text(encoding="utf-8-sig")
+
+    def test_hide_gives_the_keyboard_back_before_hiding(self):
+        show = case(self.window, "case kBoxShow: {")
+        release = show.index("if (!visible && GetFocus() == h) {")
+        self.assertIn("SetFocus(GetParent(h));", show[release:])
+        self.assertLess(release, show.index("ShowWindow(h, visible ? SW_SHOWNA : SW_HIDE);"))
+
+    def test_focus_only_while_visible(self):
+        focus = case(self.window, "case kBoxFocus:")
+        focus = focus[focus.index("// Only a visible game"):]
+        self.assertIn("if (w && IsWindowVisible(h)) {", focus)
+        self.assertEqual(focus.count("SetFocus(h);"), 1)
+        self.assertEqual(focus.count("embed: focus handback rc=%p err=%lu focus-after=%s"), 1)
+        self.assertIn("const DWORD error = GetLastError();", focus)
+        self.assertIn('!after ? "none" : after == h ? "self" : after == GetParent(h) ? "parent" : "other"', focus)
+        self.assertLess(focus.index("IsWindowVisible(h)"), focus.index("SetFocus(h);"))
+
+    def test_nothing_activates_the_embedded_window(self):
+        for call in ("SetForegroundWindow(", "SetActiveWindow(", "BringWindowToTop(", "AttachThreadInput("):
+            self.assertIsNone(re.search(r"\b" + re.escape(call), self.window), call)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/port/tests/yougame_embed_toplevel_test.cpp b/port/tests/yougame_embed_toplevel_test.cpp
new file mode 100644
index 0000000..e018e16
--- /dev/null
+++ b/port/tests/yougame_embed_toplevel_test.cpp
@@ -0,0 +1,132 @@
+// Synthetic embed policy checks: no HWND, game, disc, or process is opened.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_embed_toplevel.h"
+#include "yougame_box_present.h"
+#include "yougame_parity.h"
+#include <cstdio>
+#include <cstdlib>
+#include <climits>
+#include <string>
+#include <vector>
+
+namespace {
+int checks = 0;
+#define CHECK(x) do { ++checks; if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame::embed_toplevel_policy;
+std::vector<std::string> lines;
+void write_line(const char* line) { lines.emplace_back(line); }
+void window_styles() {
+  CHECK(!enabled(false, "1"));
+  CHECK(enabled(true, "1"));
+  for (const char* flag : {"", "0", "true", "01", "1 "}) CHECK(!enabled(true, flag));
+  for (auto backend : {Backend::D3D11, Backend::D3D12, Backend::OpenGL})
+    for (bool flip : {false, true}) {
+      const auto standalone = styles(false, flip, backend, 0x00cf0000u, 0x40000u);
+      CHECK(standalone.style == 0x00cf0000u && standalone.exstyle == 0x40000u);
+      const auto child = styles(false, flip, backend, popup);
+      CHECK(child.style == popup && child.exstyle == 0);
+      const auto top = styles(true, flip, backend, 0x00cf0000u);
+      CHECK(top.style == popup);
+      CHECK((top.style & 0x40000000u) == 0); // no WS_CHILD
+      CHECK(top.exstyle == (toolwindow | (flip && backend != Backend::OpenGL ? no_redirection : 0)));
+    }
+}
+void geometry() {
+  yg_embed_box box{};
+  CHECK(rect("rect -3840 -2160 2560 1440", true, box));
+  CHECK(box.x == -3840 && box.y == -2160 && box.w == 2560 && box.h == 1440);
+  CHECK(!rect("rect -3840 -2160 2560 1440", false, box));
+  CHECK(rect("rect 100 200 640 480", false, box));
+  auto child = yg_embed_view_init(1280, 960, 1);
+  yg_embed_view_update(&child, {80, 120, 800, 600}, true);
+  const auto clipped = yg_embed_view_update(&child, box, false);
+  CHECK(clipped.window.x == 80 && clipped.window.y == 120);
+  CHECK(clipped.clip.x == 20 && clipped.clip.y == 80);
+  // Toplevel preserves screen origins and caps dimensions before allocation.
+  CHECK(rect("rect 100000 -100000 80000 70000", true, box));
+  CHECK(first(pack(box.x, box.y)) == 100000 && second(pack(box.x, box.y)) == -100000);
+  CHECK(first(pack(box.w, box.h)) == 16384 && second(pack(box.w, box.h)) == 16384);
+  CHECK(rect("rect 0 0 16384 16383", true, box));
+  CHECK(box.w == 16384 && box.h == 16383);
+  CHECK(rect("rect 0 0 1 2147483647", true, box));
+  CHECK(box.w == 1 && box.h == 16384);
+  CHECK(rect("rect 0 0 2147483647 1", true, box));
+  CHECK(box.w == 16384 && box.h == 1);
+  CHECK(rect("rect 0 0 80000 70000", false, box));
+  CHECK(box.w == 80000 && box.h == 70000);
+  for (int x : {INT_MIN, -65536, -1, 0, 65536, INT_MAX})
+    for (int y : {INT_MIN, -1, 0, INT_MAX}) {
+      CHECK(first(pack(x, y)) == x);
+      CHECK(second(pack(x, y)) == y);
+    }
+  CHECK(rect("rect -2147483648 2147483647 1 1", true, box));
+  for (const char* line : {"rect 2147483648 0 1 1", "rect -2147483649 0 1 1",
+       "rect 0 0 0 1", "rect 0 0 1 -1", "rect 0 0 1 1 junk", "rect 0 0 1",
+       "rect 0 0 1x 1", "view 0 0 1 1", "", "rect 0 0 1 9999999999999999999"})
+    CHECK(!rect(line, true, box));
+}
+void capabilities() {
+  using namespace yougame::parity;
+  CHECK(std::string(caps(false)) == kCaps);
+  CHECK(std::string(caps(false)).find("toplevel") == std::string::npos);
+  CHECK(std::string(caps(true)) == "yg {\"caps\":[\"ready\",\"overlay\",\"join\",\"notice\",\"pads\",\"rumble\",\"view\",\"volume\",\"toplevel\"]}");
+  Signals top;
+  top.start(false, write_line, true);
+  CHECK(lines.empty());
+  top.start(true, write_line, true);
+  top.start(true, write_line, false);
+  top.presented(true);
+  CHECK(lines == (std::vector<std::string>{kToplevelCaps, kReady}));
+  lines.clear();
+  Signals child;
+  child.start(true, write_line);
+  CHECK(lines == (std::vector<std::string>{kCaps}));
+}
+void present() {
+  using yougame::box_present::choose;
+  for (bool vsync : {false, true}) for (bool fullscreen : {false, true})
+    for (bool agent : {false, true}) for (bool flip : {false, true})
+      for (bool paced : {false, true}) for (bool tearing : {false, true})
+        for (bool vrr : {false, true}) {
+          const auto top = choose(true, vsync, fullscreen, agent, flip, paced, tearing, vrr, true);
+          const auto standalone = choose(false, vsync, fullscreen, agent, flip, paced, tearing, vrr);
+          CHECK(top.interval == standalone.interval && top.flags == standalone.flags);
+          CHECK(!top.compositor && !top.agent);
+          CHECK(top.interval == (vsync || vrr ? 1u : 0u));
+          CHECK(top.flags == (!vsync && !vrr && tearing ? yougame::box_present::allow_tearing : 0u));
+          const auto child = choose(true, vsync, fullscreen, agent, flip, paced, tearing, vrr);
+          CHECK(child.compositor == (vsync && !fullscreen && flip && agent && paced));
+          CHECK(child.agent == child.compositor);
+          CHECK(child.interval == (child.compositor ? 0u : vsync || vrr ? 1u : 0u));
+        }
+}
+void focus() {
+  CHECK(app_pid("1234") == 1234);
+  CHECK(app_pid("4294967294") == 4294967294u);
+  for (const char* pid : {"", "0", "-1", "+1", " 123", "123 ", "12x", "1.0",
+       "4294967295", "4294967296", "99999999999999999999999999999"}) CHECK(app_pid(pid) == 0);
+  CHECK(preferred_app_pid(1234, 5678) == 1234);
+  CHECK(preferred_app_pid(1234, 1234) == 1234);
+  CHECK(preferred_app_pid(1234, 0) == 1234);
+  CHECK(preferred_app_pid(0, 5678) == 5678);
+  CHECK(preferred_app_pid(0, 0) == 0);
+  CHECK(preferred_app_pid(UINT32_MAX, 5678) == 5678);
+  CHECK(preferred_app_pid(UINT32_MAX, 0) == 0);
+  for (bool foreground : {false, true}) for (bool focused : {false, true})
+    CHECK(emit_focus_return(foreground, focused) == (foreground || focused));
+  CHECK(std::string(kFocusReturn) == "yg {\"focusReturn\":1}");
+  CHECK(hwnd_line(0x1A2B3C) == "yg {\"toplevelHwnd\":1715004}");
+  CHECK(focus_return_message(1234) == "embed: toplevel focus return pid=1234");
+  CHECK(focus_return_message(0) == "embed: toplevel focus return pid=none");
+  FocusReturn state;
+  CHECK(state.changed());
+  CHECK(!state.changed());
+  state.focused();
+  CHECK(state.changed());
+  CHECK(!state.changed());
+}
+}
+int main() {
+  window_styles(); geometry(); capabilities(); present(); focus();
+  std::printf("yougame embed toplevel: %d checks passed\n", checks);
+}
diff --git a/port/tests/yougame_embed_toplevel_wiring_test.py b/port/tests/yougame_embed_toplevel_wiring_test.py
new file mode 100644
index 0000000..e7c3126
--- /dev/null
+++ b/port/tests/yougame_embed_toplevel_wiring_test.py
@@ -0,0 +1,183 @@
+"""Windows toplevel contract wiring; reads source and never launches the game."""
+from pathlib import Path
+import re
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def source(path):
+    return (ROOT / path).read_text(encoding="utf-8-sig")
+
+
+def block(text, marker):
+    start = text.index("{", text.index(marker))
+    depth = 1
+    end = start + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start + 1:end - 1]
+
+
+class ToplevelWiringTest(unittest.TestCase):
+    def setUp(self):
+        self.window = source("port/runtime/host/window.cpp")
+        self.link = source("port/runtime/hle/yougame_link.cpp")
+
+    def test_env_is_taken_before_reader_and_ignored_off_windows(self):
+        start = block(self.link, "void start()")
+        flags = start[start.index('#ifdef _WIN32'):start.index('#endif', start.index('#ifdef _WIN32'))]
+        self.assertIn('enabled(g_embedded, take("YOUGAME_EMBED_TOPLEVEL"))', flags)
+        self.assertIn('app_pid(take("YOUGAME_APP_PID"))', flags)
+        self.assertLess(start.index('take("YOUGAME_APP_PID")'), start.index('std::thread(read_stdin)'))
+        self.assertIn('bool g_embed_toplevel = false;', self.link)
+
+    def test_caps_follow_successful_window_creation(self):
+        create = block(self.window, 'void* window_create(')
+        self.assertLess(create.index('if (!g_hwnd) die('), create.index('yougame::embed_window_ready(reinterpret_cast<uintptr_t>(g_hwnd));'))
+        self.assertIn('if (!g_embed_toplevel) parity::signals.start(true,', self.link)
+        ready = block(self.link, 'void embed_window_ready(uintptr_t hwnd)')
+        self.assertIn('if (g_embed_toplevel)', ready)
+        self.assertIn('parity::signals.start(g_stdio,', ready)
+        self.assertIn('}, true);', ready)
+        self.assertIn('if (hwnd) parity::signals.emit(embed_toplevel_policy::hwnd_line(hwnd).c_str());', ready)
+
+    def test_styles_are_chosen_at_creation_and_owner_is_external(self):
+        create = block(self.window, 'void* window_create(')
+        self.assertIn('styles(yougame::embed_toplevel(), flip, Backend::D3D12,', create)
+        self.assertIn('CreateWindowExW(style.exstyle,', create)
+        self.assertIn('title, style.style,', create)
+        adopted = block(create, 'const auto boxAdopted = []')
+        self.assertIn('if (yougame::embed_toplevel()) return GetWindow(g_hwnd, GW_OWNER) != nullptr;', adopted)
+        for call in ('SetParent(', 'SetForegroundWindow(', 'SetActiveWindow(', 'AttachThreadInput('):
+            self.assertIsNone(re.search(r"\b" + re.escape(call), self.window), call)
+        # The only parent-focus operations remain in the legacy child case, after a toplevel return.
+        for marker in ('case kBoxFocus:', 'case kBoxShow: {'):
+            case = self.window[self.window.index(marker):]
+            top = block(case, 'if (yougame::embed_toplevel())')
+            self.assertNotIn('GetParent(', top)
+            self.assertIn('return 0;', top)
+            self.assertGreater(case.index('SetFocus(GetParent(h))'), case.index(top) + len(top))
+
+    def test_screen_rects_bypass_child_clipping_and_zorder(self):
+        apply = block(self.window, 'void apply_toplevel_geometry(')
+        self.assertIn('first(w), second(w), first(l), second(l)', apply)
+        self.assertIn('SWP_NOACTIVATE | SWP_NOZORDER', apply)
+        self.assertNotIn('SetWindowRgn', apply)
+        handler = block(self.window, 'yougame::set_box_handler([window]')
+        top = block(handler, 'if (yougame::embed_toplevel())')
+        self.assertIn('rect(line, true, box)', top)
+        self.assertIn('PostMessageW(window, kBoxScreenRect,', top)
+        self.assertIn('pack(box.x, box.y)', top)
+        self.assertNotIn('0xFFFF', top)
+        self.assertIn('if (line.rfind("view ", 0) == 0) return;', top)
+        self.assertIn('if (yougame::embed_toplevel()) return;', block(self.window, 'void raise_embed('))
+
+    def test_dpi_and_fullscreen_are_app_owned(self):
+        start = block(self.link, 'void start()')
+        top = block(start, 'if (g_embed_toplevel)')
+        failed = block(top, 'if (!SetProcessDpiAwarenessContext(')
+        self.assertIn('g_toplevel_dpi_error = GetLastError();', failed)
+        self.assertIn('g_toplevel_dpi_failed = true;', failed)
+        self.assertNotIn('host::log(', top)
+        logging = block(self.link, 'void logging_ready()')
+        self.assertIn('std::call_once(once,', logging)
+        self.assertIn('if (g_embed_toplevel && g_toplevel_dpi_failed)', logging)
+        self.assertIn('embed: toplevel DPI awareness failed err=%lu', logging)
+        create = block(self.window, 'void* window_create(')
+        self.assertNotIn('requires per-monitor-v2 DPI awareness', create)
+        dpi = self.window[self.window.index('case WM_DPICHANGED:'):]
+        top = block(dpi, 'if (yougame::embed_toplevel())')
+        self.assertIn('g_on_dpi(HIWORD(w))', top)
+        self.assertIn('return 0;', top)
+        self.assertNotIn('SetWindowPos', top)
+        for path in ('port/app/main.cpp', 'port/runtime/gx/threaded_backend.cpp'):
+            text = source(path)
+            self.assertRegex(text, r'#ifdef _WIN32\s*(?://[^\n]*\n\s*)?if \(yougame::embed_toplevel\(\)\) \w+\.exclusive_fullscreen = false;')
+        fullscreen = block(self.window, 'void window_set_fullscreen(')
+        self.assertIn('if (yougame::embedded()) return;', fullscreen)
+
+    def test_flip_surface_is_declared_in_both_game_window_paths(self):
+        for path, arg in (('port/app/main.cpp', '!hidden'), ('port/runtime/gx/threaded_backend.cpp', 'visible')):
+            self.assertIn(f'{arg}\n#ifdef _WIN32\n', source(path))
+            self.assertIn(', true\n#endif', source(path))
+        d11 = source('port/runtime/gx/gx_d3d11.cpp')
+        fallback = d11[d11.index('if (FAILED(swapchain_hr))'):]
+        self.assertLess(fallback.index('if (yougame::embed_toplevel()) require(swapchain_hr,'),
+                        fallback.index('sd.SwapEffect = DXGI_SWAP_EFFECT_DISCARD'))
+        for backend in ('d3d11', 'd3d12'):
+            text = source(f'port/runtime/gx/gx_{backend}.cpp')
+            self.assertIn('synced, yougame::embed_toplevel());', text)
+            fullscreen = block(text, '::apply_fullscreen_mode()')
+            self.assertIn('if (yougame::embed_toplevel()) opts_.exclusive_fullscreen = false;', fullscreen)
+
+    def test_focus_return_grants_only_the_pid_then_emits_then_logs(self):
+        focus = block(self.window, 'void return_toplevel_focus(HWND h)')
+        self.assertIn('if (!yougame::embed_toplevel_policy::emit_focus_return(GetForegroundWindow() == h, g_has_focus.load())) return;', focus)
+        self.assertLess(focus.index('emit_focus_return('), focus.index('toplevel_app_pid(h)'))
+        self.assertIn('if (pid && !AllowSetForegroundWindow(pid))', focus)
+        failed = block(focus, 'if (pid && !AllowSetForegroundWindow(pid))')
+        self.assertIn('const DWORD error = GetLastError();', failed)
+        self.assertIn('if (!failure_logged)', failed)
+        self.assertIn('embed: toplevel AllowSetForegroundWindow failed err=%lu', failed)
+        self.assertLess(focus.index('AllowSetForegroundWindow(pid)'), focus.index('signals.emit('))
+        self.assertIn('signals.emit(yougame::embed_toplevel_policy::kFocusReturn)', focus)
+        self.assertIn('if (g_toplevel_focus.changed())', focus)
+        self.assertIn('focus_return_message(pid)', focus)
+        show = block(self.window[self.window.index('case kBoxShow: {'):], 'if (yougame::embed_toplevel())')
+        self.assertLess(show.index('if (!w) return_toplevel_focus(h);'), show.index('ShowWindow('))
+        focus = block(self.window[self.window.index('case kBoxFocus:'):], 'if (yougame::embed_toplevel())')
+        self.assertIn('if (w && IsWindowVisible(h))', focus)
+        self.assertIn('SetFocus(h);', focus)
+        self.assertIn('else if (!w) return_toplevel_focus(h);', focus)
+        self.assertIn('if (w && !foreground_logged)', focus)
+        self.assertIn('embed: toplevel foreground=%d', focus)
+        self.assertLess(focus.index('SetFocus(h);'), focus.index('embed: toplevel foreground=%d'))
+
+    def test_toplevel_uses_foreground_focus_and_prefers_owner_pid(self):
+        focused = block(self.window, 'bool window_focused(HWND h)')
+        self.assertIn('if (yougame::embed_toplevel()) return GetForegroundWindow() == h;', focused)
+        self.assertIn('return yougame::embedded() ? g_has_focus.load() : GetForegroundWindow() == h;', focused)
+        pid = block(self.window, 'uint32_t toplevel_app_pid(HWND h)')
+        self.assertIn('GetWindowThreadProcessId(GetWindow(h, GW_OWNER), &owner_pid)', pid)
+        self.assertIn('preferred_app_pid(owner_pid, env_pid)', pid)
+        self.assertIn('owner_pid && env_pid && owner_pid != env_pid && !mismatch_logged', pid)
+        self.assertIn('embed: toplevel owner pid %lu differs from YOUGAME_APP_PID %u', pid)
+
+    def test_toplevel_waits_for_placement_and_falls_back_after_timeout(self):
+        apply = block(self.window, 'void apply_toplevel_geometry(')
+        self.assertLess(apply.index('if (!SetWindowPos('), apply.index('g_toplevel_rect = true;'))
+        self.assertLess(apply.index('g_toplevel_rect = true;'), apply.index('ShowWindow('))
+        self.assertIn('if (g_toplevel_shown && !IsWindowVisible(h))', apply)
+        show = block(self.window[self.window.index('case kBoxShow: {'):], 'if (yougame::embed_toplevel())')
+        self.assertIn('if (!w || g_toplevel_rect || g_toplevel_fallback) ShowWindow(', show)
+        create = block(self.window, 'void* window_create(')
+        init = block(create, 'if (yougame::embed_toplevel())')
+        self.assertIn('g_toplevel_shown = visible;', init)
+        self.assertIn('g_toplevel_fallback = false;', init)
+        self.assertIn('const ULONGLONG until = GetTickCount64() + 30000;', create)
+        self.assertIn('while ((!boxAdopted() || (yougame::embed_toplevel() && !g_toplevel_rect)) && GetTickCount64() < until)', create)
+        boxed = block(create, 'if (boxed)')
+        adoption = block(boxed[boxed.index('Sleep(5);'):], 'if (yougame::embed_toplevel())')
+        self.assertIn('if (boxAdopted()) toplevel_app_pid(g_hwnd);', adoption)
+        fallback = block(adoption, 'if (!boxAdopted() || !g_toplevel_rect)')
+        self.assertIn('g_toplevel_fallback = true;', fallback)
+        self.assertIn('GetWindowLongPtrW(g_hwnd, GWL_EXSTYLE) & ~WS_EX_TOOLWINDOW', fallback)
+        self.assertIn('SWP_FRAMECHANGED', fallback)
+        self.assertIn('embed: toplevel never adopted; shown as a normal window', fallback)
+        self.assertLess(fallback.index('SetWindowLongPtrW('), fallback.index('ShowWindow('))
+        # No unconditional show remains after the adoption/placement gate.
+        tail = create[create.index('RegisterRawInputDevices(rid, 2, sizeof rid[0]);'):]
+        self.assertNotIn('ShowWindow(', block(tail, 'if (yougame::embed_toplevel())'))
+        screen_rect = self.window[self.window.index('case kBoxScreenRect:'):self.window.index('case kBoxRect:')]
+        self.assertIn('if (yougame::embed_toplevel()) apply_toplevel_geometry(h, w, l);', screen_rect)
+
+    def test_registration_precedes_linux_return(self):
+        cmake = source('CMakeLists.txt')
+        self.assertLess(cmake.index('include(port/tests/embed_toplevel.cmake)'), cmake.index('  return()'))
+        self.assertIn("'port_yougame_embed_toplevel_test'", source('tools/build_linux.py'))
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/port/tests/yougame_embed_view_test.cpp b/port/tests/yougame_embed_view_test.cpp
new file mode 100644
index 0000000..eae6e21
--- /dev/null
+++ b/port/tests/yougame_embed_view_test.cpp
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_embed_view.h"
+#include <climits>
+#include <initializer_list>
+#include <cstdio>
+#include <cstdlib>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+static bool equal(yg_embed_box a, yg_embed_box b) {
+  return a.x == b.x && a.y == b.y && a.w == b.w && a.h == b.h;
+}
+
+static void legacy(int minimum) {
+  auto s = yg_embed_view_init(1280, 960, minimum);
+  CHECK(!yg_embed_view_visible(&s));
+  for (const auto box : {yg_embed_box{10, 20, 640, 480}, {30, 40, 800, 600},
+                         {-20, -10, 640, 480}, {0, 0, minimum, minimum}}) {
+    const auto old = s.window;
+    const auto r = yg_embed_view_update(&s, box, 0);
+    CHECK(equal(r.window, box));
+    CHECK(equal(r.clip, (yg_embed_box{0, 0, box.w, box.h})));
+    CHECK(r.resize == (old.w != box.w || old.h != box.h));
+    CHECK(r.valid && r.visible && !s.has_view && !r.warn_clamp);
+  }
+  const auto old = s.window;
+  auto r = yg_embed_view_update(&s, {0, 0, minimum - 1, 480}, 0);
+  CHECK(!r.valid && !r.visible && !r.resize && equal(r.window, old));
+  yg_embed_view_show(&s, 0);
+  r = yg_embed_view_update(&s, {0, 0, 640, 480}, 0);
+  CHECK(r.valid && !r.visible);
+  yg_embed_view_show(&s, 1);
+  CHECK(yg_embed_view_visible(&s));
+}
+
+int main() {
+  legacy(1); legacy(32);
+  auto s = yg_embed_view_init(640, 480, 32);
+  const yg_embed_box view{100, 80, 1000, 800};
+  auto r = yg_embed_view_update(&s, view, 1);
+  CHECK(s.has_view && !s.has_rect && r.resize && equal(r.window, view));
+  CHECK(!r.visible && !r.valid && r.clip.w == 0 && r.clip.h == 0);
+  r = yg_embed_view_update(&s, view, 0);
+  CHECK(!r.resize && !r.move && r.visible);
+  CHECK(equal(r.clip, (yg_embed_box{0, 0, 1000, 800})));
+  // Six overlay transitions change only the clip, never layout or surface size.
+  for (int trim = 0; trim < 6; ++trim) {
+    r = yg_embed_view_update(&s, {100 + trim, 80 + trim, 1000 - 2 * trim, 800 - trim}, 0);
+    CHECK(!r.resize && !r.move && r.visible && equal(r.window, view));
+    CHECK(equal(r.clip, (yg_embed_box{trim, trim, 1000 - 2 * trim, 800 - trim})));
+  }
+  yg_embed_view_show(&s, 0);
+  r = yg_embed_view_update(&s, view, 0);
+  CHECK(!r.visible && !r.resize);
+  r = yg_embed_view_update(&s, {100, 80, 1200, 900}, 1);
+  CHECK(r.resize && !r.visible); // View changes resize, preserving hide.
+  yg_embed_view_show(&s, 1);
+  CHECK(yg_embed_view_visible(&s));
+  r = yg_embed_view_update(&s, {150, 90, 1200, 900}, 1);
+  CHECK(!r.resize && r.move); // Moving the whole view needs no new surface.
+
+  s = yg_embed_view_init(640, 480, 32);
+  yg_embed_view_update(&s, view, 1);
+  r = yg_embed_view_update(&s, {0, 0, 1200, 1000}, 0);
+  CHECK(r.warn_clamp && !r.resize && r.visible);
+  CHECK(equal(r.clip, (yg_embed_box{0, 0, 1000, 800})));
+  r = yg_embed_view_update(&s, {0, 0, 1200, 1000}, 0);
+  CHECK(!r.warn_clamp && !r.resize); // Log once per attachment.
+  r = yg_embed_view_update(&s, {1090, 870, 100, 100}, 0);
+  CHECK(equal(r.clip, (yg_embed_box{990, 790, 10, 10})) && !r.visible && !r.resize);
+  r = yg_embed_view_update(&s, {1200, 1000, 100, 100}, 0);
+  CHECK(equal(r.clip, (yg_embed_box{1000, 800, 0, 0})) && !r.visible && !r.resize);
+  yg_embed_view_show(&s, 1);
+  CHECK(!yg_embed_view_visible(&s));
+  r = yg_embed_view_update(&s, {0, 0, 10, 10}, 0);
+  CHECK(equal(r.clip, (yg_embed_box{0, 0, 0, 0})) && !r.resize);
+  r = yg_embed_view_update(&s, {100, 80, -1, -1}, 0);
+  CHECK(r.clip.w == 0 && r.clip.h == 0 && !r.resize && !r.visible);
+  r = yg_embed_view_update(&s, view, 0);
+  CHECK(r.visible && !r.resize);
+  r = yg_embed_view_update(&s, {100, 80, 0, 0}, 1);
+  CHECK(!r.resize && !r.visible && equal(r.window, view));
+
+  // A rect preceding the first view must switch from legacy mapping to clipping.
+  s = yg_embed_view_init(1280, 960, 1);
+  yg_embed_view_update(&s, {120, 100, 800, 600}, 0);
+  r = yg_embed_view_update(&s, view, 1);
+  CHECK(r.resize && r.visible && equal(r.window, view));
+  CHECK(equal(r.clip, (yg_embed_box{20, 20, 800, 600})));
+  r = yg_embed_view_update(&s, {INT_MAX - 100, INT_MAX - 100, 1000, 800}, 1);
+  CHECK(!r.resize && !r.visible);
+  r = yg_embed_view_update(&s, {INT_MAX - 90, INT_MAX - 90, 50, 50}, 0);
+  CHECK(equal(r.clip, (yg_embed_box{10, 10, 50, 50})) && r.visible && !r.resize);
+  std::puts("YouGame embed view geometry passed");
+}
diff --git a/port/tests/yougame_embed_volume_test.cpp b/port/tests/yougame_embed_volume_test.cpp
