+// Portable broker ordering and room recovery policy, shared with the fake-broker tests.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "yougame_ranked.h"
+#include <algorithm>
+#include <chrono>
+#include <atomic>
+#include <condition_variable>
+#include <climits>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <set>
+#include <stdexcept>
