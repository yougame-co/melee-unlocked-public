+// Window-free checks of YouGame's spectator and mod-source boundaries.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_mode_policy.h"
+#include "hle_card_filter.h"
+#include "../runtime/gx/render_options.h"
+#include <cstdio>
+#include <cstdlib>
+#include <initializer_list>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+int main() {
+  using namespace yougame::mode_policy;
+  int route_cases = 0;
+  for (int mode : {0, 1, 2, 3, 4}) {
+    for (bool active : {false, true}) {
+      for (bool login : {false, true}) {
+        for (bool agent : {false, true}) {
+          for (bool friend_room : {false, true}) {
+            for (bool vanilla : {false, true}) {
+              const auto expected = agent || (active && (mode != 1 || !login || friend_room || !vanilla))
+                  ? MatchmakingRoute::YouGame : MatchmakingRoute::Slippi;
+              CHECK(matchmaking_route(mode, active, login, agent, friend_room, vanilla) == expected);
+              ++route_cases;
+            }
+          }
+        }
+      }
+    }
+  }
+  CHECK(route_cases == 160);
+  // A remix (not vanilla-only) never reaches Slippi, even signed in to Slippi on plain Unranked.
+  CHECK(matchmaking_route(1, true, true, false, false, false) == MatchmakingRoute::YouGame);
+  CHECK(matchmaking_route(1, true, true, false, false, true) == MatchmakingRoute::Slippi);
+  // Ranked stays off the YouGame Online menu until it plays like Slippi's (Luis, 2026-10-29).
+  CHECK(!yougame_ranked_offered);
+  std::printf("yougame_mode_policy: %d matchmaking route cases passed\n", route_cases);
+  CHECK(hle::card::file_filter == nullptr);  // Standalone card tests and mounts need no app filter.
+  CHECK(spectator_allowed(false, true));
+  CHECK(!spectator_allowed(false, false));
+  CHECK(!spectator_allowed(true, false));
+  CHECK(!spectator_allowed(true, true));  // A stale saved 'on' cannot open the listener.
+  // The crash dialog is for a player who started the game themselves; in the player box the app reports.
+  CHECK(crash_dialog_allowed(false, false));
+  CHECK(!crash_dialog_allowed(false, true));
+  CHECK(!crash_dialog_allowed(true, false));
+  CHECK(!crash_dialog_allowed(true, true));
+  // The app shows the last stderr line of a stopped run: one line, registers cut, never a path.
+  CHECK(crash_line("guest fault: interpreter jump outside RAM (C7B6B105) in TRK_flush_cache (80328F50); lr=80673588 r1=804EEA30") ==
+        "crash: guest fault: interpreter jump outside RAM (C7B6B105) in TRK_flush_cache (80328F50)");
+  CHECK(crash_line("cannot open C:\\Users\\someone\\melee.iso") == "crash: fatal error");
+  CHECK(crash_line("cannot open /home/someone/melee.iso") == "crash: fatal error");
+  CHECK(crash_line("") == "crash: fatal error");
+  CHECK(crash_line(nullptr) == "crash: fatal error");
+  CHECK(crash_line("two\nlines") == "crash: two");
+  CHECK(crash_line(std::string(300, 'x').c_str()).size() == 7 + 160);
+
+  for (bool yougame_mode : {false, true}) {
+    for (bool explicit_args : {false, true}) {
+      for (bool saved_profile : {false, true}) {
+        for (std::size_t choices : {std::size_t(0), std::size_t(1), std::size_t(7)}) {
+          const auto sources = mod_sources(yougame_mode, explicit_args, saved_profile, choices);
+          CHECK(sources.explicit_args == explicit_args);  // Listing args survive saved state.
+          CHECK(sources.saved_profile == (!yougame_mode && !explicit_args && saved_profile));
+          CHECK(sources.folders == !yougame_mode);  // Includes newly discovered packs and Mods/Files.
+          CHECK(sources.ignored_choices == (yougame_mode ? choices + (saved_profile ? 1 : 0) : 0));
+        }
+      }
+    }
+  }
+  const auto clean = mod_sources(true);
+  CHECK(!clean.explicit_args && !clean.saved_profile && !clean.folders && clean.ignored_choices == 0);
+  // Auxiliary loaders (Gecko/replay code files, AI discs, boot discs, alternate game libraries
+  // and test-only TE ownership)
+  // must stay off even when a listing explicitly selected some other mod layers.
+  for (bool explicit_args : {false, true}) {
+    const auto listing = mod_sources(true, explicit_args, true, 3);
+    CHECK(!listing.folders);
+    CHECK(!listing.saved_profile);
+    CHECK(listing.explicit_args == explicit_args);
+    CHECK(listing.ignored_choices == 4);
+  }
+  // Card mount policy: ordinary saves always work, and explicitly imported mod saves retain their
+  // private saved copy. A mod ISO/profile alone cannot authorize an ambient TE save.
+  for (bool yougame_mode : {false, true}) {
+    for (bool mod_save : {false, true}) {
+      for (bool explicit_import : {false, true}) {
+        CHECK(card_save_allowed(yougame_mode, mod_save, explicit_import) ==
+              (!yougame_mode || !mod_save || explicit_import));
+      }
+    }
+  }
+  CHECK(!card_save_allowed(true, true));
+  CHECK(card_save_allowed(true, false));
+  CHECK(card_save_allowed(true, true, true));
+  // Upstream owns the parent listing's feature gate. Suspending it must leave the saved choices
+  // intact, and a subsequent remix launch must regain mod support without restoring ambient loaders.
+  gx::RenderOptions saved;
+  saved.mod_profile = "saved-profile";
+  saved.mod_choices["te"] = 1;
+  host::gameplay::vanilla_only_session = true;
+  CHECK(!gx::RenderOptions::mod_features_available());
+  CHECK(saved.mod_profile == "saved-profile" && saved.mod_choices.at("te") == 1);
+  for (const char* arg : {"--mod-iso", "--mod-base-iso", "--mod-profile", "--mod-dir", "--mod-gci",
+                          "--gecko-codes", "--te-options", "--te-options2", "--ram-translator", "--lag-test"})
+    CHECK(host::gameplay::conflicts_with_vanilla(arg));
+  for (const char* arg : {"--iso", "--settings-path", "--card-dir", "--no-mod-autodetect",
+                          "--slippi-menus", "--online-test"})
+    CHECK(!host::gameplay::conflicts_with_vanilla(arg));
+  host::gameplay::vanilla_only_session = false;
+  host::gameplay::mod_autodetect_disabled = true;
+  CHECK(gx::RenderOptions::mod_features_available());  // Explicit remix imports remain available.
+  CHECK(!mod_sources(true, true, true, 1).folders);
+  CHECK(!card_save_allowed(true, true));
+  host::gameplay::mod_autodetect_disabled = false;
+  std::puts("yougame_mode_policy: spectator matrix and mod-source precedence/counts ok");
+}
diff --git a/port/tests/yougame_net_test.cpp b/port/tests/yougame_net_test.cpp
new file mode 100644
index 0000000..72fc422
--- /dev/null
+++ b/port/tests/yougame_net_test.cpp
@@ -0,0 +1,118 @@
+// Window-free fake-clock scheduling, startup parsing and Direct-only policy checks.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_net_test.h"
+#include "yougame_agent_test.h"
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame;
+using nlohmann::json;
+void parsing() {
+  using agent_test::map_keys;
+  using agent_test::Engine;
+  auto defaults = map_keys(json::object());
+  CHECK(!defaults.net.enabled() && defaults.net.jitter_ms == 0);
+  for (int delay : {0, 1, 90, 250}) {
+    auto s = map_keys({{"netDelayMs", delay}});
+    CHECK(s.net.delay_ms == unsigned(delay));
+    CHECK(s.arguments.empty() && s.environment.empty());
+    CHECK(s.log.find("ignored") == std::string::npos);
+  }
+  for (int jitter : {0, 1, 20, 100}) {
+    auto s = map_keys({{"netDelayMs", 90}, {"netJitterMs", jitter}});
+    CHECK(s.net.delay_ms == 90 && s.net.jitter_ms == unsigned(jitter));
+  }
+  for (const char* key : {"netDelayMs", "netJitterMs"}) {
+    for (const auto& bad : {json(-1), json(251), json(1.0), json(true), json(false), json("90"),
+         json(nullptr), json::array(), json::object(), json(UINT64_MAX)}) {
+      auto object = json{{"netDelayMs", 90}};
+      object[key] = bad;
+      auto s = map_keys(object);
+      CHECK(s.log.find(std::string("agent-test: ") + key + " invalid value; ignored") != std::string::npos);
+      CHECK(key == std::string("netDelayMs") ? !s.net.enabled() : s.net.jitter_ms == 0);
+    }
+    auto s = map_keys({{key, 20}}, Engine::Static);
+    CHECK(!s.net.enabled() && s.net.jitter_ms == 0);
+    CHECK(s.log == std::string("agent-test: ") + key + " not supported on the Static Recomp; ignored");
+  }
+  CHECK(map_keys({{"netDelayMs", 90}, {"netJitterMs", 101}}).net.jitter_ms == 0);
+  for (const auto& object : {json{{"netJitterMs", 0}}, json{{"netJitterMs", 20}},
+       json{{"netDelayMs", 0}, {"netJitterMs", 20}},
+       json{{"netDelayMs", -1}, {"netJitterMs", 20}}}) {
+    auto s = map_keys(object);
+    CHECK(!s.net.enabled() && s.net.jitter_ms == 0);
+    CHECK(s.log.find("agent-test: netJitterMs requires netDelayMs > 0; ignored") != std::string::npos);
+  }
+  auto conflict = map_keys({{"netDelayMs", 90}, {"netJitterMs", 20}}, Engine::Source, {}, true);
+  CHECK(!conflict.net.enabled() && conflict.net.jitter_ms == 0);
+  CHECK(conflict.log == "agent-test: net delay keys conflict with receive-side injector; ignored");
+  for (int mode = -1; mode < 6; ++mode) {
+    CHECK(net_test::mode_allowed({}, mode));
+    CHECK(net_test::mode_allowed({90, 20}, mode) == (mode == 2));
+  }
+  CHECK(std::string(net_test::mode_name(0)) == "ranked");
+  CHECK(std::string(net_test::mode_name(1)) == "unranked");
+  CHECK(std::string(net_test::mode_name(3)) == "teams");
+  CHECK(std::string(net_test::mode_name(4)) == "party");
+  net_test::install({90, 20}); net_test::install({120, 40});
+  CHECK(net_test::config().delay_ms == 90 && net_test::config().jitter_ms == 20);
+}
+void queue() {
+  using Q = net_test::DelayQueue<std::unique_ptr<int>>;
+  auto value = [](int x) { return std::make_unique<int>(x); };
+  std::vector<int> sent;
+  auto send = [&](const auto& p) { sent.push_back(*p); };
+  Q off({});
+  auto p = value(1);
+  CHECK(!off.push(0x80, 100, 0, std::move(p)) && p && off.size() == 0);
+  CHECK(off.wait_ms(100, 250) == 250);
+  Q q({60, 0});
+  for (unsigned id = 0; id < 256; ++id) {
+    auto packet = value(id);
+    CHECK(q.push(id, 100, 0, std::move(packet)) == (id == 0x80 || id == 0xE1));
+    if (!net_test::input_message(id)) CHECK(packet);
+  }
+  CHECK(q.size() == 2 && q.wait_ms(100, 250) == 60);
+  CHECK(q.wait_ms(100, 1) == 1);
+  CHECK(!q.drain(159, send) && sent.empty());
+  CHECK(q.wait_ms(160, 250) == 0);
+  CHECK(q.drain(160, send) && sent == (std::vector<int>{0x80, 0xE1}));
+  CHECK(q.wait_ms(160, 250) == 250);
+  CHECK(q.push(0x80, 170, 0, value(1)));
+  q.reset(1); // StartSlippiGame: pending and not-yet-drained async inputs both expire.
+  CHECK(q.size() == 0);
+  CHECK(q.push(0xE1, 170, 0, value(2)) && q.size() == 0);
+  CHECK(q.push(0x80, 170, 1, value(3)));
+  q.reset(1); CHECK(q.size() == 1); // Repeated generation observations cannot discard inputs.
+  CHECK(q.drain(230, send) && sent.back() == 3);
+  CHECK(q.push(0x80, 240, 1, value(4)));
+  q.reset(2); // Disconnect: do not send anything left from this peer/session.
+  CHECK(!q.drain(9999, send) && sent.back() == 3);
+
+  Q jitter({90, 100}), repeat({90, 100});
+  std::vector<int> order, order2;
+  uint64_t previous_deadline = 0;
+  for (int i = 0; i < 500; ++i) {
+    const uint64_t enqueued = 1000 + i;
+    CHECK(jitter.push(i & 1 ? 0x80 : 0xE1, enqueued, 0, value(i)));
+    CHECK(repeat.push(i & 1 ? 0x80 : 0xE1, enqueued, 0, value(i)));
+  }
+  for (uint64_t t = 1000; t <= 1690; ++t) {
+    jitter.drain(t, [&](const auto& packet) {
+      const uint64_t enqueued = 1000 + *packet;
+      CHECK(t >= enqueued + 90 && t <= enqueued + 190);
+      CHECK(t >= previous_deadline); previous_deadline = t;
+      order.push_back(*packet);
+    });
+    repeat.drain(t, [&](const auto& packet) { order2.push_back(*packet); });
+    CHECK(order == order2); // Private fixed seed, independent of gameplay/global RNG.
+  }
+  CHECK(order.size() == 500 && jitter.size() == 0);
+  for (int i = 0; i < 500; ++i) CHECK(order[i] == i);
+}
+int main() { parsing(); queue(); std::puts("net test: parsing, modes and fake-clock queue passed"); }
+#else
+int main() { return 0; }
+#endif
diff --git a/port/tests/yougame_pad_trace_test.cpp b/port/tests/yougame_pad_trace_test.cpp
new file mode 100644
index 0000000..9648473
--- /dev/null
+++ b/port/tests/yougame_pad_trace_test.cpp
@@ -0,0 +1,91 @@
+#include "yougame_agent_pad_trace.h"
+#include "yougame_agent_test.h"
+#include <cstdio>
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <regex>
+using namespace yougame;
+namespace fs = std::filesystem;
+static int checks = 0;
+#define CHECK(x) do { ++checks; if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+static std::string read(const fs::path& path) {
+  std::ifstream in(path);
+  return {std::istreambuf_iterator<char>(in), {}};
+}
+int main(int argc, char** argv) {
+  CHECK(argc == 2);
+  const auto root = fs::u8path(argv[1]);
+  fs::remove_all(root);
+  fs::create_directories(root / "sub");
+  auto parse = [&](nlohmann::json j) { return agent_test::map_keys(j, agent_test::Engine::Source, root); };
+  CHECK(parse({{"padTrace", "sub/pads.txt"}}).pad_trace == "sub/pads.txt");
+  CHECK(parse({{"padTrace", "sub\\pads.txt"}}).pad_trace == "sub/pads.txt");
+  for (const auto* bad : {"", "../pads", "/pads", "C:/pads", "missing/pads", "sub/", ".", "x\ny"}) {
+    const auto s = parse({{"padTrace", bad}});
+    CHECK(s.pad_trace.empty());
+    CHECK(s.log.find("agent-test: padTrace invalid output path; ignored") != s.log.npos);
+  }
+  CHECK(parse({{"padTrace", true}}).pad_trace.empty());
+  agent_paths::Root cap;
+  CHECK(cap.load(root));
+  agent_test::PadTrace trace;
+  CHECK(trace.arm("sub/pads.txt", cap));
+  agent_test::TracePad p{0x1100, -80, 80, 0, 0, 0, 0, 0, "relayed slot 2"};
+  trace.record(123, 0, p);
+  trace.record(124, 0, p);
+  CHECK(read(root / "sub/pads.txt") == "123 port 1 src relayed slot 2 buttons 1100 stick -80,80\n");
+  p.x = 0; trace.record(125, 0, p);
+  p.buttons = 0; trace.record(126, 0, p);
+  // Every pad field participates, including fields omitted from the concise output.
+  p.cx = 40; trace.record(127, 0, p);
+  p.cy = -40; trace.record(128, 0, p);
+  p.left = 127; trace.record(129, 0, p);
+  p.right = 255; trace.record(130, 0, p);
+  p.error = -1; p.source = "none"; trace.record(131, 0, p);
+  for (const auto* src : {"sdl", "adapter", "keyboard", "none"}) {
+    p.source = src;
+    trace.record(132, 3, p);
+  }
+  const auto contents = read(root / "sub/pads.txt");
+  CHECK(std::count(contents.begin(), contents.end(), '\n') == 12);
+  std::istringstream lines(contents);
+  std::string line;
+  const std::regex format(R"(^[0-9]+ port [1-4] src (relayed slot [1-4]|sdl|adapter|keyboard|none) buttons [0-9A-F]{4} stick -?[0-9]+,-?[0-9]+$)");
+  while (std::getline(lines, line)) CHECK(std::regex_match(line, format));
+  trace.record(133, -1, p); trace.record(133, 4, p);
+  CHECK(read(root / "sub/pads.txt") == contents);
+  trace.stop();
+  trace.record(134, 0, p);
+  CHECK(read(root / "sub/pads.txt") == contents);
+  CHECK(trace.arm("sub/pads.txt", cap));
+  trace.record(135, 0, p);
+  trace.stop();
+  CHECK(read(root / "sub/pads.txt").substr(0, contents.size()) == contents); // append across sessions
+  fs::create_symlink(root / "sub/pads.txt", root / "link");
+  CHECK(parse({{"padTrace", "link"}}).pad_trace.empty());
+  CHECK(!trace.arm("link", cap));
+  fs::create_hard_link(root / "sub/pads.txt", root / "hard");
+  CHECK(!trace.arm("hard", cap));
+  { std::ofstream out(root / "agent-test.json"); out << R"({"padTrace":"loaded.txt"})"; }
+  CHECK(agent_test::load(false, root.u8string().c_str()).pad_trace.empty());
+  CHECK(!fs::exists(root / "loaded.txt"));
+  CHECK(agent_test::load(true, root.u8string().c_str()).pad_trace == "loaded.txt");
+  agent_test::pad_trace.record(1, 1, p);
+  CHECK(!read(root / "loaded.txt").empty());
+  agent_test::load(false, nullptr);
+  const auto loaded = read(root / "loaded.txt");
+  agent_test::pad_trace.record(2, 1, {});
+  CHECK(read(root / "loaded.txt") == loaded);
+  cap.reset();
+  fs::remove_all(root);
+  std::printf("pad trace: %d/%d checks passed\n", checks, checks);
+}
+#else
+#include <type_traits>
+template<class T, class = void> struct HasPadTrace : std::false_type {};
+template<class T> struct HasPadTrace<T, std::void_t<decltype(std::declval<T>().pad_trace)>> : std::true_type {};
+static_assert(!HasPadTrace<yougame::agent_test::Settings>::value, "production settings exclude tracing");
+int main() { return 0; }
+#endif
diff --git a/port/tests/yougame_parity_test.cpp b/port/tests/yougame_parity_test.cpp
new file mode 100644
index 0000000..b95cbeb
--- /dev/null
+++ b/port/tests/yougame_parity_test.cpp
@@ -0,0 +1,139 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_parity.h"
+#include "../linux/embed_visibility.h"
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+
+namespace {
+std::mutex lines_mutex;
+std::vector<std::string> lines;
+void write_line(const char* line) {
+  std::lock_guard<std::mutex> lock(lines_mutex);
+  lines.emplace_back(line);
+}
+void expect(yougame::parity::OverlayKey::Result event, bool swallowed, const char* line = nullptr) {
+  CHECK(event.swallowed == swallowed);
+  CHECK((event.line == nullptr) == (line == nullptr));
+  if (line) CHECK(std::string(event.line) == line);
+}
+
+void check_embed_visibility() {
+  linux_window::EmbedVisibility visibility;
+  yougame::parity::Signals signals;
+  signals.start(true, write_line);
+  // Attachment alone and show-before-rect must not emit ready, even though the
+  // helper's size query already returns the original drawable dimensions.
+  CHECK(!visibility.visible());
+  visibility.show(true);
+  signals.presented(visibility.visible());
+  CHECK(lines.size() == 1);
+  visibility.rect(31, 480);
+  CHECK(!visibility.visible());
+  visibility.rect(640, 31);
+  CHECK(!visibility.visible());
+  visibility.rect(32, 32);
+  CHECK(visibility.visible());
+  visibility.show(false);
+  visibility.rect(640, 480);
+  CHECK(!visibility.visible());  // Rect updates never undo an explicit hide.
+  signals.presented(visibility.visible());
+  CHECK(lines.size() == 1);
+  visibility.show(true);
+  CHECK(visibility.visible());
+  visibility.rect(0, 480);
+  visibility.show(true);
+  CHECK(!visibility.visible());  // Show cannot override a too-small rect.
+  visibility.rect(640, -1);
+  CHECK(!visibility.visible());
+  signals.presented(visibility.visible());
+  CHECK(lines.size() == 1);
+  visibility.rect(640, 480);
+  CHECK(visibility.visible());
+  signals.presented(visibility.visible());
+  CHECK(lines.size() == 2 && lines.back() == yougame::parity::kReady);
+  visibility.show(false);
+  visibility.show(true);
+  signals.presented(visibility.visible());
+  CHECK(lines.size() == 2);  // Re-show never sends a second ready.
+  visibility = {};
+  CHECK(!visibility.visible());  // A new attachment needs its own page rect.
+  visibility.rect(32, 32);
+  CHECK(visibility.visible());
+  lines.clear();
+}
+}
+
+int main() {
+  check_embed_visibility();
+  using namespace yougame::parity;
+  Signals signals;
+  signals.start(false, write_line);  // Standalone and the legacy HTTP link.
+  signals.presented(true);
+  signals.emit(kDown);
+  CHECK(lines.empty());
+  signals.start(true, nullptr);
+  CHECK(lines.empty());
+
+  // Ineligible/early presents must not consume the ready flag. Concurrent callers
+  // stand in for startup and presentation threads; caps must precede a single ready.
+  signals.presented(true);
+  std::thread a([&] { signals.start(true, write_line); });
+  std::thread b([&] { signals.start(true, write_line); });
+  a.join(); b.join();
+  signals.start(true, write_line);
+  signals.presented(false);
+  CHECK(lines == std::vector<std::string>{kCaps});
+  std::thread c([&] { for (int i = 0; i < 100; ++i) signals.presented(true); });
+  std::thread d([&] { for (int i = 0; i < 100; ++i) signals.presented(true); });
+  c.join(); d.join();
+  CHECK(lines.size() == 2);
+  CHECK(lines[1] == "yg {\"ready\":true}");
+
+  OverlayKey key;
+  expect(key.tab(false, true, true, false), false);
+  expect(key.tab(false, false, true, false), false);
+  CHECK(key.cancel() == nullptr);
+  expect(key.tab(true, true, false, false), false);  // Plain Tab stays the practice key.
+  expect(key.tab(true, true, true, true), false);   // Shift added during repeat is not a press.
+  expect(key.tab(true, false, true, false), false);
+  expect(key.tab(true, true, true, true), false);   // Stray repeat must not generate down.
+  expect(key.tab(true, false, false, false), false);
+
+  auto event = key.tab(true, true, true, false);
+  expect(event, true, "yg {\"overlay\":\"down\"}"); signals.emit(event.line);
+  expect(key.tab(true, true, true, true), true);
+  expect(key.tab(true, true, false, true), true);   // Shift released before Tab.
+  event = key.tab(true, false, false, false);
+  expect(event, true, "yg {\"overlay\":\"up\"}"); signals.emit(event.line);
+  expect(key.tab(true, false, false, false), false); // Duplicate release.
+  CHECK(key.cancel() == nullptr);
+
+  event = key.tab(true, true, true, false);
+  expect(event, true, kDown); signals.emit(event.line);
+  const char* cancelled = key.cancel();  // Focus loss, deactivate, close and destroy share this.
+  CHECK(cancelled && std::string(cancelled) == "yg {\"overlay\":\"cancel\"}");
+  signals.emit(cancelled);
+  CHECK(key.cancel() == nullptr);        // Multiple focus/close notifications emit once.
+  expect(key.tab(true, true, false, true), true);
+  expect(key.tab(true, false, false, false), true); // Cancelled release never sends up.
+  expect(key.tab(true, true, false, false), false); // Plain Tab works again.
+  expect(key.tab(true, false, false, false), false);
+
+  // A lost key-up does not stop a fresh chord after returning to the window.
+  expect(key.tab(true, true, true, false), true, kDown);
+  CHECK(key.cancel() != nullptr);
+  expect(key.tab(true, true, true, false), true, kDown);
+  expect(key.tab(true, false, true, false), true, kUp);
+  CHECK(key.cancel() == nullptr);
+  CHECK(lines == (std::vector<std::string>{
+    kCaps, "yg {\"ready\":true}",
+    "yg {\"overlay\":\"down\"}", "yg {\"overlay\":\"up\"}",
+    "yg {\"overlay\":\"down\"}", "yg {\"overlay\":\"cancel\"}"}));
+  std::puts("YouGame host parity passed");
+}
