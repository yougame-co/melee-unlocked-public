index 0000000..17141dd
--- /dev/null
+++ b/port/tests/yougame_agent_fight_test.cpp
@@ -0,0 +1,213 @@
+// Window-free policy, native-state gating and startup parsing checks.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_agent_fight.h"
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include "yougame_agent_test.h"
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <tuple>
+
+static unsigned checks = 0;
+#define CHECK(x) do { ++checks; if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame::agent_test;
+
+static auto fields(const MuPadStatus& p) {
+  return std::make_tuple(p.button, p.stick_x, p.stick_y, p.sub_x, p.sub_y,
+                        p.trigger_l, p.trigger_r, p.analog_a, p.analog_b, p.err);
+}
+static uint32_t bits(float f) {
+  uint32_t value;
+  std::memcpy(&value, &f, sizeof value);
+  return value;
+}
+
+static void policy() {
+  FightState s{};
+  s.opponent_x = 80;
+  CHECK(fight_input(s).stick_x == 80);
+  CHECK(fight_input(s).button == 0);
+  s.self_x = 80;
+  s.opponent_x = 0;
+  CHECK(fight_input(s).stick_x == -80);
+  s.self_x = 0;
+  s.opponent_x = 10;
+  s.facing = -1;
+  CHECK(fight_input(s).stick_x == 40 && fight_input(s).button == 0);
+  s.opponent_x = -10;
+  s.facing = 1;
+  CHECK(fight_input(s).stick_x == -40 && fight_input(s).button == 0);
+  s.opponent_x = 10;
+  for (uint32_t base : {0u, 240u, 480u}) {
+    s.frame = base;
+    CHECK(fight_input(s).button == 0x0100 && fight_input(s).stick_x == 0); // jab
+    s.frame = base + 2;
+    CHECK(fight_input(s).button == 0);
+    s.frame = base + 54;
+    CHECK(fight_input(s).button == 0x0100 && fight_input(s).stick_x == 40); // tilt
+    s.frame = base + 56;
+    CHECK(fight_input(s).button == 0);
+    s.frame = base + 101;
+    CHECK(fight_input(s).button == 0 && fight_input(s).stick_y == 0);
+    for (uint32_t f = 102; f < 140; ++f) {
+      s.frame = base + f;
+      const auto pad = fight_input(s);
+      CHECK(pad.button == 0x0100); // charge lasts 38 frames, with a 2-frame up flick
+      CHECK(pad.stick_y == (f < 104 ? 80 : 0));
+    }
+    s.frame = base + 140;
+    CHECK(fight_input(s).button == 0 && fight_input(s).stick_y == 0);
+    s.frame = base + 174;
+    CHECK(fight_input(s).button == 0x0100 && fight_input(s).stick_y == -80); // down smash
+    s.frame = base + 176;
+    CHECK(fight_input(s).button == 0 && fight_input(s).stick_y == 0);
+  }
+  s.frame = 54;
+  s.opponent_x = -10;
+  s.facing = -1;
+  CHECK(fight_input(s).button == 0x0100 && fight_input(s).stick_x == -40);
+  s.airborne = true;
+  s.self_x = 90;
+  s.frame = 0;
+  CHECK(fight_input(s).stick_x == -60 && fight_input(s).stick_y == 80 && fight_input(s).button == 0x0200);
+  s.self_x = -90;
+  CHECK(fight_input(s).stick_x == 60 && fight_input(s).button == 0x0200);
+  s.self_x = 0;
+  s.self_y = -6;
+  CHECK(fight_input(s).stick_x == 0 && fight_input(s).stick_y == 80 && fight_input(s).button == 0x0200);
+  s.frame = 2;
+  CHECK(fight_input(s).button == 0 && fight_input(s).stick_y == 80);
+  s.frame = 12;
+  CHECK(fight_input(s).button == 0x0200); // a new special edge
+  s.airborne = false;
+  CHECK(fight_input(s).button != 0x0200); // grounded outside the edge is not recovery
+  s.airborne = true;
+  s.self_y = 0;
+  CHECK(fight_input(s).button == 0x0100 && fight_input(s).stick_x == -40); // onstage aerial
+  s.stage_edge = fight_stage_edge(8);
+  s.self_x = 60;
+  CHECK(fight_input(s).button == 0x0200); // Yoshi's smaller edge
+  s.stage_edge = fight_stage_edge(32);
+  s.opponent_x = 65;
+  CHECK(fight_input(s).button == 0x0100); // same position over FD is onstage
+
+  // The whole 180-second policy horizon, mirrored ground/air/recovery cases. Repeat the call
+  // after an unrelated state so accidental mutable counters cannot pass the equality check.
+  for (uint32_t f = 0; f < 10800; ++f) {
+    for (float x : {-95.0f, -10.0f, 10.0f, 95.0f}) {
+      for (bool air : {false, true}) {
+        s = {f, x, -6, x < 0 ? 1.0f : -1.0f, air, 14, 120, -x, 0, 80};
+        const auto pad = fight_input(s);
+        (void)fight_input(FightState{});
+        CHECK(fields(pad) == fields(fight_input(s)));
+        CHECK((pad.button & ~0x0300) == 0); // no Start, D-pad, shoulders or menu chord
+        CHECK(pad.sub_x == 0 && pad.sub_y == 0 && pad.trigger_l == 0 && pad.trigger_r == 0 && pad.err == 0);
+      }
+    }
+  }
+}
+
+static void injection() {
+  FightContext c{true, true, true, true, false, 1, 0};
+  MuStatePod state{};
+  state.scene_major = 0x0E;
+  state.scene = 1;
+  state.match_frame = 54;
+  for (int i = 0; i < 2; ++i) {
+    auto& p = state.player[i];
+    p.present = 1;
+    p.stocks = 4;
+    p.facing = bits(1);
+    p.pos_x = bits(i ? 0.0f : 10.0f);
+    p.percent = bits(30.0f * i);
+  }
+  MuLcancelView air{};
+  air.port[0].present = 1;
+  air.port[0].slot = 1; // local slot 1 is driven by physical port 0
+  auto sample = fight_sample(c, state, air);
+  CHECK(sample.port == 0 && sample.pad.stick_x == 40 && sample.pad.button == 0x0100);
+  std::array<MuPadStatus, 4> pads{};
+  for (auto& pad : pads) { pad.button = 0x1000; pad.stick_y = 15; pad.err = -1; }
+  const auto original = pads;
+  CHECK(apply_fight(pads.data(), sample, InputState{0, -1}, [](const char*) {}));
+  CHECK(fields(pads[0]) == fields(sample.pad));
+  for (int i = 1; i < 4; ++i) CHECK(fields(pads[i]) == fields(original[i]));
+  c.local_port = 3;
+  CHECK(fight_sample(c, state, air).port == 3);
+  c.local_port = 0;
+  auto inert = [&] {
+    pads = original;
+    CHECK(!apply_fight(pads.data(), fight_sample(c, state, air), InputState{0, -1}, [](const char*) {}));
+    for (int i = 0; i < 4; ++i) CHECK(fields(pads[i]) == fields(original[i]));
+  };
+  for (bool FightContext::* gate : {&FightContext::enabled, &FightContext::yougame,
+                                    &FightContext::online_test, &FightContext::in_match}) {
+    c.*gate = false; inert(); c.*gate = true;
+  }
+  c.replay = true; inert(); c.replay = false;
+  for (int port : {-1, 4}) { c.local_port = port; inert(); }
+  c.local_port = 0;
+  for (int slot : {-1, 4}) { c.local_slot = slot; inert(); }
+  c.local_slot = 1;
+  state.scene_major = 2; inert(); state.scene_major = 0x0E;
+  state.scene = 0; inert(); state.scene = 1;
+  state.match_frame = 0; inert(); state.match_frame = 54;
+  state.player[1].present = 0; inert(); state.player[1].present = 1;
+  state.player[1].stocks = 0; inert(); state.player[1].stocks = 4;
+  state.player[0].present = 0; inert(); state.player[0].present = 1;
+  state.player[0].stocks = 0; inert(); state.player[0].stocks = 4;
+  air.port[0].present = 0; inert(); air.port[0].present = 1;
+  state.player[2] = state.player[0]; inert(); state.player[2] = {};
+  state.player[1].pos_x = bits(std::numeric_limits<float>::quiet_NaN()); inert();
+  state.player[1].pos_x = bits(0);
+  // Airborne and stage bounds really travel through the snapshot adapter.
+  state.player[1].pos_x = bits(90);
+  state.match_frame = 12;
+  air.port[0].ground_or_air = 1;
+  CHECK(fight_sample(c, state, air).pad.button == 0x0200);
+  CHECK(fight_sample(c, state, air).pad.stick_x == -60);
+  CHECK(current_fight_sample.port == -1); // non-game consumers start inactive
+}
+
+static void parsing(const char* scratch) {
+  const auto directory = std::filesystem::u8path(scratch) / "fight-profile";
+  std::filesystem::create_directory(directory);
+  const auto path = directory / "agent-test.json";
+  auto load = [&](const nlohmann::json& object, bool active = true) {
+    { std::ofstream file(path); file << object.dump(); CHECK(file.good()); }
+    return yougame::agent_test::load(active, directory.string().c_str());
+  };
+  CHECK(!load(nlohmann::json::object()).fight);
+  const auto enabled = load({{"fight", true}});
+  CHECK(enabled.fight);
+  CHECK(enabled.arguments.empty() && enabled.environment.empty());
+  CHECK(enabled.log == "agent-test.json applied default keys: fight");
+  CHECK(!load({{"fight", false}}).fight);
+  CHECK(load({{"fight", false}}).log.empty());
+  for (const auto& invalid : {nlohmann::json(0), nlohmann::json(1), nlohmann::json(1.0),
+                            nlohmann::json("true"), nlohmann::json(nullptr),
+                            nlohmann::json::array(), nlohmann::json::object()}) {
+    const auto s = load({{"fight", invalid}});
+    CHECK(!s.fight && s.arguments.empty() && s.environment.empty());
+    CHECK(s.log == "agent-test.json; invalid/unknown or inapplicable keys ignored");
+  }
+  CHECK(load({{"fight", true}, {"mute", true}}).log == "agent-test.json applied default keys: fight, mute");
+  CHECK(!load({{"fight", true}}, false).fight);
+  CHECK(load({{"fight", true}}, false).log.empty());
+  CHECK(!yougame::agent_test::load(true, nullptr).fight);
+  CHECK(!yougame::agent_test::load(true, "").fight);
+  std::filesystem::remove_all(directory);
+}
+
+int main(int argc, char** argv) {
+  CHECK(argc == 2);
+  policy();
+  injection();
+  parsing(argv[1]);
+  std::printf("yougame_agent_fight: %u checks passed (policy, 180 s determinism, gating, local port, parsing)\n", checks);
+}
+#else
+// This target compiles the same header without the hook. Its binary must contain no fight symbols.
+int main() { return 0; }
+#endif
diff --git a/port/tests/yougame_agent_keys_test.cpp b/port/tests/yougame_agent_keys_test.cpp
new file mode 100644
index 0000000..f612cb2
--- /dev/null
+++ b/port/tests/yougame_agent_keys_test.cpp
@@ -0,0 +1,210 @@
+// Window-free key-script parsing, presentation epoch, and shared overlay ownership.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_agent_keys.h"
+#include "yougame_parity.h"
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include "yougame_agent_test.h"
+
+static unsigned checks = 0;
+#define CHECK(x) do { ++checks; if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame::agent_test;
+using namespace yougame::parity;
+using namespace std::chrono_literals;
+static std::vector<std::string> lines;
+static void write_line(const char* line) { lines.emplace_back(line); }
+
+static std::vector<ScriptedKey> parse(const std::string& script) {
+  std::string why;
+  const auto keys = parse_key_script(script, why);
+  CHECK(why.empty());
+  return keys;
+}
+
+static void parsing(const std::filesystem::path& directory) {
+  const auto keys = parse("overlay@20,escape@30,overlay@45");
+  CHECK(keys.size() == 3 && keys[0].overlay && !keys[1].overlay && keys[2].overlay);
+  CHECK(keys[0].seconds == 20 && keys[1].seconds == 30 && keys[2].seconds == 45);
+  const auto sorted = parse("overlay@600,escape@0.01,overlay@20,escape@20");
+  CHECK(sorted[0].seconds == 0.01 && sorted[3].seconds == 600);
+  CHECK(sorted[1].overlay && !sorted[2].overlay);  // Stable ties.
+  std::string sixteen;
+  for (int i = 0; i < 16; ++i) sixteen += (i ? "," : "") + std::string("overlay@1");
+  CHECK(parse(sixteen).size() == 16);
+  for (const auto& script : {std::string(), sixteen + ",escape@1", std::string("menu@20"),
+       std::string("Overlay@20"), std::string("overlay"), std::string("overlay@1@2"),
+       std::string("overlay@1,"), std::string(",overlay@1"), std::string("overlay@1,,escape@2"),
+       std::string("overlay@0"), std::string("overlay@-1"), std::string("overlay@601"),
+       std::string("overlay@600.0000000000000000001"), std::string("overlay@nan"),
+       std::string("overlay@inf"), std::string("overlay@1e2"), std::string("overlay@+1"),
+       std::string("overlay@1s"), std::string("overlay@ 1"), std::string("overlay@1 "),
+       std::string("overlay@.5"), std::string("overlay@1."), std::string("overlay@"),
+       std::string("overlay@99999999999999999999"), std::string("overlay@1\0", 10),
+       std::string("overlay@1\nescape@2"), std::string(4097, 'x')}) {
+    // A valid prefix never survives a bad suffix.
+    const auto settings = map_keys({{"keys", "escape@1," + script}});
+    CHECK(settings.key_script.empty());
+    CHECK(settings.log.find("agent-test: keys ignored: ") == 0);
+    CHECK(settings.log.find('\n') == std::string::npos);
+  }
+  for (const auto& value : {nlohmann::json(nullptr), nlohmann::json(true), nlohmann::json(20),
+                           nlohmann::json::array(), nlohmann::json::object()}) {
+    const auto settings = map_keys({{"keys", value}});
+    CHECK(settings.key_script.empty());
+    CHECK(settings.log == "agent-test: keys ignored: expected a string");
+  }
+  CHECK(map_keys({{"keys", ""}}).log == "agent-test: keys ignored: empty script");
+  const auto mixed = map_keys({{"keys", "bad@1"}, {"mute", true}});
+  CHECK(mixed.arguments == (std::vector<std::string>{"--volume", "0"}));
+  CHECK(mixed.log == "agent-test.json applied default keys: mute\nagent-test: keys ignored: unknown key name");
+  std::filesystem::create_directories(directory);
+  { std::ofstream file(directory / "agent-test.json");
+    file << R"({"mute":true,"keys":"overlay@20,escape@30,overlay@45"})";
+    CHECK(file.good()); }
+  for (const auto engine : {Engine::Source, Engine::Static}) {
+    const auto settings = load(true, directory.u8string().c_str(), engine);
+    CHECK(settings.key_script.size() == 3);
+    CHECK(settings.log == "agent-test.json applied default keys: keys, mute");
+    const auto standalone = load(false, directory.u8string().c_str(), engine);
+    CHECK(standalone.key_script.empty() && standalone.log.empty());
+  }
+}
+
+struct Fixture {
+  Signals signals;
+  OverlayKey overlay;
+  KeyScript script;
+  std::vector<std::string> logs;
+  const KeyScript::Clock::time_point epoch{1000s};
+  Fixture(const std::string& keys, bool stdio = true) {
+    lines.clear();
+    signals.start(stdio, write_line);
+    script.arm(stdio, parse(keys));
+  }
+  void pump(KeyScript::Clock::time_point now, bool stdio = true) {
+    script.pump(stdio, now, signals, overlay,
+      [] { write_line("yg {\"key\":\"escape\"}"); },
+      [&](const std::string& line) { logs.push_back(line); });
+  }
+  void real(bool down, bool shift = true, bool repeat = false) {
+    signals.emit(overlay.tab(true, down, shift, repeat).line);
+  }
+};
+
+static void schedule() {
+  Fixture f("overlay@20,escape@30,overlay@45");
+  f.pump(f.epoch + 700s);  // Process age cannot trigger the script.
+  f.signals.presented(false, f.epoch - 100s);  // Loading frame.
+  f.pump(f.epoch + 700s);
+  CHECK(lines == (std::vector<std::string>{kCaps}) && f.logs.empty());
+  f.signals.presented(true, f.epoch);
+  f.signals.presented(true, f.epoch + 15s);  // Later frames cannot reset the epoch.
+  f.pump(f.epoch - 1s);
+  f.pump(f.epoch + 20s - 1ms);
+  CHECK(lines == (std::vector<std::string>{kCaps, kReady}));
+  f.pump(f.epoch + 20s);
+  CHECK(lines.back() == kDown && lines.size() == 3);
+  CHECK(f.logs == (std::vector<std::string>{"agent-test: key overlay at 20 s"}));
+  f.pump(f.epoch + 20s + 99ms);
+  CHECK(lines.size() == 3);
+  f.pump(f.epoch + 20s + 100ms);
+  CHECK(lines.back() == kUp && lines.size() == 4 && f.logs.size() == 1);
+  f.pump(f.epoch + 30s);
+  CHECK(lines.back() == "yg {\"key\":\"escape\"}" && lines.size() == 5);
+  f.pump(f.epoch + 45s);
+  f.pump(f.epoch + 45s + 100ms);
+  f.pump(f.epoch + 900s);
+  CHECK(lines == (std::vector<std::string>{kCaps, kReady, kDown, kUp,
+      "yg {\"key\":\"escape\"}", kDown, kUp}));
+  CHECK(f.logs == (std::vector<std::string>{"agent-test: key overlay at 20 s",
+      "agent-test: key escape at 30 s", "agent-test: key overlay at 45 s"}));
+}
+
+static void holds() {
+  Fixture f("overlay@1,escape@2,overlay@3,overlay@4");
+  f.signals.presented(true, f.epoch);
+  f.real(true);
+  f.pump(f.epoch + 1s);
+  CHECK(lines.size() == 3 && lines.back() == kDown);
+  CHECK(f.logs.back() == "agent-test: key overlay at 1 s skipped: real Shift+Tab held");
+  f.pump(f.epoch + 1100ms);
+  CHECK(lines.size() == 3);  // Script must not release the real hold.
+  f.pump(f.epoch + 2s);
+  CHECK(lines.back() == "yg {\"key\":\"escape\"}");
+  f.signals.emit(f.overlay.cancel());
+  f.pump(f.epoch + 3s);  // Cancelled real hold remains reserved until release.
+  CHECK(lines.back() == kCancel && f.logs.back().find("skipped") != std::string::npos);
+  f.real(false, false);
+  f.pump(f.epoch + 4s);
+  CHECK(lines.back() == kDown);
+  f.pump(f.epoch + 4100ms);
+  CHECK(lines.back() == kUp && f.logs.size() == 4);
+
+  Fixture overlap("overlay@1,overlay@1.05,escape@1.06");
+  overlap.signals.presented(true, overlap.epoch);
+  overlap.pump(overlap.epoch + 1s);
+  overlap.real(true);
+  overlap.real(true, true, true);
+  overlap.real(false);
+  CHECK(lines.size() == 3);  // Real edges cannot shorten the tap or duplicate down.
+  overlap.pump(overlap.epoch + 1060ms);
+  CHECK(lines.back() == "yg {\"key\":\"escape\"}");
+  overlap.pump(overlap.epoch + 1100ms);
+  CHECK(lines == (std::vector<std::string>{kCaps, kReady, kDown,
+      "yg {\"key\":\"escape\"}", kUp, kDown}));
+  overlap.real(true);
+  overlap.pump(overlap.epoch + 1200ms);
+  CHECK(lines.back() == kUp);  // Up still arrives after 100 ms with a new real hold.
+  const auto count = lines.size();
+  overlap.real(false);
+  CHECK(lines.size() == count);  // Its release cannot emit a duplicate up.
+  CHECK(overlap.logs.size() == 3);
+
+  Fixture cancelled("overlay@1");
+  cancelled.signals.presented(true, cancelled.epoch);
+  cancelled.pump(cancelled.epoch + 1s);
+  cancelled.signals.emit(cancelled.overlay.cancel());
+  cancelled.real(true);
+  cancelled.pump(cancelled.epoch + 1100ms);
+  CHECK(lines == (std::vector<std::string>{kCaps, kReady, kDown, kCancel, kDown}));
+  cancelled.real(false);
+  CHECK(lines.back() == kUp);  // Stale script release cannot release a new real press.
+}
+
+static void gating_and_late_pump() {
+  Fixture standalone("overlay@1,escape@2", false);
+  standalone.signals.presented(true, standalone.epoch);
+  standalone.pump(standalone.epoch + 10s, false);
+  standalone.pump(standalone.epoch + 10s);
+  CHECK(lines.empty() && standalone.logs.empty());
+  Fixture f("overlay@1,escape@2");
+  f.signals.presented(true, f.epoch);
+  f.pump(f.epoch + 5s, false);
+  CHECK(lines.size() == 2 && f.logs.empty());
+  f.pump(f.epoch + 5s);  // A stalled pump still gives a full 100 ms tap.
+  CHECK(lines == (std::vector<std::string>{kCaps, kReady, kDown, "yg {\"key\":\"escape\"}"}));
+  f.pump(f.epoch + 5099ms);
+  CHECK(lines.size() == 4);
+  f.pump(f.epoch + 5100ms);
+  CHECK(lines.back() == kUp);
+}
+
+int main(int argc, char** argv) {
+  CHECK(argc == 2);
+  parsing(std::filesystem::u8path(argv[1]));
+  schedule();
+  holds();
+  gating_and_late_pump();
+  std::printf("yougame_agent_keys: %u checks passed\n", checks);
+}
+#else
+// Include the hook header in an off build, alongside the normal parity path. The
+// production scanner must find no script diagnostics or hook implementation.
+int main() {
+  yougame::parity::OverlayKey key;
+  return key.tab(false, true, true, false).swallowed ? 1 : 0;
+}
+#endif
diff --git a/port/tests/yougame_agent_pad_test.cpp b/port/tests/yougame_agent_pad_test.cpp
new file mode 100644
index 0000000..3e73e2a
--- /dev/null
+++ b/port/tests/yougame_agent_pad_test.cpp
@@ -0,0 +1,81 @@
+// Offline, exhaustive frame checks for the test-only GameCube port-1 sequence.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_agent_pad.h"
+#include "settings_chord.h"
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame::agent_test;
+
+void neutral_axes(const MuPadStatus& pad) {
+  CHECK(pad.stick_x == 0 && pad.stick_y == 0);
+  CHECK(pad.sub_x == 0 && pad.sub_y == 0);
+  CHECK(pad.trigger_l == 0 && pad.trigger_r == 0);
+  CHECK(pad.analog_a == 0 && pad.analog_b == 0);
+}
+
+void no_override(const PadFrame& state) {
+  CHECK(!state.active && state.step == -1);
+  CHECK(state.pad.err == -1 && state.pad.button == 0);
+  neutral_axes(state.pad);
+}
+
+void sequence(int seconds) {
+  const uint64_t start = static_cast<uint64_t>(seconds) * 60;
+  // Check each frame, rather than deriving expectations from the production step table.
+  for (uint64_t frame = 0; frame < start; ++frame) no_override(pad_back_frame(frame, seconds));
+  bool chord_held = false;
+  int chord_edges = 0, right_edges = 0, a_edges = 0;
+  uint16_t last_buttons = 0;
+  for (uint64_t f = 0; f < 152; ++f) {
+    const auto state = pad_back_frame(start + f, seconds);
+    CHECK(state.active && state.pad.err == 0);
+    neutral_axes(state.pad);
+    uint16_t expected = 0;
+    if (f >= 30 && f < 40) expected = 0x1014;
+    if ((f >= 60 && f < 66) || (f >= 80 && f < 86)) expected = 0x0002;
+    if ((f >= 100 && f < 106) || (f >= 126 && f < 132)) expected = 0x0100;
+    CHECK(state.pad.button == expected);
+    const int expected_step = f < 30 ? 0 : f < 40 ? 1 : f < 60 ? 2 : f < 66 ? 3 :
+        f < 80 ? 4 : f < 86 ? 5 : f < 100 ? 6 : f < 106 ? 7 : f < 126 ? 8 : f < 132 ? 9 : 10;
+    CHECK(state.step == expected_step);
+    // Exercise the actual chord edge/suppression policy on the same state the menu snapshot gets.
+    auto buttons = state.pad.button;
+    if (host::settings_shortcut::poll_z_start(true, buttons, chord_held)) ++chord_edges;
+    CHECK(buttons == (expected == 0x1014 ? 0 : expected));
+    if ((buttons & 0x0002) && !(last_buttons & 0x0002)) ++right_edges;
+    if ((buttons & 0x0100) && !(last_buttons & 0x0100)) ++a_edges;
+    last_buttons = buttons;
+  }
+  CHECK(chord_edges == 1 && right_edges == 2 && a_edges == 2);
+  CHECK(!chord_held && last_buttons == 0);
+  for (uint64_t f : {start + 152, start + 153, start + 304, uint64_t(1000000),
+                     std::numeric_limits<uint64_t>::max()}) no_override(pad_back_frame(f, seconds));
+}
+
+void clock_gating() {
+  PadBack script;
+  const PadBack::Clock::time_point epoch{};
+  no_override(script.sample(epoch + std::chrono::hours(1)));
+  script.arm(10, epoch);
+  no_override(script.sample(epoch - std::chrono::seconds(1)));
+  no_override(script.sample(epoch + std::chrono::milliseconds(9999)));
+  CHECK(script.sample(epoch + std::chrono::seconds(10)).active);
+  // The same instant has the same input, regardless of the number of input reads or render frames.
+  for (int i = 0; i < 200; ++i) {
+    const auto state = script.sample(epoch + std::chrono::milliseconds(10500));
+    CHECK(state.active && state.step == 1 && state.pad.button == 0x1014);
+  }
+  no_override(script.sample(epoch + std::chrono::milliseconds(12534)));
+  no_override(script.sample(epoch + std::chrono::hours(1)));
+}
+
+int main() {
+  sequence(10);
+  sequence(900);
+  for (int seconds : {0, 9, 901}) no_override(pad_back_frame(60000, seconds));
+  clock_gating();
+  std::puts("yougame_agent_pad: all 152 frames, releases, connected state, chord edges, timing and no repeat ok");
+}
diff --git a/port/tests/yougame_agent_pad_ui_test.cpp b/port/tests/yougame_agent_pad_ui_test.cpp
new file mode 100644
index 0000000..3129046
--- /dev/null
+++ b/port/tests/yougame_agent_pad_ui_test.cpp
@@ -0,0 +1,171 @@
+// Offline regression: the hook waits for UI samples, including hidden/stalled rendering.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_agent_pad.h"
+#include "settings_chord.h"
+#include "settings_nav.h"
+#include "imgui.h"
+#include "imgui_internal.h"
+#include <cstdio>
+#include <cstdlib>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame::agent_test;
+
+void acknowledgement() {
+  PadBack script;
+  const PadBack::Clock::time_point epoch{};
+  CHECK(!script.sample_for_ui(epoch + std::chrono::hours(1)).active);
+  script.arm(10, epoch);
+  CHECK(!script.sample_for_ui(epoch - std::chrono::seconds(1)).active);
+  CHECK(!script.sample_for_ui(epoch + std::chrono::milliseconds(9999)).active);
+  CHECK(script.sample_for_ui(epoch + std::chrono::seconds(10)).step == 0);
+  for (int i = 0; i < 1000; ++i)
+    CHECK(script.sample_for_ui(epoch + std::chrono::hours(1)).step == 0);
+  CHECK(!script.consume_ui(-1) && !script.consume_ui(1));
+  CHECK(script.consume_ui(0));
+  CHECK(script.sample_for_ui(epoch + std::chrono::hours(2)).step == 0);
+  CHECK(script.consume_ui(0));
+  CHECK(!script.consume_ui(0));
+  CHECK(script.sample_for_ui(epoch + std::chrono::hours(2)).step == 1);
+  constexpr unsigned counts[] = {2, 1, 3, 1, 3, 1, 3, 1, 3, 1, 3};
+  constexpr uint16_t buttons[] = {0, 0x1014, 0, 2, 0, 2, 0, 0x100, 0, 0x100, 0};
+  for (int step = 1; step < 11; ++step) {
+    // Wall time and any number of input reads cannot skip a press or release.
+    for (unsigned ui = 0; ui < counts[step]; ++ui) {
+      for (int read = 0; read < 50; ++read) {
+        const auto pad = script.sample_for_ui(epoch + std::chrono::hours(24));
+        CHECK(pad.active && pad.step == step && pad.pad.err == 0);
+        CHECK(pad.pad.button == buttons[step]);
+      }
+      CHECK(script.consume_ui(step));
+    }
+    CHECK(!script.consume_ui(step));
+  }
+  CHECK(!script.sample_for_ui(epoch + std::chrono::hours(48)).active);
+  CHECK(!script.consume_ui(10));
+  for (int seconds : {0, 9, 901}) {
+    PadBack invalid;
+    invalid.arm(seconds, epoch);
+    CHECK(!invalid.sample_for_ui(epoch + std::chrono::hours(48)).active);
+  }
+}
+
+// Exercise the bundled ImGui navigation engine and the production arming/chord rules. No OS
+// window, renderer, physical input or exit action. Layout/IDs match the small YouGame menu.
+void menu_navigation(float dt, bool render_faster_than_input,
+                     ImGuiKey activate = ImGuiKey_GamepadFaceDown, bool hide_confirmation_cursor = false) {
+  ImGui::CreateContext();
+  auto& io = ImGui::GetIO();
+  io.IniFilename = nullptr;
+  io.LogFilename = nullptr;
+  io.DisplaySize = ImVec2(1280, 960);
+  io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
+  io.ConfigInputTrickleEventQueue = false;
+  unsigned char* pixels;
+  int w, h;
+  io.Fonts->GetTexDataAsRGBA32(&pixels, &w, &h);
+  PadBack script;
+  const PadBack::Clock::time_point epoch{};
+  script.arm(10, epoch);
+  bool open = false, quit = false, exited = false, chord = false, toggle = false;
+  bool focus_pending = false;
+  bool was_active = false, armed = false, rest[4]{};
+  int port = 0, right_edges = 0, left_edges = 0, a_edges = 0, quit_actions = 0, confirm_actions = 0, focus_requests = 0;
+  const bool keyboard = activate != ImGuiKey_GamepadFaceDown;
+  const ImGuiKey right = keyboard ? ImGuiKey_RightArrow : ImGuiKey_GamepadDpadRight;
+  PadFrame published;
+  for (int frame = 0; frame < 100 && !exited; ++frame) {
+    // Let input time run arbitrarily far ahead, then sometimes render the same snapshot twice.
+    if (!render_faster_than_input || frame % 2 == 0) {
+      published = script.sample_for_ui(epoch + std::chrono::hours(frame + 1));
+      if (!published.active) break;
+      if (host::settings_shortcut::poll_z_start(true, published.pad.button, chord)) toggle = true;
+    }
+    auto pad = published.pad;
+    if (!script.consume_ui(published.step)) pad = {}; // window_ui_pads' stale-snapshot release
+    host::settings_nav::Pad pads[4] = {{true, pad.button, pad.stick_x, pad.stick_y}, {}, {}, {}};
+    const bool active = open;
+    port = host::settings_nav::follow(pads, rest, port, active);
+    CHECK(port == 0);
+    io.ConfigFlags &= ~ImGuiConfigFlags_NavEnableGamepad;
+    io.BackendFlags &= ~ImGuiBackendFlags_HasGamepad;
+    if (active && !was_active) {
+      io.ClearEventsQueue();
+      io.ClearInputKeys();
+      armed = false;
+    }
+    was_active = active;
+    if (!active) armed = false;
+    else if (!armed) armed = pad.button == 0;
+    if (active && armed) {
+      io.ConfigFlags |= ImGuiConfigFlags_NavEnableGamepad;
+      io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+      io.AddKeyEvent(activate, (pad.button & 0x100) != 0);
+      io.AddKeyEvent(right, (pad.button & 2) != 0);
+      io.AddKeyEvent(ImGuiKey_GamepadDpadLeft, (pad.button & 1) != 0);
+    }
+    io.DeltaTime = dt;
+    ImGui::NewFrame();
+    if (ImGui::IsKeyPressed(right, true)) ++right_edges;
+    if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft, true)) ++left_edges;
+    if (ImGui::IsKeyPressed(activate, false)) ++a_edges;
+    if (toggle) { open = !open; quit = false; toggle = false; }
+    if (open) {
+      ImGui::SetNextWindowPos(ImVec2(260, 770), ImGuiCond_Always);
+      ImGui::SetNextWindowSize(ImVec2(760, 172), ImGuiCond_Always);
+      ImGui::Begin("##esc_menu", nullptr, ImGuiWindowFlags_NoDecoration | ImGuiWindowFlags_NoMove |
+          ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings | ImGuiWindowFlags_NoBackground);
+      const int count = quit ? 2 : 3;
+      const float width = (760.f - 40.f - 10.f * (count - 1)) / count;
+      const auto action = [&](const char* id, int index) {
+        ImGui::SetCursorPos(ImVec2(20.f + index * (width + 10.f), 66));
+        const bool pressed = ImGui::InvisibleButton(id, ImVec2(width, 58), ImGuiButtonFlags_EnableNav);
+        // Mirror the production one-shot focus transfer, including the gamepad cursor requirement.
+        if (quit && index == 0 && focus_pending) {
+          CHECK(!ImGui::IsWindowAppearing()); // the regression: this is an in-place view change
+          if (hide_confirmation_cursor) ImGui::SetNavCursorVisible(false);
+          ImGui::SetFocusID(ImGui::GetItemID(), ImGui::GetCurrentWindow());
+          if (ImGui::GetCurrentContext()->NavInputSource == ImGuiInputSource_Gamepad)
+            ImGui::SetNavCursorVisible(true);
+          focus_pending = false;
+          ++focus_requests;
+          CHECK(ImGui::IsItemFocused()); // focused on the confirmation's very first frame
+          CHECK(!pressed && !exited);   // transferring focus must not activate the confirmation
+          if (!keyboard) CHECK(ImGui::GetCurrentContext()->NavCursorVisible);
+        }
+        return pressed;
+      };
+      if (!quit) {
+        CHECK(!action("##resume", 0));
+        ImGui::SetItemDefaultFocus();
+        CHECK(!action("##settings", 1));
+        if (action("##quit", 2)) { quit = true; focus_pending = true; ++quit_actions; }
+      } else {
+        const bool enter = ImGui::IsKeyPressed(ImGuiKey_Enter, false) || ImGui::IsKeyPressed(ImGuiKey_KeypadEnter, false);
+        if (action("##confirm_quit", 0) || enter) { exited = true; ++confirm_actions; }
+        ImGui::SetItemDefaultFocus();
+        CHECK(!action("##cancel_quit", 1));
+      }
+      ImGui::End();
+    }
+    ImGui::Render();
+  }
+  CHECK(exited && quit_actions == 1 && confirm_actions == 1 && focus_requests == 1);
+  CHECK(right_edges == 2 && a_edges == 2);
+  CHECK(left_edges == 0);
+  ImGui::DestroyContext();
+}
+
+int main() {
+  acknowledgement();
+  for (float dt : {1.f / 60.f, 0.7f, 5.f}) {
+    menu_navigation(dt, false);
+    menu_navigation(dt, true);
+    menu_navigation(dt, false, ImGuiKey_Enter);
+    menu_navigation(dt, true, ImGuiKey_Enter);
+    menu_navigation(dt, false, ImGuiKey_KeypadEnter);
+    menu_navigation(dt, true, ImGuiKey_KeypadEnter);
+  }
+  menu_navigation(1.f / 60.f, false, ImGuiKey_GamepadFaceDown, true);
+  std::puts("yougame_agent_pad_ui: stalls, acknowledgements, stale snapshots, arming, A/A, Enter/Enter and keypad Enter exit navigation ok");
+}
diff --git a/port/tests/yougame_agent_present_test.cpp b/port/tests/yougame_agent_present_test.cpp
new file mode 100644
index 0000000..ab704f0
--- /dev/null
+++ b/port/tests/yougame_agent_present_test.cpp
@@ -0,0 +1,153 @@
+// Window-free validation, evidence formatting, box filtering and asynchronous output.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "yougame_agent_present.h"
+#include <cstdio>
+#ifdef YOUGAME_AGENT_TEST_HOOK
+#include "yougame_agent_test.h"
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+
+static unsigned checks = 0;
+#define CHECK(x) do { ++checks; if (!(x)) { std::fprintf(stderr, "line %d: %s\n", __LINE__, #x); std::exit(1); } } while (0)
+using namespace yougame;
+using namespace std::chrono_literals;
+namespace fs = std::filesystem;
+
+static std::string read(const fs::path& path) {
+  std::ifstream file(path, std::ios::binary);
+  CHECK(file.good());
+  return std::string(std::istreambuf_iterator<char>(file), {});
+}
+static void validation(const fs::path& directory) {
+  using agent_test::Engine;
+  auto parse = [&](const nlohmann::json& object) { return agent_test::map_keys(object, Engine::Source, directory); };
+  const auto good = parse({{"present_log", "presents.txt"}, {"present_frames", "strip:600"}});
+  CHECK(good.present.log == "presents.txt");
+  CHECK(good.present.directory == "strip" && good.present.every == 600);
+  CHECK(good.environment.empty() && good.arguments.empty());
+  CHECK(good.log == "agent-test.json applied default keys: present_frames, present_log");
+  for (const auto* name : {"log", "log.txt", "log-file_1.txt", "frame strip"}) {
+    CHECK(parse({{"present_log", name}}).present.log == name);
+    CHECK(parse({{"present_frames", std::string(name) + ":1"}}).present.every == 1);
+  }
+  for (const auto& name : {std::string(), std::string("."), std::string(".."), std::string("a..b"),
+       std::string("../x"), std::string("/absolute"), std::string("C:\\absolute"), std::string("a/b"),
+       std::string("a\\b"), std::string("a:b"), std::string("x\ny"), std::string("x\0y", 3)}) {
+    for (const auto* key : {"present_log", "present_frames"}) {
+      const auto s = parse({{key, name + (std::string(key) == "present_frames" ? ":30" : "")}, {"mute", true}});
+      CHECK(!s.present.enabled());
+      CHECK(s.log == std::string("agent-test.json applied default keys: mute\nagent-test: ") +
+          key + " invalid name or interval; ignored"); // Exactly one refusal; other keys survive.
+    }
+  }
+  for (const auto* spec : {"strip:0", "strip:601", "strip:-1", "strip:+1", "strip:1.5", "strip:",
+                           "strip", "strip:1:2", "strip:99999999999999999999", "strip: 1"}) {
+    CHECK(!parse({{"present_frames", spec}}).present.enabled());
+  }
+  for (const auto& value : {nlohmann::json(nullptr), nlohmann::json(1), nlohmann::json(true), nlohmann::json::array()}) {
+    CHECK(!parse({{"present_log", value}, {"present_frames", value}}).present.enabled());
+  }
+  CHECK(!agent_test::map_keys({{"present_log", "p.txt"}}, Engine::Source).present.enabled());
+  CHECK(!agent_test::map_keys({{"present_log", "p.txt"}}, Engine::Static, directory).present.enabled());
+  // Checked output paths refuse symlinks, even when the leaf would stay within the root.
+  { std::ofstream file(directory / "target"); file << "untouched"; }
+  fs::create_symlink(directory / "target", directory / "linked-log");
+  fs::create_directory_symlink(directory / "strip", directory / "linked-frames");
+  CHECK(!parse({{"present_log", "linked-log"}}).present.enabled());
+  CHECK(!parse({{"present_frames", "linked-frames:1"}}).present.enabled());
+  CHECK(read(directory / "target") == "untouched");
+  { std::ofstream file(directory / "agent-test.json");
+    file << R"({"present_log":"loaded.txt","present_frames":"loaded:30"})"; }
+  CHECK(!agent_test::load(false, directory.u8string().c_str()).present.enabled());
+  CHECK(!agent_present::recorder().enabled());
+  const auto loaded = agent_test::load(true, directory.u8string().c_str());
+  CHECK(loaded.present.enabled() && agent_present::recorder().enabled());
+  agent_present::recorder().stop();
+  CHECK(!fs::exists(directory / "loaded.txt")); // Opening waits for the first present.
+  CHECK(!agent_test::load(true, nullptr).present.enabled());
+}
+static void formatting() {
+  CHECK(agent_present::header(123456789) ==
+      "present-log v1 wall_ms=123456789 fields=present us sim scene backbuffer window scale\n");
+  CHECK(agent_present::line(1, 0, 77, 2, 10, 1920, 1080, 960, 540) ==
+      "1 0 77 02:0A 1920x1080 960x540 2.000\n");
+  CHECK(agent_present::line(60, 999999, 100, 0x1c, 2, 1000, 500, 800, 400) ==
+      "60 999999 100 1C:02 1000x500 800x400 1.250\n");
+  CHECK(agent_present::frame_name("strip", 60, 999999) == "strip/60-999999.ppm");
+}
+static void filtering() {
+  const uint8_t pixels[] = {0,10,20, 20,30,40, 100,110,120, 120,130,140,
+                            40,50,60, 60,70,80, 140,150,160, 160,170,180};
+  const auto image = agent_present::downscale(pixels, 4, 2, 2);
+  CHECK(image.width == 2 && image.height == 1);
+  CHECK(image.pixels == (std::vector<uint8_t>{30,40,50, 130,140,150}));
+  CHECK(image.ppm_header() == "P6\n2 1\n255\n");
+  const auto flipped = agent_present::downscale(pixels, 4, 2, 4);
+  CHECK(flipped.width == 4 && flipped.height == 2);
+  CHECK(flipped.pixels == (std::vector<uint8_t>{40,50,60, 60,70,80, 140,150,160, 160,170,180,
+                                              0,10,20, 20,30,40, 100,110,120, 120,130,140}));
+  CHECK(agent_present::downscale(pixels, 4, 2, 4, false).pixels == std::vector<uint8_t>(pixels, pixels + 24));
+  const uint8_t fractional[] = {0,0,0, 60,60,60, 180,180,180};
+  const auto narrow = agent_present::downscale(fractional, 3, 1, 2);
+  CHECK(narrow.width == 2 && narrow.height == 1);
+  CHECK(narrow.pixels == (std::vector<uint8_t>{20,20,20, 140,140,140}));
+  const uint8_t one[] = {1,2,3};
+  CHECK(agent_present::downscale(one, 1, 1).pixels == (std::vector<uint8_t>{1,2,3}));
+  CHECK(agent_present::downscale(nullptr, 4, 2).pixels.empty());
+  std::vector<uint8_t> wide(960 * 4 * 3, 73);
+  const auto half = agent_present::downscale(wide.data(), 960, 4);
+  CHECK(half.width == 480 && half.height == 2);
+  CHECK(half.pixels == std::vector<uint8_t>(480 * 2 * 3, 73));
+}
+static void limits() {
+  agent_present::Budget count;
+  CHECK(count.reserve(18000, 100) == nullptr && !count.stopped);
+  CHECK(std::string(count.reserve(18001, 0)) == "18000 presents" && count.stopped);
+  CHECK(count.reserve(18002, 0) == nullptr); // One notice.
+  agent_present::Budget bytes;
+  CHECK(bytes.reserve(1, bytes.byte_limit - 1) == nullptr);
+  CHECK(std::string(bytes.reserve(2, 2)) == "2 GiB limit");
+  CHECK(bytes.reserved == bytes.byte_limit - 1);
+  CHECK(bytes.reserve(3, 2) == nullptr);
+}
+static void output(const fs::path& directory) {
+  agent_paths::Root root;
+  CHECK(root.load(directory));
+  agent_present::Recorder recorder;
+  CHECK(recorder.arm({"output.txt", "output-frames", 2}, root));
+  const auto epoch = agent_present::Recorder::Clock::time_point(100s);
+  const auto wall = std::chrono::system_clock::time_point(123456789ms);
+  std::string expected = agent_present::header(123456789);
+  for (uint64_t n = 1; n <= 61; ++n) {
+    const auto us = (n - 1) * 16667;
+    const bool wanted = recorder.wants_frame(n);
+    CHECK(wanted == (n % 2 == 0));
+    agent_present::Image image;
+    if (wanted) { image.width = image.height = 1; image.pixels = {uint8_t(n), 2, 3}; }
+    recorder.after_swap(n, 100 + n, 2, 2, 960, 540, 480, 270, std::move(image), epoch + std::chrono::microseconds(us), wall);
+    expected += agent_present::line(n, us, 100 + n, 2, 2, 960, 540, 480, 270);
+  }
+  recorder.stop(); // Drains queued work and flushes the final partial batch.
+  CHECK(read(directory / "output.txt") == expected);
+  CHECK(std::distance(fs::directory_iterator(directory / "output-frames"), fs::directory_iterator{}) == 30);
+  auto ppm = std::string("P6\n1 1\n255\n"); ppm.append("\x02\x02\x03", 3);
+  CHECK(read(directory / "output-frames/2-16667.ppm") == ppm);
+  CHECK(!fs::exists(directory / "output-frames/1-0.ppm"));
+  CHECK(recorder.arm({"", "limit-frames", 600}, root));
+  CHECK(recorder.wants_frame(18000));
+  CHECK(!recorder.wants_frame(18001));
+  CHECK(!recorder.wants_frame(18600));
+  recorder.stop();
+}
+int main(int argc, char** argv) {
+  CHECK(argc == 2);
+  const auto directory = fs::absolute(fs::u8path(argv[1]));
+  fs::remove_all(directory); fs::create_directories(directory);
+  validation(directory); formatting(); filtering(); limits(); output(directory);
+  fs::remove_all(directory);
+  std::printf("yougame_agent_present_test: %u/%u passed\n", checks, checks);
+}
+#else
+int main() { std::puts("presentation evidence disabled"); }
+#endif
